<?xml version="1.0" encoding="utf-8"?>
<s:SkinnableContainer xmlns:fx="http://ns.adobe.com/mxml/2009" 
					  xmlns:s="library://ns.adobe.com/flex/spark" 
					  xmlns:mx="library://ns.adobe.com/flex/mx"
					  backgroundAlpha="0"
					  >
	
	<fx:Metadata>
		[Event(name="signOut", type="flash.events.Event")]
	</fx:Metadata>
	
	<fx:Script>
		<![CDATA[
			import com.gazuntite.common.model.valueobject.provider.ProviderStatusDTO;
			import com.gazuntite.common.utils.UtilityFunctions;
			import com.gazuntite.temp.model.TempApplicationModel;
			[Bindable]
			protected var model:TempApplicationModel = TempApplicationModel.getInstance();
		]]>
	</fx:Script>
	
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	
	
	<s:layout>
		<s:VerticalLayout paddingBottom="5" paddingLeft="5" paddingRight="5" paddingTop="5" />
	</s:layout>
	
	<s:HGroup width="100%" horizontalAlign="center"  >
		<s:ToggleButton label="{UtilityFunctions.TitleCase( ProviderStatusDTO.ONLINE )}" 
						skinClass="com.gazuntite.topbar.skin.OnlineButton"
						selected="{model.loggedInUserSessionDTO.Status == ProviderStatusDTO.ONLINE}"
						width="33.3%"/>
		<s:ToggleButton label="{UtilityFunctions.TitleCase( ProviderStatusDTO.AWAY )}" 
						selected="{model.loggedInUserSessionDTO.Status == ProviderStatusDTO.AWAY}" 
						skinClass="com.gazuntite.topbar.skin.AwayButton"
						width="33.3%"/>
		<s:ToggleButton label="{UtilityFunctions.TitleCase( ProviderStatusDTO.BUSY )}" 
						selected="{model.loggedInUserSessionDTO.Status == ProviderStatusDTO.BUSY}" 
						skinClass="com.gazuntite.topbar.skin.BusyButton"
						width="33.3%"/>
		
	</s:HGroup>
	
	<s:Button label="SIGN OUT" width="100%" skinClass="com.gazuntite.topbar.skin.SignoutButton"
			  />
	
</s:SkinnableContainer>
