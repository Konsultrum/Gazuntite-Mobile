<?xml version="1.0" encoding="utf-8"?>
<s:BorderContainer borderVisible="false" backgroundColor="#101010" xmlns:fx="http://ns.adobe.com/mxml/2009" 
					  xmlns:s="library://ns.adobe.com/flex/spark" xmlns:view="com.gazuntite.topbar.view.*"
					  height="90"
					  >
	<fx:Script>
		<![CDATA[
			import com.gazuntite.common.logo.LogoAsset;
			import com.gazuntite.common.model.valueobject.provider.ProviderStatusDTO;
			import com.gazuntite.common.utils.UtilityFunctions;
			import com.gazuntite.common.viewmodel.mainlayout.MainLayoutManager;
			import com.gazuntite.temp.model.TempApplicationModel;
			[Bindable]
			public var mainContainerManager:MainLayoutManager = MainLayoutManager.getInstance();
			
			[Bindable]
			protected var model:TempApplicationModel = TempApplicationModel.getInstance();
			
			[Bindable]
			protected var tabHeight:Number = 30;
			
			[Bindable]
			protected var tabSelectedHeight:Number = 36;

			protected function onLoginStatusClick(event:MouseEvent):void
			{
				var call:LoginStatusCallout = new LoginStatusCallout();
				call.open(event.target as DisplayObjectContainer, true);
			}
			
			protected function onNameClick(event:MouseEvent):void
			{
				var callout:AddressViewCallout = new AddressViewCallout();
				callout.open(uiNameOptionContainer, true);
			}
			
		]]>
	</fx:Script>
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	<s:layout>
		<s:BasicLayout
			/>
	</s:layout>
	<view:TopBarLogo id="uiLogo" x="0" y="0"/>
	<s:VGroup height="100%" verticalAlign="top" horizontalAlign="center" gap="2" horizontalCenter="0">
		
		<s:SkinnableContainer id="uiNameOptionContainer" width="100%" height="32"
							  skinClass="assets.skin.BlackBackgroundSkin"
							  click="onNameClick(event)"
							  >
			<s:layout>
				<s:HorizontalLayout horizontalAlign="left" verticalAlign="middle" paddingLeft="10" paddingRight="4"/>
			</s:layout>
			<s:Label id="actionBarTitle"
					 text="DR. JOHN HARRISON" 
					 fontSize="24" fontWeight="bold"
					 color="#ffffff"
					 fontFamily="CalibriCFF"
					 verticalCenter="0" maxDisplayedLines="1"  
					 />
			<s:Spacer width="100%"/>
			<s:Button id="uiOptionButton"
							skinClass="assets.skin.MoreOptionToggleButtonSkin"
							
							/>
			
		</s:SkinnableContainer>
		
		<s:Label text="95 M Street, NW, Washington DC" color="#ffffff" fontSize="14"/>
		
		<s:HGroup  paddingTop="4" horizontalAlign="center" verticalAlign="top" height="{tabHeight}" gap="10">
			<s:ToggleButton id="uiRapid" 
							width="80"
							height="{mainContainerManager.curViewState.rapidAccessViewOpen?tabSelectedHeight:tabHeight}"
							skinClass="com.gazuntite.topbar.skin.RapidAccessButtonSkin"
							selected="{mainContainerManager.curViewState.rapidAccessViewOpen}"
							change="mainContainerManager.toggleRapidAccess()"
							/>
			<s:ToggleButton width="80" 
							height="{mainContainerManager.curViewState.communicationViewOpen?tabSelectedHeight:tabHeight}"
							skinClass="com.gazuntite.topbar.skin.CommunicationButtonSkin"
							selected="{mainContainerManager.curViewState.communicationViewOpen}"
							change="mainContainerManager.toggleCommunication()"
							/>
			<s:ToggleButton width="80" 
							height="{mainContainerManager.curViewState.webViewOpen?tabSelectedHeight:tabHeight}"
							skinClass="com.gazuntite.topbar.skin.WebButtonSkin"
							selected="{mainContainerManager.curViewState.webViewOpen}"
							change="mainContainerManager.toggleWeb()"
							/>
		</s:HGroup>
		
	</s:VGroup>
	<s:HGroup top="0" right="4" height="90" gap="0" verticalAlign="bottom">
		<s:ToggleButton height="100%" skinClass="com.gazuntite.topbar.skin.UserThumbSkin"/>
		<s:Image smooth="true" source="@Embed('/assets/images/online_icon.png')"
				 width="40" height="50"
				 visible="{model.loggedInUserSessionDTO.Status == ProviderStatusDTO.ONLINE}"
				 includeInLayout="{model.loggedInUserSessionDTO.Status == ProviderStatusDTO.ONLINE}"
				 click="onLoginStatusClick(event)"
				 />
		<s:Image smooth="true" source="@Embed('/assets/images/away_icon.png')"
				 width="40" height="50"
				 visible="{model.loggedInUserSessionDTO.Status == ProviderStatusDTO.AWAY}"
				 includeInLayout="{model.loggedInUserSessionDTO.Status == ProviderStatusDTO.AWAY}"
				 />
		<s:Image smooth="true" source="@Embed('/assets/images/busy_icon.png')"
				 width="40" height="50"
				 visible="{model.loggedInUserSessionDTO.Status == ProviderStatusDTO.BUSY}"
				 includeInLayout="{model.loggedInUserSessionDTO.Status == ProviderStatusDTO.BUSY}"
				 />
	</s:HGroup>
</s:BorderContainer>
