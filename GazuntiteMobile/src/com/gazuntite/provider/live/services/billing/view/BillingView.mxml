<?xml version="1.0" encoding="utf-8"?>
<s:BorderContainer xmlns:fx="http://ns.adobe.com/mxml/2009" 
					  xmlns:s="library://ns.adobe.com/flex/spark" 
					  xmlns:mx="library://ns.adobe.com/flex/mx"
					  xmlns:superbill="com.gazuntite.provider.live.services.billing.view.superbill.*" 
					  xmlns:view="com.gazuntite.provider.live.services.billing.superBill.view.*"
					  borderVisible="false" backgroundColor="0xFFFFFF" cornerRadius="3"
					  >
	<fx:Script>
		<![CDATA[
			import com.gazuntite.provider.live.services.billing.superBill.model.SuperBillModelLocator;
			
			[Bindable]
			private var model:SuperBillModelLocator = SuperBillModelLocator.getInstance();
			
			private var _QIVisitID:int;
			private var _QIVisitProviderID:int;

			public function get QIVisitProviderID():int
			{
				return _QIVisitProviderID;
			}

			public function set QIVisitProviderID(value:int):void
			{
				_QIVisitProviderID = value;
				model.VisitProviderID = value;
				
			}


			public function get QIVisitID():int
			{
				return _QIVisitID;
			}

			public function set QIVisitID(value:int):void
			{
				model.isFromPendingBills = false;
				_QIVisitID = value;	
				model.VisitID = value;
			}
			
		]]>
	</fx:Script>
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	
	<s:layout>
		<s:VerticalLayout horizontalAlign="center" verticalAlign="top" gap="0"/>
	</s:layout>
	
	<s:Scroller width="100%" height="100%" 	horizontalScrollPolicy="off" verticalScrollPolicy="auto" 
				skinClass="com.gazuntite.skins.controls.list.InvisibleScrollerSkin">
		<s:Group width="100%" height="100%">
			<view:SuperBillMain width="100%" />	
		</s:Group>			
	</s:Scroller>
	
	<view:SuperBillButtonBar width="100%" />	
	
</s:BorderContainer>
