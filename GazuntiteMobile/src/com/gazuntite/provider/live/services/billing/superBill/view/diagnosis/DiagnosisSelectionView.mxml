<?xml version="1.0" encoding="utf-8"?>
<s:Group xmlns:fx="http://ns.adobe.com/mxml/2009" 
		 xmlns:s="library://ns.adobe.com/flex/spark" 
		 xmlns:mx="library://ns.adobe.com/flex/mx" 		 		
		 creationComplete="cc(event)" xmlns:diagnosis="com.gazuntite.provider.live.services.billing.superBill.view.diagnosis.*" 
		 xmlns:components="com.gazuntite.controls.extended.components.*" 
		 xmlns:search="com.gazuntite.components.search.*" 
		 >
	<fx:Script>
		<![CDATA[
			import com.adobe.cairngorm.control.CairngormEventDispatcher;
			import com.gazuntite.common.dto.assessment.diagnosis.ICDCodeDTO;
			import com.gazuntite.common.event.visit.LoadDiagnosisICDCodeEvent;
			import com.gazuntite.components.search.SearchDropDownEvent;
			import com.gazuntite.provider.live.services.billing.superBill.model.SuperBillModelLocator;
			import com.gazuntite.provider.live.services.billing.superBill.view.event.diagnosis.SuperBillDiagnosisSelectedEvent;
						
			import mx.core.FlexGlobals;
			import mx.events.FlexEvent;
			
			[Embed(source="com/gazuntite/provider/live/services/billing/view/assets/search_text.png")]
			[Bindable]	public var searchText:Class;
			
			[Bindable]
			public var model:SuperBillModelLocator = SuperBillModelLocator.getInstance();
			
			private var _isInputView:Boolean;
			
			[Bindable]
			public function get isInputView():Boolean
			{
				return _isInputView;
			}
			
			public function set isInputView(value:Boolean):void
			{
				_isInputView = value;
				if(value && selectedDiagnosis)
					id_selectDiagnosisVS.selectedIndex = 1;
				else
					id_selectDiagnosisVS.selectedIndex = 0;
			}
			
			private var _selectedDiagnosis:ICDCodeDTO;
			
			[Bindable]
			public function get selectedDiagnosis():ICDCodeDTO
			{
				return _selectedDiagnosis;
			}
			
			public function set selectedDiagnosis(value:ICDCodeDTO):void
			{
				_selectedDiagnosis = value;
				if(value)
					id_selectDiagnosisVS.selectedIndex = 1;	
			}
			
			
			private function toggleView():void
			{
				var toggleView:Boolean = id_selectDiagnosisVS.selectedIndex == 0;
				
				if( null != selectedDiagnosis && toggleView)
				{
					id_selectDiagnosisVS.selectedIndex = 1;
				}
				else
				{
					id_selectDiagnosisVS.selectedIndex = 0;
				}
			}
			
			protected function selectionView_clickHandler(event:MouseEvent):void
			{
				toggleView();
			}
			
			protected function whenDiagnosisSelected(event:SuperBillDiagnosisSelectedEvent):void
			{
				selectedDiagnosis = event.selection as ICDCodeDTO;
				
				toggleView();
			}
			
			
			protected function cc(event:FlexEvent):void
			{
				parent.addEventListener(MouseEvent.CLICK, function(event:Event):void
				{
					if(null != selectedDiagnosis)
					{						
						id_selectDiagnosisVS.selectedIndex = 1;
					}
				});				
			}
			
			protected function searchdropdown1_startSearchHandler(event:SearchDropDownEvent):void
			{
				trace(event.SearchQuery, event.searchTypePrompt, event.searchTypeIndex, event.SelectedItem);
				//do service call here for searching and when search result is ready pass arraycollection to SearchDropDown
				
				var DiagnosisEvent: LoadDiagnosisICDCodeEvent = new LoadDiagnosisICDCodeEvent(event.SearchQuery,model.LoggedInUserSessionID,model.LoggedInUserId,resultCallBack);
				CairngormEventDispatcher.getInstance().dispatchEvent(DiagnosisEvent);
			}
			
			protected function resultCallBack(icdCodeList:ArrayCollection):void
			{
				model.icdCodeDTOList = icdCodeList;
				id_searchDD.ShowResult(model.icdCodeDTOList);
			}
			
			protected function id_searchDD_searchResultSelectionChangeHandler(event:SearchDropDownEvent):void
			{
				selectedDiagnosis = event.SelectedItem;
			}			
			
		]]>
	</fx:Script>
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	
	<components:LabelViewStack id="id_selectDiagnosisVS" width="100%" height="100%"  borderVisible="false" backgroundAlpha="0">
		<s:ArrayList>
			<search:SearchDropDown id="id_searchDD"
								   width="100%" height="30" PromptFieldName="label" 
								   includeInLayout="{isInputView}" visible="{isInputView}" ShowResultAsPopup="true"
								   searchResultSelectionChange="id_searchDD_searchResultSelectionChangeHandler(event)"
								   startSearch="searchdropdown1_startSearchHandler(event)" 
								   ResultRenderer="com.gazuntite.provider.live.services.billing.superBill.view.itemRenderer.diagnosis.DiagnosisSearchIR">
				<search:DataProvider>
					<s:ArrayCollection>
						<fx:Object label="ICD Code" icon="{searchText}" />
						<fx:Object label="Diagnosis" icon="{searchText}" />
					</s:ArrayCollection>
				</search:DataProvider>
			</search:SearchDropDown>
			
			<s:Group width="100%" height="100%" click="selectionView_clickHandler(event)" includeInLayout="{isInputView}" visible="{isInputView}"
					 toolTip="{selectedDiagnosis.IcdCodeName +' - '+ selectedDiagnosis.IcdCodeDescription }"
					 >
				<s:layout>
					<s:HorizontalLayout horizontalAlign="left" verticalAlign="middle" paddingLeft="5"/>
				</s:layout>
				
				<s:Label text="{selectedDiagnosis.IcdCodeName}"  fontWeight="bold" fontFamily="CalibriCFFBold" fontSize="15" color="#666666"/>
				<s:Label text="{selectedDiagnosis.IcdCodeDescription}"
						 fontWeight="bold" fontFamily="CalibriCFFBold" 
						 fontSize="15" width="100%"  color="#000000" maxDisplayedLines="1" />
			</s:Group>
		</s:ArrayList>
	</components:LabelViewStack>
	
</s:Group>