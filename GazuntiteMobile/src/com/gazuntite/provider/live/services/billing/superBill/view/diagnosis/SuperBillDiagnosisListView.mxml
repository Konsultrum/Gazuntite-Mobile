<?xml version="1.0" encoding="utf-8"?>
<s:Group xmlns:fx="http://ns.adobe.com/mxml/2009" 
					  xmlns:s="library://ns.adobe.com/flex/spark" 
					  xmlns:mx="library://ns.adobe.com/flex/mx"
					  >
	
	<fx:Script>
		<![CDATA[
			import com.gazuntite.provider.live.services.billing.superBill.model.SuperBillModelLocator;
			
			[Bindable]
			private var model:SuperBillModelLocator = SuperBillModelLocator.getInstance();
			
		]]>
	</fx:Script>
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	<s:layout>
		<s:VerticalLayout gap="0" verticalAlign="middle"/>
	</s:layout>
	
	<s:SkinnableContainer width="100%" height="21" skinClass="com.gazuntite.skins.controls.container.ePrescription.RxHeaderSkin">
		<s:layout>
			<s:HorizontalLayout horizontalAlign="left" verticalAlign="middle" paddingLeft="8"  />
		</s:layout>
		
		<s:Label width="25%" text="Code" fontFamily="CalibriCFF" fontSize="14" color="#FFFFFFF" textAlign="left" paddingLeft="6" maxDisplayedLines="1" showTruncationTip="true"/>
		<s:Line height="100%" >
			<s:stroke>
				<s:SolidColorStroke caps="none" color="#4B4B4B" joints="miter" miterLimit="4" weight="1"/>
			</s:stroke>
		</s:Line>
		
		<s:Label text="Description" width="50%" fontFamily="CalibriCFF" fontSize="14" color="#FFFFFFF" textAlign="left" paddingLeft="6" maxDisplayedLines="1" showTruncationTip="true"/>
		<s:Line height="100%" >
			<s:stroke>
				<s:SolidColorStroke caps="none" color="#4B4B4B" joints="miter" miterLimit="4" weight="1"/>
			</s:stroke>
		</s:Line>
		
		<s:Label text="Order" width="25%" fontFamily="CalibriCFF" fontSize="14" color="#FFFFFFF" textAlign="left" paddingLeft="6" maxDisplayedLines="1" showTruncationTip="true"/>
		<s:Line height="100%" visible="false" includeInLayout="false">
			<s:stroke>
				<s:SolidColorStroke caps="none" color="#4B4B4B" joints="miter" miterLimit="4" weight="1"/>
			</s:stroke>
		</s:Line>	
		
		<s:Label visible="false" includeInLayout="false" text="Action" width="70" fontFamily="CalibriCFF" fontSize="14" color="#FFFFFFF" textAlign="left" paddingLeft="6" maxDisplayedLines="1" showTruncationTip="true"/>			
	</s:SkinnableContainer>
	
	<s:List id="uiprocedureList"
			width="100%"  minHeight="50" allowMultipleSelection="false" 
			borderVisible="false" 
			dataProvider="{model.diagnosisDTOList}"
			verticalScrollPolicy="off" horizontalScrollPolicy="off"
			itemRenderer="com.gazuntite.provider.live.services.billing.superBill.view.itemRenderer.diagnosis.DiagnosisListItemRenderer"
			/>	
</s:Group>