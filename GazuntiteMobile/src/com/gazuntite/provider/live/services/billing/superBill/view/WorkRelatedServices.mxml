							{
								model.TotalCharges -= Number((model.CurrentWRServices[3] as WorkRelatedServiceDTO).Fee);
								model.TotalCharges += Number(id_Type4Fee.text);
								(model.CurrentWRServices[3] as WorkRelatedServiceDTO).Fee = id_Type4Fee.text;
							}
							else if(id_Type4Fee.text == "") 
								id_Type4Fee.text = (Services[3] as WorkRelatedServiceDTO).Fee;
						}
						else
