			public var LastChildTabIndex:int = 0;
			private function SetTabIndexes():void
			{
				var incrementer:int = 0;
				id_Type1.tabIndex = tabIndex + (++incrementer);
				id_Type1Fee.tabIndex = tabIndex + (++incrementer);
				
				id_Type2.tabIndex = tabIndex + (++incrementer);
				id_Type2Fee.tabIndex = tabIndex + (++incrementer);
				
				id_Type3.tabIndex = tabIndex + (++incrementer);
