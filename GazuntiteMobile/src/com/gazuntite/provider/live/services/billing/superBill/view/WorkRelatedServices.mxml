			protected function check_changeHandler(event:Event):void
			{
				var chk:CheckBox = event.currentTarget as CheckBox
				switch (chk.id)
				{
					case "id_Type1":							
						if(chk.selected == true && id_Type1Fee.text != "")
						{
							model.TotalCharges += Number(id_Type1Fee.text);
							id_Type1Fee.setStyle("color","Green");
							id_Type1Fee.setStyle("fontWeight","bold");
							
							(model.CurrentWRServices[0] as WorkRelatedServiceDTO).IsSelected = true;
						}
						else if(chk.selected == false && id_Type1Fee.text != "")
						{
							model.TotalCharges -= Number(id_Type1Fee.text);
							var defaultDTO:WorkRelatedServiceDTO = Services[0] as WorkRelatedServiceDTO;
							id_Type1Fee.text = defaultDTO.Fee;
							id_Type1Fee.setStyle("color","Black");
							id_Type1Fee.setStyle("fontWeight","normal");
							(model.CurrentWRServices[0] as WorkRelatedServiceDTO).Fee = defaultDTO.Fee;
