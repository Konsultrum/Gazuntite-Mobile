			protected function fee_focusOutHandler(event:FocusEvent):void
			{
				var txt:TextInput = event.currentTarget as TextInput
				switch(txt.id)
				{
					case "id_Type1Fee":	
						if(id_Type1.selected )	
						{
							if(id_Type1Fee.text != "" && Number(id_Type1Fee.text) != Number((model.CurrentWRServices[0] as WorkRelatedServiceDTO).Fee))
							{
								model.TotalCharges -= Number((model.CurrentWRServices[0] as WorkRelatedServiceDTO).Fee);
								model.TotalCharges += Number(id_Type1Fee.text);
								(model.CurrentWRServices[0] as WorkRelatedServiceDTO).Fee = id_Type1Fee.text;
							}
							else if(id_Type1Fee.text == "") 
								id_Type1Fee.text = (Services[0] as WorkRelatedServiceDTO).Fee;
						}
						else
							id_Type1Fee.text = (Services[0] as WorkRelatedServiceDTO).Fee;
						
						break;
					case "id_Type2Fee":	
