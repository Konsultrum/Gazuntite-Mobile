			public function initializeData():void
			{
				Services = model.VisitSuperBill.WRSInfo;
				
				if(Services != null && Services.length > 0 )
				{
					model.CurrentWRServices = new ArrayCollection();
					
					for(var i:int = 0; i < Services.length; i++)
					{
						var dto1:WorkRelatedServiceDTO = Services[i] as WorkRelatedServiceDTO;
						var dto1New:WorkRelatedServiceDTO = new WorkRelatedServiceDTO();
						dto1New.Fee = dto1.Fee;
						dto1New.IsSelected = dto1.IsSelected;
						dto1New.WRSTypeId = dto1.WRSTypeId;
						
						model.CurrentWRServices.addItem(dto1New);
					}					
					
					var dto:WorkRelatedServiceDTO = Services[0] as WorkRelatedServiceDTO;
					
					id_Type1.selected = dto.IsSelected as Boolean ;
					id_lblType1.text = dto.ServiceDescription;
					id_lblType1.toolTip = dto.ServiceDescription;
					id_Type1Fee.text = dto.Fee;
					if(id_Type1.selected == true)
					{
						model.TotalCharges += Number(id_Type1Fee.text);
						id_Type1Fee.setStyle("color","Green");
						id_Type1Fee.setStyle("fontWeight","bold");
					}
					
					dto = Services[1] as WorkRelatedServiceDTO;
					
					id_Type2.selected = dto.IsSelected as Boolean ;
					id_lblType2.text = dto.ServiceDescription;
					id_lblType2.toolTip = dto.ServiceDescription;
					id_Type2Fee.text = dto.Fee;
					if(id_Type2.selected == true)
					{
						model.TotalCharges += Number(id_Type2Fee.text);
						id_Type2Fee.setStyle("color","Green");
						id_Type2Fee.setStyle("fontWeight","bold");
					}					
					
					dto = Services[2] as WorkRelatedServiceDTO;
					
					id_Type3.selected = dto.IsSelected as Boolean ;
					id_lblType3.text = dto.ServiceDescription;
					id_lblType3.toolTip = dto.ServiceDescription;
					id_Type3Fee.text = dto.Fee;
					if(id_Type3.selected == true)
					{
						model.TotalCharges += Number(id_Type3Fee.text);
						id_Type3Fee.setStyle("color","Green");
						id_Type3Fee.setStyle("fontWeight","bold");
					}
					
					dto = Services[3] as WorkRelatedServiceDTO;
					
					id_Type4.selected = dto.IsSelected as Boolean ;
					id_lblType4.text = dto.ServiceDescription;
					id_lblType4.toolTip = dto.ServiceDescription;
					id_Type4Fee.text = dto.Fee;
					if(id_Type4.selected == true)
					{
						model.TotalCharges += Number(id_Type4Fee.text);
						id_Type4Fee.setStyle("color","Green");
						id_Type4Fee.setStyle("fontWeight","bold");
					}
					
					dto = Services[4] as WorkRelatedServiceDTO;
					
					id_Type5.selected = dto.IsSelected as Boolean ;
					id_lblType5.text = dto.ServiceDescription;
					id_lblType5.toolTip = dto.ServiceDescription;
					id_Type5Fee.text = dto.Fee;
					if(id_Type5.selected == true)
					{
						model.TotalCharges += Number(id_Type5Fee.text);
						id_Type5Fee.setStyle("color","Green");
						id_Type5Fee.setStyle("fontWeight","bold");
					}
					
					dto = Services[5] as WorkRelatedServiceDTO;
					
