				id_Type4.tabIndex = tabIndex + (++incrementer);
				id_Type4Fee.tabIndex = tabIndex + (++incrementer);
				
				id_Type5.tabIndex = tabIndex + (++incrementer);
				id_Type5Fee.tabIndex = tabIndex + (++incrementer);
				
				id_Type6.tabIndex = tabIndex + (++incrementer);
				id_Type6Fee.tabIndex = tabIndex + (++incrementer);			
				
				LastChildTabIndex = ++incrementer;
			}	
			protected function CC(event:FlexEvent):void
