<?xml version="1.0" encoding="utf-8"?>
<components:PopupGroup xmlns:fx="http://ns.adobe.com/mxml/2009" 
					   xmlns:s="library://ns.adobe.com/flex/spark" 
					   xmlns:mx="library://ns.adobe.com/flex/mx" 
					   xmlns:extended="com.adobe.gazuntite.view.controls.extended.*" 
					   xmlns:components="com.gazuntite.controls.extended.components.*" 
					   creationComplete="popupgroup1_creationCompleteHandler(event)" >
	
	<fx:Metadata>
		[Event(name="MedicineSelected", type="com.gazuntite.provider.eprescription.services.patient.view.events.MedicineSelectedEvent")]  
	</fx:Metadata>
	
	<fx:Script>
		<![CDATA[
			import com.gazuntite.provider.eprescription.services.patient.model.EPrescriptionModelLocator;
			import com.gazuntite.provider.eprescription.services.patient.view.events.MedicineSelectedEvent;
			
			import mx.core.FlexGlobals;
			import mx.events.CloseEvent;
			import mx.events.FlexEvent;
			
			[Bindable]
			private var model:EPrescriptionModelLocator = EPrescriptionModelLocator.getInstance();
			
			public function closeHandler( event:MouseEvent = null ):void
			{
				id_outValue.text = '';
				//this.removePopup();
				var e:CloseEvent = new CloseEvent( "closeSearchBox", true );
				dispatchEvent( e );
			}
			
			protected function popupgroup1_creationCompleteHandler(event:FlexEvent):void
			{
				FlexGlobals.topLevelApplication.addEventListener(MouseEvent.MOUSE_DOWN, function(event:MouseEvent):void
				{
					//closeHandler()
				});
			}
			protected function id_SearchList_clickHandler(event:MouseEvent):void
			{
				var evt:MedicineSelectedEvent = new MedicineSelectedEvent( MedicineSelectedEvent.MED_SELECTED); 
				this.dispatchEvent( evt );
				closeHandler();
				
				event.stopImmediatePropagation();
				event.preventDefault();
				
				
			}
			
			protected function id_SearchList_valueCommitHandler(event:FlexEvent):void
			{
				if( null != id_SearchList.selectedItem )
				{
					id_outValue.text = id_SearchList.selectedItem.Product.GenericName; 
					id_outValue.text += ", "+ id_SearchList.selectedItem.STRENGTH_DESCRIPTION; 
					id_outValue.text += ", "+ id_SearchList.selectedItem.NDC.NDC;
					
				}
			}
			
			protected function id_OK_clickHandler(event:MouseEvent):void
			{
				/* var evt:MedicineSelectedEvent = new MedicineSelectedEvent( MedicineSelectedEvent.MED_SELECTED); 
				this.dispatchEvent( evt );
				closeHandler(); */
			}
			
		]]>
	</fx:Script>
	
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	
	<s:SkinnableContainer width="100%" skinClass="com.gazuntite.skins.controls.container.ePrescription.EprescriptionSpinnerBG">
		<s:layout>
			<s:VerticalLayout gap="3" paddingBottom="3" paddingLeft="5" paddingTop="3" paddingRight="5" />
		</s:layout>
		
		<!--<s:BorderContainer width="100%" height="70" cornerRadius="4" >-->
			<s:List id="id_SearchList" 
					width="100%" height="70" 
					horizontalScrollPolicy="off"
					dataProvider="{model.medicineResults}"
					click="id_SearchList_clickHandler(event)"
					 borderVisible="false"
					valueCommit="id_SearchList_valueCommitHandler(event)"
					skinClass="com.gazuntite.skins.controls.list.InvisibleScrollSkin"
					itemRenderer="com.gazuntite.provider.eprescription.services.patient.view.itemRenderers.MedicationSearchIR"
					/>
		<!--</s:BorderContainer>-->
		
		<s:Group width="100%" visible="false" includeInLayout="false">
			<s:Label id="id_outValue"  text="# of Rec(s) : {id_SearchList.dataProvider.length}" color="#FFFFFF" fontFamily="CalibriCFF" fontSize="13"  verticalCenter="0" maxDisplayedLines="1" right="50" left="0" />
			<s:Button id="id_OK" click="id_OK_clickHandler(event)" 
					  useHandCursor="true" buttonMode="true" verticalCenter="0" toolTip="Select Medicine"
					  skinClass="com.gazuntite.skins.controls.button.SpinnerSeletedButton"	right="25"/>
			<s:Button id="id_CloseBtn" 
					  click="closeHandler(event)" 
					  buttonMode="true" useHandCursor="true" verticalCenter="0" toolTip="Close Medicine Search"
					  skinClass="com.gazuntite.skins.controls.button.SpinnerCancelButton"  right="0"/>
		</s:Group>
	</s:SkinnableContainer>
	
</components:PopupGroup>