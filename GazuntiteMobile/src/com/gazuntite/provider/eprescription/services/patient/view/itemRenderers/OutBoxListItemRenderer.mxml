<?xml version="1.0" encoding="utf-8"?>
<s:ItemRenderer xmlns:fx="http://ns.adobe.com/mxml/2009" 
				xmlns:s="library://ns.adobe.com/flex/spark" 
				xmlns:mx="library://ns.adobe.com/flex/mx" 
				autoDrawBackground="true"
				>
	<fx:Script>
		<![CDATA[
			import mx.events.FlexEvent;
			
			[Bindable]
			public var inEditMode:Boolean = false;
			[Bindable]
			public var model:Object;
			
			
			override public function set data(value:Object):void
			{
				super.data = value;
				model = value;
			}
			
			protected function toggleEditView():void
			{
				inEditMode = !inEditMode;
			}
			
			protected function sendBtnClicked(event:MouseEvent):void
			{
				dispatchEvent(new MouseEvent("SendClicked",true,true));
				
			}
			
			protected function removeBtnClicked(event:MouseEvent):void
			{
				dispatchEvent(new MouseEvent("RemoveClicked",true,true));				
			}
			
		]]>
	</fx:Script>
	<s:layout>
		<s:VerticalLayout gap="0"/>
	</s:layout>
	
	<s:SkinnableContainer width="100%" height="35" skinClass="com.gazuntite.skins.controls.list.GeneralListItemSkin" >
		
		<s:HGroup left="0" right="52" top="0" bottom="0" gap="8"
				  horizontalAlign="left"  verticalAlign="middle"
				  paddingLeft="8" paddingRight="8"  buttonMode="true" toolTip="Open/Close Details"
				  click="toggleEditView()"  >
			<s:Label text="{model.Patient}" width="100%" toolTip="{model.AllergyName}" color="#333333" fontFamily="CalibriCFF"
					 fontSize="14"/>
			
			<s:Image  click="removeBtnClicked(event)"   
					  buttonMode="true" useHandCursor="true" toolTip="Remove"
					  source="@Embed('com/gazuntite/provider/eprescription/services/patient/view/assets/images/new.png')"/>
			
			<s:Button  click="sendBtnClicked(event)"
					  buttonMode="true" useHandCursor="true" toolTip="Send"
					  skinClass="com.gazuntite.skins.controls.button.ePrescription.SendBUttonSkin"/>
		</s:HGroup>
	</s:SkinnableContainer>
	
	<s:BorderContainer width="100%" height="50" includeInLayout="{inEditMode}" visible="{inEditMode}" borderColor="#CECAB3" backgroundColor="#DBD9C3" borderWeight="1">
		<s:layout>
			<s:HorizontalLayout paddingBottom="3" paddingLeft="5" paddingRight="5" paddingTop="4"/>
		</s:layout>
		
		<s:VGroup width="100%" height="100%">
			<s:Label text="{data.Drug}" fontFamily="CalibriCFF" />
			<s:Label text="{data.Dose}" fontFamily="CalibriCFF" />
		</s:VGroup>
		<s:VGroup width="100%" height="100%">
			<s:Label text="{data.Sig}" fontFamily="CalibriCFF" />
			<s:Label text="{data.Quantity}" fontFamily="CalibriCFF" />
		</s:VGroup>
	</s:BorderContainer>
	
</s:ItemRenderer>
