<?xml version="1.0" encoding="utf-8"?>
<s:Group xmlns:fx="http://ns.adobe.com/mxml/2009" 
		 xmlns:s="library://ns.adobe.com/flex/spark" 
		 xmlns:mx="library://ns.adobe.com/flex/mx"
		 xmlns:components="com.gazuntite.controls.extended.components.*" 
		 xmlns:view="com.gazuntite.provider.search.services.patient.view.*" 
		 creationComplete="cc(event)"
		
		 >
	<fx:Script>
		<![CDATA[
			import com.gazuntite.common.dto.PatientDTO;
			import com.gazuntite.provider.eprescription.services.patient.model.EPrescriptionModelLocator;
			import com.gazuntite.provider.search.services.patient.view.events.PatientSelectedEvent;
			
			import mx.core.FlexGlobals;
			import mx.events.FlexEvent;
			
			import spark.skins.spark.ImageSkin;
			
			private var _selectedIndex:int;
			public var AllowSearch:Boolean = true;
			[Bindable] private var model : EPrescriptionModelLocator = EPrescriptionModelLocator.getInstance();
			
			[Bindable]
			public function get selectedIndex():int
			{
				return _selectedIndex;
			}
			
			public function set selectedIndex(value:int):void
			{
				_selectedIndex = value;
			}
			
			private var _selectedPatient:PatientDTO;
			
			[Bindable]
			public function get selectedPatient():PatientDTO
			{
				return _selectedPatient;
			}
			
			public function set selectedPatient(value:PatientDTO):void
			{
				_selectedPatient = value;
				togglePatientSearchView();
			}
			
			protected function whenPatientSelected(event:PatientSelectedEvent):void 
			{
				selectedPatient = event.selection as PatientDTO;
				model.PatientID = selectedPatient.ID;
				togglePatientSearchView();
				
			}
			
			private function togglePatientSearchView():void
			{
				var toggleView:Boolean = id_selectPatientVS.selectedIndex == 0 || AllowSearch == false;
				
				if( null != selectedPatient && toggleView)
				{
					id_selectPatientVS.selectedIndex = 1;
				}
				else
				{
					id_selectPatientVS.selectedIndex = 0;
				}
			}
			
			protected function selectionView_clickHandler(event:MouseEvent):void
			{
				if( event.target is ImageSkin ) return;
				togglePatientSearchView();
			}
			
			
			protected function cc(event:FlexEvent):void
			{
				FlexGlobals.topLevelApplication.addEventListener(MouseEvent.CLICK, function(event:Event):void
				{
					if(null != selectedPatient)
					{
						id_patientSelectionView.clearSearchResults();
						id_selectPatientVS.selectedIndex = 1;
					}
						//togglePatientSearchView();
				});
			}
			
		]]>
	</fx:Script>
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	
	
	<components:LabelViewStack id="id_selectPatientVS" width="100%" height="100%" selectedIndex="{selectedIndex}" borderVisible="false" backgroundAlpha="0">
		
		<s:ArrayList>
			<view:SearchPatientView id="id_patientSelectionView" width="100%"  click="selectionView_clickHandler(event)" PatientSelected="whenPatientSelected(event)" />
			
			<s:Group width="100%">
				
				<s:SkinnableContainer click="selectionView_clickHandler(event)" width="100%" height="24" left="5" skinClass="com.gazuntite.skins.controls.container.ePrescription.SerachPatientSkeltonBG" top="3">
					<s:HGroup left="39" right="2" horizontalAlign="center" verticalAlign="middle" height="100%">
						<s:Label text="Rx for " fontFamily="CalibriCFF" fontSize="15" color="#666666" maxDisplayedLines="1"/>
						<s:Label text="{selectedPatient.FullName}" toolTip="{selectedPatient.FullName}" fontWeight="bold" fontFamily="CalibriCFFBold" fontSize="15" width="100%" maxDisplayedLines="1"/>
						<!--<s:Label text="{UtilityFunctions.CalculateAge( selectedPatient.DOB )}," fontFamily="Calibri" fontSize="11"/>
						<s:Label text="{selectedPatient.Gender}," fontFamily="Calibri" fontSize="11"/>
						<s:Label text="{selectedPatient.SSN}" fontFamily="Calibri" fontSize="11"/>-->
					</s:HGroup>
				</s:SkinnableContainer>
				
				<s:Group width="29" height="29">
					<s:Ellipse x="0" y="0" width="100%" height="100%">
						<s:stroke>
							<s:SolidColorStroke caps="none" color="#FFFFFF" joints="miter" miterLimit="4" weight="1"/>
						</s:stroke>
						<s:fill>
							<s:LinearGradient rotation="90">
								<s:GradientEntry alpha="1.0" color="#689BE4" ratio="0"/>
								<s:GradientEntry alpha="1.0" color="#2F76DA" ratio="1"/>
							</s:LinearGradient>
						</s:fill>
						<s:filters>
							<s:DropShadowFilter alpha="0.5" angle="90" blurX="3" blurY="3" color="0x000000" distance="1" hideObject="false" inner="false" knockout="false" quality="2" strength="1"/>
						</s:filters>
					</s:Ellipse>
					
					<s:Label text="1" color="#FFFFFF" fontFamily="CalibriCFF" fontSize="15" horizontalCenter="0" verticalCenter="0"/>
				</s:Group>
			</s:Group>
			
		</s:ArrayList>
		
	</components:LabelViewStack>
	
</s:Group>
