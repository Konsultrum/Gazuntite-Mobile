				}
				popup.ShowPopup( this );
				
				if(isDefaultDisplay)
				{
					var pt:Point = event.currentTarget.parent.localToGlobal(new Point(event.currentTarget.x, event.currentTarget.y));
					popup.move( pt.x  , pt.y + event.currentTarget.height  - 4); 
				}else
				{
					var pt2:Point = event.currentTarget.parent.localToGlobal(new Point(event.currentTarget.x, event.currentTarget.y));
					popup.move( (pt2.x + event.currentTarget.width)  - popup.width - 5 , pt2.y + event.currentTarget.height  - 4); 
				}
			}
			
			private function IsCompletlyFilled():void
			{
				if (null  != selectedDose && null  != selectedQuantity && null  != selectedFrequency && null  != selectedRoute && null  != selectedRefill && null  != selectedSubstitution)
				{
					isComplete =  true;
					calculateDuration();
					GenerateSIG();
				}
				else
					isComplete = false;
			}
			
			protected function GenerateSIG():void
			{				
				if(selectedDose.value.length != 0 && selectedDose.item && selectedFrequency.item != 0 && selectedFrequency.item)
				{
					var SIG:String = "";
					SIG += "Take ";
					SIG += selectedDose.value + " " + selectedDose.item.Term;
					SIG += " for "+ duration + " days, " + selectedFrequency.item.Description;
				}
				
				if(selectedRoute.value)
				{
					SIG += " via "+selectedRoute.value + " ";
				}
				GeneratedSig = SIG;
			}
			
			
			public function calculateDuration():void
			{
				/* if(selec.text.length != 0 && id_quantity.text.length != 0)
				{ */
					var dose:int 		= parseInt(selectedDose.value);
					var quantity:int 	= parseInt(selectedQuantity.value);
					
					var eachday:Number;
					var freq:Number;
					
					if(selectedFrequency.item.Abbreviation == "TID")
					{
						freq = 3;
					}
					else if(selectedFrequency.item.Abbreviation == "3X/W")
					{
						freq = 3/7;
					}
					else if(selectedFrequency.item.Abbreviation == "QID")
					{
						freq = 4;
					}
					else if(selectedFrequency.item.Abbreviation == "5X/D")
					{
						freq = 5;
					}
					else if(selectedFrequency.item.Abbreviation == "Q18H")
					{
						freq = 24/18;
					}
					else if(selectedFrequency.item.Abbreviation == "Q36H")
					{
						freq = 24/36;
					}
					else if(selectedFrequency.item.Abbreviation == "Q48H")
					{
						freq = 24/48;
					}
					else if(selectedFrequency.item.Abbreviation == "Q72H")
					{
						freq = 24/72;
					}
					else if(selectedFrequency.item.Abbreviation == "Q7D")
					{
						freq = 1/7;
					}
					else if(selectedFrequency.item.Abbreviation == "every other day")
					{
						freq = 0.5;
					}
					else if(selectedFrequency.item.Abbreviation == "once a day")
					{
						freq = 1;
					}
					else if(selectedFrequency.item.Abbreviation == "Q1MO")
					{
						freq = 1/30;
					}
					else if(selectedFrequency.item.Abbreviation == "1X/W")
					{
						freq = 1/7;
					}
					else if(selectedFrequency.item.Abbreviation == "BID")
					{
						freq = 2;
					}
					else if(selectedFrequency.item.Abbreviation == "2X/W")
					{
						freq = 2/7;
					}
					else if(selectedFrequency.item.Abbreviation == "Q15MIN")
					{
						freq = 60*24 / 15;
					}
					else if(selectedFrequency.item.Abbreviation == "Q1H")
					{
						freq = 24;
					}
					else if(selectedFrequency.item.Abbreviation == "10X/D") //10 times a day
					{
						freq = 10;
					}
					else if(selectedFrequency.item.Abbreviation == "12X/D")
					{
						freq = 12;
					}
					else if(selectedFrequency.item.Abbreviation == "16X/D")
					{
						freq = 16;
					}
					else if(selectedFrequency.item.Abbreviation == "6X/D")
					{
						freq = 6;
					}
					else if(selectedFrequency.item.Abbreviation == "7X/D")
					{
						freq = 7;
					}
					else if(selectedFrequency.item.Abbreviation == "8X/D")
					{
						freq = 8;
					}
					else if(selectedFrequency.item.Abbreviation == "Q16H") //every 16 hours
					{
						freq = 24/16;
					}
					else if(selectedFrequency.item.Abbreviation == "Q2W") //every 2 weeks
					{
						freq = 1/14;
					}
					else if(selectedFrequency.item.Abbreviation == "Q30MIN") //every 30 minutes
					{
						freq = 60*24 / 30;
					}
					else if(selectedFrequency.item.Abbreviation == "Q40H") //every 40 hours
					{
						freq = 24 / 40;
					}
					else if(selectedFrequency.item.Abbreviation == "QY") //yearly
					{
						freq = 1/365;
					}
					else if(selectedFrequency.item.Abbreviation == "9X/D")
					{
						freq = 9;
					}
					else if(selectedFrequency.item.Abbreviation == "9X/D")
					{
						freq = 9;
					}
					else if(selectedFrequency.item.Abbreviation == "Q3W")
					{
						freq = 1/21;
					}
					else if(selectedFrequency.item.Abbreviation == "Q5D")
					{
						freq = 1/5;
					}
					else if(selectedFrequency.item.Abbreviation == "Q60H")
					{
						freq = 24 / 60;
					}
					else
					{
						freq = 1;
					}
					
					eachday = dose * freq;
					duration = quantity/eachday;
					duration = Math.round(duration);
					//id_duration.text = duration.toString();
				/* } */
			}
			
			protected function cc(event:FlexEvent):void
			{
				refillDP = new ArrayCollection();
				var i:int;
				for(i = 0; i < 100; i++ )
				{
					refillDP.addItem({Refill:i});
				}
			}
			
			public function loadStaticData():void
			{
				if( isStaticDataLoaded ) return; //static data is already loaded
				
				var eusername:String  	= model.SearchProviderDetailsResults.EUserName;
				var epassword:String  	= model.SearchProviderDetailsResults.EPassword;
				var gaxenUserId:String 	= model.SearchProviderDetailsResults.GAXENID;
				
				
				var securityHeaderXML:XML	 			= <Header />;					
				securityHeaderXML.@EUserName	= eusername;
				securityHeaderXML.@EPassword	= epassword;
				securityHeaderXML.@ClinicID		= "sad";
				
				var getRXStaticDataEvent: LoadStaticDataEvent = new LoadStaticDataEvent(StaticListsLoaded);				
				getRXStaticDataEvent.data = securityHeaderXML; 				
				CairngormEventDispatcher.getInstance().dispatchEvent(getRXStaticDataEvent);
			}
			
			// -- Static data load ------------
			public function StaticListsLoaded(staticList:XML):void
			{
				//DOSAGE FORMS
				var dosageFormsArrayCol:ArrayCollection = new ArrayCollection();
				for(var i:uint = 0; i < staticList.DosageForms.Form.length(); i++)
				{
					var s_code:String = staticList.DosageForms.Form[i].@Code.toString();
					var s_term:String = staticList.DosageForms.Form[i].@Term.toString();					
					dosageFormsArrayCol.addItem({ Code:s_code, Term:s_term});
				}
				dosageFormDP = dosageFormsArrayCol;
				dosageFormLabelField = "Term";
				
				//QUANTITY FORMS
				var quantityFormsArrayCol:ArrayCollection = new ArrayCollection();
				for(var i:uint = 0; i < staticList.QuantityForms.Form.length(); i++)
				{
					var s_code:String = staticList.QuantityForms.Form[i].@Code.toString();
					var s_term:String = staticList.QuantityForms.Form[i].@Term.toString();					
					quantityFormsArrayCol.addItem({ Code:s_code, Term:s_term});
				}
				quantityFormDP = quantityFormsArrayCol;
				quantityFormLabelField = "Term";
				
				//substitution FORMS
				var substitutionFormsArrayCol:ArrayCollection = new ArrayCollection();
				for(var i:uint = 0; i < staticList.Substitutions.Substitution.length(); i++)
				{
					var s_code:String = staticList.Substitutions.Substitution[i].@SubstitutionCode.toString();
					var s_term:String = staticList.Substitutions.Substitution[i].@SubstitutionText.toString();					
					substitutionFormsArrayCol.addItem({ SubstitutionCode:s_code, SubstitutionText:s_term});
				}
				
				substitutionDP = substitutionFormsArrayCol;
				substitutionLabelField = "SubstitutionText";
				
				//ROUTE FORMS
				var routeArrayCol:ArrayCollection = new ArrayCollection();
				for(var i:uint = 0; i < staticList.Routes.Route.length(); i++)
				{
					var s_code:String = staticList.Routes.Route[i].@DOSE_ROUTE_ID.toString();
					var s_term:String = staticList.Routes.Route[i].@DOSE_ROUTE_DESCRIPTION.toString();					
					routeArrayCol.addItem({ DOSE_ROUTE_ID:s_code, DOSE_ROUTE_DESCRIPTION:s_term});
				}
				routeDP = routeArrayCol;
				routeLabelField = "DOSE_ROUTE_DESCRIPTION";
				
				//FREQUENCY FORMS
				var freqArrayCol:ArrayCollection = new ArrayCollection();
				for(var i:uint = 0; i < staticList.Frequencies.Frequency.length(); i++)
				{
					var s_code:String = staticList.Frequencies.Frequency[i].@Description.toString();
					var s_term:String = staticList.Frequencies.Frequency[i].@Abbreviation.toString();					
					freqArrayCol.addItem({ Description:s_code, Abbreviation:s_term});
				}
				frequencyDP = freqArrayCol;
				frequencyLabelField = "Description";
				
				isStaticDataLoaded = true;
			}
			
			public function ViewIsDirty():Boolean
			{
				if(selectedDose	!= null ||
					selectedQuantity != null ||
					selectedFrequency != null ||
					selectedRoute != null ||	
					selectedRefill != null ||	
					selectedSubstitution != null ||
					selectedType != null)
					return true
				else
					return false
			}
			
			public function ResetFields():void
			{
				selectedDose				= null;
				selectedQuantity			= null;
				selectedFrequency			= null;	
				selectedRoute				= null;		
				selectedRefill				= null;		
				selectedSubstitution		= null;
				selectedType				= null;
				
				id_Dose.text				= '';
				id_Quantity.text			= '';
				id_Frequency.text			= '';
				id_Route.text				= '';
				id_Refill.text				= '';
				id_Substitution.text		= '';
				id_type.text				= '';
				
				isComplete = false;
			}
			
		]]>
	</fx:Script>
	
