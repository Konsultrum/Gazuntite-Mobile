			protected function InputButton_clickHandler(event:MouseEvent):void
			{
				var id:String = event.currentTarget.id;
				var isDefaultDisplay:Boolean = true;
				
				if(popup.isPopUp) // already a pop is openned. close that popuop to open the next one.
				{
					if(event.currentTarget.id != selectedBtn)
						event.currentTarget.selected = false;
					else
						event.currentTarget.selected = true;
					
					event.stopImmediatePropagation();
					event.preventDefault();
					return;
				}
				
				popup = new MedicineInputPopup();
				
				switch(id)
				{
					case "id_DoseBtn":
					{
						popup.DataProvider = dosageFormDP;
						popup.labelFeild   = dosageFormLabelField;
						selectedBtn = 'id_DoseBtn';
						if(null != selectedDose)
						{
							popup.selectedItem = selectedDose.item;
							popup.inputValue =  selectedDose.value;
						}
						popup.addEventListener("OkClick", function(event:Event):void
						{
							id_Dose.text = popup.id_outValue.text;
							id_Dose.toolTip = popup.id_outValue.text;
							id_DoseBtn.selected = false ;
							selectedBtn = '';
							
							selectedDose = {value:popup.inputValue, item:popup.selectedItem};
							IsCompletlyFilled();		 // check if all fields are completly filled.		
						});
						popup.addEventListener("CancelClick", function(event:Event):void
						{
							id_DoseBtn.selected = false ;
							selectedBtn = '';
						});
						
						break;
					}
						
					case "id_QulityBtn":
					{
						popup.DataProvider = quantityFormDP;
						popup.labelFeild   = quantityFormLabelField;
						selectedBtn = 'id_QulityBtn';
						if(null != selectedQuantity)
						{
							popup.selectedItem = selectedQuantity.item;
							popup.inputValue =  selectedQuantity.value;
						}
						popup.addEventListener("OkClick", function(event:Event):void
						{
							id_Quantity.text = popup.id_outValue.text;
							id_Quantity.toolTip = popup.id_outValue.text;
							selectedBtn = '';
							
							id_QulityBtn.selected = false ;
							selectedQuantity = {value:popup.inputValue, item:popup.selectedItem};
							IsCompletlyFilled(); // check if all fields are completly filled.
						});
						popup.addEventListener("CancelClick", function(event:Event):void
						{
							selectedBtn = '';
							id_QulityBtn.selected = false ;
						});
						
						break;
					}
						
					case "id_FrequencyBtn":
					{
						popup.DataProvider = frequencyDP;
						popup.labelFeild   = frequencyLabelField;
						popup.ShowInput    = false;
						selectedBtn = 'id_FrequencyBtn';
						if(null != selectedFrequency)
						{
							popup.selectedItem = selectedFrequency.item;
							popup.inputValue =  selectedFrequency.value;
						}
						
						popup.addEventListener("OkClick", function(event:Event):void
						{
							id_Frequency.text = popup.id_outValue.text;
							id_Frequency.toolTip = popup.id_outValue.text;
							id_FrequencyBtn.selected = false ;
							selectedBtn = '';
							
							selectedFrequency = {value:popup.inputValue, item:popup.selectedItem};
							IsCompletlyFilled(); // check if all fields are completly filled.
							
						});
						popup.addEventListener("CancelClick", function(event:Event):void
						{
							selectedBtn = '';
							id_FrequencyBtn.selected = false ;
						});
						
						break;
					}
						
					case "id_RouteBtn":
					{
						popup.DataProvider = routeDP;
						popup.labelFeild   = routeLabelField;
						popup.ShowInput    = false;
						selectedBtn = 'id_RouteBtn';
						
						if(null != selectedRoute)
						{
							popup.selectedItem = selectedRoute.item;
							popup.inputValue =  selectedRoute.value;
						}
						
						popup.addEventListener("OkClick", function(event:Event):void
						{
							id_Route.text = popup.id_outValue.text;
							id_Route.toolTip = popup.id_outValue.text;
							id_RouteBtn.selected = false ;
							selectedBtn = '';
							
							selectedRoute = {value:popup.inputValue, item:popup.selectedItem};
							IsCompletlyFilled(); // check if all fields are completly filled.
							
						});
						popup.addEventListener("CancelClick", function(event:Event):void
						{
							selectedBtn = '';
							id_RouteBtn.selected = false ;
						});
						
						break;
					}
						
					case "id_RefillBtn":
					{
						popup.DataProvider = refillDP;
						popup.labelFeild   = refillLabelField;
						popup.ShowInput = false;
						popup.ShowPRN = true;
						selectedBtn = 'id_RefillBtn';
						if(null != selectedRefill)
						{
							//popup.selectedItem = selectedRefill.item;
							popup.inputValue =  selectedRefill.value;
						}
						
						popup.addEventListener("OkClick", function(event:Event):void
						{
							id_Refill.text = popup.id_outValue.text;
							id_Refill.toolTip = popup.id_outValue.text;
							id_RefillBtn.selected = false ;
							selectedBtn = '';
							
							selectedRefill = {value:popup.inputValue, item:popup.selectedItem};
							IsCompletlyFilled(); // check if all fields are completly filled.
							
						});
						
						popup.addEventListener("CancelClick", function(event:Event):void
						{
							selectedBtn = '';
							id_RefillBtn.selected = false ;
						});
						
						isDefaultDisplay = false;
						break;
					}
						
					case "id_SubstitutionBtn":
					{
						popup.DataProvider = substitutionDP;
						popup.labelFeild   = substitutionLabelField;
						popup.ShowInput    = false;
						selectedBtn = 'id_SubstitutionBtn';
						if(null != selectedSubstitution)
						{
							popup.selectedItem = selectedSubstitution.item;
							popup.inputValue =  selectedSubstitution.value;
						}
						
						popup.addEventListener("OkClick", function(event:Event):void
						{
							id_Substitution.text = popup.id_outValue.text;
							id_Substitution.toolTip = popup.id_outValue.text;
							id_SubstitutionBtn.selected = false ;
							selectedBtn = '';
							
							selectedSubstitution = {value:popup.inputValue, item:popup.selectedItem};
							IsCompletlyFilled(); // check if all fields are completly filled.
							
						});
						
						popup.addEventListener("CancelClick", function(event:Event):void
						{
							selectedBtn = '';
							id_SubstitutionBtn.selected = false ;
						});
						
						isDefaultDisplay = false;
						break;
					}
						
					case "id_TypeBtn":
					{
						popup.DataProvider = TypeDP;
						popup.labelFeild   = TypeLabelField;
						popup.ShowInput    = false;
						selectedBtn = 'id_TypeBtn';
						if(null != selectedType)
						{
							popup.selectedItem = selectedType.item;
							popup.inputValue =  selectedType.value;
						}
						
						popup.addEventListener("OkClick", function(event:Event):void
						{
							id_type.text = popup.id_outValue.text;
							id_type.toolTip = popup.id_outValue.text;
							id_TypeBtn.selected = false ;
							selectedBtn = '';
							
							selectedType = {value:popup.inputValue, item:popup.selectedItem};
							IsCompletlyFilled(); // check if all fields are completly filled.
							
						});
						
						popup.addEventListener("CancelClick", function(event:Event):void
						{
							selectedBtn = '';
							id_TypeBtn.selected = false ;
						});
						
						isDefaultDisplay = false;
						break;
