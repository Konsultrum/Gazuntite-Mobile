<?xml version="1.0" encoding="utf-8"?>
<s:SkinnableContainer xmlns:fx="http://ns.adobe.com/mxml/2009" 
					  xmlns:s="library://ns.adobe.com/flex/spark" 
					  xmlns:mx="library://ns.adobe.com/flex/mx" 
					  xmlns:components="com.gazuntite.controls.extended.components.*" 
					  xmlns:pharmacySearch="com.gazuntite.provider.eprescription.services.patient.view.pharmacySearch.*"
					  skinClass="com.gazuntite.skins.controls.container.ePrescription.PatientSearchListSpinnerBG"
					  creationComplete="skinnablecontainer1_creationCompleteHandler(event)">
	<fx:Metadata>
		[Event(name="PharmacySelected", type="com.gazuntite.provider.eprescription.services.patient.view.events.PharmacySelectedEvent")]
	</fx:Metadata>
	<fx:Script>
		<![CDATA[
			import com.adobe.cairngorm.control.CairngormEventDispatcher;
			import com.gazuntite.provider.eprescription.services.patient.event.SearchPharmaciesEvent;
			import com.gazuntite.provider.eprescription.services.patient.view.events.PharmacySelectedEvent;
			
			import mx.events.FlexEvent;
			
			import spark.events.IndexChangeEvent;
			import spark.events.TextOperationEvent;
			
			private var searchTypeCase:int 		= 1;
			[Bindable]
			private var isSearchListShow:Boolean = false;
			public var pageNo : int = 0;
			[Bindable]
			public var npcid:String ="0";
			private var _pharmacyname:String ="0";
			public var address:String ="0";
			public var zipcode:String ="0";
			public var state:String ="0";
			public var city:String ="0";
			public var phone:String ="0";
			public var fax:String ="0";
			public var serviceLevel:int = -1;
			public var changelevel:String = "0";
			public var isActivated:Boolean = true;
			
			public function get pharmacyname():String
			{
				return _pharmacyname;
			}
			
			public function set pharmacyname(value:String):void
			{
				_pharmacyname = value;
			}
			
			protected function searchType_changeHandler(event:IndexChangeEvent):void
			{

				id_SearchListView.visible = false;
				id_pharmacy.text = '';

				switch(id_searchType.selectedIndex)
				{
					case 0:
						id_pharmacy.prompt = 'Name';
						id_image.source = selected_name;
						break;
					case  1:
						id_pharmacy.prompt = 'NCPDPID';
						id_image.source = selected_NCPDPID;
						break;
					case 2:
						 //serviceLevel = pharmacy;
						id_pharmacy.prompt = 'Service Level';
						id_image.source = selected_serviceLvl; 
						break;
					case 3:
						id_pharmacy.prompt = 'Change Level';
						id_image.source = selected_changeLvl;
						break;
					case 4:
						id_pharmacy.prompt = 'State';
						id_image.source = selected_State;
						break;
					case 5:
						id_pharmacy.prompt = 'Phone';
						id_image.source = selected_Phone;
						break;
					case 6:
						id_pharmacy.prompt = 'Fax';
						id_image.source = selected_Fax;
						break;
					case 7:
						id_pharmacy.prompt = 'Zip';
						id_image.source = selected_Zip;
						break;
					case 8:
						id_pharmacy.prompt = 'City';
						id_image.source = selected_City;
						break;
					case 9:
						id_pharmacy.prompt = 'Address';
						id_image.source = selected_Address;
						break;
					
					default:
					{
						id_pharmacy.prompt = 'Name';
						id_image.source = selected_name;
						break;
					}
				}
				
			}	
			
			protected function pharmacy_clickHandler(event:MouseEvent):void
			{
				/* var pharmacyname:String = id_pharmacy.text;
				
				if(pharmacyname == "")
				{
				pharmacyname = "0";
				}
				
				if(!pharmacySearch)
				{
				pharmacySearch = new pharmacySearchPopup();
				}
				
				pharmacySearch.addEventListener("SelectButtonClicked", selectPharmacy);
				
				var pLoc:Point = new Point( this.x , this.y );
				var loc:Point = this.localToGlobal( pLoc );
				pharmacySearch.x = loc.x ; 
				pharmacySearch.y = loc.y ;			
				
				pharmacySearch.ncpdid 	= pharmacyname;
				pharmacySearch.inSearchPopup 	= true;
				
				pharmacySearch.ShowPopup(this);
				pharmacySearch.id_pharmacySearch.ti_npcid.text = pharmacyname;
				pharmacySearch.id_pharmacySearch.searchPharmacy();
				//reset pharmacy search field
				id_pharmacy.text = ""; */
			}
			
			
			private function OnItemClick(event:Event):void
			{
				try
				{
					var ps:PharmacySelectedEvent = new PharmacySelectedEvent(PharmacySelectedEvent.PHARMACY_SELECTED);;
					ps.selection = id_SearchListView.id_SearchList.selectedItem;
					dispatchEvent( ps );
					
					clearSearchResults();
				}
				catch(e:Error)
				{
					trace("ERROR --> PatientSelectedEvent :: OnItemClick", e );
				}
			}
			
			public function clearSearchResults(event:Event = null):void
			{
				if( id_SearchListView && id_SearchListView.visible )
				{
					id_pharmacy.text		= '';
					id_SearchListView.visible 	= false;
					isSearchListShow = false;
					return
				}
			}
			
			protected function btnSearch_ClickHandler(event:MouseEvent):void
			{
				Search();
				event.stopImmediatePropagation();	
			}
			
			
			private function resetFields():void
			{
				npcid ="0";
				pharmacyname ="0";
				address ="0";
				zipcode ="0";
				state ="0";
				city ="0";
				phone ="0";
				fax ="0";
				changelevel = "0";
				
			}
			private function Search():void
			{
				var pharmacy:String = id_pharmacy.text;
				
				resetFields();
				
				switch(id_searchType.selectedIndex)
				{
					
					case 0:
						pharmacyname = pharmacy;
						id_image.source = selected_name;
						break;
					case  1:
						npcid = pharmacy;
						id_image.source = selected_NCPDPID;
						break;
					case 2:
						serviceLevel = int( pharmacy);
						id_image.source = selected_serviceLvl; 
						break;
					case 3:
						changelevel = pharmacy;
						id_image.source = selected_changeLvl;
						break;
					case 4:
						state = pharmacy;
						id_image.source = selected_State;
						break;
					case 5:
						phone = pharmacy;
						id_image.source = selected_Phone;
						break;
					case 6:
						fax = pharmacy;
						id_image.source = selected_Fax;
						break;
					case 7:
						zipcode = pharmacy;
						id_image.source = selected_Zip;
						break;
					case 8:
						city = pharmacy;
						id_image.source = selected_City;
						break;
					case 9:
						address = pharmacy;
						id_image.source = selected_Address;
						break;
						
					default:
					{
						pharmacyname = pharmacy;
						id_image.source = selected_name;
						break;
					}
						
				}
				
				sendToServer(pageNo);
				
			} 
			// ----------------- Send to Server for Result---------------------------------------------------
			private function sendToServer(pageNo:int ):void
			{
				trace('SendToServer ---------------- ', 'SearchPatientbyClinicIdEvent');
				var pharmacyEvent: SearchPharmaciesEvent = new SearchPharmaciesEvent(pageNo, npcid, pharmacyname, address, zipcode, state, city, phone, fax, serviceLevel, changelevel, isActivated, getPharmacies);
				CairngormEventDispatcher.getInstance().dispatchEvent(pharmacyEvent);
			}
			
			private function getPharmacies():void
			{
				id_SearchListView.visible = true;
				isSearchListShow = true;
				resetFields();
				return;	
			}
			
			protected function textInput_keyUpHandler(event:KeyboardEvent):void
			{
				if(event.keyCode == Keyboard.ENTER)
				{
					Search();
				}
			}
			
			protected function textInput_clickHandler(event:MouseEvent):void
			{
				event.stopImmediatePropagation();				
			}
			
			protected function id_pharmacy_changeHandler(event:TextOperationEvent):void
			{
				return; // Only search on enter 
				
				if(id_pharmacy.text.length >= 2)
					Search();
			}
			
			protected function id_image_clickHandler(event:MouseEvent):void
			{
				id_searchType.openDropDown();
				event.stopImmediatePropagation();
			}
			
			[Embed(source="com/gazuntite/provider/eprescription/services/patient/view/assets/images/name_selected.png")]
			[Bindable]	public var selected_name:Class;
			[Embed(source="com/gazuntite/provider/eprescription/services/patient/view/assets/images/ncpdpid_selected.png")]
			[Bindable]	public var selected_NCPDPID:Class;
			[Embed(source="com/gazuntite/provider/eprescription/services/patient/view/assets/images/service_selected.png")]
			[Bindable]	public var selected_serviceLvl:Class;
			[Embed(source="com/gazuntite/provider/eprescription/services/patient/view/assets/images/change_selected.png")]
			[Bindable]	public var selected_changeLvl:Class;
			[Embed(source="com/gazuntite/provider/eprescription/services/patient/view/assets/images/state_selected.png")]
			[Bindable]	public var selected_State:Class;
			[Embed(source="com/gazuntite/provider/eprescription/services/patient/view/assets/images/phone_selected.png")]
			[Bindable]	public var selected_Phone:Class;
			[Embed(source="com/gazuntite/provider/eprescription/services/patient/view/assets/images/fax_selected.png")]
			[Bindable]	public var selected_Fax:Class;
			[Embed(source="com/gazuntite/provider/eprescription/services/patient/view/assets/images/zip_selected.png")]
			[Bindable]	public var selected_Zip:Class;
			[Embed(source="com/gazuntite/provider/eprescription/services/patient/view/assets/images/city_selected.png")]
			[Bindable]	public var selected_City:Class;
			[Embed(source="com/gazuntite/provider/eprescription/services/patient/view/assets/images/address_selected.png")]
			[Bindable]	public var selected_Address:Class;
			
			protected function skinnablecontainer1_creationCompleteHandler(event:FlexEvent):void
			{
				// TODO Auto-generated method stub
			}
			
		]]>
	</fx:Script>
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	<s:layout>
		<s:VerticalLayout gap="-3" paddingLeft="5" paddingRight="5" paddingTop="5" paddingBottom="5"/>
	</s:layout>
	
	<s:Label text="ADD NEW" fontFamily="CalibriCFF" fontSize="14" color="#FFFFFF"/>
	
	<s:Spacer visible="false" height="6"/>
	
	<s:SkinnableContainer id="id_Main" width="100%" height="28" skinClass="com.gazuntite.skins.controls.container.PatientSearchBackgroundSkin">
		
		<s:SkinnableContainer skinClass="com.gazuntite.skins.controls.container.PatientSearchSelectionBg" width="35" height="28" left="0" visible="{!isSearchListShow}" includeInLayout="{!isSearchListShow}"/>
		<s:SkinnableContainer skinClass="com.gazuntite.skins.controls.container.PatientSearchSelectedBg" width="35" height="28" left="0" visible="{isSearchListShow}" includeInLayout="{isSearchListShow}"/>
		
		<s:Group left="3" verticalCenter="0">
			<s:DropDownList id="id_searchType"
							labelField="label" requireSelection="true"
							skinClass="com.gazuntite.skins.controls.combobox.CustomDropDownListSkin"
							itemRenderer="spark.skins.spark.DefaultComplexItemRenderer"	
							change="searchType_changeHandler(event)" 
							width="1" height="1" left="0"
							>
				<s:dataProvider>
					<s:ArrayList>
						<s:BitmapImage source="@Embed('com/gazuntite/provider/eprescription/services/patient/view/assets/images/name.png')" />
						<s:BitmapImage source="@Embed('com/gazuntite/provider/eprescription/services/patient/view/assets/images/ncpdpid.png')" />
						<s:BitmapImage source="@Embed('com/gazuntite/provider/eprescription/services/patient/view/assets/images/servicelevel.png')" />
						<s:BitmapImage source="@Embed('com/gazuntite/provider/eprescription/services/patient/view/assets/images/changelevel.png')" />
						<s:BitmapImage source="@Embed('com/gazuntite/provider/eprescription/services/patient/view/assets/images/state.png')" />
						<s:BitmapImage source="@Embed('com/gazuntite/provider/eprescription/services/patient/view/assets/images/phone.png')" />
						<s:BitmapImage source="@Embed('com/gazuntite/provider/eprescription/services/patient/view/assets/images/fax.png')" />
						<s:BitmapImage source="@Embed('com/gazuntite/provider/eprescription/services/patient/view/assets/images/zip.png')" />
						<s:BitmapImage source="@Embed('com/gazuntite/provider/eprescription/services/patient/view/assets/images/city.png')" />
						<s:BitmapImage source="@Embed('com/gazuntite/provider/eprescription/services/patient/view/assets/images/address.png')" />
					</s:ArrayList>
				</s:dataProvider>
			</s:DropDownList>
			
			<s:Image id="id_image" 
					 width="30" height="19" source="{selected_name}" left="0" click="id_image_clickHandler(event)" buttonMode="true" useHandCursor="true" />
		</s:Group>
		
		<components:LabelTextInput id="id_pharmacy" 
								   height="100%"
								   focusAlpha="0" left="30" right="21" verticalCenter="0" fontSize="15" 
								   prompt="Search Pharmacy" restrict="[A-Z a-z , . / \- 0-9]" 
								   keyUp="textInput_keyUpHandler(event)"
								   click="textInput_clickHandler(event)"  
								   change="id_pharmacy_changeHandler(event)"
								   skinClass="com.gazuntite.controls.extended.skins.transparentTextInputSkin"   />
	</s:SkinnableContainer>
	
	<pharmacySearch:pharmacySearchList id="id_SearchListView" 
									   width="100%" 
									   PharmacySelected="OnItemClick(event)"
									   visible="false" includeInLayout="{id_SearchListView.visible}" />
</s:SkinnableContainer>
