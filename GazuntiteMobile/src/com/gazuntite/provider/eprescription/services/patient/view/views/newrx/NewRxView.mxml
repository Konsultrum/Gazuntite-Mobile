					SaveNewRXXML_.@MessageStatus			= "3";
					
					//there are two items in id_type combo "OTC" and "History"
					// in New Impl there is no combo Box in design
					/*<components1:LabelComboBox id="id_type" prompt="Type" width="75%"  required="true" toolTip="Type">
