					SaveNewRXXML_.@Type						= "History" ;//id_type.selectedItem; 
				}
				else
				{
					SaveNewRXXML_.@isChronic				= "false";
					SaveNewRXXML_.@Type						= "e-Prescribed" ;//id_type.selectedItem;
				}
				
				SaveNewRXXML_.@SPI						= SPI;//SPI; 
				SaveNewRXXML_.@OtherID  = "";//Dication ID
				SaveNewRXXML_.@Notes = id_InputView.id_pharmacyNote.text;//Notes
				SaveNewRXXML_.appendChild(InsurancesXML);
				
				
				SaveNewRXXML_.@isActive  = 'true';
				
				SaveNewRXXML_.@GaxenUserID  = model.LoggedInUserGaxenID;// user Gaxen ID
				
				var rpEvent : SaveNewRXEvent = new SaveNewRXEvent(SummaryRecived);
				rpEvent.data = SaveNewRXXML_;
				CairngormEventDispatcher.getInstance().dispatchEvent( rpEvent ); 
			}
			
			
			public function calculateDuration(doseValue:String , Quantity:String , frequencyAbbreviation:String):String
			{
				if(doseValue.length != 0 && Quantity.length != 0)
				{
					var dose:int 		= parseInt(doseValue);
					var quantity:int 	= parseInt(Quantity);
					var duration:Number;
					var eachday:Number;
					var freq:Number;
					
					if(frequencyAbbreviation == "TID")
					{
						freq = 3;
					}
					else if(frequencyAbbreviation == "3X/W")
					{
						freq = 3/7;
					}
					else if(frequencyAbbreviation == "QID")
					{
						freq = 4;
					}
					else if(frequencyAbbreviation == "5X/D")
					{
						freq = 5;
					}
					else if(frequencyAbbreviation == "Q18H")
					{
						freq = 24/18;
					}
					else if(frequencyAbbreviation == "Q36H")
					{
						freq = 24/36;
					}
					else if(frequencyAbbreviation == "Q48H")
					{
						freq = 24/48;
					}
					else if(frequencyAbbreviation == "Q72H")
					{
						freq = 24/72;
					}
					else if(frequencyAbbreviation == "Q7D")
					{
						freq = 1/7;
					}
					else if(frequencyAbbreviation == "every other day")
					{
						freq = 0.5;
					}
					else if(frequencyAbbreviation == "once a day")
					{
						freq = 1;
					}
					else if(frequencyAbbreviation == "Q1MO")
					{
						freq = 1/30;
					}
					else if(frequencyAbbreviation == "1X/W")
					{
						freq = 1/7;
					}
					else if(frequencyAbbreviation == "BID")
					{
						freq = 2;
					}
					else if(frequencyAbbreviation == "2X/W")
					{
						freq = 2/7;
					}
					else if(frequencyAbbreviation == "Q15MIN")
					{
						freq = 60*24 / 15;
					}
					else if(frequencyAbbreviation == "Q1H")
					{
						freq = 24;
					}
					else if(frequencyAbbreviation == "10X/D") //10 times a day
					{
						freq = 10;
					}
					else if(frequencyAbbreviation == "12X/D")
					{
						freq = 12;
					}
					else if(frequencyAbbreviation == "16X/D")
					{
						freq = 16;
					}
					else if(frequencyAbbreviation == "6X/D")
					{
						freq = 6;
					}
					else if(frequencyAbbreviation == "7X/D")
					{
						freq = 7;
					}
					else if(frequencyAbbreviation == "8X/D")
					{
						freq = 8;
					}
					else if(frequencyAbbreviation == "Q16H") //every 16 hours
					{
						freq = 24/16;
					}
					else if(frequencyAbbreviation == "Q2W") //every 2 weeks
					{
						freq = 1/14;
					}
					else if(frequencyAbbreviation == "Q30MIN") //every 30 minutes
					{
						freq = 60*24 / 30;
					}
					else if(frequencyAbbreviation == "Q40H") //every 40 hours
					{
						freq = 24 / 40;
					}
					else if(frequencyAbbreviation == "QY") //yearly
					{
						freq = 1/365;
					}
					else if(frequencyAbbreviation == "9X/D")
					{
						freq = 9;
					}
					else if(frequencyAbbreviation == "9X/D")
					{
						freq = 9;
					}
					else if(frequencyAbbreviation == "Q3W")
					{
						freq = 1/21;
					}
					else if(frequencyAbbreviation == "Q5D")
					{
						freq = 1/5;
					}
					else if(frequencyAbbreviation == "Q60H")
					{
						freq = 24 / 60;
					}
					else
					{
						freq = 1;
					}
					
				}
				
				eachday = dose * freq;
				duration = quantity/eachday;
				duration = Math.round(duration);
				return duration.toString();
				
			}
			
