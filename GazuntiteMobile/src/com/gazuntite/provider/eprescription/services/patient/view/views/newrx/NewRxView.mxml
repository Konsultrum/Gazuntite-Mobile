				SaveNewRXXML_.@Strength					= id_InputView.selectedMedicine.STRENGTH_ID; //StrengthId; //id_strength.text;
				
				if(null != id_InputView.id_MedicineInputView.selectedDose)
				{
					SaveNewRXXML_.@Dose						= id_InputView.id_MedicineInputView.selectedDose.value; //id_dose.text?id_dose.text:"0";
					SaveNewRXXML_.@DoseForm					= id_InputView.id_MedicineInputView.selectedDose.item.Code; //id_dosageForm.text;
					SaveNewRXXML_.@DoseFormDES				= id_InputView.id_MedicineInputView.selectedDose.item.Term; //id_dosageForm.text;
					
					
					SaveNewRXXML_.@Duration					= calculateDuration(id_InputView.id_MedicineInputView.selectedDose.value ,id_InputView.id_MedicineInputView.selectedQuantity.value ,id_InputView.id_MedicineInputView.selectedFrequency.item.Abbreviation);
				}
				else
				{
					SaveNewRXXML_.@Dose						= '0';
					SaveNewRXXML_.@DoseForm					='';
					SaveNewRXXML_.@DoseFormDES					='';
				}
				
				if(null != id_InputView.id_MedicineInputView.selectedQuantity)
				{
					SaveNewRXXML_.@Quantity					= id_InputView.id_MedicineInputView.selectedQuantity.value; //id_quantity.text?id_quantity.text:"0";
					SaveNewRXXML_.@QuantityForm				= id_InputView.id_MedicineInputView.selectedQuantity.item.Code;//QuantityForm; // id_quantityForm.text;
					SaveNewRXXML_.@QuantityFormDES			= id_InputView.id_MedicineInputView.selectedQuantity.item.Term;//QuantityForm; // id_quantityForm.text;
				}
					
				else
				{
					SaveNewRXXML_.@Quantity								= '0';
					SaveNewRXXML_.@QuantityForm							= '';
					SaveNewRXXML_.@QuantityFormDES						= '';
				}
				
				
				if(null != id_InputView.id_MedicineInputView.selectedRoute)
				{
					SaveNewRXXML_.@Route					= id_InputView.id_MedicineInputView.selectedRoute.value; 
				}
					
				else
				{
					SaveNewRXXML_.@Route 					= '';
				}
				
				if(null != id_InputView.id_MedicineInputView.selectedFrequency)
				{
					SaveNewRXXML_.@frequency				= id_InputView.id_MedicineInputView.selectedFrequency.item.Abbreviation; //Frequency; //id_frequency.text;
					SaveNewRXXML_.@frequencyDES				= id_InputView.id_MedicineInputView.selectedFrequency.item.Description; //Frequency; //id_frequency.text;
				}
					
				else
				{
					SaveNewRXXML_.@frequency 				= '';
					SaveNewRXXML_.@frequencyDES 			= '';
				}
				
				if(null != id_InputView.id_MedicineInputView.selectedRefill)
				{
					var isPRN:String 						= id_InputView.id_MedicineInputView.selectedRefill.value;
					SaveNewRXXML_.@isPRN					= isPRN.length > 0 ? isPRN:"false";
					
					if(id_InputView.id_MedicineInputView.selectedRefill.value == "true")
					{
						SaveNewRXXML_.@Refill					= "0";				
					}
					else
					{
						SaveNewRXXML_.@Refill				= id_InputView.id_MedicineInputView.selectedRefill.item.Refill;
					}
				}
				
				else 
