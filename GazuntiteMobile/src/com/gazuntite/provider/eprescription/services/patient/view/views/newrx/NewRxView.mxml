			protected function cc(event:FlexEvent):void
			{
				//id_InputView.addEventListener(FlipViewEvent.FLIP_VIEW_EVENT, onFlipRequested);
				
				addEventListener( "sendCMData", onSendCMData);
				addEventListener( "sendData", onSendData);
				addEventListener( "addData", onAddData);
				
				
				//services
				var loadClinicUsersBasicInfoEvent: LoadClinicUsersBasicInfoEvent = new LoadClinicUsersBasicInfoEvent(model.LoggedInUserId, model.LoggedInUserSelectedBranchId, getProviderDetails);
				CairngormEventDispatcher.getInstance().dispatchEvent(loadClinicUsersBasicInfoEvent);
			}
			
			// get provider detail
			private function getProviderDetails(val:* = null):void
			{
				var eusername:String  	= model.SearchProviderDetailsResults.EUserName;
				var epassword:String  	= model.SearchProviderDetailsResults.EPassword;
				var gaxenUserId:String 	= model.SearchProviderDetailsResults.GAXENID;
				
				var securityHeaderXML:XML	 			= <Header />;					
				securityHeaderXML.@EUserName	= eusername;
				securityHeaderXML.@EPassword	= epassword;
				securityHeaderXML.@ClinicID		= "sad";
				
				var rpEvent_ : LoadPrescriberbyGaxenIDEvent = new LoadPrescriberbyGaxenIDEvent(gaxenUserId, PrescriberLoaded);	
				rpEvent_.data = securityHeaderXML;
				CairngormEventDispatcher.getInstance().dispatchEvent( rpEvent_ );  
				
				id_InputView.loadStaticData();
			}
			
			
			// ********* PrescriberLoaded call back function *********************************
			public function PrescriberLoaded(response:XML):void
			{
				var ServiceLevelCodes:String = response.Prescriber.@ServiceLevelCodes;
				var a:Array = ServiceLevelCodes.split(",");
				
				for(var i:uint=0; i<a.length; i++)
				{
					if(a[i] == "1" || a[i] == "3")
					{
						chk1 = true;
					}
					if(a[i] == "32")
					{
						chk2 = true;
					}
					if(a[i] == "8")
					{
						chk3 = true;
					}
					if(a[i] == "64")					
					{
						chk4 = true;
					}
					if(a[i] == "2048")					
					{
						chk5 = true;
					}
					if(chk1)
					{
						model.checkPrescriberServiceLevels = true;
					}
				}
			}
			
			private function onSendCMData(event:Event):void
			{
				if(!ValidateNEWRX() )
					return;
				else
					AssignSummary(true,id_InputView.id_ChronicMedication.selected?true:false);
			}
			private function onSendData(event:Event):void
			{
				if(!model.checkPrescriberServiceLevels)
				{
//					var alert:Alert = Alert.show("You don’t have the required service level to prescribe this medicine", "Alert", 4, FlexGlobals.topLevelApplication.mainContainer, function(event:Event):void{
//						return;											
//					});
					return;
				}
				
				if(!ValidateNEWRX() )
				{
					return;
				}
					
				else
				{
					AssignSummary(true,id_InputView.id_ChronicMedication.selected?true:false);
				}
			}
			
			public function ValidateNEWRX():Boolean
			{
				return true;
			}
			
			private function AssignSummary(sendOnly:Boolean, isChronic:Boolean = false, encounterId:String="0"):void
