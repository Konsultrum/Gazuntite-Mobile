<?xml version="1.0" encoding="utf-8"?>
<s:Group xmlns:fx="http://ns.adobe.com/mxml/2009" 
		 xmlns:s="library://ns.adobe.com/flex/spark" 
		 xmlns:mx="library://ns.adobe.com/flex/mx" 
		  creationComplete="group1_creationCompleteHandler(event)" xmlns:components="com.gazuntite.controls.extended.components.*">
	<fx:Script>
		<![CDATA[
			import com.gazuntite.common.util.ValidationUtils;
			
			import mx.collections.ArrayCollection;
			import mx.events.FlexEvent;
			
			import spark.events.TextOperationEvent;
			
		    private var m_oPhoneNumberTypes:ArrayCollection;
			private var _phoneNumber:String;
			
			[Bindable]
			public function get phoneNumber():String
			{
				return _phoneNumber;
			}

			public function set phoneNumber(value:String):void
			{
				_phoneNumber = value;
				if(_phoneNumber != '')
					_phoneNumber = setPhoneNumberMasking(_phoneNumber)
			}

			[Bindable]
			public function get PhoneNumberTypes():ArrayCollection
			{
				return m_oPhoneNumberTypes;
			}

			public function set PhoneNumberTypes(value:ArrayCollection):void
			{
				m_oPhoneNumberTypes = value;
			}

			public function resetFields():void
			{
				if (id_TelNumber)
					id_TelNumber.text = "";
				
				if (id_ExtNumber)
					id_ExtNumber.text = "";
			}
			
			public function getPhoneNumberDetails():Object
			{
				var result:Object;
				
				if (id_TelNumber && id_TelNumber.text)
				{
					if (!result)
						result = {};
					
					result["phoneNumber"] = getPhoneNumberWithoutMasking(id_TelNumber.text);
				}
				/* as per req
				if (id_TelNumberKind && id_TelNumberKind.selectedItem)
				{
					 if (result)
						result["phoneNumberKind"] = (id_TelNumberKind.selectedItem); 
				} */
				
				if (id_ExtNumber)
				{
					if (result)
						result["phoneExtension"] = id_ExtNumber.text;
				}
				
				return result;
			}
			
			public function isInValid(mustEnterRequiredFields:Boolean = false, errorStrToAppend:String = ""):Object
			{
				var isNotValid:Boolean = false;
				var errorStr:String = "";
				var toSetFocus:*;
				
				ValidationUtils.Trim(id_TelNumber);
				ValidationUtils.Trim(id_ExtNumber);
				
				if (id_TelNumber.text.length || id_ExtNumber.text.length)//as per req || id_TelNumberKind.selectedIndex != -1)
				{
					if (id_TelNumber.text.length >= 10 && id_TelNumber.text.length <= 20)
					{
						if (!ValidationUtils.isValidPhone2(getPhoneNumberWithoutMasking(id_TelNumber.text)))
						{
							isNotValid = true;
							
							if (errorStrToAppend)
								errorStr += errorStrToAppend + " ";
							
							errorStr += "phone number is invalid.\n";
							
							if (!toSetFocus)
								toSetFocus = id_TelNumber;
						}
					}
					else
					{
						isNotValid = true;
						errorStr += "Specify minimum 10 and maximum 20 digits for ";
						
						if (errorStrToAppend)
						{
							errorStr += errorStrToAppend.toLowerCase() + " ";
						}
						
						errorStr += "phone number.\n";
						
						if (!toSetFocus)
							toSetFocus = id_TelNumber;
					}
					
					if (id_ExtNumber.text.length && !ValidationUtils.isValidPhoneExt(id_ExtNumber))
					{
						isNotValid = true;
						
						if (errorStrToAppend)
							errorStr += errorStrToAppend + " ";
						
						errorStr += "phone number extension is invalid.\n";
						
						if (!toSetFocus)
							toSetFocus = id_ExtNumber;
					}
					
					/* as per req 
					if (!ValidationUtils.isValidValueSelected(id_TelNumberKind))
					{
						isNotValid = true;
						
						if (errorStrToAppend)
							errorStr += errorStrToAppend + " ";
						
						errorStr += "phone number type is invalid.\n";
						
						if (!toSetFocus)
							toSetFocus = id_TelNumberKind;
					} */
				}
				else
				{
					if (mustEnterRequiredFields)
					{
						isNotValid = true;
						
						errorStr += "Specify minimum 10 and maximum 20 digits for ";
						
						if (errorStrToAppend)
							errorStr += errorStrToAppend.toLowerCase() + " ";
						
						errorStr += "phone number.\n";
						
						if (errorStrToAppend)
							errorStr += errorStrToAppend + " ";
						
						errorStr += "phone number type is invalid.\n";
						
						
						if (!toSetFocus)
							toSetFocus = id_TelNumber;
					}else{
						isNotValid = true;
					}
						
				}
				
				var result:Object = {"isNotValid":isNotValid, "errorStr": errorStr, "toSetFocus": toSetFocus};
				
				return result;
			}
			
			public function isGetEdited():Boolean
			{
				if (id_TelNumber.text.length)//as per req || id_TelNumberKind.selectedIndex != -1)
					return true;
				
				return false;
			}
			

			protected function group1_creationCompleteHandler(event:FlexEvent):void
			{
				id_TelNumber.tabIndex = tabIndex;
				id_ExtNumber.tabIndex = tabIndex + 1;
				// as per req id_TelNumberKind.tabIndex=tabIndex+2;
			}
			//Tahir Alvi - apply masking on the phone number
			public function applyMask():void
			{
				var s:String      = id_TelNumber.text.replace(/[^0-9]/g,"");
				id_TelNumber.text = '('+s.substring(0,3) + (s.length>3?")"+s.substring(3,6) + (s.length>6?"-"+s.substring(6,10):""):"");
				id_TelNumber.selectRange(id_TelNumber.text.length, id_TelNumber.text.length);
				
				if(id_TelNumber.text.length == 1 && id_TelNumber.text == '(')
					id_TelNumber.text = '';
			}
			//Tahir Alvi - remove masking on the phone number
			public function getPhoneNumberWithoutMasking(text:String):String
			{
				var val1:String = text;
				var val2:String = val1.replace('(','');
				var val3:String = val2.replace(')','');
				var val4:String = val3.replace('-','');
				
				return val4;
			}
			//Tahir Alvi - apply masking on the phone number at load time
			public function setPhoneNumberMasking(val:String):String
			{
				var val_Format:String = '(' + val.substring(0,3) + ')' + val.substring(3,6) + '-' + val.substring(6,10);
				return val_Format;
			}

			protected function id_TelNumber_changeHandler(event:TextOperationEvent):void
			{
				applyMask();
			}
			
		]]>
	</fx:Script>
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	<s:HGroup width="100%">
		<components:LabelTextInput id="id_TelNumber" fontFamily="Calibri" fontSize="11" width="70%" prompt="Telephone Number" text="{phoneNumber}"  restrict="[0-9]"
								 required="true" change="id_TelNumber_changeHandler(event)"/>
		<components:LabelTextInput id="id_ExtNumber" fontFamily="Calibri" fontSize="11" width="30%" prompt="Ext" maxChars="4" restrict="[0-9]"/>
		<!--<components:LabelComboBox id="id_TelNumberKind" prompt="Phone type" width="55%" 
								  labelField="NumberTypeName" required="true" 
								  dataProvider="{PhoneNumberTypes}" visible="false" includeInLayout="false"/>-->
	</s:HGroup>
	
</s:Group>
