<?xml version="1.0" encoding="utf-8"?>
<s:Group xmlns:fx="http://ns.adobe.com/mxml/2009" 
		 xmlns:s="library://ns.adobe.com/flex/spark" 
		 xmlns:mx="library://ns.adobe.com/flex/mx"
		 creationComplete="group1_creationCompleteHandler(event)">
	<fx:Script>
		<![CDATA[
			import com.adobe.cairngorm.control.CairngormEventDispatcher;
			import com.gazuntite.common.view.events.MarkVisitValidEvent;
			import com.gazuntite.controls.events.FlipViewEvent;
			import com.gazuntite.provider.eprescription.services.patient.model.EPrescriptionModelLocator;
			
			import mx.events.FlexEvent;
			import mx.managers.CursorManager;
			
			
			[Bindable]
			private var model:EPrescriptionModelLocator = EPrescriptionModelLocator.getInstance();
			
			private var _URL:String = '';
			
			public function get URL():String
			{
				return _URL;
			}
			
			public function set URL(value:String):void
			{
				_URL = value;
				if(value!= null)
					NavigateToURL();
				
			}
			
			private function NavigateToURL():void
			{
				CursorManager.removeBusyCursor();
				id_htmlArea.htmlLoader.navigateInSystemBrowser = false;
				id_htmlArea.location = URL;
				
				id_htmlArea.addEventListener(Event.COMPLETE, completeHandler);
			}
			
			protected function group1_creationCompleteHandler(event:FlexEvent):void
			{
				/* CursorManager.removeBusyCursor();
				id_htmlArea.htmlLoader.navigateInSystemBrowser = false;
				id_htmlArea.location = URL;
				
				id_htmlArea.addEventListener(Event.COMPLETE, completeHandler); */
			}
			
			protected function completeHandler(event:Event):void 
			{
				if(null != id_htmlArea.htmlLoader.window.document.getElementById("BtnClose"))
					id_htmlArea.htmlLoader.window.document.getElementById("BtnClose").onclick = clickHandler;
				
				if(null != id_htmlArea.htmlLoader.window.document.getElementById("btnExit"))
					id_htmlArea.htmlLoader.window.document.getElementById("btnExit").onclick = ExitBtn_Clicked;
				
				if(null != id_htmlArea.htmlLoader.window.document.getElementById("btnAddmoreRX"))
					id_htmlArea.htmlLoader.window.document.getElementById("btnAddmoreRX").onclick = AddMoreRX_Clicked;
				
				if(null != id_htmlArea.htmlLoader.window.document.getElementById("BtnSub"))
					id_htmlArea.htmlLoader.window.document.getElementById("BtnSub").onclick = RXSaved;
			}
			
			private function RXSaved(object:*):void
			{
				dispatchEvent(new Event("LoadPatientMedications",true));
				
				/* var ev:MarkVisitValidEvent = new MarkVisitValidEvent(MarkVisitValidEvent.MarkVisitValid);
				
				ev.visitDate = model.visitDate;
				ev.visitID 	= parseInt(model.visitID)
				
				dispatchEvent(ev);  */
			}
			
			protected function clickHandler(object:*):void 
			{
				id_htmlArea.location = 'http://www.quivus.com/QuivusAirDev/VideoChatStaging/blankpage.aspx';
				dispatchEvent(new FlipViewEvent());
			}
			
			
			protected function ExitBtn_Clicked(object:*):void 
			{
				dispatchEvent(new Event("CloseRX",true));
			}
			
			
			protected function AddMoreRX_Clicked(object:*):void 
			{
				id_htmlArea.location = 'http://www.quivus.com/QuivusAirDev/VideoChatStaging/blankpage.aspx';
				id_htmlArea.callLater(function ():void
				{
					dispatchEvent(new Event("AddMorePrescreption",true));
					dispatchEvent(new FlipViewEvent());
					
				});
			}
			
			
			protected function id_htmlArea_completeHandler(event:Event):void
			{
				var obj:Object = id_htmlArea.htmlLoader.window.document.getElementById("btnAddmoreRX")
				
				if(obj != null)
				{
					var ev:MarkVisitValidEvent = new MarkVisitValidEvent(MarkVisitValidEvent.MarkVisitValid);
					
					ev.visitDate = model.visitDate;
					ev.visitID 	= parseInt(model.visitID)
					
					dispatchEvent(ev); 
				}
			}
			
		]]>
	</fx:Script>
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	<s:BorderContainer backgroundColor="#B9BDC6" borderColor="#B9BDC6" borderWeight="1" cornerRadius="3" width="100%" height="100%"  maxHeight="210">
		<s:filters>
			<s:DropShadowFilter alpha="0.5" strength="1" quality="2" color="#727472"/>
		</s:filters>
		<mx:HTML horizontalScrollPolicy="off" verticalScrollPolicy="off" id="id_htmlArea" height="100%" width="100%" complete="id_htmlArea_completeHandler(event)"/>
	</s:BorderContainer>
</s:Group>
