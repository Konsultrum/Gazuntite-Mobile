			private var comOptionpoup:OptionPopUp;
			protected function uiOptionButton_clickHandler(event:MouseEvent):void
			{
				
				var toggleView:Boolean = null != comOptionpoup;
				
				removeAllPopups();
				
				if(toggleView )
				{
					return;
				}
				
				comOptionpoup = new OptionPopUp();
				comOptionpoup.ShowPopup( this );
				
				comOptionpoup.addEventListener("ClosePopup", function(closeevent:Event):void 
				{ 
					removeAllPopups();
				});
				
				var pt:Point = event.currentTarget.parent.localToGlobal(new Point(event.currentTarget.x, event.currentTarget.y));
				
				comOptionpoup.move( pt.x - comOptionpoup.width + 25, pt.y + 25 ); 
				
				event.preventDefault();
				event.stopImmediatePropagation();
				
				
			}
			
			public function removeAllPopups():void
			{
				
				if( comOptionpoup && comOptionpoup.isPopUp )
				{
					comOptionpoup.removePopup();
					comOptionpoup = null;
					uiOptionButton.selected = false;
				}
				
			}
			protected function showNote(event:MouseEvent):void
			{
				newRXDictationNoteViewModel.inlineEditing = false;
				newRXDictationNoteViewModel.inNoteMode = true;
				newRXDictationNoteViewModel.visible = true;
			}
			protected function showDictation(event:MouseEvent):void
			{
				newRXDictationNoteViewModel.inlineEditing = false;
				newRXDictationNoteViewModel.inDictationMode = true;
				newRXDictationNoteViewModel.visible = true;
			}
