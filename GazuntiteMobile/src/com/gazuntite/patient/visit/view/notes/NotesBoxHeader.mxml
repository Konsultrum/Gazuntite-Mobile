<?xml version="1.0" encoding="utf-8"?>
<s:Group xmlns:fx="http://ns.adobe.com/mxml/2009" 
		 xmlns:s="library://ns.adobe.com/flex/spark" 
		 xmlns:mx="library://ns.adobe.com/flex/mx" width="628" height="201">
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	
	<!--<s:BorderContainer id="id_header" width="100%" height="17" backgroundColor="#666666" borderColor="#666666"  backgroundAlpha="1" borderAlpha="0" borderVisible="false" >-->
	<s:SkinnableContainer id="id_header" width="100%" height="23"  skinClass="com.adobe.gazuntite.skins.chrome.containerSkins.notesHeaderSkin">
		
		
		<s:layout>
			<s:HorizontalLayout gap="0" horizontalAlign="right" />
		</s:layout>
		<s:Rect height="23" width="1">
			<s:fill>
				<s:SolidColor color="#333333"/>
			</s:fill>
			<s:filters>
				<s:DropShadowFilter alpha="0.4" angle="0" blurX="0" blurY="0" color="#FFFFFF" distance="1" hideObject="false" inner="false" knockout="false" quality="2" strength="1"/>
			</s:filters>
		</s:Rect>
		
		<s:Button id="id_VoiceBtn" height="23" width="23" label="mic" skinClass="com.adobe.gazuntite.skins.chrome.buttonSkins.QIInnerMicBtn" 
				  buttonMode="true" useHandCursor="true" toolTip="Record Dictation"/>
		<s:Rect height="23" width="1">
			<s:fill>
				<s:SolidColor color="#333333"/>
			</s:fill>
			<s:filters>
				<s:DropShadowFilter alpha="0.4" angle="0" blurX="0" blurY="0" color="#FFFFFF" distance="1" hideObject="false" inner="false" knockout="false" quality="2" strength="1"/>
			</s:filters>
		</s:Rect>
		
		<s:Button id="id_ClearBtn" label="_" visible="false" includeInLayout="false"  /> 
		<s:Button id="id_CloseBtn" height="23" width="23" skinClass="com.adobe.gazuntite.skins.chrome.buttonSkins.QICrossButtonSkin"
				  buttonMode="true" useHandCursor="true" toolTip="Close" /> 
		<!--</s:BorderContainer>-->
		
	</s:SkinnableContainer>
	
</s:Group>
