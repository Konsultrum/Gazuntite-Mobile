			private function showRecordProgressBar(event:TimerEvent):void 
			{	
				soundTimerCounter++;
				
				var recSecond:int =  soundTimerCounter % 60;
				
				var recMinute:int =  soundTimerCounter / 60;
				
				//var recHours:int =  soundTimerCounter / (60 * 60 * 60);
				if( recMinute == 9 )
				{
					id_maxTimmerWarning.visible 		= true;
					id_maxTimmerWarning.includeInLayout = true;
					
					if( recSecond == 59 )
					{
						doRecStop(event);
						return;
					}
				}
				
				recordingTimer.text = recMinute + " : " + recSecond;
				
				var num = recorder.microphone.activityLevel;
				
				micLevelBar.width = num * 1.5;
				
			}
			
			private function showSoundProgressBar(event:TimerEvent):void 
			{	
				soundTimerCounter++;
				
				var recSecond:int =  soundTimerCounter % 60;
				
				var recMinute:int =  soundTimerCounter / 60;
				
				var num:int  =  recSecond * 1000; //convert to milliseconds
				
				trace("num "+ num);
				
				trace("WIDTH " + soundProgressBar.width);
				
				trace("mySound.length "+ mySound.length);
				
				//trace("mySound.length "+ mySound.length);
				
				//trace("mySound.bytesLoaded "+ mySound.bytesLoaded);
				
				//trace("mySound.bytesTotal "+ mySound.bytesTotal);
				
				if(num >= mySound.length)
				{
					playTimer.stop();
					
					soundTimerCounter = 0;
					
					rec_btn.enabled = false;
					recStop_btn.enabled = false;				
					play_btn.enabled = true;
					playStop_btn.enabled = false;
					
					soundProgressBar.width = myProgressBarFrame.width - 5;
				}
				else
				{
					recordingTimer.text = recMinute + " : " + recSecond;				
					soundProgressBar.width = (num / mySound.length) * (myProgressBarFrame.width - 5);//100 * 1.75 ; //scale to width of process bar
				}				
			}
			
			private function doPlayStop(e:Event):void
			{
				playTimer.stop();
				
				audio.stop();
				mySound.removeEventListener(Event.COMPLETE, loaded);
				mySound = null;
				
				soundTimerCounter = 0;
				
				rec_btn.enabled = false;
				recStop_btn.enabled = false;				
				play_btn.enabled = true;
				playStop_btn.enabled = false;
			}
			
				
			
			private function doPlay(event:Event):void
			{	
				
				try
				{
					trace("FILE TO PLAY " + DictationDTO.DictationID);
					
					soundTimerCounter = 0;
					
					var sessionID:String = model.LoggedInUserSessionID;				
					
					var urlRequest:URLRequest = new URLRequest();
					var temp:File = File.applicationStorageDirectory.resolvePath(Constants.DICTATION_FOLDER_NAME+"/"+DictationDTO.DictationID+".mp3");
					
					if(temp!=null && temp.exists)
					{
						urlRequest.url = temp.nativePath;
					}
					else
					{
						urlRequest.url = Constants.DICTATION_SERVER_URL + "GetDictationFile/"+DictationDTO.DictationID+"/"+sessionID;
						urlRequest.method = URLRequestMethod.GET;
					}
					
					mySound = new Sound();
					mySound.load(urlRequest);
					mySound.addEventListener(Event.COMPLETE, loaded);
				}
				catch(err:Error)
				{
					trace(err.errorID, err.name, err.message, "\n", err.getStackTrace() );
				}
			}
			
			private function loaded(event:Event):void
			{
				mySound.addEventListener(SampleDataEvent.SAMPLE_DATA, processSound);
				audio = mySound.play();
				
				playTimer.start();
				
				rec_btn.enabled = false;
				recStop_btn.enabled = false;				
				play_btn.enabled = false;
				playStop_btn.enabled = true;
			}
			
			private function processSound(event:SampleDataEvent):void
			{
				var bytes:ByteArray = new ByteArray();
				mySound.extract(bytes, 4096);
				event.data.writeBytes(upOctave(bytes));
			}
			
			private function upOctave(bytes:ByteArray):ByteArray
			{
				var returnBytes:ByteArray = new ByteArray();
				bytes.position = 0;
				while(bytes.bytesAvailable > 0)
				{
					returnBytes.writeFloat(bytes.readFloat());
					returnBytes.writeFloat(bytes.readFloat());
					if (bytes.bytesAvailable > 0)
					{
						bytes.position += 8;
					}
					
					//myProgressBar.width = (bytes.position/bytes.length) * 100 * 2.5;					
					trace("WIDTH = " + (bytes.position/bytes.length));
				}
				return returnBytes;
			}
			
			
			private function onRecording(event:RecordingEvent):void
			{
				//trace ( event.time );
			}
			
			private function onRecordComplete(event:Event):void
			{
				DictationDTO.DictationID = UIDUtil.createUID();
				
				//newFileName = DictationID;
				
				var src = WaveFile.createSample(recorder.output) // this is fine
				
				// I think im not clearing out the old audio properly here somehow...
				var sequence = new ListPerformance();
				sequence.addSourceAt(0, src);
				var ap = new AudioPerformer(sequence, new AudioDescriptor());
				
				model.dictationUploadInProcessCount++;
				trace("DICTATION COUNT -- " + model.dictationUploadInProcessCount);
				
				renderWav(ap, true);
				
				dispatchEvent(new Event("DictationSaved", true));
				
				
				
				removePopup();
				
				logger.debug( "onRecordComplete --> Recording Complete with id " + DictationDTO.DictationID );
			}
			
			private function playbackSampleHandler(event:SampleDataEvent):void
			{
				soundBytes.position = 0;
				
				for (var i:int = 0; i < 8192 && soundBytes.bytesAvailable > 0; i++)
				{
					var sample:Number = soundBytes.readFloat();
					event.data.writeFloat(sample);
					event.data.writeFloat(sample);
				}
			}
			
			private function renderWav(src, convertToMp3 = false):void
			{	
				innerTimer.addEventListener(TimerEvent.TIMER, handleRenderTimer)
				innerTimer.start();
				
				function handleRenderTimer(e:TimerEvent)
				{
					src.getSample(framesPerChunk).writeWavBytes(myWavData);
					
					var m = Math.min(src.frameCount, src.position + framesPerChunk);
					var n = Math.max(0, m - src.position);
					
					//M myProgressBar.width = n;
					
					if (n == 0)
					{	
						if (src.position > 0)
							finishRender()
						else
							trace("cancel rendering")
					} 
					else
					{
						//statustxt.text = "rendering audio: "+ Math.floor(src.position * 100 / src.frameCount) + "%";
					}
				}
				
				function finishRender():void
				{
					innerTimer.stop()
					
					WaveFile.writeBytesToWavFile(myWavFile, myWavData, 44100, 2, 16)
					
					if (!convertToMp3)
					{
						//wavbtn.enabled = true;
					} 
					else 
					{
						makeIntoMp3()
					}
				}
			}
			
			private function makeIntoMp3():void
			{	
				myWavFile.position = 0;
				mp3Encoder = new ShineMP3Encoder(myWavFile);
				mp3Encoder.addEventListener(Event.COMPLETE, mp3EncodeComplete);
				//mp3Encoder.addEventListener(ProgressEvent.PROGRESS, mp3EncodeProgress);
				//mp3Encoder.addEventListener(ErrorEvent.ERROR, mp3EncodeError);
				mp3Encoder.start();
			}
			
			function mp3EncodeComplete(e: Event) : void 
			{
				// WRITE ID3 TAGS
				var sba:ByteArray = mp3Encoder.mp3Data;
				sba.position =  sba.length - 128
				sba.writeMultiByte("TAG", "iso-8859-1");
				sba.writeMultiByte("Gazuntite Dictation " + String.fromCharCode(0), "iso-8859-1");	// Title
				sba.writeMultiByte("Gazuntite " + String.fromCharCode(0), "iso-8859-1");	// Artist			
				sba.writeMultiByte("Dictation "+String.fromCharCode(0), "iso-8859-1");	// Album		
				sba.writeMultiByte("2010 " + String.fromCharCode(0), "iso-8859-1");		// Year
				sba.writeMultiByte("www.quivus.com " + String.fromCharCode(0), "iso-8859-1");// comments
				sba.writeByte(57);																		
				
				saveFile(sba);			
			}
			
			private function saveFile(sba:ByteArray):void
			{
				trace("SAVING DICTATION FILE ......");
				logger.debug( "saveFile--> SAVING DICTATION FILE with id " + DictationDTO.DictationID );
				
				var fileName:String = DictationDTO.DictationID;
				
				//var filePath:String = File.applicationStorageDirectory.resolvePath(Constants.DICTATION_FOLDER_NAME+"/"+fileName+".wav");
				file = File.applicationStorageDirectory.resolvePath(Constants.DICTATION_FOLDER_NAME+"/"+fileName+".mp3");
				var filePath:String =file.nativePath;
				//newFileName = fileName;
				newFilePath = filePath;
				
				//FileNameToPlay = newFileName;
				
				file = File.applicationStorageDirectory.resolvePath(Constants.DICTATION_FOLDER_NAME+"/"+fileName+".mp3");
				
				var stream:FileStream = new FileStream();
				stream.open(file, FileMode.WRITE);
				
				stream.writeBytes(sba, 0, sba.length);
				stream.close(); 
				
				trace("SAVED DICTATION FILE NAME::"+ DictationDTO.DictationID);
				
				saveToServer(sba);
			}
			
			private function saveToServer(sba:ByteArray):void
			{
				trace("SAVING DICTATION FILE TO SERVER ......");
				var date:Date = new Date();
				var recordTimeStamp:String;
				
				var dat:int = date.getDate();
				var mon:int = (date.getMonth()+1);
				var yr:int  = date.getFullYear();
				
				if(dat<10)
					recordTimeStamp 	= "0"+ dat;
				else
					recordTimeStamp 	= dat.toString();
				
				if(mon<10)
					recordTimeStamp		= recordTimeStamp + "0"+ mon;
				else
					recordTimeStamp		= recordTimeStamp + mon.toString();
				
				recordTimeStamp = recordTimeStamp + yr;
				//var recordTimeStamp:String 	= date.getDate()+""+(date.getMonth()+1)+""+date.getFullYear();//new Date().toString();
				var sessionID:String		= model.LoggedInUserSessionID;
				var createdAt:String 		= recordTimeStamp;//date.getDate()+""+(date.getMonth()+1)+""+date.getFullYear();//new Date().toString();
				var createdBy:int 			= model.LoggedInUserId;
				
				/* var urlRequest:URLRequest 	= new URLRequest();
				urlRequest.url 				= Constants.DICTATION_SERVER_URL + "UploadDictationFile/"+newFileName+"/"+recordTimeStamp+"/"+sessionID+"/"+createdAt+"/"+createdBy;
				urlRequest.method 			= URLRequestMethod.POST;
			
				
				file = File.applicationStorageDirectory.resolvePath(Constants.DICTATION_FOLDER_NAME+"/"+newFileName+".wav");
				
				
				
				try {
										
					file.upload(urlRequest);
				} catch (err:*) {
					Alert.show(err.getStackTrace())	;
				} */
				var uploadPath:String = Constants.DICTATION_SERVER_URL + "UploadDictationFile/"+DictationDTO.DictationID+"/"+recordTimeStamp+"/"+sessionID+"/"+createdAt+"/"+createdBy;			
				
				
				
				var urlRequest:URLRequest = new URLRequest();
				urlRequest.url = uploadPath;
	//			urlRequest.contentType = 'multipart/form-data; boundary=' + UploadPostHelper.getBoundary();
				urlRequest.method = URLRequestMethod.POST;
				urlRequest.contentType = "application/octet-stream";
				urlRequest.data = UploadPostHelper.getPostData(DictationDTO.DictationID, sba);
				urlRequest.requestHeaders.push( new URLRequestHeader( 'Cache-Control', 'no-cache' ) );
				urlRequest.requestHeaders.push( new URLRequestHeader( 'AllowWriteStreamBuffering', 'false' ) );
				urlRequest.requestHeaders.push( new URLRequestHeader( 'SendChunked', 'true' ) );
				
				var urlLoader:URLLoader = new URLLoader();
				urlLoader.dataFormat = URLLoaderDataFormat.BINARY;
				
				urlLoader.addEventListener(Event.COMPLETE, onUploadingComplete);
				urlLoader.addEventListener(IOErrorEvent.IO_ERROR, onUploadingError);
				urlLoader.addEventListener(SecurityErrorEvent.SECURITY_ERROR, onUploadingError);
				
				urlLoader.load(urlRequest);
 
				model.dictationUploadInProcessCount--;
				
				trace("DICTATION COUNT -- " + model.dictationUploadInProcessCount);
				
				trace("FILE SENT TO SERVER ......");
				
				if( Log.isDebug() )
					logger.debug( "saveToServer--> FILE SENT TO SERVER @ " + urlRequest.url );
				
				//Fire event from here
				
				writeSyncInfo( file.name, file.nativePath, DictationDTO.DictationID, recordTimeStamp, sessionID, createdAt, createdBy );
			}
			
			protected function onUploadingComplete(event:Event):void
			{
				//file uploaded sucessfull/completed no need to keep sync info
				removeSyncInfo( file.name );
			}
			
			protected function onUploadingError(event:IOErrorEvent):void
			{
				logger.error( "dictation file upload failed. " + file.nativePath +"<br> Error Report : <br>" + event.toString() );
				model.dictationUploadInProcessCount--;
				//Error while uploading				
				//Alert.show(event.toString());
			}
			
			protected function popupgroup1_creationCompleteHandler(event:FlexEvent):void
			{
				SyncFile = new XMLFileReaderWriter("appSync/dictation.xml");
				SyncFile.read();
				if( null == SyncFile.content )
				{
					SyncFile.content = new XML(  "<dictations/>" );
					SyncFile.write();
				}
				
				init();
			}
			
			public function resultFunction(res:ResultEvent):void
			{
				Alert.show("result \n"+res.toString());
			}
			
			public function faultFunction(res:FaultEvent):void
			{
				Alert.show("fault \n"+res.toString());
			}
			
			
			
			private function writeSyncInfo(fileName:String, nativePath:String, dictationID:String, recordTimeStamp:String, sessionID:String, createdAt:String, createdBy:int ):void
			{
				var xdictation:XML 				= XmlUtils.getNodeByTagName( "dictation" );
				xdictation.@['name'] 			= fileName;
				xdictation.@['nativePath'] 		= nativePath;
				xdictation.@['ID'] 				= dictationID;
				xdictation.@['recordTimeStamp'] = recordTimeStamp;
				xdictation.@['sessionID'] 		= sessionID;
				xdictation.@['createdAt'] 		= createdAt;
				xdictation.@['createdBy'] 		= createdBy;
				
				SyncFile.append( xdictation);
				SyncFile.write();
			}
			
			private function removeSyncInfo(fileName:String):void
			{
				delete SyncFile.content.dictation.( @['name'] == fileName )[0];
				SyncFile.write();
				if( Log.isDebug() )
					logger.debug( "removeSyncInfo--> " + fileName );
			}
			
			
			
		
		]]>
	</fx:Script>
	
	
