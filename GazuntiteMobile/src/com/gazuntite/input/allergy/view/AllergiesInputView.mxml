<?xml version="1.0" encoding="utf-8"?>
<s:View xmlns:fx="http://ns.adobe.com/mxml/2009" 
		xmlns:s="library://ns.adobe.com/flex/spark" 
		title="{navModel.title}" xmlns:components="components.*" 
		gestureSwipe="onSwipe(event)"
		xmlns:navigation="com.gazuntite.common.view.navigation.*" xmlns:view="com.gazuntite.input.allergy.view.*" xmlns:component="com.gazuntite.common.view.component.*">
	<fx:Script>
		<![CDATA[
			import com.gazuntite.common.view.navigation.NavigationCallout;
			import com.gazuntite.common.viewmodel.navigation.NavigationInfo;
			import com.gazuntite.common.viewmodel.navigation.NavigationInfoItem;
			import com.gazuntite.temp.model.TempDataModel;
			
			import spark.events.IndexChangeEvent;
			import spark.transitions.SlideViewTransition;
			[Bindable]
			public var navModel:NavigationInfoItem;
			public var slide:SlideViewTransition = new SlideViewTransition();
			
			
			public override function set data(value:Object):void
			{
				super.data = value;
				navModel = value as NavigationInfoItem; 
			}
			
			protected function onSortChange(event:IndexChangeEvent):void
			{
//				trace (uiSortBar.selectedIndex);
			}
			protected function onSwipe(event:TransformGestureEvent):void
			{
				if (event.offsetX ==-1)
				{
					uiNextButton.onNextClick();
				}
				else
				{
					uiPrevButton.onPrevClick();
				}
			}
			
		]]>
	</fx:Script>
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	<s:navigationContent>
		<navigation:NavigationBackButton id="uiPrevButton" navModel="{navModel}" navigator="{navigator}"/>
	</s:navigationContent>
	<s:actionContent>
		<navigation:NavigationQuickAccessImage
			navigator="{navigator}"
			/>
		<s:Spacer width="4"/>
		<navigation:NavigationNextButton id="uiNextButton" navModel="{navModel}" navigator="{navigator}"/>
	</s:actionContent>
	<s:VGroup id="uiContainer" width="100%" gap="0" paddingLeft="4" paddingRight="4" paddingBottom="4" paddingTop="4">
		<view:AllergyItemEditView width="100%"/>
		<component:SortBar id="uiSortBar" width="100%" 
						   dataProvider="{TempDataModel.getInstance().sortSourceAllergy}"
						   change="onSortChange(event)"
						   />
		<s:List width="100%"
				dataProvider="{TempDataModel.getInstance().allergyItemList}"
				itemRenderer="com.gazuntite.input.allergy.view.AllergyItemRenderer"
				borderVisible="true" alternatingItemColors="[0xEEEEEE, 0xDFDFDF]"
				/>
	</s:VGroup>
	<s:Scroller viewport="{uiContainer}" width="100%" height="100%"/>
</s:View>
