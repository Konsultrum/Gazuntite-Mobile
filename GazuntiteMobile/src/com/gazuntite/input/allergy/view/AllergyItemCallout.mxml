<?xml version="1.0" encoding="utf-8"?>
<s:Callout xmlns:fx="http://ns.adobe.com/mxml/2009" 
		   xmlns:s="library://ns.adobe.com/flex/spark" 
		   xmlns:mx="library://ns.adobe.com/flex/mx" 
		   mouseDownOutside="onMouseDownOutside(event)" xmlns:view="com.gazuntite.input.allergy.view.*"
		   >
	<fx:Script>
		<![CDATA[
			import mx.events.FlexMouseEvent;
			
			protected function onMouseDownOutside(event:FlexMouseEvent):void
			{
				this.close();
			}
			
		]]>
	</fx:Script>
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	<s:layout>
		<s:HorizontalLayout/>
	</s:layout>
	<view:AllergyItemEditView width="100%" height="100%" showNkda="false"/>
	<s:Button  icon="@Embed('assets/images/31-circle-x.png')" click="this.close()"/>
</s:Callout>
