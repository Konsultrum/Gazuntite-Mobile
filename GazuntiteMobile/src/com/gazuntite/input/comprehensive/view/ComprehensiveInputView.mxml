<?xml version="1.0" encoding="utf-8"?>
<s:View xmlns:fx="http://ns.adobe.com/mxml/2009" 
		xmlns:s="library://ns.adobe.com/flex/spark" 
		title="{navModel.title}" xmlns:components="components.*" 
		gestureSwipe="onSwipe(event)"
		xmlns:navigation="com.gazuntite.common.view.navigation.*" xmlns:view="com.gazuntite.input.allergy.view.*" xmlns:component="com.gazuntite.common.view.component.*" xmlns:general="com.gazuntite.input.comprehensive.view.general.*" xmlns:family="com.gazuntite.input.comprehensive.view.family.*" xmlns:social="com.gazuntite.input.comprehensive.view.social.*">
	<fx:Script>
		<![CDATA[
			import com.gazuntite.common.view.navigation.NavigationCallout;
			import com.gazuntite.common.viewmodel.navigation.NavigationInfo;
			import com.gazuntite.common.viewmodel.navigation.NavigationInfoItem;
			import com.gazuntite.temp.model.TempDataModel;
			
			import spark.events.IndexChangeEvent;
			import spark.transitions.SlideViewTransition;
			[Bindable]
			public var navModel:NavigationInfoItem;
			public var slide:SlideViewTransition = new SlideViewTransition();
			
			
			public override function set data(value:Object):void
			{
				super.data = value;
				navModel = value as NavigationInfoItem; 
			}
			
			protected function onSortChange(event:IndexChangeEvent):void
			{
				//				trace (uiSortBar.selectedIndex);
			}
			protected function onSwipe(event:TransformGestureEvent):void
			{
				if (event.offsetX ==-1)
				{
					uiNextButton.onNextClick();
				}
				else
				{
					uiPrevButton.onPrevClick();
				}
			}
			
		]]>
	</fx:Script>
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	<s:navigationContent>
		<navigation:NavigationBackButton id="uiPrevButton" navModel="{navModel}" navigator="{navigator}"/>
	</s:navigationContent>
	<s:actionContent>
		<navigation:NavigationQuickAccessImage
			navigator="{navigator}"
			/>
		<s:Spacer width="4"/>
		<navigation:NavigationNextButton id="uiNextButton" navModel="{navModel}" navigator="{navigator}"/>
	</s:actionContent>
	<s:VGroup id="uiContainer" width="100%" gap="0" horizontalAlign="center" 
			  paddingLeft="4" paddingRight="4" paddingBottom="4" paddingTop="4">
		<s:HGroup width="100%" horizontalAlign="center">
			<s:Button label="General" click="uiViewStack.selectedIndex=0"/>
			<s:Button label="Family" click="uiViewStack.selectedIndex=1"/>
			<s:Button label="Social" click="uiViewStack.selectedIndex=2"/>
		</s:HGroup>
		<s:TabBar labelField="name" skinClass="com.gazuntite.input.comprehensive.skin.PinkTabBarSkin" 
				  dataProvider="{uiViewStack}"
				  visible="false" includeInLayout="false"
				  />
		
		<s:Scroller width="100%" height="100%" horizontalScrollPolicy="off" verticalScrollPolicy="auto" >
			<s:Group width="100%" height="100%">
				<s:layout>
					<s:VerticalLayout gap="0" />
				</s:layout>
				
				<s:SkinnableContainer skinClass="com.gazuntite.input.comprehensive.skin.PinkBackgroundSkin" width="100%" height="100%" >
					<component:LabelViewStack id="uiViewStack" width="100%" height="100%" backgroundAlpha="0" borderVisible="false">
						<s:ArrayList>
							<general:GeneralView name="General" width="100%" height="100%"/>
							<family:FamilyView name="Family" width="100%" height="100%"/>
							<social:SocialView name="Social" width="100%" height="100%"/>
						</s:ArrayList>
					</component:LabelViewStack>
				</s:SkinnableContainer>
				
			</s:Group>
		</s:Scroller>
	</s:VGroup>
	<s:Scroller viewport="{uiContainer}" width="100%" height="100%"/>
</s:View>
