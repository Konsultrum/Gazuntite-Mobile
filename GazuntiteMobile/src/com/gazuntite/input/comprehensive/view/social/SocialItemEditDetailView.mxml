<?xml version="1.0" encoding="utf-8"?>
<s:Group xmlns:fx="http://ns.adobe.com/mxml/2009" 
		 xmlns:s="library://ns.adobe.com/flex/spark" 
		 xmlns:mx="library://ns.adobe.com/flex/mx"
		 currentState="formTB" 		 
		 xmlns:component="com.gazuntite.view.patient.component.*" 
		 xmlns:components="com.gazuntite.controls.extended.components.*"
		 xmlns:social="com.gazuntite.view.patient.input.history.comprehensive.social.*" xmlns:social1="com.gazuntite.input.comprehensive.view.social.*" xmlns:component1="com.gazuntite.common.view.component.*"
		 >
	<fx:Script>
		<![CDATA[
			import com.gazuntite.input.main.QIConstants;
			private var currentCategory:String = "";
			private var _canInput:Boolean = true;
			
			[Bindable]
			public function get canInput():Boolean
			{
				return _canInput;
			}
			
			public function set canInput(value:Boolean):void
			{
				_canInput = value;
			}
			
			public function goNext():void
			{
				var stat:String = this.currentState;
				if(stat != "dictation")
					stat = stat.substring(0,4);
				switch (stat)
				{
					case "note":
						if(currentCategory == QIConstants.SOCIAL_WORK_STATUS_MODULE_NAME || currentCategory == QIConstants.SOCIAL_OTHER_MODULE_NAME)
							currentState = "dictation";
						else
							if(currentCategory == QIConstants.SOCIAL_TOBACCO_MODULE_NAME)
								currentState = "formTB";
							else if(currentCategory == QIConstants.SOCIAL_ALCOHOL_MODULE_NAME)
								currentState = "formAL";
							else if(currentCategory == QIConstants.SOCIAL_DRUGS_MODULE_NAME)
								currentState = "formDR";
						break;
					case "form":
						currentState = "dictation";
						break;
					case "dictation":
						if(currentCategory == QIConstants.SOCIAL_WORK_STATUS_MODULE_NAME || currentCategory == QIConstants.SOCIAL_OTHER_MODULE_NAME)
						{
							if(currentCategory == QIConstants.SOCIAL_WORK_STATUS_MODULE_NAME)
								currentState = "noteWS";
							else
								currentState = "noteOT";
						}
						else
						{
							if(currentCategory == QIConstants.SOCIAL_TOBACCO_MODULE_NAME)
								currentState = "noteTB";
							else if(currentCategory == QIConstants.SOCIAL_ALCOHOL_MODULE_NAME)
								currentState = "noteAL";
							else if(currentCategory == QIConstants.SOCIAL_DRUGS_MODULE_NAME)
								currentState = "noteDR";
						}
						break;
				}
			}
			
			public function goPrev():void
			{
				var stat:String = this.currentState;
				if(stat != "dictation")
					stat = stat.substring(0,4);
				switch (stat)
				{
					case "note":
						currentState = "dictation";
						break;
					case "form":
						if(currentCategory == QIConstants.SOCIAL_TOBACCO_MODULE_NAME)
							currentState = "noteTB";
						else if(currentCategory == QIConstants.SOCIAL_ALCOHOL_MODULE_NAME)
							currentState = "noteAL";
						else if(currentCategory == QIConstants.SOCIAL_DRUGS_MODULE_NAME)
							currentState = "noteDR";
						break;
					case "dictation":
						if(currentCategory == QIConstants.SOCIAL_WORK_STATUS_MODULE_NAME || currentCategory == QIConstants.SOCIAL_OTHER_MODULE_NAME)
						{
							if(currentCategory == QIConstants.SOCIAL_WORK_STATUS_MODULE_NAME)
								currentState = "noteWS";
							else
								currentState = "noteOT";
						}
						else
							if(currentCategory == QIConstants.SOCIAL_TOBACCO_MODULE_NAME)
								currentState = "formTB";
							else if(currentCategory == QIConstants.SOCIAL_ALCOHOL_MODULE_NAME)
								currentState = "formAL";
							else if(currentCategory == QIConstants.SOCIAL_DRUGS_MODULE_NAME)
								currentState = "formDR";
						break;
				}
			}
		]]>
	</fx:Script>
	<s:layout>
		<s:VerticalLayout horizontalAlign="right" paddingTop="4" paddingRight="4" gap="0"/>
	</s:layout>
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	<s:states>
		<s:State name="none"/>
		<s:State name="noData"/>
		<s:State name="unKnown"/>
		<s:State name="noteWS"/>
		<s:State name="noteOT"/>
		<s:State name="noteTB"/>
		<s:State name="noteAL"/>
		<s:State name="noteDR"/>
		<s:State name="formTB"/>
		<s:State name="formAL"/>
		<s:State name="formDR"/>
		<s:State name="dictation"/>
		<s:State name="marital"/>
	</s:states>
	<s:HGroup width="100%" horizontalAlign="right" verticalAlign="middle" paddingRight="4" gap="4" >
		<s:HGroup  width="200" height="20" visible="{canInput}" verticalAlign="middle">
<!--			<s:Rect x="0" y="0" width="120" height="20" radiusX="10">
				<s:fill>
					<s:LinearGradient rotation="90">
						<s:GradientEntry alpha="1.0" color="#9E9E9E" ratio="0"/>
						<s:GradientEntry alpha="1.0" color="#5E5E5E" ratio="0.4980392156862745"/>
						<s:GradientEntry alpha="1.0" color="#474747" ratio="0.5019607843137255"/>
						<s:GradientEntry alpha="1.0" color="#3A3B3B" ratio="1"/>
					</s:LinearGradient>
				</s:fill>
				<s:filters>
					<s:DropShadowFilter alpha="0.5" angle="90" blurX="0" blurY="0" color="#FFFFFF" distance="1" hideObject="false" inner="false" knockout="false" quality="3" strength="1"/>
					<s:DropShadowFilter alpha="1" angle="90" blurX="2" blurY="2" color="#000000"
										distance="1" hideObject="false" inner="true" knockout="false"
										quality="3" strength="1"/>
				</s:filters>
			</s:Rect>
-->			
			<s:Button label="Prev"
					  verticalCenter="0" useHandCursor="true" buttonMode="true" toolTip="Previous"
					  click="goPrev()"
					  />
			<s:Label text="NOTES" includeIn="noteWS" horizontalCenter="0" verticalCenter="0" fontFamily="CalibriCFF" fontWeight="bold" color="#FFFFFF" fontSize="14"/>
			<s:Label text="NOTES" includeIn="noteOT" horizontalCenter="0" verticalCenter="0" fontFamily="CalibriCFF" fontWeight="bold" color="#FFFFFF" fontSize="14"/>
			<s:Label text="NOTES" includeIn="noteTB" horizontalCenter="0" verticalCenter="0" fontFamily="CalibriCFF" fontWeight="bold" color="#FFFFFF" fontSize="14"/>
			<s:Label text="NOTES" includeIn="noteAL" horizontalCenter="0" verticalCenter="0" fontFamily="CalibriCFF" fontWeight="bold" color="#FFFFFF" fontSize="14"/>
			<s:Label text="NOTES" includeIn="noteDR" horizontalCenter="0" verticalCenter="0" fontFamily="CalibriCFF" fontWeight="bold" color="#FFFFFF" fontSize="14"/>
			<s:Label text="FORM" includeIn="formTB" horizontalCenter="0" verticalCenter="0" fontFamily="CalibriCFF" fontWeight="bold" color="#FFFFFF" fontSize="14"/>
			<s:Label text="FORM" includeIn="formAL" horizontalCenter="0" verticalCenter="0" fontFamily="CalibriCFF" fontWeight="bold" color="#FFFFFF" fontSize="14"/>
			<s:Label text="FORM" includeIn="formDR" horizontalCenter="0" verticalCenter="0" fontFamily="CalibriCFF" fontWeight="bold" color="#FFFFFF" fontSize="14"/>
			<s:Label text="DICTATION" includeIn="dictation" horizontalCenter="0" verticalCenter="0" fontFamily="CalibriCFF" fontWeight="bold" color="#FFFFFF" fontSize="14"/>
			<s:Button label="Next"
					  verticalCenter="0" useHandCursor="true" buttonMode="true" toolTip="Next"
					  click="goNext()"
					  />
		</s:HGroup>
		
		<s:Button label="Save" useHandCursor="true" buttonMode="true"
				  
				  />
		<s:Button
			skinClass="com.gazuntite.common.view.skin.NextButtonSkin"
			toolTip="Next"
			buttonMode="true" useHandCursor="true"
			visible="false" includeInLayout="false"
			/>
	</s:HGroup>
	
	<s:VGroup width="100%" height="100%" verticalAlign="middle" horizontalAlign="right"
			  paddingLeft="4" paddingRight="4" paddingTop="4" paddingBottom="4"
			  visible="{!canInput}"  includeIn="noData,none"
			  >
		<s:BorderContainer width="100%" height="100%" cornerRadius="3" backgroundColor="0xD0DEF6"  borderColor="#5A5A5A" borderWeight="1">
			<s:Label  text="None" fontSize="18" fontWeight="bold" fontFamily="CalibriCFF" horizontalCenter="0" verticalCenter="0"/>
		</s:BorderContainer>
	</s:VGroup>
	
	<s:VGroup width="100%" height="100%" verticalAlign="middle" horizontalAlign="right"
			  paddingLeft="4" paddingRight="4" paddingTop="4" paddingBottom="4"
			  visible="{!canInput}"  includeIn="unKnown"
			  >
		<s:BorderContainer width="100%" height="100%" cornerRadius="3" backgroundColor="0xD0DEF6"  borderColor="#5A5A5A" borderWeight="1">
			<s:Label  text="You have selected Unknown" fontSize="18" fontWeight="bold" fontFamily="CalibriCFF" horizontalCenter="0" verticalCenter="0"/>
		</s:BorderContainer>
	</s:VGroup>
	
	<s:VGroup width="100%" height="100%" verticalAlign="middle" horizontalAlign="right"
			  paddingLeft="4" paddingRight="4" paddingTop="4" paddingBottom="4"
			  visible="{!canInput}"  includeIn="marital"
			  >
		<s:BorderContainer width="100%" height="100%" cornerRadius="3" backgroundColor="0xD0DEF6"  borderColor="#5A5A5A" borderWeight="1">
			<s:Label  text="{'You have selected '}" fontSize="18" fontWeight="bold" fontFamily="CalibriCFF" horizontalCenter="0" verticalCenter="0"/>
		</s:BorderContainer>
	</s:VGroup>	
	<s:VGroup width="100%" height="100%" 
			  paddingLeft="4" paddingRight="4" paddingTop="4" paddingBottom="4"
			  visible="{canInput}" includeIn="noteTB"
			  >
		<s:TextArea id="id_TextTobacco" 
								  width="100%" height="100%" 
								  prompt="Notes"
								  />
		
	</s:VGroup>
	<s:VGroup width="100%" height="100%" 
			  paddingLeft="4" paddingRight="4" paddingTop="4" paddingBottom="4"
			  visible="{canInput}" includeIn="noteAL"
			  >
		<s:TextArea id="id_TextAlcohol" 
								  width="100%" height="100%" 
								  prompt="Notes"
								  />
		
	</s:VGroup>
	<s:VGroup width="100%" height="100%" 
			  paddingLeft="4" paddingRight="4" paddingTop="4" paddingBottom="4"
			  visible="{canInput}" includeIn="noteDR"
			  >
		<s:TextArea id="id_TextDrugs" 
								  width="100%" height="100%" 
								  prompt="Notes"
								  />
		
	</s:VGroup>
	<s:VGroup width="100%" height="100%" 
			  paddingLeft="4" paddingRight="4" paddingTop="4" paddingBottom="4"
			  visible="{canInput}" includeIn="noteWS"
			  >
		<s:TextArea id="id_TextAreaWoekStatus" 
								  width="100%" height="100%" 
