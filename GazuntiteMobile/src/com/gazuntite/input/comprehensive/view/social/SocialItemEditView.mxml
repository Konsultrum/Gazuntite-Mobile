<?xml version="1.0" encoding="utf-8"?>
<s:SkinnableContainer xmlns:fx="http://ns.adobe.com/mxml/2009" 
					  xmlns:s="library://ns.adobe.com/flex/spark" 
					  xmlns:mx="library://ns.adobe.com/flex/mx" 
					  xmlns:components="com.gazuntite.controls.extended.components.*" 
					  xmlns:comprehensive="com.gazuntite.view.patient.input.history.comprehensive.*" 
					  xmlns:component="com.gazuntite.view.patient.component.*" 
					  xmlns:general="com.gazuntite.view.patient.input.history.comprehensive.general.*" 
					  xmlns:family="com.gazuntite.view.patient.input.history.comprehensive.family.*" 
					  xmlns:social="com.gazuntite.view.patient.input.history.comprehensive.social.*"
					  xmlns:component1="com.gazuntite.input.comprehensive.view.component.*" xmlns:social1="com.gazuntite.input.comprehensive.view.social.*"
					  >
	<fx:Script>
		<![CDATA[
			[Bindable]
			public var canInput:Boolean = true;
		]]>
	</fx:Script>
	<s:layout>
		<s:HorizontalLayout
			gap="-2" horizontalAlign="left"
			paddingLeft="4" paddingRight="4" paddingTop="4" paddingBottom="4"
			/>
	</s:layout>
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	<s:VGroup	gap="0"	width="204"	>
		<component1:SideTabTobaccoButton id="id_tobacco" label="Tobacco" width="100%"
										/>
		<component1:SideTabTobaccoButton id="id_alcohol" label="Alcohol" width="100%"
										/>
		<component1:SideTabTobaccoButton id="id_drugs" label="Drugs" width="100%"
										/>
		<component1:SideTabWorkOtherButton id="id_work" label="Work Status" width="100%"
										  />
		<component1:SideTabMaritalButton id="id_marital" label="Marital" width="100%"
										/>
		<component1:SideTabWorkOtherButton id="id_other" label="Other" width="100%"
										  />
	</s:VGroup>
	
	<s:SkinnableContainer width="100%" minHeight="200"
						  skinClass="com.gazuntite.input.comprehensive.skin.GreyBackgroundSkin" >
		<s:layout>
			<s:VerticalLayout horizontalAlign="center" verticalAlign="middle"  />
		</s:layout>
		
		<social1:SocialItemEditDetailView id="id_Social" width="100%" height="100%" canInput="{canInput}" />
	</s:SkinnableContainer>
	
</s:SkinnableContainer>