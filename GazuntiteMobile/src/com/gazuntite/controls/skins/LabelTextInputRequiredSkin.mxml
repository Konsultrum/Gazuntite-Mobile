<?xml version="1.0" encoding="utf-8"?>
<s:SparkSkin 
	xmlns:fx="http://ns.adobe.com/mxml/2009"
	xmlns:s="library://ns.adobe.com/flex/spark"
	>

	<!--
	////////////////////////////////////////////////////////////////////////////
	//
	//	Metadata
	//
	////////////////////////////////////////////////////////////////////////////
	-->

	<fx:Metadata>
	<![CDATA[
		 
		[HostComponent("com.gazuntite.controls.extended.components.LabelTextInput")]
    	
	]]>
	</fx:Metadata>
	<fx:Style>
		
		@namespace s "library://ns.adobe.com/flex/spark";
		@namespace mx "library://ns.adobe.com/flex/mx";
		@namespace zig "com.adobe.Quivus.view.controls.extended.components.*";
		
		@font-face
		{
			fontFamily: "Calibri Bold";
			src: url("assets/fonts/CALIBRIB.TTF");
			embedAsCFF: true;
		}
		@font-face
		{
			fontFamily: CalibriBold;
			src: url("assets/fonts/CALIBRIB.TTF");
			embedAsCFF: true;
		}
	</fx:Style>

	<!--
	////////////////////////////////////////////////////////////////////////////
	//
	//	States
	//
	////////////////////////////////////////////////////////////////////////////
	-->

	<s:states>
		<s:State name="normal"/><s:State name="normalWithPrompt"/>
		<s:State name="disabled"/><s:State name="disabledWithPrompt"/>
	</s:states>

	<!--
	////////////////////////////////////////////////////////////////////////////
	//
	//	Graphics
	//
	////////////////////////////////////////////////////////////////////////////
	-->

	<!-- border -->
	<s:Rect 
		id = "id_border"
		bottom="0"
		left="0"
		right="0"
		top="0"
		>
		<s:stroke>
			<s:SolidColorStroke id="outline" weight="1" color="#444444" alpha="0.9"/>
		</s:stroke>
		<!--<s:stroke>
			
			<s:LinearGradientStroke 
				
				weight="1"
				>
				<s:GradientEntry 
					color="0x000000"
					alpha="0.0"
					/>
				<s:GradientEntry 
					color="0x000000"
					alpha="0.0"
					/>
				<s:SolidColor 
					id="bdrFill"
					color="0x000000"
					/>
			</s:LinearGradientStroke>
		</s:stroke>-->
	</s:Rect>

	<!-- fill -->
	<s:Rect 
		id="background"
		bottom="1"
		left="1"
		right="1"
		top="1"
		>
		<s:fill>
			<!--- Defines the background fill color. -->
			<s:SolidColor 
				id="bgFill"
				color="0xEDDA8C"
				/>
		</s:fill>
	</s:Rect>

	<!-- shadow -->
	<s:Rect 
		height="1"
		left="1"
		right="1"
		top="1"
		>
		<s:fill>
			<s:SolidColor 
				color="0x000000"
				alpha="0.12"
				/>
		</s:fill>
	</s:Rect>

	<!--
	////////////////////////////////////////////////////////////////////////////
	//
	//	Components
	//
	////////////////////////////////////////////////////////////////////////////
	-->

	<!-- text -->
	<s:RichEditableText 
		id="textDisplay"
		bottom="1"
		left="1"
		paddingBottom="3"
		paddingLeft="3"
		paddingRight="3"
		paddingTop="5"
		right="1"
		top="1"
		fontFamily="Calibri"
		fontWeight="bold"
		focusRect="false"
		focusThickness="0"
		color="#000000"
		
		focusIn="{textDisplay.selectRange(0,textDisplay.text.length) }"
		/>

	<!-- prompt -->
	<s:Label 
		id="promptView"
		bottom="1"
		color="#666666"
		fontStyle="normal"
		left="1"
		paddingBottom="3"
		paddingLeft="3"
		paddingRight="3"
		paddingTop="5"
		right="1"
		top="1"
		fontFamily="Calibri Bold"
		
		/>

</s:SparkSkin>
