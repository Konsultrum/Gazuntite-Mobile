			</s:LinearGradient>
		</s:fill>
	</s:Rect>
	<s:Rect height="12" includeIn="disabledAndSelected,down,downAndSelected,over,overAndSelected,up,upAndSelected" width="16" y="0.5" visible.up="false" x="0.5">
		<s:stroke>
			<s:SolidColorStroke caps="none" color="#949494" joints="miter" miterLimit="4" weight="1"/>
