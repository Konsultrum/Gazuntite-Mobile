<?xml version="1.0" encoding="utf-8"?>
<s:SparkSkin 
	xmlns:fx="http://ns.adobe.com/mxml/2009"
	xmlns:s="library://ns.adobe.com/flex/spark" alpha.disabled=".5" alpha.disabledWithPrompt="0.5"
	>

	<!--
	////////////////////////////////////////////////////////////////////////////
	//
	//	Metadata
	//
	////////////////////////////////////////////////////////////////////////////
	-->

	<fx:Metadata>
	<![CDATA[
		 
		[HostComponent("com.gazuntite.controls.extended.components.LabelTextInput")]
    	
	]]>
	</fx:Metadata>
	<fx:Style>
		
		@namespace s "library://ns.adobe.com/flex/spark";
		@namespace mx "library://ns.adobe.com/flex/mx";
		
		@font-face
		{
			fontFamily: "Calibri Bold";
			src: url("assets/fonts/CALIBRIB.TTF");
			embedAsCFF: true;
		}
		@font-face
		{
			fontFamily: CalibriBold;
			src: url("assets/fonts/CALIBRIB.TTF");
			embedAsCFF: true;
		}
		@font-face
		{
			fontFamily: Calibri;
			src: url("assets/fonts/CALIBRIB.TTF");
			embedAsCFF: true;
		}
	</fx:Style>

	<!--
	////////////////////////////////////////////////////////////////////////////
	//
	//	States
	//
	////////////////////////////////////////////////////////////////////////////
	-->

	<s:states>
		<s:State name="normal"/><s:State name="normalWithPrompt"/>
		<s:State name="disabled"/><s:State name="disabledWithPrompt"/>
	</s:states>

	<!--
	////////////////////////////////////////////////////////////////////////////
	//
	//	Graphics
	//
	////////////////////////////////////////////////////////////////////////////
	-->

	<!-- border -->
	<!--<s:Rect 
		id = "id_border"
		bottom="0"
		left="0"
		right="0"
		top="0"
		>
		<s:stroke>
			<s:SolidColorStroke id="outline" weight="1" color="#444444" alpha="0"/>
		</s:stroke>
		
	</s:Rect>-->

	<!-- fill -->
	<!--<s:Rect 
		id="background"
		bottom="1"
		left="1"
		right="1"
		top="1"
		radiusX="2"
		>
		
		<s:fill>
			<s:LinearGradient id="bgFill" rotation="90">
				<s:GradientEntry alpha="1" color="#FFFFFF" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#CCCCCC" ratio="0.7215686274509804"/>
				<s:GradientEntry alpha="1.0" color="#E1E1E1" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
	</s:Rect>-->
	
	
	<s:Group width="100%" alpha.disabled="0.5" >
	<s:Rect id="background" radiusX="2" width="100%"
			 height="19">
		
		<s:stroke>
			<s:SolidColorStroke caps="none" color="#7F7F7F" joints="miter" miterLimit="4" weight="1"/>
		</s:stroke>
		<s:fill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry alpha="1.0" color="#CCCCCC"  ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#F7F3F7"  ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter alpha="1" angle="90" blurX="2" blurY="2" color="0x000000" distance="1" hideObject="false" inner="true" knockout="false" quality="3" strength="1"/>
		</s:filters>
	</s:Rect>
	</s:Group>
	
	
	
	<!-- shadow -->
	<!--<s:Rect 
		height="1"
		left="1"
		right="1"
		top="1"
		>
		<s:fill>
			<s:SolidColor 
				color="0x000000"
				alpha="0"
				/>
		</s:fill>
	</s:Rect>-->

	<!--
	////////////////////////////////////////////////////////////////////////////
	//
	//	Components
	//
	////////////////////////////////////////////////////////////////////////////
	-->

	<!-- text -->
	<s:RichEditableText 
		id="textDisplay"
		bottom="1"
		left="1"
		paddingBottom="3"
		paddingLeft="3"
		paddingRight="3"
		paddingTop="5"
		right="1"
		top="1"
		fontFamily="Calibri"
		focusRect="false"
		focusThickness="0"
		color="#000000"
		fontSize = "11"
		focusIn="{textDisplay.selectRange(0,textDisplay.text.length) }"
		/>

	<!-- prompt -->
	<s:Label 
		id="promptDisplay"
		bottom="1"
		includeIn="disabledWithPrompt,normalWithPrompt"
		color="#333333"		
		left="1"
		paddingBottom="3"
		paddingLeft="3"
		paddingRight="3"
		paddingTop="5"
		right="1"
		top="1"
		fontStyle="normal"
		fontFamily="Calibri"
		fontSize = "11"
		/>

</s:SparkSkin>
