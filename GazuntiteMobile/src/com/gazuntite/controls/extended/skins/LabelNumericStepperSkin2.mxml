<?xml version="1.0" encoding="utf-8"?>
<s:SparkSkin xmlns:fx="http://ns.adobe.com/mxml/2009" xmlns:s="library://ns.adobe.com/flex/spark"
      xmlns:fb="http://ns.adobe.com/flashbuilder/2009"  minWidth="40" 
      alpha.disabled="0.5" xmlns:mx="library://ns.adobe.com/flex/mx">

    <fx:Metadata>
    <![CDATA[ 
        /** 
         * @copy spark.skins.spark.ApplicationSkin#hostComponent
         */
        [HostComponent("spark.components.NumericStepper")]
    ]]>
    </fx:Metadata> 
    
   
  
    <s:states>
        <s:State name="normal" /><s:State name="normalWithControlBar" />
        <s:State name="disabled" />
    </s:states>

	<!--<s:layout>
		<s:HorizontalLayout gap="-1" verticalAlign="middle"/>
	</s:layout>
	-->
	
		
	
	<s:HGroup id="id_bg" width="100%" paddingLeft="10" paddingRight="10" paddingTop="0" horizontalAlign="center" x="1" verticalAlign="top" height="18" minWidth="40">
		
	
	<s:TextInput id="textDisplay" height="18" fontFamily="calibri" fontSize="12" borderAlpha="0" minWidth="25"  text="1212" 
				 skinClass="spark.skins.spark.NumericStepperTextInputSkin" width="100%" textAlign="center"/>
	
	</s:HGroup>
		

	
	<s:HGroup width="100%" gap="8" verticalAlign="middle" minWidth="40" paddingTop="1">
		<s:Button id="decrementButton" rotation="0" useHandCursor="true" buttonMode="true" 
				  skinClass="com.gazuntite.controls.extended.skins.VBPMHPrevBtn" />
		<mx:Spacer width="100%" />
		<s:Button id="incrementButton" rotation="0"  useHandCursor="true" buttonMode="true"  
				  skinClass="com.gazuntite.controls.extended.skins.VBPMHNextBtn" />				
	</s:HGroup>
	
	
	
</s:SparkSkin>
