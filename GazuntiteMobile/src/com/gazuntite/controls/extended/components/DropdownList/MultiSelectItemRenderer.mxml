<?xml version="1.0" encoding="utf-8"?>
<s:ItemRenderer xmlns:fx="http://ns.adobe.com/mxml/2009" 
				xmlns:s="library://ns.adobe.com/flex/spark" 
				xmlns:mx="library://ns.adobe.com/flex/mx"
				autoDrawBackground="false"
				>
	
	<s:states>
		<s:State name="normal" /><s:State name="normalWithControlBar" />
		<s:State name="hovered" />
		<s:State name="selected" />
		<!--
		<s:State name="normalAndCaret" />
		<s:State name="normalAndShowsCaret" />
		<s:State name="hoveredAndCaret" />
		<s:State name="hoveredAndShowsCaret" />
		<s:State name="selectedAndCaret" />
		<s:State name="selectedAndShowsCaret" />-->
	</s:states>


	<s:Rect id="id_rolloutbg" height="100%" width="160" alpha="0.6">
		<s:fill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry alpha="1.0" color="#BEC4C6" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#AAAFB2" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		
		<s:stroke>
			<s:SolidColorStroke caps="none" color="#737373" joints="miter" miterLimit="4" weight="1"/>
		</s:stroke>
	</s:Rect>
	
	<s:Rect id="id_rolloverbg" height="100%" width="160" alpha="0.6" visible="false">
		<s:fill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry alpha="1" color="#FFFFFF" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#DDD5B1" ratio="1"/> 
			</s:LinearGradient>		
		</s:fill>
		<s:stroke>
			<s:SolidColorStroke caps="none" color="#737373" joints="miter" miterLimit="4" weight="1"/>
		</s:stroke>
	</s:Rect>
	
	<s:HGroup width="100%" verticalAlign="middle">
		<s:RichText id="labelDisplay"
					text=""
					textAlign="left"
					styleName="listItem"
					verticalAlign="middle"
					lineBreak="toFit"
					paddingTop="10"
					color="#000000"
					paddingBottom="10"
					color.hovered ="#000000"
					color.selected="#000000"
					fontFamily="Calibri"
					paddingLeft="10"
					paddingRight="10"
					horizontalCenter="0" verticalCenter="1">
		</s:RichText>
		
		<mx:Spacer width="100%" />
		<s:CheckBox id="checkbox" />
	</s:HGroup>
	
</s:ItemRenderer>
