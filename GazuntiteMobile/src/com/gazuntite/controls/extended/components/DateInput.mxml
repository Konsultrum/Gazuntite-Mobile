<?xml version="1.0" encoding="utf-8"?>
<s:Group xmlns:fx="http://ns.adobe.com/mxml/2009" 
		 xmlns:s="library://ns.adobe.com/flex/spark"
		 width="124" minWidth="124"
		 creationComplete="onCreated(event)"
		 >
	<fx:Script>
		<![CDATA[
			import mx.events.FlexEvent;
			import mx.events.FlexMouseEvent;
			
			import spark.components.DateSpinner;
			import spark.formatters.DateTimeFormatter;
			
			//TODO: properties to be added:
			public var yearNavigationEnabled:Boolean;
			public var IsEditAllow:Boolean;
			public var editable:Boolean;
			public var maxYear:*;
			public var minYear:*;
			public var selectableRange:*;
			public var change:*;
			public function open():void
			{
				
			}
			public var text:String;
			
			
			
			[Bindable]
			public var prompt:String = "";
			
			[Bindable]
			public var selectedDate:Date = null;
			
			[Bindable]
			protected var dateFormatter:DateTimeFormatter;
			
			protected var dateSpinner:DateSpinner;
			
			protected function onCreated(event:FlexEvent):void
			{
				dateFormatter = new DateTimeFormatter();
				dateFormatter.dateTimePattern = "MM/dd/yyyy";
				dateSpinner = new DateSpinner()
				uiPopup.popUp = dateSpinner;
				dateSpinner.addEventListener(FlexMouseEvent.MOUSE_DOWN_OUTSIDE, onClickAway);
				dateSpinner.addEventListener(Event.CHANGE, onDateChange);
				dateSpinner.addEventListener(MouseEvent.CLICK, onPopupClick);
			}
			protected function onClick(event:MouseEvent):void
			{
				uiLabel.visible = false;
				uiPopup.displayPopUp = true;
				uiPopup.popUpWidthMatchesAnchorWidth = true;
			}
			protected function onPopupClick(event:MouseEvent):void
			{
				if (selectedDate == null)
				{
					selectedDate = dateSpinner.selectedDate;
					uiPopup.displayPopUp = false;
					uiLabel.visible = true;
				}
			}
			
			protected function onDateChange(event:Event):void
			{
				selectedDate = dateSpinner.selectedDate;
			}
			protected function onClickAway(event:FlexMouseEvent):void
			{
				uiPopup.displayPopUp = false;
				uiLabel.visible = true;
			}
		]]>
	</fx:Script>
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	<s:TextInput id="uiLabel"
				 editable="false"
				 width="100%"
				 skinClass="spark.skins.mobile.TextInputSkin"
				 click="onClick(event)"
				 text="{selectedDate==null?prompt:dateFormatter.format(selectedDate)}"
				 color="{selectedDate==null?0x999999:0x0}"
				 fontStyle="{selectedDate==null?'italic':'normal'}"
				 />
	<s:Image id="uiImage"
			 source="@Embed('assets/images/visitdatecal.png')"
			 right="4" verticalCenter="-2"
			 click="onClick(event)"
			 />
	<s:PopUpAnchor id="uiPopup"
				   width="100%" height="0"
				   />
</s:Group>
