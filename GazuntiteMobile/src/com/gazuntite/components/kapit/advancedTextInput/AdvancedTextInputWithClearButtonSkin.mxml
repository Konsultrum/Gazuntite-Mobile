<?xml version="1.0" encoding="utf-8"?>
<s:SparkSkin xmlns:fx="http://ns.adobe.com/mxml/2009"
			 xmlns:s="library://ns.adobe.com/flex/spark"
			 xmlns:fb="http://ns.adobe.com/flashbuilder/2009" 
			 alpha.disabledStates="0.5" blendMode="normal"
			 minHeight="25">
	
	<fx:Metadata>
		<![CDATA[ 
		[HostComponent("spark.components.TextInput")]
		]]>
	</fx:Metadata> 
	
	<s:states>
		<s:State name="normal"/>
		<s:State name="disabled" stateGroups="disabledStates"/>
		<s:State name="normalWithPrompt" stateGroups="withPromptStates"/>
		<s:State name="disabledWithPrompt" stateGroups="disabledStates, withPromptStates"/>
	</s:states>
	
	<s:Rect left="0" right="0" top="0" bottom="0" id="border" radiusX="3">
		<s:filters>
			<s:DropShadowFilter alpha="1" angle="90" blurX="5" blurY="5" color="0x000000" distance="2" hideObject="false" inner="true" knockout="false" quality="3" strength="1"/>
		</s:filters>
		<s:stroke>
			<s:SolidColorStroke caps="none" color="#999999" joints="miter" miterLimit="4" weight="1"/>
		</s:stroke>
		<s:fill>
			<s:SolidColor color="#FFFFFF"/>
		</s:fill>
	</s:Rect>
	
	<s:RichEditableText id="textDisplay"
						verticalAlign="middle"
						widthInChars="10"
						fontFamily="CalibriCFF"
						fontStyle="normal"
						left="5" right="20" top="1" bottom="1" />
	
	<!--- Defines the Label that is used for prompt text. The includeInLayout property is false so the prompt text does not affect measurement. -->
	
	<s:Label id="promptDisplay" maxDisplayedLines="1"
			 mouseEnabled="false" mouseChildren="false"
			 includeIn="withPromptStates" 
			 verticalCenter="0" left="5" right="20"
			 fontFamily="CalibriCFF"
			 fontStyle="normal"
			 />
	
	<s:Button id="clearButton" verticalCenter="0" right="5"
			  icon="@Embed('/assets/icon-clear.png')"
			  width="12" height="12" buttonMode="true"/>
	
	<s:BitmapImage id="iconBitmapImage" width="15" height="15" verticalCenter="0" left="3" />
	
</s:SparkSkin>