<?xml version="1.0" encoding="utf-8"?>
<s:SparkSkin xmlns:fx="http://ns.adobe.com/mxml/2009" 
			 xmlns:s="library://ns.adobe.com/flex/spark"
			 xmlns:fb="http://ns.adobe.com/flashbuilder/2009"
			 alpha.disabledStates="0.5" blendMode="normal" 
			 xmlns:list="com.gazuntite.components.kapit.list.*"
			 minHeight="21"
			 >
	
	<fx:Metadata>
		<![CDATA[
		/**
		* @copy spark.skins.spark.ApplicationSkin#hostComponent
		*/
		[HostComponent("com.gazuntite.components.kapit.advancedTextInput.AdvancedTextInput")]
		]]>
	</fx:Metadata>
	
	<fx:Script>
		<![CDATA[
			
			
			override protected function updateDisplayList(unscaledWidth:Number, unscaledHeight:Number):void
			{
				var icon:Object = getStyle("icon");
				if (iconBitmapImage)
				{
					iconBitmapImage.visible = (icon != null);
					iconBitmapImage.source = icon;
				}
				
				
				super.updateDisplayList(unscaledWidth, unscaledHeight);
			}
			
		]]>
	</fx:Script>
	
	<s:states>
		<s:State name="normal"/>
		<s:State name="disabled" stateGroups="disabledStates"/>
		<s:State name="normalWithPrompt"/>
		<s:State name="disabledWithPrompt" stateGroups="disabledStates"/>
		<s:State name="open" />
	</s:states>
	
	
	<s:Rect left="0" right="0" top="0" bottom="0" id="border" radiusX="3">
		<s:filters>
			<s:DropShadowFilter alpha="1" angle="90" blurX="5" blurY="5" color="0x000000" distance="2" hideObject="false" inner="true" knockout="false" quality="3" strength="1"/>
		</s:filters>
		<s:stroke>
			<s:SolidColorStroke caps="none" color="#999999" joints="miter" miterLimit="4" weight="1"/>
		</s:stroke>
		<s:fill>
			<s:SolidColor color="#FFFFFF"/>
		</s:fill>
	</s:Rect>
	
	
	<s:HGroup top="1" bottom="1" left="1" right="1" paddingLeft="3"  verticalAlign="middle"	  gap="0">
		<s:BitmapImage id="iconBitmapImage"  verticalCenter="0"  rotation="270"/>
		<s:Group width="100%" height="100%">
			<!-- text -->
			<!--- @copy spark.components.supportClasses.SkinnableTextBase#textDisplay -->
			<s:RichEditableText id="textDisplay"
								verticalAlign="middle"
								widthInChars="10"
								left="4" right="10" verticalCenter="0"
								fontFamily="CalibriCFF" fontStyle="normal"
								/>
			
			
			<!-- prompt -->
			<!--- Defines the Label that is used for prompt text. The includeInLayout property is false so the prompt text does not affect measurement. -->
			<s:Label id="promptDisplay" 
					 maxDisplayedLines="1"
					 verticalAlign="middle"
					 mouseEnabled="false" mouseChildren="false"
					 includeIn="normalWithPrompt,disabledWithPrompt"
					 left="4" right="4" verticalCenter="0"
					 fontFamily="CalibriCFF" fontStyle="normal"
					 />
		</s:Group>
		<!-- cancel button -->
		<!--- @private -->
		<s:Group height="100%" width="20">
			<s:Button id="clearButton"
					  verticalCenter="-1" horizontalCenter="0"
					  icon="@Embed('/assets/icon-clear.png')"
					  width="12" height="12" buttonMode="true"
					  />
		</s:Group>
		<!-- rule -->
		<!--- @private -->
		<s:Rect height="100%" width="1" id="rule">
			<s:fill>
				<s:SolidColor id="ruleColor" color="0x000000" alpha="0.12" />
			</s:fill>
		</s:Rect>
		<!--
		<s:Button id="openButton" height="100%" width="18"/>
		-->
	</s:HGroup>
	
	
	<s:PopUpAnchor id="popUp"
				   displayPopUp.open="true" displayPopUp.normal="false"
				   left="0" right="0" top="20" bottom="0"
				   popUpWidthMatchesAnchorWidth="true"
				   popUpPosition="below" 
				   >
		
			<list:AdvancedList id="dropDown"
							   minHeight="30"
							   emptyString="No results"
							   borderVisible="false"
							   skinClass="com.gazuntite.components.kapit.list.AdvancedListSkin"
							   horizontalScrollPolicy="off"
							   itemRenderer="com.gazuntite.components.kapit.autoComplete.AutoCompleteDefaultItemRenderer">
				<list:layout>
					<s:VerticalLayout requestedRowCount="5" />
				</list:layout>
			</list:AdvancedList>
		
	</s:PopUpAnchor>
	
</s:SparkSkin>