<?xml version="1.0" encoding="utf-8"?>
<s:ItemRenderer xmlns:fx="http://ns.adobe.com/mxml/2009"
				xmlns:s="library://ns.adobe.com/flex/spark"
				xmlns:mx="library://ns.adobe.com/flex/mx"
				autoDrawBackground="true" width="100%" height="20"
				useHandCursor="true" buttonMode="true"
				initialize="init()"
				>
	
	<fx:Script>
		<![CDATA[
			import flashx.textLayout.conversion.TextConverter;
			
			[Bindable]	protected var tooltip:String;
			
			private function init():void
			{
				setStyle("rollOverColor", 0x73A7F8);
				setStyle("selectionColor", 0x6C8DF1);
			}
			
			override public function set data(value:Object):void
			{
				super.data = value;
				
				var r:RegExp = new RegExp("("+value.searchString+")", "gi");
				
				if (data.label)
					var s:String = data.label.replace(r, "<u><b>$1</b></u>");
				
				richText.textFlow = TextConverter.importToFlow(s, TextConverter.TEXT_FIELD_HTML_FORMAT);
				tooltip = richText.text;
			}
			
			override protected function updateDisplayList(unscaledWidth:Number,  unscaledHeight:Number):void 
			{
		//		id_Header.setStyle('backgroundColor', itemIndex % 2 ? 0xA7BEFF : 0xFFFFFF);
		//		richText.setStyle('color', itemIndex % 2 ? 0xFFFFFF : 0x000000);
				super.updateDisplayList(unscaledWidth, unscaledHeight);
			}
			private function onMouseOver():void
			{
				//id_Header.setStyle('backgroundColor', 0xFFD08F);
			}
			private function onMouseOut():void
			{
				//id_Header.setStyle('backgroundColor', itemIndex % 2 ? 0xA7BEFF : 0xFFFFFF);
			}
		]]>
	</fx:Script>
	
	<s:states>
		<s:State name="normal" />
		<s:State name="hovered" />
		<s:State name="selected" />
	</s:states>
	
	<s:RichText id="richText" 
				verticalCenter="0" width="100%"
				fontSize="12"
				color.selected="0xFFFFFF"
				color.hovered="0xFFFFFF"
				maxDisplayedLines="1"
				showTruncationTip="true" 
				toolTip="{tooltip}"
				left="5" right="5"/>
	
