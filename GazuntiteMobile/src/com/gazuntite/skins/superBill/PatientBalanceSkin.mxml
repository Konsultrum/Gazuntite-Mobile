<?xml version="1.0" encoding="utf-8"?>
<s:Skin xmlns:fx="http://ns.adobe.com/mxml/2009"
		xmlns:s="library://ns.adobe.com/flex/spark"
		xmlns:fb="http://ns.adobe.com/flashbuilder/2009"
		width="140" height="90"
		alpha.disabled="0.5"
		>

    <fx:Metadata>
    <![CDATA[ 
        [HostComponent("spark.components.SkinnableContainer")]
    ]]>
    </fx:Metadata> 
    <fx:Script>
		<![CDATA[
			[Bindable] public var patientBalance:String;
		]]>
	</fx:Script>
    <s:states>
        <s:State name="normal" />
        <s:State name="disabled" />
    </s:states>
    
	<s:Rect   left="1" right="1" top="1" bottom="1" radiusX="3">
		<s:fill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry alpha="1.0" color="#777777" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#333333" ratio="0.48627450980392156"/>
				<s:GradientEntry alpha="1.0" color="#000000" ratio="0.49411764705882355"/>
				<s:GradientEntry alpha="1.0" color="#363635" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:stroke>
			<s:SolidColorStroke caps="none" color="#000000" joints="miter" miterLimit="4" weight="1"/>
		</s:stroke>
	</s:Rect>
    
	<s:Rect height="40" radiusX="3"
			width.disabled="129"
			left.normal="5" right.normal="5" bottom.normal="5">
		<s:fill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry alpha="1.0" color="#F4B32E" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#F5B52F" ratio="0.5137254901960784"/>
				<s:GradientEntry alpha="1.0" color="#F5AA22" ratio="0.5176470588235295"/>
				<s:GradientEntry alpha="1.0" color="#F5AA22" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter alpha="0.5" angle="90" blurX="4.0" blurY="4.0" color="#000000"
								distance="4.0" hideObject="false" inner="true" knockout="false"
								quality="2" strength="1"/>
		</s:filters>
	</s:Rect>
	
	<s:RichText color="#FFFFFF" fontFamily="CalibriCFF" fontSize="15" tabStops="S0 S50"
				text="Patient Balance"
				top.normal="14" horizontalCenter.normal="0"/>
	
    <s:Group id="contentGroup" left="0" right="0" top="0" bottom="0" minWidth="0" minHeight="0">
        <s:layout>
            <s:BasicLayout/>
        </s:layout>
    </s:Group>

</s:Skin>