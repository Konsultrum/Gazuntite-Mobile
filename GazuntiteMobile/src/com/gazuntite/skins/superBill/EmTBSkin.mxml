				<s:GradientEntry alpha="1.0" color="#272D33" ratio="1"/>
			</s:LinearGradientStroke>
		</s:stroke>
		<s:stroke.disabledAndSelected>
			<s:SolidColorStroke caps="none" color="#666666" joints="miter" miterLimit="4" weight="1"/>
		</s:stroke.disabledAndSelected>
