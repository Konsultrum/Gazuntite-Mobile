			<s:LinearGradient rotation="90"
							  rotation.over="270">
				<s:GradientEntry alpha="1.0" color="#64281A" ratio="0"
								 color.disabled="#666666"/>
				<s:GradientEntry alpha="1.0" color="#C68475" ratio="1"
								 color.disabled="#999999"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter alpha="0.5" angle="90" blurX="2" blurY="2" color="0x000000"
