	<s:Rect width="40" height="19" radiusX="2"
			width.disabled="37" horizontalCenter.disabled="0" verticalCenter.disabled="0"
			visible.disabledAndSelected="false" x.disabledAndSelected="0.5"
			y.disabledAndSelected="0.5"
			width.down="37" horizontalCenter.down="0" verticalCenter.down="0"
			visible.downAndSelected="false" x.downAndSelected="0.5" y.downAndSelected="0.5"
			width.over="37" horizontalCenter.over="0" verticalCenter.over="0"
			visible.overAndSelected="false" x.overAndSelected="0.5" y.overAndSelected="0.5"
			visible.up="false" x.up="0.5" y.up="0.5"
			visible.upAndSelected="false" x.upAndSelected="0.5" y.upAndSelected="0.5">
