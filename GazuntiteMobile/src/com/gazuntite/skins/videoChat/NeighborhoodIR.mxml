<?xml version="1.0" encoding="utf-8"?>
<s:ItemRenderer xmlns:fx="http://ns.adobe.com/mxml/2009" 
				xmlns:s="library://ns.adobe.com/flex/spark" 
				xmlns:mx="library://ns.adobe.com/flex/mx" 
				autoDrawBackground="true"
				height="30%">
	
	<fx:Script>
		<![CDATA[
			
			import flashx.textLayout.events.SelectionEvent;
			
			import spark.events.IndexChangeEvent;
			/* import mx.controls.Alert;
			protected function button1_clickHandler(event:MouseEvent):void
			{
			Alert.show(	itemIndex.toString());
			} */
			
			protected function call_label_clickHandler(event:MouseEvent):void
			{
				var e :IndexChangeEvent = new IndexChangeEvent(IndexChangeEvent.CHANGE, true);
				e.newIndex = itemIndex;
				dispatchEvent(e);
			}
		]]>
	</fx:Script>
	
	
	
	<s:HGroup width="60%" height="50%">
		
		<s:HGroup height="100%" width="50%" verticalAlign="middle" horizontalAlign="left">
			<s:Label text="{data.name}" />
		</s:HGroup>
		<s:HGroup height="100%" width="50%" verticalAlign="middle" horizontalAlign="left">
			<s:Button id="call_label" label="Call" height="100%" click="call_label_clickHandler(event)"/>
		</s:HGroup>
		
		
	</s:HGroup>
</s:ItemRenderer>
