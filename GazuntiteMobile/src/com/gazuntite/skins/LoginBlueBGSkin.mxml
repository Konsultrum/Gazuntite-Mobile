<?xml version="1.0" encoding="utf-8"?>
<s:Skin xmlns:fx="http://ns.adobe.com/mxml/2009" 
		xmlns:s="library://ns.adobe.com/flex/spark" 
		xmlns:mx="library://ns.adobe.com/flex/mx">
	<!-- host component -->
	<fx:Metadata>
		[HostComponent("spark.components.SkinnableContainer")]
	</fx:Metadata>
	
	<!-- states -->
	<s:states>
		<s:State name="disabled" />
		<s:State name="normal" />
	</s:states>
	
	
	<s:Rect left="0" right="0" top="0" bottom="0" radiusX="8" radiusY="8">
		<s:fill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry alpha="1.0" color="#CBDBEF" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#889AB2" ratio="0.5"/>
				<s:GradientEntry alpha="1.0" color="#8195B0" ratio="0.5"/>
				<s:GradientEntry alpha="1.0" color="#6E84A2" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		
		<s:filters>
			<s:DropShadowFilter alpha="0.75" angle="90" color="0x000000"
								hideObject="false" inner="false" knockout="false"
								quality="3" strength="1"
								blurX="10" blurY="10" distance="10"/>
		</s:filters>
		
	</s:Rect>
	
	<s:Group id="contentGroup" right="0" left="0" top="0" bottom="0"/>
	
	
</s:Skin>
