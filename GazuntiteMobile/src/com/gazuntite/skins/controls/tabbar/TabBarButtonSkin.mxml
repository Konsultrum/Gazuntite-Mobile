<?xml version="1.0" encoding="utf-8"?>
<s:SparkButtonSkin xmlns:fx="http://ns.adobe.com/mxml/2009" 
                   xmlns:s="library://ns.adobe.com/flex/spark" 
                   xmlns:fb="http://ns.adobe.com/flashbuilder/2009"
                   minWidth="21" minHeight="21" width="86"
                   alpha.disabled="0.5">
    
    <!-- host component -->
    <fx:Metadata>
        <![CDATA[ 
        /** 
         * @copy spark.skins.spark.ApplicationSkin#hostComponent
         */
        [HostComponent("spark.components.ButtonBarButton")]
        ]]>
    </fx:Metadata>
	<fx:Script>
		<![CDATA[
			override protected function updateDisplayList(unscaledWidth:Number, unscaledHeight:Number):void
			{
				super.updateDisplayList(unscaledWidth, unscaledHeight);
				if (currentState.indexOf("Selected")>=0)
				{
					labelDisplay.text = hostComponent.label.toUpperCase();
				}
				else
				{
					labelDisplay.text = hostComponent.label;
				}
			}
		]]>
	</fx:Script>
	<s:states>
		<s:State name="up" stateGroups="unSelectedState"/>
		<s:State name="over" stateGroups="unSelectedState"/>
		<s:State name="down" stateGroups="unSelectedState"/>
		<s:State name="disabled" stateGroups="unSelectedState"/>
		<s:State name="upAndSelected" stateGroups="selectedState"/>
		<s:State name="overAndSelected" stateGroups="selectedState"/>
		<s:State name="downAndSelected" stateGroups="selectedState"/>
		<s:State name="disabledAndSelected" stateGroups="selectedState"/>
	</s:states>
	<s:Rect x="0" y="4" width="86" height="25" alpha="0.75" radiusX="4"
			visible.disabledAndSelected="false"
			visible.down="false"
			visible.downAndSelected="false"
			visible.over="false"
			visible.overAndSelected="false"
			visible.upAndSelected="false">
		<s:fill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry alpha="1.0" color="#676767" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#353535" ratio="0.4980392156862745"/>
				<s:GradientEntry alpha="1.0" color="#000000" ratio="0.5019607843137255"/>
				<s:GradientEntry alpha="1.0" color="#000000" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter alpha="0.25" angle="90" blurX="0" blurY="0" color="#FFFFFF" distance="1" hideObject="false" inner="false" knockout="false" quality="3" strength="1"/>
			<s:DropShadowFilter alpha="0.5" angle="90" blurX="1" blurY="1" color="0x000000" distance="1" hideObject="false" inner="true" knockout="false" quality="3" strength="1"/>
		</s:filters>
	</s:Rect>
	<s:Rect includeIn="disabled,disabledAndSelected,downAndSelected,overAndSelected,upAndSelected"
			x="0" y="0" width="86" height="30" radiusX="4"
			visible.disabled="false" alpha.disabled="0.75"
			x.disabledAndSelected="0" y.disabledAndSelected="1" alpha.disabledAndSelected="1"
			visible.downAndSelected="false" alpha.downAndSelected="1"
			visible.overAndSelected="false" alpha.overAndSelected="1"
			alpha.upAndSelected="1">
		<s:fill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry alpha="1.0" color="#676767" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#353535" ratio="0.4980392156862745"/>
				<s:GradientEntry alpha="1.0" color="#000000" ratio="0.5019607843137255"/>
				<s:GradientEntry alpha="1.0" color="#000000" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter alpha="0.25" angle="90" blurX="0" blurY="0" color="#FFFFFF" distance="1" hideObject="false" inner="false" knockout="false" quality="3" strength="1"/>
			<s:DropShadowFilter alpha="0.5" angle="90" blurX="1" blurY="1" color="0x000000" distance="1" hideObject="false" inner="true" knockout="false" quality="3" strength="1"/>
		</s:filters>
	</s:Rect>
	<s:Rect includeIn="over,overAndSelected,up" x="0.5" width="86" radiusX="4"
			y.over="4.5" height.over="24"
			y.overAndSelected="0.5" height.overAndSelected="29"
			visible.up="false" y.up="0.5" height.up="29">
		<s:fill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry alpha="1.0" color="#C68475" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#64281A" ratio="0.5254901960784314"/>
				<s:GradientEntry alpha="1.0" color="#491B11" ratio="0.5294117647058824"/>
				<s:GradientEntry alpha="1.0" color="#491B11" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter alpha="0.25" angle="90" blurX="0" blurY="0" color="#FFFFFF" distance="1" hideObject="false" inner="false" knockout="false" quality="3" strength="1"/>
			<s:DropShadowFilter alpha="0.5" angle="90" blurX="1" blurY="1" color="0x000000" distance="1" hideObject="false" inner="true" knockout="false" quality="3" strength="1"/>
		</s:filters>
		<s:stroke>
			<s:LinearGradientStroke caps="none" joints="miter" miterLimit="4" rotation="90" weight="1">
				<s:GradientEntry alpha="1.0" color="#333333" ratio="0"/>
				<s:GradientEntry alpha="1" color="#000000" ratio="1"/>
			</s:LinearGradientStroke>
		</s:stroke>
	</s:Rect>
	<s:Rect includeIn="down,downAndSelected,up" x="0.5" width="86" alpha="0.85" radiusX="4"
			y.down="4.5" height.down="24"
			y.downAndSelected="0.5" height.downAndSelected="29"
			visible.up="false" y.up="0.5" height.up="29">
		<s:fill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry alpha="1.0" color="#C68475" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#64281A" ratio="0.5254901960784314"/>
				<s:GradientEntry alpha="1.0" color="#491B11" ratio="0.5294117647058824"/>
				<s:GradientEntry alpha="1.0" color="#491B11" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter alpha="0.25" angle="90" blurX="0" blurY="0" color="#FFFFFF" distance="1" hideObject="false" inner="false" knockout="false" quality="3" strength="1"/>
			<s:DropShadowFilter alpha="0.89" angle="90" blurX="5" blurY="5" color="0x000000" distance="1" hideObject="false" inner="true" knockout="false" quality="3" strength="1"/>
		</s:filters>
		<s:stroke>
			<s:LinearGradientStroke caps="none" joints="miter" miterLimit="4" rotation="90" weight="1">
				<s:GradientEntry alpha="1.0" color="#333333" ratio="0"/>
				<s:GradientEntry alpha="1" color="#000000" ratio="1"/>
			</s:LinearGradientStroke>
		</s:stroke>
	</s:Rect>
	
	<s:RichText id="labelDisplay" left="2" right="2" 
				verticalCenter="0" verticalCenter.over="1"
				textAlign="center" maxDisplayedLines="1" lineBreak="toFit"
				color="#FFFFFF" 
			    
				fontFamily="CalibriCFF" 
				fontSize.unSelectedState="13"
				fontSize.selectedState="13"
				lineHeight="235%"
				tabStops.unSelectedState="S0 S50" 
				tabStops.selectedState="S0 S50 S100"
				 whiteSpaceCollapse="preserve"
				/>
</s:SparkButtonSkin>
