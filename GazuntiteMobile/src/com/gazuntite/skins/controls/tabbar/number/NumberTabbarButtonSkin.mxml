<?xml version="1.0" encoding="utf-8"?>
<s:SparkButtonSkin xmlns:fx="http://ns.adobe.com/mxml/2009"
				   xmlns:s="library://ns.adobe.com/flex/spark"
				   xmlns:fb="http://ns.adobe.com/flashbuilder/2009"
				   height="24" 
				   alpha.disabledStates="0.5"
				   creationComplete="sparkskin1_creationCompleteHandler(event)"
				   toolTip="{value_text}">
	<fx:Metadata>[HostComponent("spark.components.ButtonBarButton")]</fx:Metadata>
	
	<fx:Script>
		<![CDATA[
			import mx.events.FlexEvent;
			
			[Bindable]
			private var value_text:String = '';
			
			protected function sparkskin1_creationCompleteHandler(event:FlexEvent):void
			{
				if(hostComponent.label)
				{
					var strArray:Array		= hostComponent.label.split(',', hostComponent.label.length);
					value_text	 			= strArray[0];
					id_tabNumber.text 		= strArray[1];
					hostComponent.toolTip   = value_text;
				}
				
			}
		]]>
	</fx:Script>
	<!-- host component -->
	<s:states>
		<s:State name="up" />
		<s:State name="over" stateGroups="overStates" />
		<s:State name="down" stateGroups="downStates" />
		<s:State name="disabled" stateGroups="disabledStates" />
		<s:State name="upAndSelected" stateGroups="selectedStates, selectedUpStates" />
		<s:State name="overAndSelected" stateGroups="overStates, selectedStates" />
		<s:State name="downAndSelected" stateGroups="downStates, selectedStates" />
		<s:State name="disabledAndSelected" stateGroups="selectedUpStates, disabledStates, selectedStates" />
	</s:states>
	
	<s:HGroup  width="100%" height="100%" gap="4" verticalAlign="middle" paddingLeft="2">
		
		<s:Group width="20" height="20">
			<!-- **************************** layer 2: highlight stroke (GREY)************************************************* -->
			<s:Ellipse id="id_grey" width="20" height="20" verticalCenter="0" includeIn="up, disabled, over, down">
				<s:stroke>
					<s:SolidColorStroke caps="none" color="#000000" joints="miter" miterLimit="4" weight="1"/>
				</s:stroke>
				<s:fill>
					<s:LinearGradient rotation="270">
						<s:GradientEntry alpha="1.0" color="#4E4E4E" ratio="0"/>
						<s:GradientEntry alpha="1.0" color="#595757" ratio="0.48627450980392156"/>
						<s:GradientEntry alpha="1.0" color="#686969" ratio="0.49019607843137253"/>
						<s:GradientEntry alpha="1.0" color="#656565" ratio="1"/>
					</s:LinearGradient>
				</s:fill>
			</s:Ellipse>
			
			<!--
			<s:Rect id="id_grey" width="20" height="20" radiusX="10" verticalCenter="0" includeIn="up, disabled, over, down" >
				<s:fill>
					<s:LinearGradient rotation="270">
						<s:GradientEntry alpha="1.0" color="#4E4E4E" ratio="0"/>
						<s:GradientEntry alpha="1.0" color="#595757" ratio="0.48627450980392156"/>
						<s:GradientEntry alpha="1.0" color="#686969" ratio="0.49019607843137253"/>
						<s:GradientEntry alpha="1.0" color="#656565" ratio="1"/>
					</s:LinearGradient>
				</s:fill>
				<s:filters>
					<s:DropShadowFilter alpha="0.3" angle="90" blurX="1" blurY="1" color="#FFFFFF"
										distance="1" hideObject="false" inner="false" knockout="false"
										quality="3" strength="1"/>
					<s:DropShadowFilter alpha="0.5" angle="90" blurX="1" blurY="1" color="#FFFFFF"
										distance="1" hideObject="false" inner="true" knockout="false"
										quality="3" strength="1"/>
				</s:filters>
				<s:stroke>
					<s:LinearGradientStroke caps="none" joints="miter" miterLimit="4" rotation="90"
											weight="1">
						<s:GradientEntry alpha="1.0" color="#242223" ratio="0"/>
						<s:GradientEntry alpha="1.0" color="#080606" ratio="1"/>
					</s:LinearGradientStroke>
				</s:stroke>
			</s:Rect>
			-->
			
			<!-- *********************************************** layer 2: highlight stroke (GREEN)***************************************************** -->
			<s:Ellipse width="20" height="20" verticalCenter="0" includeIn="upAndSelected, downAndSelected, disabledAndSelected, overAndSelected">
				<s:fill>
					<s:LinearGradient rotation="270">
						<s:GradientEntry alpha="1.0" color="#33A30F" ratio="0"/>
						<s:GradientEntry alpha="1.0" color="#31A10F" ratio="0.4980392156862745"/>
						<s:GradientEntry alpha="1.0" color="#33AC1A" ratio="0.5058823529411764"/>
						<s:GradientEntry alpha="1.0" color="#34BA26" ratio="1"/>
					</s:LinearGradient>
				</s:fill>
			</s:Ellipse>
			
			<!--<s:Rect width="20" height="20" radiusX="10" verticalCenter="0" includeIn="upAndSelected, downAndSelected, disabledAndSelected, overAndSelected">
				<s:fill>
					<s:LinearGradient rotation="270">
						<s:GradientEntry alpha="1.0" color="#33A30F" ratio="0"/>
						<s:GradientEntry alpha="1.0" color="#31A10F" ratio="0.4980392156862745"/>
						<s:GradientEntry alpha="1.0" color="#33AC1A" ratio="0.5058823529411764"/>
						<s:GradientEntry alpha="1.0" color="#34BA26" ratio="1"/>
					</s:LinearGradient>
				</s:fill>
				<s:filters>
					<s:DropShadowFilter alpha="0.75" angle="90" blurX="1" blurY="1" color="#000000"
										distance="1" hideObject="false" inner="false" knockout="false"
										quality="3" strength="1"/>
					<s:DropShadowFilter alpha="0.5" angle="90" blurX="1" blurY="1" color="#FFFFFF"
										distance="1" hideObject="false" inner="true" knockout="false"
										quality="3" strength="1"/>
				</s:filters>
			</s:Rect>-->
			<s:Group width="100%" height="100%" >
				<!-- TEXT in the Button -->
				<s:RichText id="id_tabNumber" width="100%" color="#FFFFFF" fontFamily="CalibriCFF" fontSize="14" 
							tabStops="S0" horizontalCenter="0" verticalCenter="0"  textAlign="center">
				</s:RichText>
				<!-- END  TEXT in the Button -->
			</s:Group>
		</s:Group>
		
		<!-- TEXT for TAB -->
		<s:VGroup height="20" verticalAlign="middle" paddingTop="4">
			<s:Label 
				includeIn="upAndSelected, downAndSelected, disabledAndSelected, overAndSelected"
				color="#FFFFFF" fontFamily="CalibriCFFBold" fontSize="15" maxDisplayedLines="1"
				showTruncationTip="true"  typographicCase="uppercase"
				text="{value_text}" toolTip="{value_text}"/>
		</s:VGroup>
		<!-- END  TEXT for TAB -->
		
		<s:Rect right="1" width="1" height="20">
			<s:fill>
				<s:SolidColor color="#000000"/>
			</s:fill>
		</s:Rect>
	</s:HGroup>
	
</s:SparkButtonSkin>