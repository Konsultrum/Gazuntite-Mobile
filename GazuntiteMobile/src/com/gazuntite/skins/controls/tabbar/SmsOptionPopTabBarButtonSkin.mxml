<!--- 
The default skin class for Spark TabBar buttons.  

@see spark.components.TabBar
@see spark.skins.spark.TabBarSkin

@langversion 3.0
@playerversion Flash 10
@playerversion AIR 1.5
@productversion Flex 4
-->

<s:SparkButtonSkin xmlns:fx="http://ns.adobe.com/mxml/2009" 
                   xmlns:s="library://ns.adobe.com/flex/spark" 
                   xmlns:fb="http://ns.adobe.com/flashbuilder/2009"
                   minWidth="21" minHeight="21" 
                   alpha.disabled="0.5">
    
    <!-- host component -->
    <fx:Metadata>
        <![CDATA[ 
        /** 
         * @copy spark.skins.spark.ApplicationSkin#hostComponent
         */
        [HostComponent("spark.components.ButtonBarButton")]
        ]]>
    </fx:Metadata>
	<fx:Script>
		
		
		[Embed(source="assets/images/compose.png")]
		public var imgClsCompose:Class; 
		
		[Embed(source="assets/images/outbox.png")]
		public var imgClsSent:Class; 
		
		override protected function updateDisplayList(unscaledWidth:Number, unscaledHeight:Number) : void
		{
			trace(hostComponent);
			hostComponent.toolTip = hostComponent.label;
			switch(hostComponent.label)
			{
				case "Sent":
					img.source=imgClsSent;

					break;
				case "Compose":
					img.source=imgClsCompose;

					break;
			
			}
	
			
			super.updateDisplayList(unscaledWidth, unscaledHeight);
		}
		
	</fx:Script>
	
	<s:states>
		<s:State name="up" stateGroups="unSelectedState"/>
		<s:State name="over" stateGroups="unSelectedState"/>
		<s:State name="down" stateGroups="unSelectedState"/>
		<s:State name="disabled" stateGroups="unSelectedState"/>
		<s:State name="upAndSelected" stateGroups="selectedState"/>
		<s:State name="overAndSelected" stateGroups="selectedState"/>
		<s:State name="downAndSelected" stateGroups="selectedState"/>
		<s:State name="disabledAndSelected" stateGroups="selectedState"/>
	</s:states>
	<s:Rect x="0" y="0" width="30" height="30" radiusX="5"
			visible.down="false"
			visible.downAndSelected="false"
			visible.over="false"
			visible.overAndSelected="false"
			visible.upAndSelected="false">
		<s:fill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry alpha="1.0" color="#000000" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#666666" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter alpha="0.75" angle="90" blurX="2" blurY="2" color="0x000000" distance="1" hideObject="false" inner="false" knockout="false" quality="3" strength="1"/>
		</s:filters>
	</s:Rect>
	<s:Rect includeIn="disabledAndSelected,down,downAndSelected,over,overAndSelected,up,upAndSelected"
			x="0" y="0" width="30" height="30" radiusX="5"
			visible.disabledAndSelected="false"
			visible.up="false">
		<s:fill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry alpha="1.0" color="#511607" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#D58674" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter alpha="0.75" angle="90" blurX="2" blurY="2" color="0x000000" distance="1" hideObject="false" inner="false" knockout="false" quality="3" strength="1"/>
		</s:filters>
	</s:Rect>
	<s:BitmapImage x="0" y="0" smooth="true"
				   source="@Embed('/assets/images/smallbutton_transparentbg.png')"
				   visible.down="false"
				   visible.downAndSelected="false"
				   alpha.overAndSelected="0.75">
	</s:BitmapImage>
	<s:BitmapImage includeIn="down,downAndSelected" x="0" y="0" smooth="true"
				   source="@Embed('/assets/images/smallbutton_transparentbg.png')">
		<s:filters>
			<s:DropShadowFilter alpha="1" angle="90" blurX="2" blurY="2" color="#333333" distance="2"
								hideObject="false" inner="true" knockout="false" quality="3"
								strength="1"/>
		</s:filters>
	</s:BitmapImage>
	<s:BitmapImage x="5" y="7" smooth="true" id="img" >
		<s:filters>
			<s:DropShadowFilter alpha="0.5" angle="90" blurX="1" blurY="1" color="#000000"
								distance="1" hideObject="false" inner="false" knockout="false"
								quality="3" strength="1"/>
		</s:filters>
	</s:BitmapImage>
<!--	<s:RichText id="labelDisplay" horizontalCenter="0" verticalCenter="0" 
				color="#FFFFFF" 
			    textAlign="left"
				fontFamily="Calibri" 
				fontSize.unSelectedState="13"
				fontSize.selectedState="14"
				lineHeight="235%"
				tabStops.unSelectedState="S0 S50" 
				tabStops.selectedState="S0 S50 S100"
				 whiteSpaceCollapse="preserve"
				/>-->
</s:SparkButtonSkin>
