<?xml version="1.0" encoding="utf-8"?>
<s:Skin xmlns:s="library://ns.adobe.com/flex/spark"
		xmlns:fx="http://ns.adobe.com/mxml/2009"
		width="60" height="24">
	<fx:Metadata>[HostComponent("spark.components.Button")]</fx:Metadata>
	<s:states>
		<s:State name="up"/>
		<s:State name="over"/>
		<s:State name="down"/>
		<s:State name="disabled"/>
	</s:states>
	<s:Rect left="0" verticalCenter="0" width="60" height="22" radiusX="12">
		<s:fill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry alpha="1.0" color="#BAF9FF" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#72CCFF" ratio="0.4980392156862745"/>
				<s:GradientEntry alpha="1.0" color="#439299" ratio="0.5019607843137255"/>
				<s:GradientEntry alpha="1.0" color="#C4FFFF" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter alpha="0.5" angle="0" blurX="2" blurY="2" color="#000000"
								distance="2" hideObject="false" inner="false" knockout="false"
								quality="2" strength="1"/>
		</s:filters>
	</s:Rect>
</s:Skin>
