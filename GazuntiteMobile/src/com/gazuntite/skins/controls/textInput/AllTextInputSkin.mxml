<?xml version="1.0" encoding="utf-8"?>
<s:Skin xmlns:s="library://ns.adobe.com/flex/spark" xmlns:fx="http://ns.adobe.com/mxml/2009" 
		xmlns:ai="http://ns.adobe.com/ai/2009" 
		xmlns:d="http://ns.adobe.com/fxg/2008/dt" 
		xmlns:flm="http://ns.adobe.com/flame/2008"
		width="100%" minHeight="20">
	<fx:Metadata>[HostComponent("spark.components.TextInput")]</fx:Metadata>
	<s:states>
		<s:State name="normal"/>
		<s:State name="normalWithPrompt"/>
		<s:State name="disabled"/>
		<s:State name="disabledWithPrompt"/>
	</s:states>
    
	<s:Rect x="0" y="0" width="100%" height="100%" radiusX="4" radiusY="4" includeIn="normal,normalWithPrompt">
		<s:fill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry alpha="1.0" color="#FFFFFF" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#BDC0C9" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter alpha="1" angle="90" blurX="2" blurY="2" color="0x000000" distance="1" hideObject="false" inner="true" knockout="false" quality="3" strength="1"/>
			<s:DropShadowFilter alpha="0.25" angle="90" blurX="1" blurY="1" color="#FFFFFF" distance="1" hideObject="false" inner="false" knockout="false" quality="3" strength="1"/>
		</s:filters>
		<!--<s:stroke>
			<s:SolidColorStroke caps="none" color="#999999" joints="miter" miterLimit="4" weight="1"/>
		</s:stroke>-->
	</s:Rect>
    
    <s:RichEditableText id="textDisplay" 
						width="100%" 
						color="#000000" 
						columnCount="1" 
						fontFamily="CalibriCFF" 
						fontSize="14" 
						fontStyle="normal" 
						heightInLines="1"
						kerning="off" 
						lineHeight="100%"
						tabStops="S0 S50 S100 S150 S200"
						textAlign="left" 
						trackingRight="0%"
						verticalAlign="middle"
						verticalCenter="0" 
						whiteSpaceCollapse="preserve"
						right="3"	left="3"  />
    <!--- Defines the Label that is used for prompt text. The includeInLayout property is false so the prompt text does not affect measurement. -->
    <s:Label id="promptDisplay"
			 bottom="1"
			 includeIn="disabledWithPrompt,normalWithPrompt"
			 color="#333333"		
			 left="3"
			 paddingLeft="3"
			 x="10"
			 verticalAlign="middle" 
			 paddingRight="3"
			 right="1"
			 top="1"
			 fontStyle="normal"
			 fontFamily="CalibriCFF"
			 fontSize = "14"
                />

</s:Skin>
