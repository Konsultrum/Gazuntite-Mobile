<?xml version="1.0" encoding="utf-8"?>
<s:Skin xmlns:s="library://ns.adobe.com/flex/spark"
		xmlns:fx="http://ns.adobe.com/mxml/2009"
		width="100" height="20">
	<fx:Metadata>[HostComponent("spark.components.TextInput")]</fx:Metadata>
	<s:states>
		<s:State name="normal"/>
		<s:State name="disabled"/>
		<s:State name="normalWithPrompt"/>
		<s:State name="disabledWithPrompt"/>
	</s:states>
	
	<s:Rect  left="1" right="1" top="1" bottom="1" radiusX="3">
		<s:fill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry alpha="1.0" color="#AFB3BD" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#8A8E9C" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter alpha="1" angle="90" blurX="2" blurY="2" color="0x000000" distance="1" hideObject="false" inner="true" knockout="false" quality="3" strength="1"/>
			<s:DropShadowFilter alpha="0.25" angle="90" blurX="1" blurY="1" color="#FFFFFF" distance="1" hideObject="false" inner="false" knockout="false" quality="3" strength="1"/>
		</s:filters>
		<s:stroke>
			<s:SolidColorStroke caps="none" color="#999999" joints="miter" miterLimit="4" weight="1"/>
		</s:stroke>
	</s:Rect>
	
	<s:RichText id="promptDisplay" 
				includeIn="disabledWithPrompt,normalWithPrompt" 
				left="5" right="5" horizontalCenter="0"
				verticalCenter="0" color="0x000000"
				fontFamily="CalibriCFF" fontSize="13"
				textAlign="center"
				/>
	<s:RichEditableText id="textDisplay" 
						heightInLines="1" 
						left="5" right="5" horizontalCenter="0"
						verticalCenter="0" color="0x000000"
						fontFamily="CalibriCFF" fontSize="13"
						textAlign="center" 
						/>
</s:Skin>
