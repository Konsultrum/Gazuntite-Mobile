<?xml version="1.0" encoding="utf-8"?>
<s:Skin xmlns:fx="http://ns.adobe.com/mxml/2009" 
		xmlns:s="library://ns.adobe.com/flex/spark" 
		xmlns:mx="library://ns.adobe.com/flex/mx"
		width="50" height="100%">
	<!-- host component -->
	<fx:Metadata>
		[HostComponent("spark.components.BorderContainer")]
	</fx:Metadata>
	
	<!-- states -->
	<s:states>
		<s:State name="disabled" />
		<s:State name="normal" />
	</s:states>
	
	<!-- SkinParts
	name=contentGroup, type=spark.components.Group, required=false
	-->
	<s:Rect height="100%" radiusX="2" width="100%" x="0" y="0">
		<s:stroke>
			<s:SolidColorStroke caps="none" color="#424242" joints="miter" miterLimit="4" weight="1"/>
		</s:stroke>
		<s:fill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry alpha="1.0" color="#404143" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#1B1B1C" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
	</s:Rect>
	<s:BitmapImage smooth="true" source="@Embed('/assets/images/patientimg.png')" horizontalCenter="0" verticalCenter="0"/>
	
</s:Skin>
