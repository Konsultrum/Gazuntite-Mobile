<?xml version="1.0" encoding="utf-8"?>
<s:Skin xmlns:fx="http://ns.adobe.com/mxml/2009"
		xmlns:s="library://ns.adobe.com/flex/spark"
		xmlns:fb="http://ns.adobe.com/flashbuilder/2009"
		alpha.disabled="0.5" >
	
	<fx:Metadata>
		<![CDATA[ 
		[HostComponent("spark.components.SkinnableContainer")]
		]]>
	</fx:Metadata> 
	
	<s:states>
		<s:State name="normal" />
		<s:State name="disabled" />
	</s:states>
	
	<s:Rect id="id_rect" x="0" y="0" width="100%" height="100%" radiusX="5">
<!--	<s:Rect id="id_rect" x="0.5" y="7.5" width="100%" height="100%" radiusX="5">-->
		<s:fill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry alpha="1.0" color="#656565" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#333333" ratio="0.6470588235294118"/>
				<s:GradientEntry alpha="1.0" color="#090A0A" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:stroke>
			<s:LinearGradientStroke caps="none" joints="miter" miterLimit="4" rotation="90" weight="1">
				<s:GradientEntry alpha="1.0" color="#666666" ratio="0"/>
				<s:GradientEntry alpha="1" color="#000000" ratio="1"/>
			</s:LinearGradientStroke>
		</s:stroke>
		
		<s:filters>
			<s:DropShadowFilter alpha="0.75" angle="90" blurX="2" blurY="2" color="#000000"
								distance="1" hideObject="false" inner="false" knockout="false"
								quality="3" strength="1"/>
			<s:BevelFilter angle="90" blurX="1" blurY="1" distance="1" highlightAlpha="0.25"
						   highlightColor="#FFFFFF" knockout="false" quality="3" shadowAlpha="1.0"
						   shadowColor="#000000" strength="1" type="inner"/>
		</s:filters>
	</s:Rect>
	
	<!--<s:Path x="209" y="0" width="15" height="8" data="M 22.59 19.57 L 0.01 19.57 11.30 0.01 Z ">
		<s:fill>
			<s:SolidColor color="#656565"/>
		</s:fill>
	</s:Path>-->
	
	<s:Group id="contentGroup" left="0" right="0" top="0" bottom="0" minWidth="0" minHeight="0">
		<s:layout>
			<s:VerticalLayout paddingBottom="5" paddingLeft="5" paddingRight="5" paddingTop="10" gap="3"/>
		</s:layout>
		
	</s:Group>
	
</s:Skin>
