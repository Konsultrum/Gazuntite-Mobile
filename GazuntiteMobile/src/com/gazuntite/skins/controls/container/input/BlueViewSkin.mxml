<?xml version="1.0" encoding="utf-8"?>
<s:Skin xmlns:fx="http://ns.adobe.com/mxml/2009" 
		xmlns:s="library://ns.adobe.com/flex/spark" 
		xmlns:fb="http://ns.adobe.com/flashbuilder/2009" 
		alpha.disabled="0.5"
		width="100%" height="100%"
		>
	
	<fx:Metadata>
		<![CDATA[ 
		/** 
		* @copy spark.skins.spark.ApplicationSkin#hostComponent
		*/
		[HostComponent("spark.components.SkinnableContainer")]
		]]>
	</fx:Metadata> 
	
	<s:states>
		<s:State name="normal" />
		<s:State name="disabled" />
	</s:states>
	
	
	<s:Rect id="background" left="0" right="0" top="0" bottom="0" alpha="1" radiusX="3">
		<s:fill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry alpha="1.0" color="#DDE7F6" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#BFCFEA" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter alpha="0.75" angle="90" blurX="2" blurY="2" color="#000000"
								distance="1" hideObject="false" inner="false" knockout="false"
								quality="3" strength="1"/>
		</s:filters>
		<s:stroke>
			<s:LinearGradientStroke caps="round" joints="miter" miterLimit="3" rotation="90"
									weight="1">
				<s:GradientEntry alpha="1.0" color="#A5BBE1" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#7B85C1" ratio="1"/>
			</s:LinearGradientStroke>
		</s:stroke>
	</s:Rect>
	
	<s:Rect x="0.5" y="0" width="28" height="28" radiusX="3">
		<s:fill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry alpha="1" color="#FFFFFF" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#FFFFFF" ratio="0.27450980392156865"/>
				<s:GradientEntry alpha="1.0" color="#EAEBEB" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter alpha="0.5" angle="90" blurX="2" blurY="2" color="#000000"
								distance="2" hideObject="false" inner="false" knockout="false"
								quality="3" strength="1"/>
		</s:filters>
	</s:Rect>
	
	<s:Group id="contentGroup" left="0" right="0" top="0" bottom="0" minWidth="0" minHeight="0">
		<s:layout>
			<s:BasicLayout/>
		</s:layout>
	</s:Group>
	
</s:Skin>