<?xml version="1.0" encoding="utf-8"?>
<s:Skin xmlns:fx="http://ns.adobe.com/mxml/2009"
		xmlns:s="library://ns.adobe.com/flex/spark"
		xmlns:fb="http://ns.adobe.com/flashbuilder/2009"
		alpha.disabled="0.5"
		width.normal="6">

    <fx:Metadata>
    <![CDATA[ 
        /** 
         * @copy spark.skins.spark.ApplicationSkin#hostComponent
         */
        [HostComponent("spark.components.SkinnableContainer")]
    ]]>
    </fx:Metadata> 
    
    <s:states>
        <s:State name="normal" />
        <s:State name="disabled" />
    </s:states>
    
    <!--- Defines the appearance of the SkinnableContainer class's background. -->
    <s:Group id="background" left="0" right="0" top="0" bottom="0">
		<s:Path x="0" y="0" width="18" height="11" alpha="0.8"
				data="M 6.27 5.40 L 0.03 5.40 3.15 -0.01 Z " rotation="90">
			<s:filters>
				<s:DropShadowFilter alpha="1" angle="90" blurX="2" blurY="2" color="#333333" distance="1" hideObject="false" inner="true" knockout="false" quality="3" strength="1"/>
				<s:DropShadowFilter alpha="0.25" angle="90" blurX="1" blurY="1" color="#FFFFFF" distance="1" hideObject="false" inner="false" knockout="false" quality="3" strength="1"/>
			</s:filters>
			<s:fill>
				<s:LinearGradient rotation="0">
					<s:GradientEntry alpha="1.0" color="#CCCCCC" ratio="0"/>
					<s:GradientEntry alpha="1.0" color="#CCCCCC" ratio="0.4980392156862745"/>
					<s:GradientEntry alpha="1.0" color="#666666" ratio="0.5019607843137255"/>
					<s:GradientEntry alpha="1.0" color="#CCCCCC" ratio="1"/>
				</s:LinearGradient>
			</s:fill>
		</s:Path>
    </s:Group>
    
    <!--- @copy spark.components.SkinnableContainer#contentGroup -->
    <s:Group id="contentGroup" left="0" right="0" top="0" bottom="0" minWidth="0" minHeight="0">
        <s:layout>
            <s:BasicLayout/>
        </s:layout>
    </s:Group>

</s:Skin>
