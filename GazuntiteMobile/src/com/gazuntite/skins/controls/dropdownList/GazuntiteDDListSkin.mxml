<?xml version="1.0" encoding="utf-8"?>
<s:SparkSkin xmlns:fx="http://ns.adobe.com/mxml/2009" 
			 xmlns:s="library://ns.adobe.com/flex/spark" 
			 xmlns:fb="http://ns.adobe.com/flashbuilder/2009" 
			 alpha.disabled=".5" xmlns:mx="library://ns.adobe.com/flex/mx"
			 minHeight="20" width="100%" height="100%"
			 creationComplete="sparkskin1_creationCompleteHandler(event)"
			 > 
	
	<fx:Metadata>
		<![CDATA[ 
		[HostComponent("spark.components.DropDownList")]
		]]>
	</fx:Metadata> 
	<fx:Script>
		<![CDATA[
			import mx.events.FlexEvent;
			
			protected function sparkskin1_creationCompleteHandler(event:FlexEvent):void
			{
				if(hostComponent)
				{
					hostComponent.useHandCursor = true;
					hostComponent.buttonMode 	= true;
				}
			}
		]]>
	</fx:Script>
	
	<s:states>
		<s:State name="normal" />
		<s:State name="open" />
		<s:State name="disabled" />
	</s:states>
	
	<s:Rect  left="0" right="0" top="0" bottom="0" radiusX="3">
		<s:fill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry alpha="1.0" color="#E2E3E3" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#C1C2C2" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter alpha="0.75" angle="90" blurX="1" blurY="1" color="#000000"
								distance="1" hideObject="false" inner="false" knockout="false"
								quality="3" strength="1"/>
		</s:filters>
	</s:Rect>
	
	<s:PopUpAnchor id="popUp"  
				   displayPopUp.normal="false" displayPopUp.open="true" includeIn="open"
				   left="0" right="0" top="0" bottom="0" itemDestructionPolicy="auto"
				   popUpPosition="below" popUpWidthMatchesAnchorWidth="true">
		
		<s:Group id="dropDown">
			<s:filters>
				<s:DropShadowFilter alpha="1" angle="90" blurX="4" blurY="4" color="#000000"
									distance="3" hideObject="false" inner="false" knockout="false"
									quality="3" strength="1"/>
			</s:filters>
			
			
			<s:Rect id="background" left="1" right="1" top="1" bottom="1" radiusX="3">
				<s:filters>
					<s:DropShadowFilter alpha="1" angle="90" blurX="4" blurY="4" color="#000000"
										distance="2" hideObject="false" inner="false" knockout="false"
										quality="3" strength="1"/>
				</s:filters>
				<s:fill>
					<s:SolidColor color="#FFFFFF"/>
				</s:fill>
			</s:Rect>
			
			<s:Scroller id="scroller"
						skinClass="com.gazuntite.skins.controls.list.InvisibleScrollerSkin"
						left="0" top="0" right="0" bottom="0" hasFocusableChildren="false" minViewportInset="1" >
				<s:DataGroup id="dataGroup" itemRenderer="spark.skins.spark.DefaultItemRenderer" >
					<s:layout>
						<s:VerticalLayout gap="0" horizontalAlign="contentJustify" requestedMinRowCount="1" requestedMaxRowCount="6"
										  paddingBottom="2" paddingLeft="2" paddingRight="2" paddingTop="-3"/>
					</s:layout>
				</s:DataGroup> 
			</s:Scroller>
		</s:Group>
	</s:PopUpAnchor>
	
	<s:Button id="openButton"
			  right="0" top="0" bottom="0" 
			  buttonMode="true" useHandCursor="true"
			  focusEnabled="false"
			  tabEnabled="false"
			  skinClass="com.gazuntite.skins.controls.combobox.StepperComboOpenButtonSkin"
			  />  
	
	<s:Label id="labelDisplay" 
			 verticalAlign="middle" 
			 maxDisplayedLines="1" 
			 mouseEnabled="false" 
			 mouseChildren="false"
			 left="2" right="20" top="2" bottom="2"
			 width="100%" 
			 verticalCenter="1" 
			 fontFamily="CalibriCFF"
			 showTruncationTip="true"
			 /> 
</s:SparkSkin>