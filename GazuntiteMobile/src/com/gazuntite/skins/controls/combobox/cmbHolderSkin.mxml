<?xml version="1.0" encoding="utf-8"?>
<s:SparkSkin xmlns:fx="http://ns.adobe.com/mxml/2009" xmlns:s="library://ns.adobe.com/flex/spark" 
        xmlns:fb="http://ns.adobe.com/flashbuilder/2009" alpha.disabled=".5"> 
    
    <!-- host component -->
    <fx:Metadata>
        <![CDATA[ 
        /** 
        * @copy spark.skins.spark.ApplicationSkin#hostComponent
        */
        [HostComponent("spark.components.ComboBox")]
        ]]>
    </fx:Metadata> 

	<s:states>
        <s:State name="normal" />
        <s:State name="open" />
        <s:State name="disabled" />
    </s:states>
    
    <s:PopUpAnchor id="popUp"  displayPopUp.normal="false" displayPopUp.open="true" includeIn="open"
                   left="0" right="0" top="0" bottom="0" itemDestructionPolicy="auto"
                   popUpPosition="below" popUpWidthMatchesAnchorWidth="true">
        
        <s:Group id="dropDown">
            
            <s:Rect id="background" left="1" right="1" top="1" bottom="1" radiusX="3">
				<s:filters>
					<s:DropShadowFilter alpha="1" angle="90" blurX="4" blurY="4" color="#000000"
										distance="2" hideObject="false" inner="false" knockout="false"
										quality="3" strength="1"/>
				</s:filters>
				<s:fill>
					<s:SolidColor color="#FFFFFF"/>
				</s:fill>
            </s:Rect>
            
            <!--- @private -->
            <s:Scroller id="scroller" left="3" top="3" right="3" bottom="3" hasFocusableChildren="false" minViewportInset="1"
						skinClass="com.gazuntite.skins.controls.list.InvisibleScrollerSkin">
                <!--- @copy spark.components.SkinnableDataContainer#dataGroup-->
                <s:DataGroup id="dataGroup" itemRenderer="spark.skins.spark.DefaultItemRenderer">
                    <s:layout>
                        <s:VerticalLayout gap="0" horizontalAlign="contentJustify" requestedMinRowCount="1" requestedMaxRowCount="6"  paddingTop="-3" />
                    </s:layout>
                </s:DataGroup> 
            </s:Scroller>
        </s:Group>
    </s:PopUpAnchor>
    
    <s:Button id="openButton" width="19" right="0" top="0" bottom="0" focusEnabled="false"
              skinClass="spark.skins.spark.ComboBoxButtonSkin" tabEnabled="false" visible="false" includeInLayout="false"/>  
   
    <s:TextInput id="textInput" enabled.disabled="false"
                 left="0" right="18" top="0" bottom="0" 
                 skinClass="spark.skins.spark.ComboBoxTextInputSkin" visible="false" includeInLayout="false"/> 
    
</s:SparkSkin>

