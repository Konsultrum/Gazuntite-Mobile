<?xml version="1.0" encoding="utf-8"?>
<s:Skin xmlns:s="library://ns.adobe.com/flex/spark"
		xmlns:fx="http://ns.adobe.com/mxml/2009"
		width="53" height="18">
	<fx:Metadata>[HostComponent("spark.components.RadioButton")]</fx:Metadata>
	<s:states>
		<s:State name="up"/>
		<s:State name="over"/>
		<s:State name="down"/>
		<s:State name="disabled"/>
		<s:State name="upAndSelected"/>
		<s:State name="overAndSelected"/>
		<s:State name="downAndSelected"/>
		<s:State name="disabledAndSelected"/>
	</s:states>
	<s:RichText horizontalCenter="0" verticalCenter="0" color="#FFFFFF" fontFamily="Calibri" fontSize="13" fontWeight="bold"
				lineHeight="0" paddingBottom="0" paddingLeft="0" paddingRight="0" paddingTop="0"
				tabStops="S0" text="Chronic" trackingRight="1%"
				visible.disabled="false"
				visible.down="false"
				visible.over="false"
				visible.up="false">
		<s:filters>
			<s:DropShadowFilter alpha="0.5" angle="90" blurX="1" blurY="1" color="#000000"
								distance="1" hideObject="false" inner="false" knockout="false"
								quality="3" strength="1"/>
		</s:filters>
	</s:RichText>
	<s:Rect x="0" y="0" width="100%" height="100%" radiusX="2"
			visible.disabledAndSelected="false"
			visible.downAndSelected="false"
			visible.overAndSelected="false"
			visible.upAndSelected="false">
		<s:fill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry alpha="1.0" color="#D6D6D6" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#FCFCFC" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter alpha="0.5" angle="90" blurX="0" blurY="0" color="#FFFFFF"
								distance="1" hideObject="false" inner="true" knockout="false"
								quality="3" strength="1"/>
		</s:filters>
	</s:Rect>
	<s:RichText horizontalCenter="0" verticalCenter="0" color="#999999" fontFamily="Calibri" fontSize="12" lineHeight="0"
				paddingBottom="0" paddingLeft="0" paddingRight="0" paddingTop="0" tabStops="S0"
				text="Chronic" trackingRight="1%"
				visible.disabledAndSelected="false"
				visible.downAndSelected="false"
				visible.overAndSelected="false"
				visible.upAndSelected="false"/>
</s:Skin>
