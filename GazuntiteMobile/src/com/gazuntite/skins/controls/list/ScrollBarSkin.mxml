<!--- The default skin class for the Spark VScrollBar component. The thumb and track skins are defined by the
VScrollBarThumbSkin and VScrollBarTrackSkin classes, respectively.  

@langversion 3.0
@playerversion Flash 10
@playerversion AIR 1.5
@productversion Flex 4
-->
<s:SparkSkin xmlns:fx="http://ns.adobe.com/mxml/2009" xmlns:s="library://ns.adobe.com/flex/spark"
			 xmlns:fb="http://ns.adobe.com/flashbuilder/2009" minWidth="15" minHeight="35" 
			 alpha.disabled="0.5" alpha.inactive="0.5">
	
	<fx:Metadata>
		<![CDATA[ 
		/** 
		* @copy spark.skins.spark.ApplicationSkin#hostComponent
		*/
		[HostComponent("spark.components.VScrollBar")]
		]]>
	</fx:Metadata> 
	
	<fx:Script fb:purpose="styling">
		/* Define the skin elements that should not be colorized. 
		For scroll bar, the skin itself is colorized but the individual parts are not. */
		static private const exclusions:Array = ["track", "thumb", "decrementButton", "incrementButton"];
		
		/**
		 * @private
		 */
		override public function get colorizeExclusions():Array {return exclusions;}
		
		/**
		 * @private
		 */
		override protected function initializationComplete():void
		{
			this.useChromeColor=true;
			//useBaseColor = true;
			super.initializationComplete();
		}
	</fx:Script>
	
	<s:states>
		<s:State name="normal" />
		<s:State name="disabled" />
		<s:State name="inactive" />
	</s:states>
	
	<!-- bg -->
	<s:Rect height="100%" radiusX="8" width="15" top="2" bottom="2" >
		<s:fill>
			<s:SolidColor color="#FFFFFF"/>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter alpha="0.5" angle="90" blurX="2" blurY="2" color="0x000000" distance="0" hideObject="false" inner="false" knockout="false" quality="2" strength="1"/>
		</s:filters>
	</s:Rect>
	
	<s:Button id="track" top="23" bottom="23" 
			  focusEnabled="false" tabEnabled="false"
			  skinClass="com.gazuntite.skins.controls.list.VScrollBarTrackSkin" />
	
	<s:Button id="thumb" left="0.5"
			  focusEnabled="false" visible.inactive="false" tabEnabled="false"
			  skinClass="com.gazuntite.skins.controls.list.VScrollBarThumbSkin" />
	
	<s:Button id="decrementButton" top="2" left="0" width="100%" enabled.inactive="false"
			  focusEnabled="false" 
			  skinClass="com.gazuntite.skins.controls.list.ScrollBarUpButtonSkin" />

	<s:Button id="incrementButton" bottom="2" left="0" width="100%" enabled.inactive="false"
			  focusEnabled="false" 
			  skinClass="com.gazuntite.skins.controls.list.ScrollBarDownButtonSkin" />
	
</s:SparkSkin>
