<?xml version="1.0" encoding="utf-8"?>
<s:SparkSkin xmlns:fx="http://ns.adobe.com/mxml/2009" xmlns:s="library://ns.adobe.com/flex/spark"
			 xmlns:fb="http://ns.adobe.com/flashbuilder/2009" width="9" minHeight="35" 
			 alpha.disabled="0.5" alpha.inactive="0.5">
	
	<fx:Metadata>
		<![CDATA[ 
		/** 
		* @copy spark.skins.spark.ApplicationSkin#hostComponent
		*/
		[HostComponent("spark.components.VScrollBar")]
		]]>
	</fx:Metadata> 
	
	<fx:Script fb:purpose="styling">
		/* Define the skin elements that should not be colorized. 
		For scroll bar, the skin itself is colorized but the individual parts are not. */
		static private const exclusions:Array = ["track", "thumb", "decrementButton", "incrementButton"];
		
		/**
		 * @private
		 */
		override public function get colorizeExclusions():Array {return exclusions;}
		
		/**
		 * @private
		 */
		override protected function initializationComplete():void
		{
			this.useChromeColor=true;
			//useBaseColor = true;
			super.initializationComplete();
		}
	</fx:Script>
	
	<s:states>
		<s:State name="normal" />
		<s:State name="disabled" />
		<s:State name="inactive" />
	</s:states>
	
	<!-- bg -->
	<!--<s:Rect height="100%" width="9" top="0" bottom="0" >
		<s:fill>
			<s:SolidColor color="#E6E7E9"/>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter alpha="0.5" angle="90" blurX="2" blurY="2" color="0x000000" distance="0" hideObject="false" inner="false" knockout="false" quality="2" strength="1"/>
		</s:filters>
	</s:Rect>-->
	
	<s:Button id="track" top="2" bottom="2" horizontalCenter="0"
			  focusEnabled="false" tabEnabled="false"
			  skinClass="com.gazuntite.skins.controls.list.VScrollBarTrackSkin" />
	
	<s:Button id="thumb" focusEnabled="false" horizontalCenter="0"
			  skinClass="com.gazuntite.skins.controls.list.VScrollBarThumbSkin"
			  tabEnabled="false"  height="45"
			  visible.inactive="false" useHandCursor="true" buttonMode="true"
			 />
	
	<s:Button id="decrementButton" top="3" width="100%" buttonMode="true" focusEnabled="false"
			  horizontalCenter="0" toolTip="Scroll Up" useHandCursor="true"  enabled.inactive="false"
			  skinClass="com.gazuntite.skins.controls.list.VScrollBarUpButtonSkin"
			  visible="false" includeInLayout="false"
			 />

	<s:Button id="incrementButton" bottom="3" horizontalCenter="0" width="100%" enabled.inactive="false"
			  focusEnabled="false" useHandCursor="true" buttonMode="true" toolTip="Scroll Down"
			  skinClass="com.gazuntite.skins.controls.list.VScrollBarDownButtonSkin" 
			  visible="false" includeInLayout="false"
			  />
	
</s:SparkSkin>
