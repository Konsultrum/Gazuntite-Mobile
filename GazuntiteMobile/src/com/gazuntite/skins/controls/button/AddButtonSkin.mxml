<?xml version="1.0" encoding="utf-8"?>
<s:Skin xmlns:s="library://ns.adobe.com/flex/spark"
		xmlns:fx="http://ns.adobe.com/mxml/2009"
		width="70" height="25">
	<fx:Metadata>[HostComponent("spark.components.Button")]</fx:Metadata>
	<s:states>
		<s:State name="up"/>
		<s:State name="over"/>
		<s:State name="down"/>
		<s:State name="disabled"/>
	</s:states>
	<s:Rect includeIn="disabled,up" y="0.85" left="0.3" width="69" height="23" radiusX="12">
		<s:fill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry alpha="1.0" color="#676767" ratio="0"
								 color.disabled="#666666"/>
				<s:GradientEntry alpha="1.0" color="#353535" ratio="0.5254901960784314"
								 color.disabled="#444544" ratio.disabled="0.5058823529411764"/>
				<s:GradientEntry alpha="1.0" color="#000000" ratio="0.5294117647058824"
								 color.disabled="#333333" ratio.disabled="0.5098039215686274"/>
				<s:GradientEntry alpha="1.0" color="#000000" ratio="1"
								 color.disabled="#333333"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter alpha="0.25" angle="90" blurX="0" blurY="0" color="#FFFFFF" distance="1" hideObject="false" inner="false" knockout="false" quality="3" strength="1"/>
			<s:DropShadowFilter alpha="0.5" angle="90" blurX="1" blurY="1" color="0x000000" distance="1" hideObject="false" inner="true" knockout="false" quality="3" strength="1"/>
		</s:filters>
		<s:stroke>
			<s:LinearGradientStroke caps="none" joints="miter" miterLimit="4" rotation="90" weight="1">
				<s:GradientEntry alpha="1.0" color="#333333" ratio="0"/>
				<s:GradientEntry alpha="1" color="#000000" ratio="1"/>
			</s:LinearGradientStroke>
		</s:stroke>
	</s:Rect>
	<s:Rect height="23" includeIn="over" radiusX="12" width="69" x="0.8" y="0.85">
		<s:fill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry alpha="1.0" color="#C68475" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#64281A" ratio="0.5254901960784314"/>
				<s:GradientEntry alpha="1.0" color="#491B11" ratio="0.5294117647058824"/>
				<s:GradientEntry alpha="1.0" color="#491B11" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter alpha="0.25" angle="90" blurX="0" blurY="0" color="#FFFFFF" distance="1" hideObject="false" inner="false" knockout="false" quality="3" strength="1"/>
			<s:DropShadowFilter alpha="0.5" angle="90" blurX="1" blurY="1" color="0x000000" distance="1" hideObject="false" inner="true" knockout="false" quality="3" strength="1"/>
		</s:filters>
		<s:stroke>
			<s:LinearGradientStroke caps="none" joints="miter" miterLimit="4" rotation="90" weight="1">
				<s:GradientEntry alpha="1.0" color="#333333" ratio="0"/>
				<s:GradientEntry alpha="1" color="#000000" ratio="1"/>
			</s:LinearGradientStroke>
		</s:stroke>
	</s:Rect>
	<s:Rect alpha="0.85" height="23" includeIn="down" radiusX="12" width="69" x="0.8" y="0.85">
		<s:fill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry alpha="1.0" color="#C68475" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#64281A" ratio="0.5254901960784314"/>
				<s:GradientEntry alpha="1.0" color="#491B11" ratio="0.5294117647058824"/>
				<s:GradientEntry alpha="1.0" color="#491B11" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter alpha="0.25" angle="90" blurX="0" blurY="0" color="#FFFFFF" distance="1" hideObject="false" inner="false" knockout="false" quality="3" strength="1"/>
			<s:DropShadowFilter alpha="0.89" angle="90" blurX="5" blurY="5" color="0x000000" distance="1" hideObject="false" inner="true" knockout="false" quality="3" strength="1"/>
		</s:filters>
		<s:stroke>
			<s:LinearGradientStroke caps="none" joints="miter" miterLimit="4" rotation="90" weight="1">
				<s:GradientEntry alpha="1.0" color="#333333" ratio="0"/>
				<s:GradientEntry alpha="1" color="#000000" ratio="1"/>
			</s:LinearGradientStroke>
		</s:stroke>
	</s:Rect>
	<s:RichText x="32" y="5" color="#FFFFFF" fontFamily="Calibri" fontSize="15" lineHeight="0"
				paddingBottom="0" paddingLeft="0" paddingRight="0" paddingTop="0" tabStops="S0"
				text="Add" trackingRight="0%"/>
	<s:Ellipse x="2.8" y="1.85" width="21" height="21">
		<s:stroke>
			<s:SolidColorStroke caps="none" color="#FFFFFF" joints="miter" miterLimit="4" weight="1"/>
		</s:stroke>
		<s:fill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry alpha="1.0" color="#689BE4" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#2F76DA" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter alpha="0.5" angle="90" blurX="3" blurY="3" color="0x000000" distance="1" hideObject="false" inner="false" knockout="false" quality="2" strength="1"/>
		</s:filters>
	</s:Ellipse>
	<s:RichText x="7" y="0" color="#FFFFFF" fontSize="25" tabStops="S0"
				text="+" whiteSpaceCollapse="preserve" fontFamily="Calibri" fontWeight="bold">
		<s:filters>
			<s:DropShadowFilter alpha="0.5" angle="90" blurX="0" blurY="0" color="#000000"
								distance="1" hideObject="false" inner="false" knockout="false"
								quality="3" strength="1"/>
		</s:filters>
	</s:RichText>
</s:Skin>
