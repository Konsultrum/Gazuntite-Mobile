<?xml version="1.0" encoding="utf-8"?>
<s:Skin xmlns:s="library://ns.adobe.com/flex/spark"
		xmlns:fx="http://ns.adobe.com/mxml/2009"
		minWidth="30" height="13">
	
	<fx:Metadata>[HostComponent("spark.components.Button")]</fx:Metadata>
	<s:states>
		<s:State name="up"/>
		<s:State name="over"/>
		<s:State name="down"/>
		<s:State name="disabled"/>
	</s:states>
	
	<s:Rect width="100%" height="13">
		<s:fill>
			<s:SolidColor alpha="0.01" color="#FFFFFF"/>
		</s:fill>
	</s:Rect>
	
	<s:RichText x="1" y="1" color="#000000" 
				fontFamily="CalibriCFF" fontSize="11" tabStops="S0"
				text="Delete" whiteSpaceCollapse="preserve"
				visible.disabled="false" textDecoration.disabled="underline"
				visible.down="false" textDecoration.down="underline"
				visible.over="false" textDecoration.over="underline"
				text.up="Delete Picture"/>
	<s:RichText includeIn="down,over,up" x="1" y="1" color="#002FD1" 
				fontFamily="CalibriCFF"
				fontSize="11" lineHeight="140%" tabStops="S0" text="Delete Picture"
				whiteSpaceCollapse="preserve"
				visible.up="false"/>
	<s:RichText includeIn="disabled,up" 
				x="1" y="1" color="#999999" 
				fontFamily="CalibriCFF"
				fontSize="11" tabStops="S0" text="Delete" whiteSpaceCollapse="preserve"
				color.disabled="#4D627F" tabStops.disabled="S0 S50" text.disabled="Delete Picture"
				visible.up="false"/>
	
	<s:Line includeIn="up" y="12.5" width="100%">
		<s:stroke>
			<s:SolidColorStroke caps="none" color="#000000" joints="miter" miterLimit="4" weight="1"/>
		</s:stroke>
	</s:Line>
	
	<s:Line includeIn="down,over"  y="12.5" width="100%">
		<s:stroke>
			<s:SolidColorStroke caps="none" color="0x002ED1" joints="miter" miterLimit="4" weight="1"/>
		</s:stroke>
	</s:Line>
	
</s:Skin>