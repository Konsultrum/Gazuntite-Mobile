<?xml version="1.0" encoding="utf-8"?>
<s:SparkButtonSkin xmlns:fx="http://ns.adobe.com/mxml/2009" 
             xmlns:s="library://ns.adobe.com/flex/spark" 
             xmlns:fb="http://ns.adobe.com/flashbuilder/2009"
             minWidth="21" minHeight="21" 
             alpha.disabled="0.5">
     
    <fx:Metadata>
        <![CDATA[ 
        /** 
         * @copy spark.skins.spark.ApplicationSkin#hostComponent
         */
        [HostComponent("spark.components.Button")]
        ]]>
    </fx:Metadata>
    
    <!-- states -->
    <s:states>
        <s:State name="up" />
        <s:State name="over" />
        <s:State name="down" />
        <s:State name="disabled" />
    </s:states>
    
	<s:Group id="background" left="0" right="0" top="0" bottom="0" width="130">
		<s:Path x="0" y="0" width="130" height="20"
				data="M 2.4 0 L 86.4 0 C 86.909 0.005 87.416 0.201 87.802 0.587 L 92.833 5.618 C 93.615 6.4 93.615 7.68 92.833 8.462 L 87.819 13.476 C 87.429 13.866 86.915 14.062 86.4 14.063 L 1.92 14.063 C 0.864 14.063 0 13.199 0 12.143 L 0 2.4 C 0 1.08 1.08 0 2.4 0 Z"
				rotation="180" transformX="65" transformY="10">
			<s:fill>
				<s:LinearGradient rotation="90"
								  rotation.over="270">
					<s:GradientEntry alpha="1.0" color="#5B5B5C" ratio="0"
									 color.over="#708B9B"/>
					<s:GradientEntry alpha="1.0" color="#5B5B5C" ratio="0.4980392156862745"
									 color.over="#738E9E"/>
					<s:GradientEntry alpha="1.0" color="#6B6C6C" ratio="0.5019607843137255"
									 color.over="#53768C"/>
					<s:GradientEntry includeIn="over" alpha="1.0" color="#53768C"
									 ratio="0.5176470588235295"/>
					<s:GradientEntry alpha="1.0" color="#7C7D7E" ratio="1"
									 color.over="#5B7084"/>
				</s:LinearGradient>
			</s:fill>
			<s:filters>
				<s:DropShadowFilter alpha="0.75" angle="90" blurX="1" blurY="1" color="#FFFFFF"
									distance="1" hideObject="false" inner="false" knockout="false"
									quality="2" strength="1"/>
				<s:DropShadowFilter alpha="0.75" angle="90" blurX="2" blurY="2" color="#000000"
									distance="1" hideObject="false" inner="true" knockout="false"
									quality="3" strength="1"/>
			</s:filters>
		</s:Path>
	</s:Group>
	
    <s:Label id="labelDisplay"
             textAlign="center"
             maxDisplayedLines="1" fontFamily="CalibriCFF"
             horizontalCenter="0" verticalCenter="1" verticalAlign="middle"
             left="10" right="10" top="2" bottom="2"
			 showTruncationTip="true"
			 color="0xFFFFFF" fontSize="13"
			 >
    </s:Label>
    
</s:SparkButtonSkin>
