<?xml version="1.0" encoding="utf-8"?>
<s:Skin xmlns:s="library://ns.adobe.com/flex/spark"
		xmlns:fx="http://ns.adobe.com/mxml/2009"
		width="100%" height="31">
	<fx:Metadata>[HostComponent("spark.components.ToggleButton")]</fx:Metadata>
	<s:states>
		<s:State name="up"/>
		<s:State name="over"/>
		<s:State name="down"/>
		<s:State name="disabled"/>
		<s:State name="upAndSelected"/>
		<s:State name="overAndSelected"/>
		<s:State name="downAndSelected"/>
		<s:State name="disabledAndSelected"/>
	</s:states>
	<s:Rect includeIn="up" x="0" y="0" width="99%" height="27" radiusX="0">
		<s:fill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry alpha="1.0" color="#676767" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#353535" ratio="0.5254901960784314"/>
				<s:GradientEntry alpha="1.0" color="#000000" ratio="0.5294117647058824"/>
				<s:GradientEntry alpha="1.0" color="#000000" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter alpha="0.25" angle="90" blurX="0" blurY="0" color="#FFFFFF" distance="1" hideObject="false" inner="false" knockout="false" quality="3" strength="1"/>
		</s:filters>
	</s:Rect>
	<s:Rect x="1" y="1" width="99%" radiusX="4"
			height.disabled="27"
			height.disabledAndSelected="30"
			height.down="27"
			height.downAndSelected="30"
			height.over="27"
			height.overAndSelected="30"
			visible.up="false" height.up="27"
			height.upAndSelected="30">
		<s:fill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry alpha="1.0" color="#A1A1A1" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#777777" ratio="0.3215686274509804"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter alpha="0.25" angle="90" blurX="1" blurY="1" color="#FFFFFF" distance="1" hideObject="false" inner="false" knockout="false" quality="3" strength="1"/>
		</s:filters>
	</s:Rect>
	
	<s:RichText id="labelDisplay" 
				horizontalCenter="0" 
				verticalCenter="0" 
				color="#FFFFFF" 
				fontFamily="CalibriCFF" 
				fontSize="13"
				tabStops="S0" 
				typographicCase.upAndSelected  ="uppercase" 
				typographicCase.overAndSelected  ="uppercase"
				/>
</s:Skin>
