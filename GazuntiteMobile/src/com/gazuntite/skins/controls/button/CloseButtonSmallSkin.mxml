<?xml version="1.0" encoding="utf-8"?>
<s:SparkButtonSkin xmlns:fx="http://ns.adobe.com/mxml/2009" 
             xmlns:s="library://ns.adobe.com/flex/spark" 
             xmlns:fb="http://ns.adobe.com/flashbuilder/2009"
             minWidth="21" minHeight="21" 
             alpha.disabled="0.5">
     
    <fx:Metadata>
        <![CDATA[ 
        /** 
         * @copy spark.skins.spark.ApplicationSkin#hostComponent
         */
        [HostComponent("spark.components.Button")]
        ]]>
    </fx:Metadata>
    
    <!-- states -->
    <s:states>
        <s:State name="up" />
        <s:State name="over" />
        <s:State name="down" />
        <s:State name="disabled" />
    </s:states>
    
	<s:Rect includeIn="disabled,down,up" x="0" y="0" width="15" height="15"
			   visible.down="false" radiusX="2">
		<s:fill>
			<s:SolidColor color="#FFFFFF"/>
		</s:fill>
	</s:Rect>
	<s:Rect includeIn="down,over" x="0" y="0" width="15" height="15" radiusX="2">
		<s:fill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry alpha="1.0" color="#C68475" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#64281A" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
	</s:Rect>
	<s:BitmapImage x="4" y="4" smooth="true" source="@Embed('/assets/images/cross.png')">
		<s:filters>
			<s:GlowFilter includeIn="down,over" alpha="1.0" blurX="6.0" blurY="6.0" color="#FFFFFF"
						  inner="true" knockout="false" quality="3" strength="6"/>
			<s:DropShadowFilter includeIn="down,over" alpha="0.5" angle="90" blurX="0" blurY="0"
								color="#000000" distance="1" hideObject="false" inner="false"
								knockout="false" quality="3" strength="1"/>
		</s:filters>
	</s:BitmapImage>
</s:SparkButtonSkin>