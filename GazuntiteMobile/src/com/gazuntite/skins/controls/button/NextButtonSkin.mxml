<?xml version="1.0" encoding="utf-8"?>
<s:Skin xmlns:s="library://ns.adobe.com/flex/spark"
		xmlns:fx="http://ns.adobe.com/mxml/2009"
		xmlns:graphics="assets.graphics.*"
		xmlns:d="http://ns.adobe.com/fxg/2008/dt"
		xmlns:ATE="http://ns.adobe.com/ate/2009"
		xmlns:ai="http://ns.adobe.com/ai/2009"
		xmlns:flm="http://ns.adobe.com/flame/2008"
		xmlns:fc="http://ns.adobe.com/flashcatalyst/2009"
		width="20" height="20" 		
		creationComplete="skin1_creationCompleteHandler(event)"
		>
	<fx:Metadata>[HostComponent("spark.components.Button")]</fx:Metadata>

	<fx:Script>
		<![CDATA[
			import mx.events.FlexEvent;
			
			protected function skin1_creationCompleteHandler(event:FlexEvent):void
			{
				if(hostComponent)
				{
					hostComponent.useHandCursor 	= true;
					hostComponent.buttonMode	 	= true;
				}
			}
			
		]]>
	</fx:Script>
	<s:states>
		<s:State name="up"/>
		<s:State name="over"/>
		<s:State name="down"/>
		<s:State name="disabled"/>
	</s:states>
	<s:Rect x="0.5" y="0.5" width="19" height="19" radiusX="2"
			visible.down="false"
			visible.over="false">
		<s:fill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry alpha="1.0" color="#7A7A7A" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#444545" ratio="0.5254901960784314"/>
				<s:GradientEntry alpha="1.0" color="#2D2E2E" ratio="0.5294117647058824"/>
				<s:GradientEntry alpha="1.0" color="#3F4040" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter alpha="0.25" angle="90" blurX="0" blurY="0" color="#FFFFFF" distance="1" hideObject="false" inner="false" knockout="false" quality="3" strength="1"/>
			<s:DropShadowFilter alpha="0.5" angle="90" blurX="1" blurY="1" color="0x000000" distance="1" hideObject="false" inner="true" knockout="false" quality="3" strength="1"/>
		</s:filters>
		<s:stroke>
			<s:LinearGradientStroke caps="none" joints="miter" miterLimit="4" rotation="90" weight="1">
				<s:GradientEntry alpha="1.0" color="#333333" ratio="0"/>
				<s:GradientEntry alpha="1" color="#000000" ratio="1"/>
			</s:LinearGradientStroke>
		</s:stroke>
	</s:Rect>
	<s:Rect height="17" height.down="19" height.over="19" includeIn="down,over,up" radiusX="2" visible.up="false" width="17" width.down="19" width.over="19" x.down="0.5" x.over="0.5" x.up="1.5" y.down="0.5" y.over="0.5" y.up="1.5">
		<s:fill>
			<s:LinearGradient rotation="270">
				<s:GradientEntry alpha="1.0" color="#64281A" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#C68475" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:stroke>
			<s:SolidColorStroke alpha="0.41000000000000003" caps="none" color="#CCCCCC" joints="miter" miterLimit="4" weight="1"/>
		</s:stroke>
		<s:filters>
			<s:DropShadowFilter alpha="1" angle="90" blurX="2" blurY="2" color="0x000000" distance="1" hideObject="false" includeIn="down" inner="true" knockout="false" quality="3" strength="1"/>
		</s:filters>
	</s:Rect>
	<s:Path x="4.478" y="2.835" width="8.059" height="10.068"
			data="M 10.86 12.49 L 0.04 6.25 10.86 0.01 Z " rotation="180"
			transformX="5.45" transformY="6.25"
			>
		<s:filters>
			<s:DropShadowFilter alpha="0.25" angle="90" blurX="0" blurY="0" color="#333333"
								distance="1" hideObject="false" inner="false" knockout="false"
								quality="3" strength="1"/>
		</s:filters>
		<s:fill>
			<s:LinearGradient rotation="270">
				<s:GradientEntry alpha="1" color="#FFFFFF" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#CCCCCC" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
	</s:Path>
</s:Skin>
