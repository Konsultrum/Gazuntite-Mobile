<!--- The default skin class for the Spark Button component.  

       @see spark.components.Button
        
      @langversion 3.0
      @playerversion Flash 10
      @playerversion AIR 1.5
      @productversion Flex 4
-->
<s:SparkButtonSkin xmlns:fx="http://ns.adobe.com/mxml/2009" 
             xmlns:s="library://ns.adobe.com/flex/spark" 
             xmlns:fb="http://ns.adobe.com/flashbuilder/2009"
             minWidth="21" minHeight="21" 
             alpha.disabled="0.5">
     
    <fx:Metadata>
        <![CDATA[ 
        /** 
         * @copy spark.skins.spark.ApplicationSkin#hostComponent
         */
        [HostComponent("spark.components.Button")]
        ]]>
    </fx:Metadata>
    
    <!-- states -->
    <s:states>
        <s:State name="up" />
        <s:State name="over" />
        <s:State name="down" />
        <s:State name="disabled" />
    </s:states>
    
	<s:Rect height="20" includeIn="disabled,over,up" radiusX="3" width="20" y="0.5" x="0.5">
		<s:stroke>
			<s:SolidColorStroke caps="none" color="#666666" joints="miter" miterLimit="4" weight="1"/>
		</s:stroke>
		<s:fill>
			<s:LinearGradient rotation="270">
				<s:GradientEntry alpha="1.0" color="#D9D9D9" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#FFFFFF" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
	</s:Rect>
	<s:Path data="M 0.04 10.98 L 0.04 0.02 9.52 5.50 Z " height="9" width="9" y="6" visible.over="false" visible.down="false" x="7">
		<s:fill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry alpha="1.0" color="0x6D7278" ratio="0"/>
				<s:GradientEntry ratio="0.4980392156862745" color="#4A5259" alpha="1.0"/>
				<s:GradientEntry ratio="0.5019607843137255" color="0x394149" alpha="1.0"/>
				<s:GradientEntry alpha="1" color="0x3F454E" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:fill.up>
			<s:SolidColor color="#000000"/>
		</s:fill.up>
		<s:fill.disabled>
			<s:SolidColor color="#333333"/>
		</s:fill.disabled>
	</s:Path>
	<s:Rect height="20" includeIn="down,over,up" radiusX="3" width="20" y="0.5" x="0.5" visible.up="false">
		<s:stroke>
			<s:SolidColorStroke caps="none" color="#454545" joints="miter" miterLimit="4" weight="1"/>
		</s:stroke>
		<s:fill>
			<s:LinearGradient rotation="270">
				<s:GradientEntry alpha="1.0" color="#565656" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#292929" ratio="0.5254901960784314"/>
				<s:GradientEntry alpha="1.0" color="#4A4A4A" ratio="0.5294117647058824"/>
				<s:GradientEntry alpha="1.0" color="#737373" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:GlowFilter alpha="1.0" blurX="6.0" blurY="6.0" color="#999999" includeIn="up" inner="true" knockout="false" quality="3" strength="1"/>
			<s:DropShadowFilter includeIn="down" blurX="2" blurY="2" distance="2" hideObject="false" color="0x000000" inner="true" strength="1" alpha="0.5" quality="3" knockout="false" angle="90"/>
		</s:filters>
	</s:Rect>
	<s:Path data="M 0.04 10.98 L 0.04 0.02 9.52 5.50 Z " height="9" includeIn="down,over,up" visible.up="false" width="9" y="6" x="7">
		<s:fill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry alpha="1" color="0xF6F6F6" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="0xD5D6D8" ratio="0.47843137254901963"/>
				<s:GradientEntry alpha="1.0" color="0xC0C1C4" ratio="0.47843137254901963"/>
				<s:GradientEntry alpha="1" color="0xC0C1C4" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter alpha="0.5" angle="90" blurX="2" blurY="2" color="0x000000" distance="2" hideObject="false" inner="false" knockout="false" quality="3" strength="1"/>
		</s:filters>
		<s:fill.over>
			<s:SolidColor color="0xF6F6F6"/>
		</s:fill.over>
		<s:fill.down>
			<s:SolidColor color="0xF6F6F6"/>
		</s:fill.down>
	</s:Path>
    
</s:SparkButtonSkin>
