<?xml version="1.0" encoding="utf-8"?>
<s:Skin xmlns:s="library://ns.adobe.com/flex/spark"
		xmlns:fx="http://ns.adobe.com/mxml/2009"
		width="18" height="18">
	<fx:Metadata>[HostComponent("spark.components.Button")]</fx:Metadata>
	<s:states>
		<s:State name="up"/>
		<s:State name="over"/>
		<s:State name="down"/>
		<s:State name="disabled"/>
	</s:states>
	<s:Rect x="0" y="0" width="18" height="18" radiusX="3">
		<s:fill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry alpha="1.0" color="#EF7C85" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#E83B47" ratio="0.49411764705882355"/>
				<s:GradientEntry alpha="1.0" color="#E10111" ratio="0.4980392156862745"/>
				<s:GradientEntry alpha="1.0" color="#EB1013" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter alpha="0.5" angle="90" blurX="0" blurY="0" color="0x000000" distance="1" hideObject="false" inner="false" knockout="false" quality="3" strength="1"/>
		</s:filters>
	</s:Rect>
	<s:BitmapImage x="2" y="3" width="14" height="13" smooth="true"
				   source="@Embed('/assets/images/video.png')">
		<s:filters>
			<s:DropShadowFilter alpha="1" angle="90" blurX="1" blurY="1" color="#000000"
								distance="1" hideObject="false" inner="false" knockout="false"
								quality="3" strength="1"/>
			<s:GlowFilter alpha="1.0" blurX="6.0" blurY="6.0" color="#000000" inner="true"
						  knockout="false" quality="3" strength="10"/>
		</s:filters>
	</s:BitmapImage>
</s:Skin>
