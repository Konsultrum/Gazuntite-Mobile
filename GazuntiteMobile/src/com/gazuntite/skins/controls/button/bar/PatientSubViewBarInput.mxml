<!--- The default skin class for a Spark SkinnableContainer container.  

     @see spark.components.SkinnableContainer
        
      @langversion 3.0
      @playerversion Flash 10
      @playerversion AIR 1.5
      @productversion Flex 4
-->
<s:Skin xmlns:fx="http://ns.adobe.com/mxml/2009" xmlns:s="library://ns.adobe.com/flex/spark" 
    xmlns:fb="http://ns.adobe.com/flashbuilder/2009" alpha.disabled="0.5">

    <fx:Metadata>
    <![CDATA[ 
        /** 
         * @copy spark.skins.spark.ApplicationSkin#hostComponent
         */
        [HostComponent("spark.components.SkinnableContainer")]
    ]]>
    </fx:Metadata> 
    
    <s:states>
        <s:State name="normal" />
        <s:State name="disabled" />
    </s:states>
    
    <!--- Defines the appearance of the SkinnableContainer class's background. -->
    <s:Rect id="background" left="0" right="0" top="0" bottom="0" alpha="0">
        <s:fill>
            <!--- @private -->
            <s:SolidColor id="bgFill" color="#FFFFFF"/>
        </s:fill>
    </s:Rect>
	<s:Rect x="0" y="0" width="111" height="24" radiusX="13">
		<s:fill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry alpha="1.0" color="#9E9E9E" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#5E5E5E" ratio="0.4980392156862745"/>
				<s:GradientEntry alpha="1.0" color="#474747" ratio="0.5019607843137255"/>
				<s:GradientEntry alpha="1.0" color="#3A3B3B" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter alpha="0.5" angle="90" blurX="0" blurY="0" color="#FFFFFF" distance="1" hideObject="false" inner="false" knockout="false" quality="3" strength="1"/>
			<s:DropShadowFilter alpha="1" angle="90" blurX="2" blurY="2" color="#000000"
								distance="1" hideObject="false" inner="true" knockout="false"
								quality="3" strength="1"/>
		</s:filters>
	</s:Rect>
	<s:RichText x="50" y="6" color="#FFFFFF" fontSize="16"
				lineHeight="0" paddingBottom="0" paddingLeft="0" paddingRight="0" paddingTop="0"
				tabStops="S0" text="INPUT" trackingRight="1%" fontFamily="Calibri" fontWeight="bold">
		<s:filters>
			<s:DropShadowFilter alpha="0.5" angle="90" blurX="1" blurY="1" color="#000000"
								distance="1" hideObject="false" inner="false" knockout="false"
								quality="3" strength="1"/>
		</s:filters>
	</s:RichText>
	<s:BitmapImage x="9" y="5" smooth="true"
				   source="@Embed('/assets/images/bluekeyboard.png')"/>
    
    <!--
        Note: setting the minimum size to 0 here so that changes to the host component's
        size will not be thwarted by this skin part's minimum size.   This is a compromise,
        more about it here: http://bugs.adobe.com/jira/browse/SDK-21143
    -->
    <!--- @copy spark.components.SkinnableContainer#contentGroup -->
    <s:Group id="contentGroup" left="0" right="0" top="0" bottom="0" minWidth="0" minHeight="0">
        <s:layout>
            <s:BasicLayout/>
        </s:layout>
    </s:Group>

</s:Skin>
