<?xml version="1.0" encoding="utf-8"?>
<s:SparkSkin name="CustomButtonBarButtonSkin"
			 xmlns:fx="http://ns.adobe.com/mxml/2009"
			 xmlns:s="library://ns.adobe.com/flex/spark"
			 width="80" height="25"
			 alpha.disabledStates="0.5">
	<!-- states -->
	<s:states>
		<s:State name="up" />
		<s:State name="over" stateGroups="overStates" />
		<s:State name="down" stateGroups="downStates" />
		<s:State name="disabled" stateGroups="disabledStates" />
		<s:State name="upAndSelected" stateGroups="selectedStates, selectedUpStates" />
		<s:State name="overAndSelected" stateGroups="overStates, selectedStates" />
		<s:State name="downAndSelected" stateGroups="downStates, selectedStates" />
		<s:State name="disabledAndSelected" stateGroups="selectedUpStates, disabledStates, selectedStates" />
	</s:states>
	
	<!-- host component -->
	<fx:Metadata>
		<![CDATA[ 
		[HostComponent("spark.components.ButtonBarButton")]
		]]>
	</fx:Metadata>
	
	<fx:Script>
		<![CDATA[
			import mx.events.FlexEvent;
			
			import spark.components.ButtonBar;
			import spark.components.ButtonBarButton;
			
			[Embed(source="assets/images/email1.png")]
			private var emailCalss:Class;
			
			[Embed(source="assets/images/sms1.png")]
			private var smsCalss:Class;
			
			[Embed(source="assets/images/chat1.png")]
			private var chatCalss:Class;
			
			[Embed(source="assets/images/audio1.png")]
			private var audioCalss:Class;
			
			[Embed(source="assets/images/video1.png")]
			private var videoCalss:Class;
			
			protected function gr_creationComplete(evt:FlexEvent):void 
			{
				/* var dataObj:Object 		= hostComponent.data;
				img.source 				= dataObj.icon;
				hostComponent.toolTip 	= dataObj.label;
				labelDisplay.toolTip  	= dataObj.label 
				labelDisplay.text  	= dataObj.label  */
				
				switch(hostComponent.label)
				{
					case "Email":
						img.source 				= emailCalss;
						break;
					case "SMS":
						img.source 				= smsCalss;
						break;
					case "Chat":
						img.source 				= chatCalss;
						break;
					case "Audio":
						img.source 				= audioCalss;
						break;
					case "Video":
						img.source 				= videoCalss;
						break;
				}
				
				hostComponent.toolTip 	= hostComponent.label;
				labelDisplay.toolTip  	= hostComponent.label ;
				labelDisplay.text  		= hostComponent.label
			}
			
			/* Define the skin elements that should not be colorized. 
			For toggle button, the graphics are colorized but the label is not. */
			static private const exclusions:Array = [];
			
			override public function get colorizeExclusions():Array {return exclusions;}
		]]>
	</fx:Script>
	
	<s:Path includeIn="disabled,disabledAndSelected,up" x="0" y="0" width="100%" height="100%"
			data="M 5.804 0 L 40.628 0 C 42.231 0 43.531 1.299 43.531 2.902 L 46.433 17.138 C 46.433 18.74 45.134 20.04 43.531 20.04 L 2.902 20.04 C 1.299 20.04 0 18.74 0 17.138 L 2.902 2.902 C 2.902 1.299 4.201 0 5.804 0 Z"
			visible.over="false">
		<s:fill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry alpha="1.0" color="#979797" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#818181" ratio="0.48627450980392156"/>
				<s:GradientEntry alpha="1.0" color="#737373" ratio="0.49019607843137253"/>
				<s:GradientEntry alpha="1.0" color="#737373" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter alpha="0.5" angle="90" blurX="2" blurY="2" color="0x000000" distance="1" hideObject="false" inner="false" knockout="false" quality="3" strength="1"/>
		</s:filters>
	</s:Path>
	<s:Path includeIn="down,downAndSelected,over,overAndSelected,upAndSelected" 
			x="0" y="0"
			width="100%" height="100%"
			data="M 5.804 0 L 40.628 0 C 42.231 0 43.531 1.299 43.531 2.902 L 46.433 17.138 C 46.433 18.74 45.134 20.04 43.531 20.04 L 2.902 20.04 C 1.299 20.04 0 18.74 0 17.138 L 2.902 2.902 C 2.902 1.299 4.201 0 5.804 0 Z"
			>
		<s:fill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry alpha="1.0" color="#525252" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#3A3A3A" ratio="0.48627450980392156"/>
				<s:GradientEntry alpha="1.0" color="#2E2E2E" ratio="0.49019607843137253"/>
				<s:GradientEntry alpha="1.0" color="#2E2E2E" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter alpha="0.5" angle="90" blurX="2" blurY="2" color="0x000000" distance="1" hideObject="false" inner="false" knockout="false" quality="3" strength="1"/>
			<s:DropShadowFilter includeIn="down" alpha="0.5" angle="90" blurX="2" blurY="2"
								color="#000000" distance="2" hideObject="false" inner="true"
								knockout="false" quality="3" strength="1"/>
		</s:filters>
	</s:Path>
	
	<!-- layer 8: icon -->
	<s:Group width="100%" height="100%">
		<s:Graphic id="gr"
				   creationComplete="gr_creationComplete(event);"
				   left="6" verticalCenter="0">
			<s:BitmapImage id="img" />
		</s:Graphic>
		
		<s:RichText id="labelDisplay" 
					left="30"  right="4"
					verticalCenter="0"
					color="#FFFFFF" 
					fontFamily="CalibriCFF" 
					fontSize="13" 
					lineHeight="235%"
					tabStops="S0 S50 S100" 
					whiteSpaceCollapse="preserve" 
					typographicCase.upAndSelected="uppercase"
					typographicCase.overAndSelected ="uppercase"
					typographicCase.downAndSelected ="uppercase"
					includeInLayout="{labelDisplay.visible}" 
					maxDisplayedLines="1"
					textAlign="left"
					useHandCursor="true" buttonMode="true"/>
	</s:Group>
	
</s:SparkSkin>