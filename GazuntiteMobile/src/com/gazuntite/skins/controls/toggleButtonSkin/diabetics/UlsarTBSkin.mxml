<?xml version="1.0" encoding="utf-8"?>
<s:Skin xmlns:s="library://ns.adobe.com/flex/spark"
		xmlns:fx="http://ns.adobe.com/mxml/2009"
		width="55" height="55">
	<fx:Metadata>[HostComponent("spark.components.ToggleButton")]</fx:Metadata>
	<s:states>
		<s:State name="up"/>
		<s:State name="over"/>
		<s:State name="down"/>
		<s:State name="disabled"/>
		<s:State name="upAndSelected"/>
		<s:State name="overAndSelected"/>
		<s:State name="downAndSelected"/>
		<s:State name="disabledAndSelected"/>
	</s:states>
	<s:Rect x="1" y="1" width="53" height="53" radiusX="3">
		<s:fill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry alpha="1" color="#FFFFFF" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#FFFFFF" ratio="0.5333333333333333"/>
				<s:GradientEntry alpha="1.0" color="#FFFFFF" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter alpha="0.75" angle="90" blurX="2" blurY="2" color="#000000"
								distance="0" hideObject="false" inner="false" knockout="false"
								quality="3" strength="1"/>
			<s:DropShadowFilter includeIn="down" alpha="0.5" angle="90" blurX="4.0" blurY="4.0"
								color="#000000" distance="4.0" hideObject="false" inner="true"
								knockout="false" quality="3" strength="1"/>
		</s:filters>
		<s:stroke>
			<s:SolidColorStroke caps="none" color="#0397FF" joints="miter" miterLimit="4" weight="2"
								color.disabled="#FFFFFF"
								color.overAndSelected="#006DBA"
								color.up="#FFFFFF"/>
		</s:stroke>
	</s:Rect>
	<s:BitmapImage x="6" y="2" smooth="true" source="@Embed('/assets/images/footsore.png')"/>
	<s:RichText color="#000000" fontFamily="Calibri" fontSize="12" horizontalCenter="0" bottom="6"
				tabStops="S0 S50 S100" text="Ulcer"/>
</s:Skin>
