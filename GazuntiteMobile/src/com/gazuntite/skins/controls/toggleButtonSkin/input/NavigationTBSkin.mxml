<?xml version="1.0" encoding="utf-8"?>
<s:Skin xmlns:s="library://ns.adobe.com/flex/spark"
		xmlns:fx="http://ns.adobe.com/mxml/2009"
		xmlns:d="http://ns.adobe.com/fxg/2008/dt"
		width="20" height="20"
		creationComplete="skin1_creationCompleteHandler(event)"
		toolTip="{value_text}"
		>
	
	<fx:Metadata>[HostComponent("spark.components.ToggleButton")]</fx:Metadata>
	
	<fx:Script>
		<![CDATA[
			import mx.events.FlexEvent;
			[Bindable] private var value_text:String = '';
			
			protected function skin1_creationCompleteHandler(event:FlexEvent):void
			{
				if(hostComponent.label)
				{
					value_text		= hostComponent.label;
					hostComponent.buttonMode = true;
				}
				if(hostComponent.toolTip)
				{
					hostComponent.toolTip   = hostComponent.toolTip;
				}
			}
			
		]]>
	</fx:Script>
	
	<s:states>
		<s:State name="up"/>
		<s:State name="over"/>
		<s:State name="down"/>
		<s:State name="disabled"/>
		<s:State name="upAndSelected"/>
		<s:State name="overAndSelected"/>
		<s:State name="downAndSelected"/>
		<s:State name="disabledAndSelected"/>
	</s:states>
	
	<s:Ellipse  width="20" height="20" 
			visible.downAndSelected="false"
			visible.overAndSelected="false"
			visible.upAndSelected="false">
		<s:fill>
			<s:LinearGradient rotation="270">
				<s:GradientEntry alpha="1.0" color="#048CE0" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#008EE5" ratio="0.49411764705882355"/>
				<s:GradientEntry alpha="1.0" color="#009CFF" ratio="0.4980392156862745"/>
				<s:GradientEntry alpha="1.0" color="#009CFF" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
	</s:Ellipse>
	
	<s:Ellipse includeIn="downAndSelected,overAndSelected,upAndSelected" width="20"	height="20" >
		<s:fill>
			<s:LinearGradient rotation="270">
				<s:GradientEntry alpha="1.0" color="#048CE0" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#008EE5" ratio="0.49411764705882355"/>
				<s:GradientEntry alpha="1.0" color="#009CFF" ratio="0.4980392156862745"/>
				<s:GradientEntry alpha="1.0" color="#009CFF" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
	</s:Ellipse>
	
	<s:RichText id="labelDisplay"  color="#FFFFFF" fontFamily="CalibriCFF" fontSize="14"
				tabStops="S0" width="20" textAlign="center" verticalCenter="0" horizontalCenter="0">
	</s:RichText>
</s:Skin>