<?xml version="1.0" encoding="utf-8"?>
<s:Skin xmlns:s="library://ns.adobe.com/flex/spark"
		xmlns:fx="http://ns.adobe.com/mxml/2009"
		xmlns:ATE="http://ns.adobe.com/ate/2009"
		xmlns:ai="http://ns.adobe.com/ai/2009"
		xmlns:d="http://ns.adobe.com/fxg/2008/dt"
		xmlns:flm="http://ns.adobe.com/flame/2008"
		xmlns:lib="assets.graphics.*"
		xmlns:fc="http://ns.adobe.com/flashcatalyst/2009"
		width="32" height="102">
	<fx:Metadata>[HostComponent("spark.components.ToggleButton")]</fx:Metadata>
	<s:states>
		<s:State name="up"/>
		<s:State name="over"/>
		<s:State name="down"/>
		<s:State name="disabled"/>
		<s:State name="upAndSelected"/>
		<s:State name="overAndSelected"/>
		<s:State name="downAndSelected"/>
		<s:State name="disabledAndSelected"/>
	</s:states>
	
	<s:Rect includeIn="down,downAndSelected,overAndSelected,up,upAndSelected" height="92" radiusX="3"
			visible.down="false" x.down="9" y.down="10" width.down="23"
			x.downAndSelected="0" y.downAndSelected="0" width.downAndSelected="32"
			height.downAndSelected="102"
			x.overAndSelected="0" y.overAndSelected="0" width.overAndSelected="32"
			height.overAndSelected="102"
			visible.up="false" x.up="9" y.up="10" width.up="23"
			x.upAndSelected="0" y.upAndSelected="0" width.upAndSelected="32"
			height.upAndSelected="102">
		<s:fill>
			<s:LinearGradient rotation="0">
				<s:GradientEntry includeIn="upAndSelected" alpha="1.0" color="#6D87AD"
								 ratio="0.4627450980392157"/>
				<s:GradientEntry includeIn="overAndSelected" alpha="1.0" color="#6D87AD"
								 ratio="0.03529411764705882"/>
				<s:GradientEntry alpha="1.0"
								 color.down="#FFFFFF" ratio.down="0"
								 color.downAndSelected="#6D87AD"
								 ratio.downAndSelected="0.4235294117647059"
								 color.overAndSelected="#6D87AD"
								 ratio.overAndSelected="0.4235294117647059"
								 color.up="#DDE7F6" ratio.up="0"
								 color.upAndSelected="#6D87AD"
								 ratio.upAndSelected="0.47058823529411764"/>
				<s:GradientEntry includeIn="down,up" alpha="1.0" color="#AAC5F4"
								 ratio="0.44313725490196076"
								 color.down="#9CC0FF" ratio.down="0.4627450980392157"/>
				<s:GradientEntry includeIn="down,up" alpha="1.0" color="#93B1E6"
								 ratio="0.4470588235294118"
								 color.down="#799CD8" ratio.down="0.4666666666666667"/>
				<s:GradientEntry alpha="1.0" color="#BFCFEA" ratio="1"
								 color.down="#A8C8FF"
								 color.upAndSelected="#BFCFEA"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter includeIn="downAndSelected,overAndSelected,up,upAndSelected"
								alpha="0.75" angle="180" blurX="7" blurY="7" color="#000000"
								distance="2" hideObject="false" inner="false" knockout="false"
								quality="3" strength="2"/>
			<s:DropShadowFilter includeIn="down" alpha="0.75" angle="90" blurX="2" blurY="2"
								color="#000000" distance="2" hideObject="false" inner="true"
								knockout="false" quality="3" strength="1"/>
			<s:DropShadowFilter includeIn="down" alpha="1" angle="90" blurX="4" blurY="4"
								color="#000000" distance="2" hideObject="false" inner="false"
								knockout="false" quality="3" strength="1"/>
		</s:filters>
	</s:Rect>
	<s:Rect includeIn="down,over" x="9" y="0" width="23" height="102" radiusX="5">
		<s:fill>
			<s:LinearGradient rotation="0">
				<s:GradientEntry alpha="1.0" color="#B24F36" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#FFBCAD" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter alpha="0.75" angle="90" blurX="4" blurY="4" color="0x000000" distance="2" hideObject="false" inner="false" knockout="false" quality="3" strength="1"/>
		</s:filters>
	</s:Rect>
	
	<s:Path x="12.631"  width="17"
			data="M 0 6.12 L 6.12 0 L 12.24 6.12 L 12.24 46.8 L 0 46.8 L 0 6.12 Z"
			y="2" height="72">
		<s:fill>
			<s:LinearGradient rotation="0">
				<s:GradientEntry alpha="1.0" color="#F0B744" ratio="0"
								 color.disabled="#CCCCCC"/>
				<s:GradientEntry alpha="1.0" color="#EFB644" ratio="0.44313725490196076"
								 color.disabled="#CCCCCC"/>
				<s:GradientEntry alpha="1.0" color="#F1C451" ratio="0.45098039215686275"
								 color.disabled="#999999"/>
				<s:GradientEntry alpha="1.0" color="#F3D360" ratio="1"
								 color.disabled="#999999"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter alpha="0.75" angle="90" blurX="1" blurY="1" color="#000000"
								distance="1" hideObject="false" inner="false" knockout="false"
								quality="3" strength="1"/>
			<s:GlowFilter alpha="1.0" blurX="6.0" blurY="6.0" color="#FFFFFF" inner="true"
						  knockout="false" quality="2" strength="1"/>
		</s:filters>
	</s:Path>
	
	<s:RichText bottom="33" color="#000000" fontFamily="Calibri" fontSize="15" fontWeight="bold"
				lineHeight="100%" rotation="-90" tabStops="S0" text="{hostComponent.label}" trackingRight="1%"
				x.disabled="14" color.disabled="#666666"
				x.disabledAndSelected="14"
				x.down="14"
				x.downAndSelected="14"
				x.over="14"
				x.overAndSelected="14"
				x.up="15" fontSize.up="14"
				x.upAndSelected="14"/>
	<s:BitmapImage x="12" y="80" smooth="true" source="@Embed('/assets/images/arrows.png')"
				   transformX="8" transformY="7"
				   alpha.disabled="0.5"
				   rotation.disabledAndSelected="180"
				   rotation.downAndSelected="180"
				   rotation.overAndSelected="180"
				   rotation.upAndSelected="180">
		<s:filters>
			<s:DropShadowFilter alpha="0.5" angle="90" blurX="0" blurY="0" distance="1"
								hideObject="false" inner="false" knockout="false" quality="3"
								strength="1"
								color.disabled="#FFFFFF"
								color.disabledAndSelected="#000000"
								color.down="#FFFFFF"
								color.downAndSelected="#000000"
								color.over="#FFFFFF"
								color.overAndSelected="#000000"
								color.up="#000000"
								color.upAndSelected="#000000"/>
			<s:GlowFilter alpha="1.0" blurX="6.0" blurY="6.0" inner="true" knockout="false"
						  quality="2" strength="5"
						  color.disabled="#2B4381"
						  color.disabledAndSelected="#2B4381"
						  color.down="#FFFFFF"
						  color.downAndSelected="#2B4381"
						  color.over="#FFFFFF"
						  color.overAndSelected="#2B4381"
						  color.up="#2B4381"
						  color.upAndSelected="#2B4381"/>
			<s:DropShadowFilter includeIn="disabledAndSelected,downAndSelected,overAndSelected,upAndSelected" alpha="0.5" angle="45.0" blurX="4.0"
								blurY="4.0" color="#2B4381" distance="4.0" hideObject="false"
								inner="true" knockout="false" quality="2" strength="1"/>
		</s:filters>
	</s:BitmapImage>
	<s:RichText x="17" color="#000000" fontFamily="CalibriCFFBold" 
				fontSize="16" rotation="90"
				lineHeight="100%" tabStops="S0" text="$" trackingRight="1%"
				transformX="4" transformY="7.5"
				color.disabled="#666666"
				top="10" bottom="70"/>
</s:Skin>
