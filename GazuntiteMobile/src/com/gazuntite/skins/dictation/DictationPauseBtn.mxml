<?xml version="1.0" encoding="utf-8"?>
<s:Skin xmlns:s="library://ns.adobe.com/flex/spark" xmlns:fx="http://ns.adobe.com/mxml/2009">
	<fx:Metadata>[HostComponent("spark.components.Button")]</fx:Metadata>
	<s:states>
		<s:State name="up"/>
		<s:State name="over"/>
		<s:State name="down"/>
		<s:State name="disabled"/><s:State name="disabledWithPrompt"/>
	</s:states>
	<s:Rect height="20" includeIn="disabled,up" radiusX="3" width="20" x="0.5" y="0.5">
		<s:stroke>
			<s:SolidColorStroke caps="none" color="#666666" joints="miter" miterLimit="4" weight="1"/>
		</s:stroke>
		<s:fill>
			<s:LinearGradient rotation="270">
				<s:GradientEntry alpha="1.0" color="#D9D9D9" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#FFFFFF" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
	</s:Rect>
	<s:Rect height="20" includeIn="down,over,up" radiusX="3" visible.up="false" width="20" x="0.5" y="0.5">
		<s:stroke>
			<s:SolidColorStroke caps="none" color="#454545" joints="miter" miterLimit="4" weight="1"/>
		</s:stroke>
		<s:fill>
			<s:LinearGradient rotation="270">
				<s:GradientEntry alpha="1.0" color="#565656" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#292929" ratio="0.5254901960784314"/>
				<s:GradientEntry alpha="1.0" color="#4A4A4A" ratio="0.5294117647058824"/>
				<s:GradientEntry alpha="1.0" color="#737373" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:GlowFilter alpha="1.0" blurX="6.0" blurY="6.0" color="#999999" includeIn="up" inner="true" knockout="false" quality="3" strength="1"/>
			<s:DropShadowFilter alpha="0.5" angle="90" blurX="2" blurY="2" color="0x000000" distance="2" hideObject="false" includeIn="down" inner="true" knockout="false" quality="3" strength="1"/>
		</s:filters>
	</s:Rect>
	<s:Rect height="9" includeIn="down,over,up" visible.up="false" width.down="2" width.over="2" width.up="9" x.down="12" x.over="12" x.up="6" y="6">
		<s:fill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry alpha="1.0" color="#F6F6F6" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#D2D3D5" ratio="0.4980392156862745"/>
				<s:GradientEntry alpha="1.0" color="#C0C1C4" ratio="0.5098039215686274"/>
				<s:GradientEntry alpha="1.0" color="#C0C1C4" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter alpha="0.5" angle="90" blurX="2" blurY="2" color="#000000" distance="2" hideObject="false" inner="false" knockout="false" quality="3" strength="1"/>
		</s:filters>
	</s:Rect>
	<s:Rect height="9" includeIn="down,over" width="2" x="8" y="6">
		<s:fill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry alpha="1.0" color="#F6F6F6" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#D2D3D5" ratio="0.4980392156862745"/>
				<s:GradientEntry alpha="1.0" color="#C0C1C4" ratio="0.5098039215686274"/>
				<s:GradientEntry alpha="1.0" color="#C0C1C4" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter alpha="0.5" angle="90" blurX="2" blurY="2" color="#000000" distance="2" hideObject="false" inner="false" knockout="false" quality="3" strength="1"/>
		</s:filters>
	</s:Rect>
	<s:Rect height="9" includeIn="disabled,up" width="3" x="7" y="6">
		<s:fill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry alpha="1.0" color="#6D7278" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#363E46" ratio="0.47843137254901963"/>
				<s:GradientEntry alpha="1.0" color="#2B323B" ratio="0.49019607843137253"/>
				<s:GradientEntry alpha="1.0" color="#454B54" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter alpha="0.5" angle="90" blurX="1" blurY="1" color="#FFFFFF" distance="1" hideObject="false" inner="false" knockout="false" quality="3" strength="1"/>
		</s:filters>
	</s:Rect>
	<s:Rect height="9" includeIn="disabled,up" width="3" x="12" y="6">
		<s:fill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry alpha="1.0" color="#6D7278" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#363E46" ratio="0.47843137254901963"/>
				<s:GradientEntry alpha="1.0" color="#2B323B" ratio="0.49019607843137253"/>
				<s:GradientEntry alpha="1.0" color="#454B54" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter alpha="0.5" angle="90" blurX="1" blurY="1" color="#FFFFFF" distance="1" hideObject="false" inner="false" knockout="false" quality="3" strength="1"/>
		</s:filters>
	</s:Rect>
</s:Skin>
