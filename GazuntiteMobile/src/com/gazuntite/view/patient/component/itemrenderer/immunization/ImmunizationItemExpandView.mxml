<s:SkinnableContainer xmlns:fx="http://ns.adobe.com/mxml/2009" 
					  xmlns:s="library://ns.adobe.com/flex/spark" 
					  xmlns:mx="library://ns.adobe.com/flex/mx"
					  xmlns:components="com.gazuntite.controls.extended.components.*" 
					  >
	<fx:Script>
		<![CDATA[
			import com.gazuntite.common.dto.pmh.immunization.ImmunizationDTO;
			import com.gazuntite.patient.visit.utils.QIConstants;
			import com.gazuntite.utils.UtilityFunctions;
			
			
			[Bindable]	public var labelWidth:Number = 120;
			
			private var _immDTO:ImmunizationDTO;
			
			[Bindable]
			public function get immDTO():ImmunizationDTO
			{
				return _immDTO;
			}
			
			public function set immDTO(value:ImmunizationDTO):void
			{
				_immDTO = value;
			}
			
			
		]]>
	</fx:Script>
	
	<s:layout>
		<s:VerticalLayout paddingLeft="4" paddingRight="4" paddingTop="4" paddingBottom="4"/>
	</s:layout>
	
	<s:Group width="100%" height="100%"  >
		
		<s:HGroup width="100%" paddingBottom="4" paddingLeft="4" paddingRight="4" paddingTop="4">
			
			<s:VGroup width="25%" horizontalAlign="left" verticalAlign="top" >
				<s:HGroup width="100%" verticalAlign="middle">
					<s:BitmapImage id="img_Associated" source="{QIConstants.IMG_GREEN}"/>
					<s:Label text="Associated With:" width="{labelWidth}" styleName="patientFormLabel" />
				</s:HGroup>
				<s:HGroup width="100%" verticalAlign="middle" >
					<s:BitmapImage id="img_Immunization" source="{QIConstants.IMG_GREEN}"/>
					<s:Label text="Immunization:" width="{labelWidth}"	 styleName="patientFormLabel"	 />
				</s:HGroup>
				<s:HGroup width="100%" verticalAlign="middle">
					<s:Spacer width="11"/>
					<s:Label text="Date Admin:"	styleName="patientFormLabel" width="100%" verticalCenter="0" />
				</s:HGroup>
				<s:HGroup width="100%" verticalAlign="middle">
					<s:Spacer width="11"/>
					<s:Label text="Expiry Date:" styleName="patientFormLabel" width="100%" verticalCenter="0" />
				</s:HGroup>
				<s:HGroup width="100%" verticalAlign="middle">
					<s:Spacer width="11"/>
					<s:Label text="Body Route:"	styleName="patientFormLabel" width="100%" verticalCenter="0" />
				</s:HGroup>
				<s:HGroup width="100%" verticalAlign="middle">
					<s:Spacer width="11"/>
					<s:Label text="Site:" styleName="patientFormLabel" width="100%" verticalCenter="0" />
				</s:HGroup>
				<s:HGroup width="100%" verticalAlign="middle">
					<s:Spacer width="11"/>
					<s:Label text="Refusal:" styleName="patientFormLabel" width="100%" verticalCenter="0" />
				</s:HGroup>
				
			</s:VGroup>
			
			<s:VGroup width="25%"  gap="7" >
				<s:Label id="id_AssociateType" width="100%" text="{immDTO.AssociateType}" toolTip="{immDTO.AssociateType}" maxDisplayedLines="1" showTruncationTip="true" styleName="patientFormValue" />
				<s:Label width="100%" text="{immDTO.ImmunizationType.Name}" toolTip="{immDTO.ImmunizationType.Name}" maxDisplayedLines="1" showTruncationTip="true" styleName="patientFormValue" />
				<s:Label width="100%" text="{immDTO.DateAdmin == 'null' ? '':immDTO.DateAdmin}" toolTip="{immDTO.DateAdmin == 'null' ? '':immDTO.DateAdmin}" maxDisplayedLines="1" showTruncationTip="true" styleName="patientFormValue" />
				<s:Label width="100%" text="{immDTO.ExpiryDate}" toolTip="{immDTO.ExpiryDate}" maxDisplayedLines="1" showTruncationTip="true" styleName="patientFormValue" />
				<s:Label width="100%" text="{immDTO.Rout == 'null' ? '':immDTO.Rout}" toolTip="{immDTO.Rout == 'null' ? '':immDTO.Rout}" maxDisplayedLines="1" showTruncationTip="true" styleName="patientFormValue" />
				<s:Label width="100%" text="{immDTO.Site == 'null' ? '':immDTO.Site}" toolTip="{immDTO.Site == 'null' ? '':immDTO.Site}" maxDisplayedLines="1" showTruncationTip="true" styleName="patientFormValue" />
				<s:Label width="100%" text="{immDTO.RefusalReason == 'null' ? '':immDTO.RefusalReason}" toolTip="{immDTO.RefusalReason == 'null' ? '':immDTO.RefusalReason}" maxDisplayedLines="1" showTruncationTip="true" styleName="patientFormValue" />
			</s:VGroup>
			
			<s:Spacer width="10" />
			
			<s:VGroup width="25%" horizontalAlign="left" verticalAlign="top" >
				<s:HGroup id="id_preVisits" width="100%" verticalAlign="middle"  >
					<s:BitmapImage id="img_preVisits" source="{QIConstants.IMG_GREEN}" visible="{id_preVisitDates.text.length >=1 ? true:false}"/>
					<s:Label text="Previous Visits:" width="{labelWidth}" styleName="patientFormLabel" />
				</s:HGroup>
				<s:HGroup width="100%" verticalAlign="middle">
					<s:BitmapImage id="img_Dose" source="{QIConstants.IMG_GREEN}"/>
					<s:Label text="Dose:" styleName="patientFormLabel" />
				</s:HGroup>
				<s:HGroup width="100%" verticalAlign="middle">
					<s:Spacer width="11"/>
					<s:Label width="100%" verticalCenter="0" styleName="patientFormLabel" text="Next Due:"/>
				</s:HGroup>
				<s:HGroup width="100%" verticalAlign="middle">
					<s:Spacer width="11"/>
					<s:Label width="100%" verticalCenter="0" styleName="patientFormLabel" text="Lot #:"/>
				</s:HGroup>
				<s:HGroup width="100%" verticalAlign="middle">
					<s:Spacer width="11"/>
					<s:Label width="100%" verticalCenter="0" styleName="patientFormLabel" text="Manufacturer:"/>
				</s:HGroup>
				<s:HGroup width="100%" verticalAlign="middle">
					<s:Spacer width="11"/>
					<s:Label width="100%" verticalCenter="0" styleName="patientFormLabel" text="Series:"/>
				</s:HGroup>
				<s:HGroup width="100%" verticalAlign="middle">
					<s:Spacer width="11"/>
					<s:Label  width="100%" verticalCenter="0"	 styleName="patientFormLabel" text="Reason of Refusal:"/>
				</s:HGroup>
			</s:VGroup>
			
			<s:VGroup width="25%" gap="7" >
				<s:Label width="100%" id="id_preVisitDates" text="{immDTO.AssociateType == 'Previous Visit' ? UtilityFunctions.FormatDate(immDTO.VisitDate, 'MM/DD/YYYY') : ''}" toolTip="{immDTO.AssociateType == 'Previous Visit' ? UtilityFunctions.FormatDate(immDTO.VisitDate, 'MM/DD/YYYY') : ''}" maxDisplayedLines="1" showTruncationTip="true" styleName="patientFormValue" />
				<s:Label width="100%" id="id_dose" text="{immDTO.Dose == 'null' ? '':immDTO.Dose}" toolTip="{immDTO.Dose == 'null' ? '':immDTO.Dose}" maxDisplayedLines="1" showTruncationTip="true" styleName="patientFormValue" />
				<s:Label width="100%" text="{immDTO.NextDoseDue == 'null' ? '':immDTO.NextDoseDue}" toolTip="{immDTO.NextDoseDue == 'null' ? '':immDTO.NextDoseDue}" maxDisplayedLines="1" showTruncationTip="true" styleName="patientFormValue" />
				<s:Label width="100%" text="{immDTO.LotNumber == 'null' ? '':immDTO.LotNumber}" toolTip="{immDTO.LotNumber == 'null' ? '':immDTO.LotNumber}" maxDisplayedLines="1" showTruncationTip="true" styleName="patientFormValue" />
				<s:Label width="100%" text="{immDTO.Manufacturer == 'null' ? '':immDTO.Manufacturer}" toolTip="{immDTO.Manufacturer == 'null' ? '':immDTO.Manufacturer}" maxDisplayedLines="1" showTruncationTip="true" styleName="patientFormValue" />
				<s:Label width="100%" text="{immDTO.Series == 'null' ? '':immDTO.Series}" toolTip="{immDTO.Series == 'null' ? '':immDTO.Series}" maxDisplayedLines="1" showTruncationTip="true" styleName="patientFormValue" />
				<s:Label width="100%" text="{immDTO.RefusalReason == 'null' ? '':immDTO.RefusalReason}" toolTip="{immDTO.RefusalReason == 'null' ? '':immDTO.RefusalReason}" maxDisplayedLines="1" showTruncationTip="true" styleName="patientFormValue" />
			</s:VGroup>
		</s:HGroup>
		
	</s:Group>
</s:SkinnableContainer>