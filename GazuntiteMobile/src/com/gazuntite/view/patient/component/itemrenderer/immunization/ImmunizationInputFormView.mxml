					prompt="Select Associated Visit" width="100%"
					viewModel="{new SearchInputViewModel()}"
					searchInputManager="{new SearchInputManagerGeneral()}"
					/>
			</s:HGroup>
			<s:HGroup width="100%" height="100%" verticalAlign="middle" paddingLeft="16">
				<autoComplete:AutoComplete id="id_VisitDatesCombo" visible="false" includeInLayout="false"  
										   width="100%" height="25" prompt="Previous Visits" labelField="VisitDateLbl" 
										   dataProvider="{model.unSignedVisitDates}"
										   enabled="false"
										   skinClass="com.gazuntite.components.kapit.autoComplete.AutoCompleteSearchSkin"
										   />
				<component:SearchInput 
					prompt="Previous Visits" width="100%"
					viewModel="{new SearchInputViewModel()}"
					searchInputManager="{new SearchInputManagerGeneral()}"
					/>
			</s:HGroup>
			<s:HGroup width="100%" height="100%" verticalAlign="middle" paddingLeft="16">
<!--				<s:SkinnableContainer enabled="{id_NextDue.enabled}" width="50%" skinClass="com.gazuntite.skins.controls.container.input.DateCoverSkin" >-->
 				<components:DateInput id="id_DateAdmin" 
											   toolTip="Admin Date" width="100%" 
											   yearNavigationEnabled="true"  IsEditAllow="false" editable="false" maxYear="{new Date().getFullYear()}" minYear="1901"
											   prompt="Date Admin"   selectableRange="{{rangeEnd : new Date()}}" 
											   styleName="coverDateField"
											   />
<!--				</s:SkinnableContainer>-->
				<s:Spacer width="4" />
				<autoComplete:AutoComplete id="id_LotNoCmbo" visible="false" includeInLayout="false" 
										   prompt="Enter Lot #"  width="50%" height="25" 
										   dataProvider="{model.GeneralLabelDTOListForLot}" labelField="label"
										   keyUp="Combo_keyUpHandler(event)" maxChars="50"
										   skinClass="com.gazuntite.components.kapit.autoComplete.AutoCompleteSearchSkin"
										   /> 
				<component:SearchInput 
					prompt="Enter Lot #" width="50%"
					viewModel="{new SearchInputViewModel()}"
					searchInputManager="{new SearchInputManagerGeneral()}"
					/>
			</s:HGroup>
			<s:HGroup width="100%" height="100%" verticalAlign="middle" paddingLeft="16">
				<autoComplete:AutoComplete id="id_ManufacturerCmbo" visible="false" includeInLayout="false" 
										   prompt="Enter Manufacturer" width="100%" height="25" 
										   dataProvider="{model.GeneralLabelDTOListForManufacturer}" labelField="label"
										   skinClass="com.gazuntite.components.kapit.autoComplete.AutoCompleteSearchSkin"
										   keyUp="Combo_keyUpHandler(event)"  
										   />
				<component:SearchInput 
					prompt="Enter Manufacturer" width="100%"
					viewModel="{new SearchInputViewModel()}"
					searchInputManager="{new SearchInputManagerGeneral(TempDataModel.getInstance().manufactureList)}"
					/>
			</s:HGroup>
			<s:HGroup width="100%" height="100%" verticalAlign="middle" paddingLeft="15">
				<s:Label verticalCenter="0"	 styleName="patientFormLabel" text="Refusal:"/>
				<s:ToggleSwitch id="uiActive" skinClass="com.gazuntite.common.view.skin.ToggleSwitchYesNoSkin" selected="true"/>
				<s:ToggleButton id="id_RefusalChk" 
								toolTip="{id_RefusalChk.selected ? 'Yes' : 'No'}"
								styleName="yesNoToggle"
								visible="false" includeInLayout="false"
								/>
			</s:HGroup>
		</s:VGroup>
	</s:HGroup>
	<!-- *******************  Bottom Row ***************************** -->
	<s:HGroup width="100%" height="100%" verticalAlign="bottom" horizontalAlign="right">
		<s:Button label="Note" icon="place-holder.png" iconPlacement="top" fontSize="9" fontWeight="normal"
				  height="100%"
				  click="showNote(event)"
				  />
		
		<s:Button label="Dict" icon="place-holder.png" iconPlacement="top" fontSize="9" fontWeight="normal"
				  click="showDictation(event)"
				  />
		<s:Button label="Save" icon="place-holder.png" iconPlacement="top" fontSize="9" fontWeight="normal"
				  />

	</s:HGroup>
	
	<dictation:PatientDictationNoteView id="dictationNoteView"  isSectionLevel="true"
										width="100%" viewModel="{viewModel.inLineDictationNoteViewModel}" isSaveButtonVisible="false"/>
	
</s:Group>