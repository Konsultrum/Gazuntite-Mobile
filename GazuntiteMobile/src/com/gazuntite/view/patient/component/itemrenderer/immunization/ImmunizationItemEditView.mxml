<s:SkinnableContainer xmlns:fx="http://ns.adobe.com/mxml/2009" 
					  xmlns:s="library://ns.adobe.com/flex/spark" 
					  xmlns:mx="library://ns.adobe.com/flex/mx"
					  xmlns:components="com.gazuntite.controls.extended.components.*" xmlns:autoComplete="com.gazuntite.components.kapit.autoComplete.*" 
					  >
	<fx:Script>
		<![CDATA[
			import com.adobe.cairngorm.control.CairngormEventDispatcher;
			import com.gazuntite.common.dto.baseDTO.GeneralLabelDTO;
			import com.gazuntite.common.dto.baseDTO.GeneralTypeDTO;
			import com.gazuntite.common.dto.pmh.immunization.ImmunizationDTO;
			import com.gazuntite.common.util.ValidationUtils;
			import com.gazuntite.components.kapit.autoComplete.AutoComplete;
			import com.gazuntite.components.kapit.autoComplete.event.AutoCompleteEvent;
			import com.gazuntite.patient.visit.event.pmh.immunization.LoadImmunicationStaticDataEvent;
			import com.gazuntite.patient.visit.model.QIModelLocator;
			import com.gazuntite.patient.visit.utils.Constants;
			import com.gazuntite.patient.visit.utils.QIConstants;
			import com.gazuntite.view.patient.input.history.Immunization.PatientInputHistoryImmunizationEvent;
			import com.gazuntite.view.patient.input.history.Immunization.PatientInputHistoryImmunizationViewModel;
			import com.gazuntite.view.patient.viewmodel.PatientInputViewModel;
			
			import mx.collections.ArrayCollection;
//			import mx.controls.Alert;
			import mx.core.FlexGlobals;
			import mx.events.CloseEvent;
			
			import spark.events.IndexChangeEvent;
			import spark.events.TextOperationEvent;
			
			[Bindable]	private var model:QIModelLocator = QIModelLocator.getInstance();
			[Bindable]	private var modelInput:PatientInputViewModel = PatientInputViewModel.getInstance();
			
			[Bindable]
			private var viewModel:PatientInputHistoryImmunizationViewModel = PatientInputHistoryImmunizationViewModel.getInstance();
			
			[Bindable]	public var labelWidth:Number = 120;
			[Bindable]	private var arrAssociateTypes:ArrayCollection = new ArrayCollection(['This Visit', 'Previous Visit', 'N/A']);
			
			private var _immDTO:ImmunizationDTO;
			public var toolTipChanged:Boolean;
			
			[Bindable]
			public function get immDTO():ImmunizationDTO
			{
				return _immDTO;
			}
			
			public function set immDTO(value:ImmunizationDTO):void
			{
				_immDTO = value;
			}
			private function saveImmunization():void
			{
				if (!immDTO)
					return;
				
				if (isInvalid())
					return;
				
				immDTO.ImmunizationType 				= id_ImmunizationCmbo.selectedItem as GeneralTypeDTO;
				immDTO.Dose								= id_DoseCmbo.text;
				immDTO.LotNumber 						= id_LotNoCmbo.text;
				immDTO.Manufacturer						= id_ManufacturerCmbo.text;
				immDTO.Rout								= id_BodySideRouteCmbo.text;
				
				var reasonOfRefusal:String = ValidationUtils.TrimString(id_ReasonOfRefusalCmbo.text);
				
				if (reasonOfRefusal.length)
					immDTO.RefusalReason = reasonOfRefusal;
				
				immDTO.Site 							= id_SiteCmbo.text;
				immDTO.Series 							= id_SeriesCmbo.text;
				
				immDTO.CreatedAt 						= new Date();
				immDTO.UpdatedAt 						= new Date();
				immDTO.PatientID 						= model.patientDTO.ID;
				
				switch (id_AssociateVisitzCombo.selectedIndex)
				{
					case 0:
						immDTO.IsNA 					= false;
						immDTO.VisitID 					= model.VisitID;
						immDTO.VisitDate 				= model.VisitDate;
						immDTO.AssociateType 			= 'This Visit';
						break;
					case 1:
						immDTO.IsNA 					= false;
						immDTO.VisitID 					= id_VisitDatesCombo.selectedItem.VisitID;
						immDTO.AssociateType 			= 'Previous Visit';
						
						var prevAssociatedVisitDate:Date;
						
						if (id_VisitDatesCombo.selectedItem)
							prevAssociatedVisitDate 	= new Date(Date.parse(id_VisitDatesCombo.selectedItem.VisitDate));
						
						immDTO.VisitDate 				= prevAssociatedVisitDate;
						
						break;
					case 2:
						immDTO.IsNA 					= true;
						immDTO.VisitID 					= 0;
						immDTO.AssociateType 			= "N/A";
						immDTO.VisitDate 				= QIConstants.NULL_DATE;
						break;
				}
				
				immDTO.CreatedBy 						= model.LoggedInUserId;
				immDTO.ManagedBy 						= model.LoggedInUserId;
				immDTO.DateAdmin 						= id_DateAdmin.text;
				immDTO.NextDoseDue 						= id_NextDue.text;
				immDTO.ExpiryDate 						= id_ExpiryDate.text; 
				immDTO.ModifiedAt 						= Constants.NULL_DATE;
				immDTO.IsRecordEditable 				= true;
				immDTO.IsDirty 							= true;
				
				immDTO.NoteSubject 						= "";
				immDTO.DictationID 						= "00000000-0000-0000-0000-000000000000";
				
				if ((id_AssociateVisitzCombo.selectedIndex == 2) || (id_AssociateVisitzCombo.selectedIndex == 1 && id_VisitDatesCombo.selectedIndex != -1))
				{
//					Alert.show("Are you sure you want to update this record.", "Save Confirmation", Alert.YES | Alert.NO, this, alertSaveListener, null, Alert.OK)	
				}
				else
				{
					onManagePatientImmunizationEvent();
				}
			}
			
			private function alertSaveListener(eventObj:CloseEvent):void 
			{
//				if (eventObj.detail == Alert.YES) 
					onManagePatientImmunizationEvent();
			}
			
			// on ManagePatientImmunizationEvent Calling ////////////////
			private function onManagePatientImmunizationEvent():void
			{
				var ev:PatientInputHistoryImmunizationEvent = new PatientInputHistoryImmunizationEvent(
							PatientInputHistoryImmunizationEvent.PATIENT_INPUT_IMMUNIZATION_EDIT_EVENT, true);
				
				ev.immunizationDTO = immDTO;
				
				dispatchEvent(ev);
				
				dispatchEvent( new Event( 'saveStatus', true ) );
			}
			
			protected function id_AssociateVisitzCombo_changeHandler(event:TextOperationEvent):void
			{
				switch (id_AssociateVisitzCombo.selectedIndex)
				{
					case 0:
					case 2:
						
						id_VisitDatesCombo.selectedItem = null;
						id_VisitDatesCombo.text = "";
						id_VisitDatesCombo.visible = false;
						break;
					case 1:
					
						id_VisitDatesCombo.visible = true;
						break;
					default:
						id_VisitDatesCombo.visible = false;
						break;
				}
				
				toolTipChanged = true;
				invalidateProperties();
			}
			
			protected function Combo_keyUpHandler(event:KeyboardEvent):void
			{
				var searchString:String = event.currentTarget.text;
				
				var curTar:AutoComplete = event.currentTarget as AutoComplete;
				
				if (!curTar)
					return;
				
				if (searchString.length == 2 || searchString.length == 5)  //only search if length is 2 or 5
				{
					var lisd:LoadImmunicationStaticDataEvent;
					
					switch (curTar)
					{
						case id_ImmunizationCmbo:
							lisd = new LoadImmunicationStaticDataEvent(searchString, QIConstants.TYPE_SELECT_TYPE);
							break;
						case id_DoseCmbo:
							lisd = new LoadImmunicationStaticDataEvent(searchString, QIConstants.DOSE_SELECT_TYPE);
							break;
						case id_ManufacturerCmbo:
							lisd = new LoadImmunicationStaticDataEvent(searchString, QIConstants.MANUFACTURER_SELECT_TYPE);
							break;
						case id_SeriesCmbo:
							lisd = new LoadImmunicationStaticDataEvent(searchString, QIConstants.SERIERS_SELECT_TYPE);
							break;
						case id_ReasonOfRefusalCmbo:
							lisd = new LoadImmunicationStaticDataEvent(searchString, QIConstants.REFUSAL_SELECT_TYPE);
							break;
						case id_BodySideRouteCmbo:
							lisd = new LoadImmunicationStaticDataEvent(searchString, QIConstants.ROUT_SELECT_TYPE);
							break;
						case id_SiteCmbo:
							lisd = new LoadImmunicationStaticDataEvent(searchString, QIConstants.SITE_SELECT_TYPE);
							break;
						case id_LotNoCmbo:
							lisd = new LoadImmunicationStaticDataEvent(searchString, QIConstants.LOT_SELECT_TYPE);
							break;	
					}
					
					if (null != lisd)
						CairngormEventDispatcher.getInstance().dispatchEvent(lisd);
					
					toolTipChanged = true;
					invalidateProperties();
				}
			}
			
			public function areRequiredFieldsProvidedAndValid():Boolean
			{
				var result:Boolean = false;
				
				if ((id_ImmunizationCmbo.selectedIndex >= 0 && id_ImmunizationCmbo.selectedItem != null) &&
					(id_DoseCmbo.text.length >= 2 || id_DoseCmbo.selectedIndex >= 0 && id_DoseCmbo.selectedItem != null))
				{
					result = true;
					
					if (id_AssociateVisitzCombo.selectedIndex == 1)
					{
						if (id_VisitDatesCombo.selectedItem)
							result = true;
						else
							result = false;
					}
					
					if (id_RefusalChk.selected)
					{
						if (!id_ReasonOfRefusalCmbo.text.length && id_ReasonOfRefusalCmbo.selectedIndex < 0 )
						{
							result = false;
						}
					}
				}
				return result;
			}
			
			public function isInvalid():Boolean
			{
				var isNotValid:Boolean = false;
				var errorStr:String = "";
				var toSetFocus:Object;
				
				if (id_AssociateVisitzCombo.selectedIndex < 0 && !id_AssociateVisitzCombo.selectedItem)
				{
					isNotValid = true;
					
					errorStr += "Please select Associate Visit Type\n";
					
					if (!toSetFocus)
						toSetFocus = id_AssociateVisitzCombo;
				}
				
				if (id_AssociateVisitzCombo.selectedIndex == 1 || id_AssociateVisitzCombo.selectedItem == "Previous Visit")
				{
					if (id_VisitDatesCombo.selectedIndex < 0 && !id_VisitDatesCombo.selectedItem)
					{
						isNotValid = true;
						
						errorStr += "Please select Previous Visit Date\n";
						
						if (!toSetFocus)
							toSetFocus = id_VisitDatesCombo;
					}
				}
				
				if (id_ImmunizationCmbo.selectedIndex < 0 && !id_ImmunizationCmbo.selectedItem)
				{
					isNotValid = true;
					
					errorStr += "Please select Immunization\n";
					
					if (!toSetFocus)
						toSetFocus = id_ImmunizationCmbo;
				}
				
				if (!id_DoseCmbo.text.length)
				{
					isNotValid = true;
					
					errorStr += "Please enter Dose\n";
					
					if (!toSetFocus)
						toSetFocus = id_DoseCmbo;
				}
				
				if (id_RefusalChk.selected)
				{
					if (!id_ReasonOfRefusalCmbo.text.length)
					{
						isNotValid = true;
						
						errorStr += "Please select Reason Of Refusal\n";
						
						if (!toSetFocus)
							toSetFocus  = id_ReasonOfRefusalCmbo;
					}
				}
				
				if (errorStr.length > 0)
				{
//					Alert.show(errorStr, "Required Field", Alert.OK, FlexGlobals.topLevelApplication.mainContainer, function():void
//					{
						if (toSetFocus)
							toSetFocus.setFocus();
//					});
				}
				
				return isNotValid;
			}
			
			protected function id_DoseCmbo_changeHandler(event:TextOperationEvent):void
			{
				id_DoseCmbo.text.replace("-", "");
				id_DoseCmbo_keyUpHandler(event);
				
				toolTipChanged = true;
				invalidateProperties();
			}
			
			protected function id_DoseCmbo_keyUpHandler(event:Event):void
			{							
				if (id_DoseCmbo.text.length >= 2 || id_DoseCmbo.selectedIndex >= 0 || id_DoseCmbo.selectedItem != null)
					img_Dose.source	= QIConstants.IMG_GREEN;
				else if (id_DoseCmbo.text.length < 2)
					img_Dose.source	= QIConstants.IMG_RED;
				
				toolTipChanged = true;
				invalidateProperties();
			}
			
			private function comboChangeHandler(event:IndexChangeEvent):void
			{
				var curTar:AutoComplete = event.currentTarget as AutoComplete;
				
				if (!curTar)
					return;
				
				if (curTar == id_AssociateVisitzCombo)
				{
					if (curTar.selectedIndex > 0 && curTar.selectedIndex < curTar.dataProvider.length)
					{
						curTar.text = curTar.dataProvider[curTar.selectedIndex] as String;
					}
				}
				
				else if (curTar == id_ImmunizationCmbo)
				{
					if (curTar.selectedIndex > 0 && curTar.selectedIndex < curTar.dataProvider.length)
					{
						var dto:GeneralTypeDTO = curTar.dataProvider[curTar.selectedIndex] as GeneralTypeDTO;
						
						curTar.text = dto.Name;
					}
				}
				else if (curTar == id_VisitDatesCombo)
				{
					if (curTar.selectedIndex > 0 && curTar.selectedIndex < curTar.dataProvider.length)
					{
						var visitDateObj:Object = curTar.dataProvider[curTar.selectedIndex] as Object;
						
						curTar.text = visitDateObj.VisitDateLbl;
					}
				}
				
				else
				{
					if (curTar.selectedIndex > 0 && curTar.selectedIndex < curTar.dataProvider.length)
					{
						var labelDTO:GeneralLabelDTO = curTar.dataProvider[curTar.selectedIndex] as GeneralLabelDTO;
						
						curTar.text = labelDTO.label;
					}
				}
				
				toolTipChanged = true;
				invalidateProperties();
			}
			
			private function setToolTips():void
			{
				if (id_AssociateVisitzCombo.text.length)
				{
					id_AssociateVisitzCombo.toolTip = id_AssociateVisitzCombo.text;
				}
				else
				{
					id_AssociateVisitzCombo.toolTip = "Associated With";
				}
				
				if (id_ImmunizationCmbo.text.length)
				{
					id_ImmunizationCmbo.toolTip = id_ImmunizationCmbo.text;
				}
				else
				{
					id_ImmunizationCmbo.toolTip = "Immunization";
				}
				
				if (id_BodySideRouteCmbo.text.length)
				{
					id_BodySideRouteCmbo.toolTip = id_BodySideRouteCmbo.text;
				}
				else
				{
					id_BodySideRouteCmbo.toolTip = "Body Route";
				}
				
				if (id_SiteCmbo.text.length)
				{
					id_SiteCmbo.toolTip = id_SiteCmbo.text;
				}
				else
				{
					id_SiteCmbo.toolTip = "Site";
				}
				
				if (id_VisitDatesCombo.text)
				{
					id_VisitDatesCombo.toolTip = id_VisitDatesCombo.text;
				}
				else
				{
					id_VisitDatesCombo.toolTip = "Previous Visits";
				}
				
				if (id_DoseCmbo.text.length)
				{
					id_DoseCmbo.toolTip = id_DoseCmbo.text;
				}
				else
				{
					id_DoseCmbo.toolTip = "Dose";
				}
				
				if (id_LotNoCmbo.text.length)
				{
					id_LotNoCmbo.toolTip = id_LotNoCmbo.text;
				}
				else
				{
					id_LotNoCmbo.toolTip = "Lot #";
				}
				
				if (id_ManufacturerCmbo.text.length)
				{
					id_ManufacturerCmbo.toolTip = id_ManufacturerCmbo.text;
				}
				else
				{
					id_ManufacturerCmbo.toolTip = "Manufacturer";
				}
				
				if (id_SeriesCmbo.text.length)
				{
					id_SeriesCmbo.toolTip = id_SeriesCmbo.text;
				}
				else
				{
					id_SeriesCmbo.toolTip = "Series";
				}
				
				if (id_ReasonOfRefusalCmbo.text.length)
				{
					id_ReasonOfRefusalCmbo.toolTip = id_ReasonOfRefusalCmbo.text;
				}
				else
				{
					id_ReasonOfRefusalCmbo.toolTip = "Refusal";
				}
			}
			
			override protected function commitProperties():void
			{
				super.commitProperties();
				
				if (toolTipChanged)
				{
					toolTipChanged = false;
					
					setToolTips();
				}
			}
			// on selection/change of any item
			protected function id_ImmunizationCmbo_selectedItemChangeHandler(event:AutoCompleteEvent):void
			{
				if(id_ImmunizationCmbo.selectedIndex >= 0 || id_ImmunizationCmbo.selectedItem != null)
					img_Immunization.source	= QIConstants.IMG_GREEN;
			}
			// on text cleared
			protected function id_ImmunizationCmbo_textClearedHandler(event:Event):void
			{
				if(id_ImmunizationCmbo.text.length <= 2)
					img_Immunization.source = QIConstants.IMG_RED;
			}
			// on text cleared
			protected function id_DoseCmbo_textClearedHandler(event:Event):void
			{
				if(id_DoseCmbo.text.length <= 2)
					img_Dose.source = QIConstants.IMG_RED;
			}
			// on selection change
			protected function id_AssociateVisitzCombo_selectedItemChangeHandler(event:AutoCompleteEvent):void
			{
				if(id_AssociateVisitzCombo.selectedIndex >= 0 || id_AssociateVisitzCombo.selectedItem != null)
					img_Associated.source = QIConstants.IMG_GREEN;
				
				if(id_AssociateVisitzCombo.selectedIndex == 1)
					id_VisitDatesCombo.enabled = true;
				else
					id_VisitDatesCombo.enabled = false;
			}
		]]>
	</fx:Script>
	
	<s:layout>
		<s:VerticalLayout paddingLeft="4" paddingRight="4" paddingTop="5" paddingBottom="4"/>
	</s:layout>
	
	<s:HGroup width="100%" >
		<s:VGroup width="50%" horizontalAlign="left" verticalAlign="top" >
			<s:HGroup width="100%" verticalAlign="middle" height="100%">
				<s:BitmapImage id="img_Immunization" source="{QIConstants.IMG_RED}"/>
				<autoComplete:AutoComplete id="id_ImmunizationCmbo" 
										   width="100%" height="25" labelField="Name" 
										   dataProvider="{model.GeneralTypeDTOListForImmunizationType}"
										   keyUp="Combo_keyUpHandler(event)" prompt="Select Immunization"
										   selectedItemChange="id_ImmunizationCmbo_selectedItemChangeHandler(event)"
										   textCleared="id_ImmunizationCmbo_textClearedHandler(event)"
										   />
			</s:HGroup>
			
			<s:HGroup width="100%" height="100%" verticalAlign="middle">
				<s:BitmapImage id="img_Dose" source="{QIConstants.IMG_RED}"/>
				<autoComplete:AutoComplete id="id_DoseCmbo" 
										   prompt="Enter Dose" width="50%"  height="25" maxChars="50"
										   dataProvider="{model.GeneralLabelDTOListForDose}" labelField="label"
										   keyUp="Combo_keyUpHandler(event)"  
										   change="id_DoseCmbo_changeHandler(event)"
										   textCleared="id_DoseCmbo_textClearedHandler(event)"
										   />
				<s:Spacer width="5" />
				<autoComplete:AutoComplete id="id_BodySideRouteCmbo" 
										   prompt="Enter Body Side/Route" width="50%" height="25"
										   dataProvider="{model.GeneralLabelDTOListForRoute}"
										   keyUp="Combo_keyUpHandler(event)"   labelField="label" 
										   />
			</s:HGroup>
			
			<s:HGroup width="100%" height="100%" verticalAlign="middle" paddingLeft="16">
<!--				<s:SkinnableContainer enabled="{id_ExpiryDate.enabled}" width="50%" 
									  styleName="DateCoverBG" 
									  >-->
					<components:DateInput id="id_ExpiryDate" 
											   toolTip="Expiry Date" width="100%"
											   yearNavigationEnabled="true"  IsEditAllow="false" editable="false" maxYear="{new Date().getFullYear()}" minYear="1901"
											   prompt="Expiry Date" 
											   styleName="coverDateField"
											   />
<!--				</s:SkinnableContainer>-->
				<s:Spacer width="4" />
				<s:SkinnableContainer enabled="{id_NextDue.enabled}" width="50%" 
									  >
					<components:DateInput id="id_NextDue" 
											   toolTip="Next Due"  width="100%"
											   yearNavigationEnabled="true"  IsEditAllow="false" editable="false" 
											   selectableRange="{{rangeStart:new Date()}}"   prompt="Next Due"
											   styleName="coverDateField"
											   />
				</s:SkinnableContainer>
			</s:HGroup>
			
			<s:HGroup width="100%" height="100%" verticalAlign="middle" paddingLeft="16">
				<autoComplete:AutoComplete id="id_SiteCmbo" 
										   prompt="Enter Site" width="50%" height="25" maxChars="250" labelField="label" 
										   skinClass="com.gazuntite.components.kapit.autoComplete.AutoCompleteSearchSkin"
										   dataProvider="{model.GeneralLabelDTOListForSite}"
										   keyUp="Combo_keyUpHandler(event)" tabIndex="14"
										   />
				<s:Spacer width="4" />
				<autoComplete:AutoComplete id="id_SeriesCmbo" 
										   prompt="Enter Series" width="50%" height="25" labelField="label" 
										   skinClass="com.gazuntite.components.kapit.autoComplete.AutoCompleteSearchSkin"
										   dataProvider="{model.GeneralLabelDTOListForSeries}"
										   keyUp="Combo_keyUpHandler(event)"  />
			</s:HGroup>
			
			<s:HGroup width="100%" height="100%" verticalAlign="middle" paddingLeft="16">
				<autoComplete:AutoComplete id="id_ReasonOfRefusalCmbo"
										   width="100%" height="25"  labelField="label"
										   dataProvider="{model.GeneralLabelDTOListForRefusal}"
										   keyUp="Combo_keyUpHandler(event)"
										   maxChars="500" prompt="Select Reason of Refusal"
										   skinClass="com.gazuntite.components.kapit.autoComplete.AutoCompleteSearchSkin"
										   />
			</s:HGroup>
			
		</s:VGroup>
		
		<s:VGroup width="50%" horizontalAlign="left" verticalAlign="top" >
			<s:HGroup width="100%" height="100%" verticalAlign="middle">
				<s:BitmapImage id="img_Associated"  source="{QIConstants.IMG_RED}"/>
				<autoComplete:AutoComplete id="id_AssociateVisitzCombo" 
										   width="100%" height="25" labelField="DISPLAY_NAME"
										   selectedItemChange="id_AssociateVisitzCombo_selectedItemChangeHandler(event)"
										   change="id_AssociateVisitzCombo_changeHandler(event)"
										   dataProvider="{arrAssociateTypes}" prompt="Select Associated Visit"
										   />
			</s:HGroup>
			<s:HGroup width="100%" height="100%" verticalAlign="middle" paddingLeft="16">
				<autoComplete:AutoComplete id="id_VisitDatesCombo" 
										   width="100%" height="25" labelField="VisitDateLbl" prompt="Previous Visits" 
										   dataProvider="{model.unSignedVisitDates}"  enabled="false"
										   skinClass="com.gazuntite.components.kapit.autoComplete.AutoCompleteSearchSkin"
										   />
			</s:HGroup>
			<s:HGroup width="100%" height="100%" verticalAlign="middle" paddingLeft="16">
				<s:SkinnableContainer enabled="{id_NextDue.enabled}" width="50%" skinClass="com.gazuntite.skins.controls.container.input.DateCoverSkin" >
					<components:DateInput id="id_DateAdmin" 
											   toolTip="Admin Date" width="100%" 
											   yearNavigationEnabled="true"  IsEditAllow="false" editable="false" maxYear="{new Date().getFullYear()}" minYear="1901"
											   prompt="Date Admin"   selectableRange="{{rangeEnd : new Date()}}" 
											   styleName="coverDateField"
											   />
				</s:SkinnableContainer>
				<s:Spacer width="4" />
				<autoComplete:AutoComplete id="id_LotNoCmbo" 
										   prompt="Enter Lot #"  width="50%" height="25" labelField="label"
										   dataProvider="{model.GeneralLabelDTOListForLot}"
										   keyUp="Combo_keyUpHandler(event)" maxChars="50"
										   skinClass="com.gazuntite.components.kapit.autoComplete.AutoCompleteSearchSkin"
										   /> 
			</s:HGroup>
			<s:HGroup width="100%" height="100%" verticalAlign="middle" paddingLeft="16">
				<autoComplete:AutoComplete id="id_ManufacturerCmbo" 
										   prompt="Enter Manufacturer" width="100%" height="25" labelField="label"
										   dataProvider="{model.GeneralLabelDTOListForManufacturer}"
										   skinClass="com.gazuntite.components.kapit.autoComplete.AutoCompleteSearchSkin"
										   keyUp="Combo_keyUpHandler(event)"  
										   />
			</s:HGroup>
			<s:HGroup width="100%" height="100%" verticalAlign="middle" paddingLeft="15">
				<s:Label verticalCenter="0"	 fontFamily="CalibriCFF" fontSize="14" color="0xFFFFFF" text="Refusal:"/>
				<s:ToggleButton id="id_RefusalChk" 
								toolTip="{id_RefusalChk.selected ? 'Yes' : 'No'}"
								/>
			</s:HGroup>
		</s:VGroup>
	</s:HGroup>
	<!-- *******************  Bottom Row ***************************** -->
	<s:HGroup width="100%" height="100%" verticalAlign="bottom" horizontalAlign="right">
		<s:Button id="save"
				  buttonMode="true" useHandCursor="true"
				  toolTip="Save"  skinClass="com.gazuntite.skins.controls.button.SaveButtonSkin" 
				  click="saveImmunization()"
				  />
	</s:HGroup>
</s:SkinnableContainer>