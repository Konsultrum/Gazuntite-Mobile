<?xml version="1.0" encoding="utf-8"?>
<s:SkinnableContainer xmlns:fx="http://ns.adobe.com/mxml/2009" 
					  xmlns:s="library://ns.adobe.com/flex/spark" 
					  xmlns:mx="library://ns.adobe.com/flex/mx"
					  creationComplete="CC(event)"
					  >
	<fx:Script>
		<![CDATA[
			import com.adobe.cairngorm.control.CairngormEventDispatcher;
			import com.gazuntite.common.dto.baseDTO.GeneralTypeDTO;
			import com.gazuntite.common.dto.pmh.compHistory.DiseaseTypeDTO;
			import com.gazuntite.common.dto.pmh.compHistory.FamilyHistoryDTO;
			import com.gazuntite.common.dto.pmh.compHistory.RelationshipTypeDTO;
			import com.gazuntite.common.event.visit.LoadDiagnosisICDCodeEvent;
			import com.gazuntite.patient.visit.event.pmh.comphistory.LoadFamilyHistoryByPatientIdEvent;
			import com.gazuntite.patient.visit.event.pmh.comphistory.ManagePatientFamilyHistoryEvent;
			import com.gazuntite.patient.visit.model.QIModelLocator;
			import com.gazuntite.patient.visit.utils.QIConstants;
			import com.gazuntite.utils.UtilityFunctions;
			import com.gazuntite.view.patient.input.history.comprehensive.PatientInputHistoryComprehensiveViewModel;
			
			import mx.collections.ArrayCollection;
			import mx.controls.Alert;
			import mx.core.FlexGlobals;
			import mx.events.CloseEvent;
			import mx.events.FlexEvent;
			
			import spark.events.IndexChangeEvent;
			
			[Bindable]	protected var model:QIModelLocator = QIModelLocator.getInstance();
			[Bindable]	protected var viewModel:PatientInputHistoryComprehensiveViewModel = PatientInputHistoryComprehensiveViewModel.getInstance();
			
			[Bindable]	public var labelWidth:Number = 70;
			
			private var _familyHistoryDto:FamilyHistoryDTO;
			
			[Bindable]
			public var availableIcdCodeList:ArrayCollection = viewModel.availableGeneralIcdCodeList;
			
			
			protected function handleSave(event:MouseEvent):void
			{				
				saveForm();				
			}
			
			private function saveForm():void
			{
				
				if(UtilityFunctions.IsNullOrEmpty(id_TypeOfDisease.textInput.text))
				{				
					Alert.show("Please select ICD Code or enter Disease.","Required field", 
						Alert.OK, FlexGlobals.topLevelApplication.mainContainer, 
						function( event:CloseEvent):void
						{
							if( event.detail == Alert.OK )
							{
								id_ICDCode.setFocus();
							}
						});
					return;		
				}
				
				
				//if(id_TextArea)
					//familyHistoryDTO.FamilyHistoryNote   = id_TextArea.text;
				if(id_Relation.selectedItem)
					familyHistoryDto.ReletionshipType = id_Relation.selectedItem as RelationshipTypeDTO;			
				familyHistoryDto.DiseaseType.Name 		= icd_description;				 	
				familyHistoryDto.ModifiedBy  = model.LoggedInUserId;
				familyHistoryDto.ModifiedAt  = new Date();
				
				if(null != model.FamilyHistoryList)
					model.FamilyHistoryList.removeAll();
				else
					model.FamilyHistoryList = new ArrayCollection();
				
				model.FamilyHistoryList.addItem(familyHistoryDto);
				
				saveFamilyHistory();
			}
			
			private function saveFamilyHistory():void
			{
				var familyHistoryRecord:FamilyHistoryDTO = new FamilyHistoryDTO();
				if( null != model.FamilyHistoryList && model.FamilyHistoryList.length)
				{
					familyHistoryRecord = model.FamilyHistoryList.getItemAt(0) as FamilyHistoryDTO;
				}
				var evt:ManagePatientFamilyHistoryEvent = new ManagePatientFamilyHistoryEvent( model.patientDTO.ID, model.ClinicBranchIdSeq, familyHistoryRecord, clearFamilyHistory );
				CairngormEventDispatcher.getInstance().dispatchEvent( evt );
			}
			private function clearFamilyHistory():void
			{					
				//update skins for icons....
				dispatchEvent(new Event("clearNotesEvent",true, true ));
				
				//update controls
				dispatchEvent( new Event("data_added", true, true) );
				
				loadFamilyHistory();
			}
			private function loadFamilyHistory():void
			{
				var ll:LoadFamilyHistoryByPatientIdEvent = new LoadFamilyHistoryByPatientIdEvent( );
				CairngormEventDispatcher.getInstance().dispatchEvent( ll );
			}
			
			[Bindable]
			private var relation_name:String = "";
			private var relation_id:int ;
			private var icd_code:String = "";
			private var icd_description:String = "";
			
			protected function id_Relation_changeHandler(event:IndexChangeEvent):void
			{
				if( id_Relation.selectedItem && id_Relation.selectedIndex >= 0 )
				{
					relation_id 	= (id_Relation.selectedItem as RelationshipTypeDTO).ID
					relation_name 	= ( id_Relation.selectedItem as RelationshipTypeDTO).Name;
				}
				else
				{
					relation_id 	= undefined;
					relation_name 	= "";
				}
			}
			
			private function icdCodeChangeHandler_keyUp():void
			{
				searchTerm = id_ICDCode.textInput.text;
				/* if(searchTerm.length >=3)
				{
					id_TypeOfDisease.textInput.text = '';
					id_TypeOfDisease.selectedIndex = -1; 
					
					var icdEvent : LoadDiagnosisICDCodeEvent = new LoadDiagnosisICDCodeEvent( searchTerm,model.LoggedInUserSessionID,model.LoggedInUserId, ICDCodeloadResult);
					CairngormEventDispatcher.getInstance().dispatchEvent( icdEvent );
					
				}  */
				
			}
			
			private function ICDCodeloadResult(icdCodeList:ArrayCollection):void
			{
				model.icdCodeDTOList = icdCodeList;
			}
			
			protected function id_ICDCode_changeHandler(event:IndexChangeEvent):void
			{
				if( id_ICDCode.selectedIndex >= 0  )
				{ 
					var item:DiseaseTypeDTO 		= id_ICDCode.selectedItem;
					icd_code 						= item.DiseaseTypeCode;
					icd_description					= item.Description;
					id_TypeOfDisease.selectedIndex 	= id_ICDCode.selectedIndex;
					
					
					dispatchEvent( new Event("ICD_Change", true, true ) );
				} 
			}
			
			protected function id_Description_changeHandler(event:IndexChangeEvent):void
			{
				//if(id_TypeOfDisease.textInput.text.length > 3 )
				if(id_TypeOfDisease.selectedIndex >= 0 )
				{
					if( id_TypeOfDisease.selectedIndex >= 0 )
					{
						var sel:DiseaseTypeDTO = id_TypeOfDisease.selectedItem as DiseaseTypeDTO;
						icd_description		= sel.Description;
						icd_code			= sel.DiseaseTypeCode.toString();
						
						id_ICDCode.selectedIndex = id_TypeOfDisease.selectedIndex; 
					}
					else
					{
						icd_description		= id_TypeOfDisease.textInput.text
					}
					
					dispatchEvent( new Event("ICD_Change", true, true ) );
				} 
			}
			private var searchTerm:String;
			private function icdDescriptionChangeHandler_keyUp():void
			{
				searchTerm = id_TypeOfDisease.textInput.text;
				if(searchTerm.length > 150)
					return;
				//if value exceeds 3 characters then search Icd Code and map the Icd Code.
				if(searchTerm.length >=3)
				{
					icd_description = searchTerm;
					
					if( id_TypeOfDisease.selectedItem && id_TypeOfDisease.selectedIndex >= 0)
					{
						var item:DiseaseTypeDTO 		= id_TypeOfDisease.selectedItem;
						icd_code 						= item.DiseaseTypeCode;
						icd_description					= item.Description;
						id_ICDCode.selectedIndex		= id_TypeOfDisease.selectedIndex; 
					}
					dispatchEvent( new Event("ICD_Change", true, true ) );
				} 
			}
			
			[Bindable]
			public var lableWidth:Number = 70;
			
			protected function CC(event:FlexEvent):void
			{
				switch(familyHistoryDto.FamilyHistoryType.Name)
				{
					case QIConstants.FAMILY_HEART_DISEASE_MODULE_NAME:
					{
						id_TypeOfDisease.dataProvider = model.heartDiseaseDiseaseTypesDTOList;
						break;
					}					
					case QIConstants.FAMILY_HYPERTENSION_MODULE_NAME:
					{
						id_TypeOfDisease.dataProvider = model.hypertensionDiseaseTypesDTOList;
						break;
					}				
					case QIConstants.FAMILY_DIABETES_MODULE_NAME:
					{
						id_TypeOfDisease.dataProvider = model.diabetesDiseaseTypesDTOList;
						break;
					}					
					case QIConstants.FAMILY_CANCER_MODULE_NAME:
					{
						id_TypeOfDisease.dataProvider = model.cancerDiseaseTypesDTOList;
						break;
					}					
					case QIConstants.FAMILY_OTHER_MODULE_NAME:
					{
						id_TypeOfDisease.dataProvider = model.otherDiseaseTypesDTOList;
						break;
					}					
				}
				
				id_Relation.selectedItem = familyHistoryDto.ReletionshipType;
				
				for each (var dz:DiseaseTypeDTO in id_TypeOfDisease.dataProvider) 
				{
					if(familyHistoryDto.DiseaseType.Name == dz.Description)
					{
						id_TypeOfDisease.selectedItem = dz;
						id_ICDCode.selectedItem = dz;
					}
				}
			}
			
			[Bindable]
			public function get familyHistoryDto():FamilyHistoryDTO
			{
				return _familyHistoryDto;
			}
			
			public function set familyHistoryDto(value:FamilyHistoryDTO):void
			{
				_familyHistoryDto = value;
			}
			
		]]>
	</fx:Script>
	
	
	<fx:Declarations>
		<mx:DateFormatter id="formatDateTime" formatString="MM/DD/YYYY" />
	</fx:Declarations>
	
	<s:layout>
		<s:HorizontalLayout paddingLeft="8" paddingRight="8" paddingTop="5" paddingBottom="8"/>
	</s:layout>
	
	<s:VGroup width="50%" gap="2">	
		<s:HGroup width="100%" verticalAlign="middle">			
			<s:Label text="Relation:" width="60"/>
			<s:ComboBox id="id_Relation" width="225" prompt="Relation" dataProvider="{model.RelationShipTypeList}"
						labelField="Name" change="id_Relation_changeHandler(event)" 
						useHandCursor="true" buttonMode="true"
						skinClass="com.gazuntite.skins.IPEControls.IPEComboboxSkin" 
						toolTip="{id_Relation.selectedItem ? id_Relation.selectedItem.Name : 'Relation'}"
						selectedItem="{familyHistoryDto.ReletionshipType}"
						/>
		</s:HGroup>
		<s:HGroup width="100%" verticalAlign="middle">
			
			<s:Label text="ICD Code:" width="60"/>
			<s:ComboBox id="id_ICDCode" prompt="ICD Code" width="225" dataProvider="{id_TypeOfDisease.dataProvider}"
						keyUp="icdCodeChangeHandler_keyUp()"  labelField="DiseaseTypeCode"
						change="id_ICDCode_changeHandler(event)" useHandCursor="true" buttonMode="true"
						skinClass="com.gazuntite.skins.IPEControls.IPEComboboxSkin" 
						toolTip="{id_ICDCode.selectedItem ? id_ICDCode.selectedItem.DiseaseTypeCode : 'ICD Code'}"
						tabIndex="3" 
						selectedItem="{familyHistoryDto.DiseaseType.ID}"/>
		</s:HGroup>
		
		<s:HGroup width="100%" verticalAlign="middle">
			<s:Label text="Disease:" width="60"/>
			<s:ComboBox id="id_TypeOfDisease" prompt="Disease" width="225" 
						keyUp="icdDescriptionChangeHandler_keyUp()" 
						change="id_Description_changeHandler(event)" useHandCursor="true" buttonMode="true" 
						labelField="Description"
						skinClass="com.gazuntite.skins.IPEControls.IPEComboboxSkin"   
						toolTip="{id_TypeOfDisease.selectedItem ? id_TypeOfDisease.selectedItem.Description : 'Disease'}"
						tabIndex="4"
						selectedItem="{familyHistoryDto.DiseaseType.Name}"/>
		</s:HGroup>
		
	</s:VGroup>
	
	<s:HGroup height="100%" width="100%" verticalAlign="bottom" horizontalAlign="right">
		<s:Button buttonMode="true"
				  skinClass="com.gazuntite.skins.controls.button.SaveButtonSkin" 
				  toolTip="Save"
				  click="handleSave(event)"
				  />
		<!--<s:Button buttonMode="true"
		skinClass="com.gazuntite.view.patient.component.NextButtonSkin" 
		toolTip="Next"
		visible="{!inItemRenderer}"
		includeInLayout="{!inItemRenderer}"
		/>-->
	</s:HGroup>
</s:SkinnableContainer>
