<?xml version="1.0" encoding="utf-8"?>
<s:Skin xmlns:s="library://ns.adobe.com/flex/spark"
		xmlns:fx="http://ns.adobe.com/mxml/2009"
		xmlns:d="http://ns.adobe.com/fxg/2008/dt"
		 height="25">
	<fx:Metadata>[HostComponent("spark.components.ToggleButton")]</fx:Metadata>
	<s:states>
		<s:State name="up"/>
		<s:State name="over"/>
		<s:State name="down"/>
		<s:State name="disabled"/>
		<s:State name="upAndSelected"/>
		<s:State name="overAndSelected"/>
		<s:State name="downAndSelected"/>
		<s:State name="disabledAndSelected"/>
	</s:states>
	<s:Rect x="0.5" y="0.5" right="0" height="24" alpha="1" radiusX="0"
			visible.downAndSelected="false"
			visible.overAndSelected="false"
			visible.upAndSelected="false">
		<s:stroke>
			<s:SolidColorStroke caps="round" color="#545454" joints="miter" miterLimit="3" weight="1"/>
		</s:stroke>
		<s:fill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry alpha="1" color="#FFFFFF" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#D7D7D7" ratio="0.49019607843137253"/>
				<s:GradientEntry alpha="1.0" color="#BDBBB5" ratio="0.4980392156862745"/>
				<s:GradientEntry alpha="1.0" color="#FFFFFF" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
	</s:Rect>
	<s:Rect includeIn="downAndSelected,overAndSelected,upAndSelected" x="0" y="0" width="160" height="25" alpha="1" radiusX="0">
		<s:filters>
			<s:DropShadowFilter alpha="0.75" angle="90" blurX="2" blurY="2" color="#000000"
								distance="1" hideObject="false" inner="false" knockout="false"
								quality="3" strength="1"/>
		</s:filters>
		<s:fill>
			<s:LinearGradient rotation="0">
				<s:GradientEntry alpha="1.0" color="#A0B9FE" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#83A3FE" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
	</s:Rect>
	<s:RichText id="labelDisplay" maxDisplayedLines="1" showTruncationTip="true" width="90" 
				includeIn="disabledAndSelected,downAndSelected,overAndSelected,upAndSelected" x="7"
				y="7" color="#000000" fontFamily="Calibri" fontSize="12" fontWeight="bold"
				tabStops="S0"
				color.disabledAndSelected="#666666" tabStops.disabledAndSelected="S0 S50"/>
</s:Skin>
