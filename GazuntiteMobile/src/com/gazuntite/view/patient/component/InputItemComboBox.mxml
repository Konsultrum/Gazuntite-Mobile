<?xml version="1.0" encoding="utf-8"?>
<s:VGroup xmlns:fx="http://ns.adobe.com/mxml/2009" 
		 xmlns:s="library://ns.adobe.com/flex/spark" 
		 xmlns:mx="library://ns.adobe.com/flex/mx" xmlns:component="com.gazuntite.view.patient.component.*">
	<fx:Script>
		<![CDATA[
			[Bindable]
			public var formLabel:String = "";
			private var _showValid:Boolean = false;

			[Bindable]
			public function get showValid():Boolean
			{
				return _showValid;
			}

			public function set showValid(value:Boolean):void
			{
				_showValid = value;
				if (_showValid)
				{
					showInvalid = false;
				}
			}

			
			private var _showInvalid:Boolean = false;

			[Bindable]
			public function get showInvalid():Boolean
			{
				return _showInvalid;
			}

			public function set showInvalid(value:Boolean):void
			{
				_showInvalid = value;
				if (_showInvalid)
				{
					showValid = false;
				}
			}

			
			[Bindable]
			public var prompt:String = "";
		]]>
	</fx:Script>
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	<s:HGroup width="100%" verticalAlign="baseline">
		<s:BitmapImage id="uiCheckImg"
					   source="@Embed('/assets/images/checkmark_green.png')"
					   visible="{showValid}" includeInLayout="{showValid}"
					   />
		<s:BitmapImage scaleMode="letterbox" source="@Embed('/assets/images/dot_red.png')"
					   visible="{showInvalid}" includeInLayout="{showInvalid}"
					   />
		<s:Rect width="11" 
				visible="{!showValid &amp;&amp; !showInvalid}"
				includeInLayout="{!showValid &amp;&amp; !showInvalid}"
				/>
		<s:Label id="uiLabel"
				 text="{formLabel}"
				 styleName="patientFormText"
				 />
	</s:HGroup>
	<s:HGroup width="100%">
		<s:Rect width="11"/>
		<component:PromptComboBox
			
			prompt="{prompt}"
			width="100%" height="24"/>
	</s:HGroup>
</s:VGroup>
