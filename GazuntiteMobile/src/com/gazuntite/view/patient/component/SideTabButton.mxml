<?xml version="1.0" encoding="utf-8"?>
<s:Group xmlns:fx="http://ns.adobe.com/mxml/2009" 
		 xmlns:s="library://ns.adobe.com/flex/spark" 
		 xmlns:mx="library://ns.adobe.com/flex/mx" width="100%">
	<fx:Script>
		<![CDATA[
			[Bindable]
			public var label:String;
			
			[Bindable]
			public var tabSelected:Boolean = false;
			
			[Bindable]
			public var dataSelected:Boolean = false;
			
			public function onTabSelectionChange(event:Event):void
			{
				if (!uiToggleButton.selected)
				{
					uiToggleButton.selected = true;
//					event.stopImmediatePropagation();
				}
			}
		]]>
	</fx:Script>
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>

	<s:ToggleButton id="uiToggleButton" 
					buttonMode="true" useHandCursor="true"
					label="{uiToggleButton.selected?label.toUpperCase():label}" 
					selected="{tabSelected}" change="onTabSelectionChange(event)"
					left="0" right="0" top="0" bottom="0" 
					skinClass="com.gazuntite.view.patient.component.SideTabButtonSkin"
					/>
	<s:ToggleButton right="7" verticalCenter="0" selected="@{dataSelected}" 
					buttonMode="true" useHandCursor="true"
					skinClass="com.gazuntite.view.patient.component.YesNoToggleButtonSkin"
					/>
</s:Group>
