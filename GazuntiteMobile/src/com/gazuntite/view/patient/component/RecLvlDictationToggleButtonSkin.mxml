<?xml version="1.0" encoding="utf-8"?>
<s:Skin xmlns:s="library://ns.adobe.com/flex/spark"
		xmlns:fx="http://ns.adobe.com/mxml/2009"
		xmlns:ATE="http://ns.adobe.com/ate/2009"
		xmlns:ai="http://ns.adobe.com/ai/2009"
		xmlns:d="http://ns.adobe.com/fxg/2008/dt"
		xmlns:flm="http://ns.adobe.com/flame/2008"
		xmlns:lib="assets.graphics.*"
		xmlns:fc="http://ns.adobe.com/flashcatalyst/2009"
		width="20" height="20">
	<fx:Metadata>[HostComponent("spark.components.ToggleButton")]</fx:Metadata>
	<s:states>
		<s:State name="up"/>
		<s:State name="over"/>
		<s:State name="down"/>
		<s:State name="disabled"/>
		<s:State name="upAndSelected"/>
		<s:State name="overAndSelected"/>
		<s:State name="downAndSelected"/>
		<s:State name="disabledAndSelected"/>
	</s:states>
	<s:Rect includeIn="up" x="0.5" y="0.5" width="19" height="19" radiusX="2">
		<s:fill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry alpha="1.0" color="#666666" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#444545" ratio="0.5254901960784314"/>
				<s:GradientEntry alpha="1.0" color="#000000" ratio="0.5294117647058824"/>
				<s:GradientEntry alpha="1.0" color="#000000" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter alpha="0.25" angle="90" blurX="0" blurY="0" color="#FFFFFF" distance="1" hideObject="false" inner="false" knockout="false" quality="3" strength="1"/>
			<s:DropShadowFilter alpha="0.5" angle="90" blurX="1" blurY="1" color="0x000000" distance="1" hideObject="false" inner="true" knockout="false" quality="3" strength="1"/>
		</s:filters>
		<s:stroke>
			<s:LinearGradientStroke caps="none" joints="miter" miterLimit="4" rotation="90" weight="1">
				<s:GradientEntry alpha="1.0" color="#333333" ratio="0"/>
				<s:GradientEntry alpha="1" color="#000000" ratio="1"/>
			</s:LinearGradientStroke>
		</s:stroke>
	</s:Rect>
	<s:Rect includeIn="down,downAndSelected,over,overAndSelected,up,upAndSelected" x="0.5"
			radiusX="2"
			y.down="0.5" width.down="19" height.down="19"
			y.downAndSelected="0.5" width.downAndSelected="19" height.downAndSelected="19"
			y.over="0.5" width.over="19" height.over="19"
			y.overAndSelected="0.5" width.overAndSelected="19" height.overAndSelected="19"
			visible.up="false" y.up="1.5" width.up="17" height.up="17"
			y.upAndSelected="0.5" width.upAndSelected="19" height.upAndSelected="19">
		<s:fill>
			<s:LinearGradient rotation="90" rotation.over="270">
				<s:GradientEntry alpha="1.0" color="#64281A" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#C68475" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter alpha="0.5" angle="90" blurX="2" blurY="2" color="0x000000" distance="1" hideObject="false" includeIn="down,downAndSelected,overAndSelected,up,upAndSelected" inner="true" knockout="false" quality="3" strength="1"/>
		</s:filters>
		<s:stroke>
			<s:SolidColorStroke alpha="0.41000000000000003" caps="none" color="#CCCCCC" joints="miter" miterLimit="4" weight="1"/>
		</s:stroke>
	</s:Rect>
	<s:Rect includeIn="disabled,disabledAndSelected,downAndSelected,overAndSelected,upAndSelected"
			x="0.5" y="0.5" width="19" height="19" radiusX="2"
			visible.downAndSelected="false"
			visible.overAndSelected="false"
			visible.upAndSelected="false">
		<s:fill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry alpha="1.0" color="#CCCCCC" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#999999" ratio="0.5254901960784314"/>
				<s:GradientEntry alpha="1.0" color="#666666" ratio="0.5294117647058824"/>
				<s:GradientEntry alpha="1.0" color="#666666" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:stroke>
			<s:LinearGradientStroke caps="none" joints="miter" miterLimit="4" rotation="90" weight="1">
				<s:GradientEntry alpha="1.0" color="#333333" ratio="0"/>
				<s:GradientEntry alpha="1" color="#000000" ratio="1"/>
			</s:LinearGradientStroke>
		</s:stroke>
	</s:Rect>
	<s:BitmapImage includeIn="down,downAndSelected,over,up,upAndSelected" x="6" y="5" smooth="true"
				   source="@Embed('/assets/images/Dictation1.png')"
				   visible.downAndSelected="false"
				   visible.upAndSelected="false">
		<s:filters>
			<s:GlowFilter alpha="1.0" blurX="6.0" blurY="6.0" color="#FFFFFF" inner="true"
						  knockout="false" quality="3" strength="6"/>
			<s:DropShadowFilter alpha="1" angle="90" blurX="0" blurY="0" color="#000000"
								distance="1" hideObject="false" inner="false" knockout="false"
								quality="3" strength="1"/>
		</s:filters>
	</s:BitmapImage>
	<s:BitmapImage includeIn="disabled,disabledAndSelected,downAndSelected,overAndSelected,upAndSelected"
				   x="6" y="5" smooth="true" source="@Embed('/assets/images/Dictation1.png')">
		<s:filters>
			<s:GlowFilter alpha="1.0" blurX="6.0" blurY="6.0" color="#333333" inner="true"
						  knockout="false" quality="3" strength="6"
						  color.downAndSelected="#FFFFFF"
						  color.overAndSelected="#FFFFFF"
						  color.upAndSelected="#FFFFFF"/>
			<s:DropShadowFilter alpha="1" angle="90" blurX="0" blurY="0" color="#FFFFFF" distance="1"
								hideObject="false" inner="false" knockout="false" quality="3"
								strength="1"
								color.downAndSelected="#000000"
								color.overAndSelected="#000000"
								color.upAndSelected="#000000"/>
		</s:filters>
	</s:BitmapImage>
</s:Skin>
