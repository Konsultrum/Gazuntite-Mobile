<?xml version="1.0" encoding="utf-8"?>
<s:Group xmlns:fx="http://ns.adobe.com/mxml/2009" 
		 xmlns:s="library://ns.adobe.com/flex/spark" 
		 xmlns:mx="library://ns.adobe.com/flex/mx"
			>
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	<s:SkinnableContainer
		skinClass="com.gazuntite.skins.controls.container.DictationNoteGreySkin"
		top="4" bottom="4" left="4" right="4"
		>
		<s:layout>
			<s:VerticalLayout verticalAlign="middle" 
							  paddingLeft="10" paddingRight="10" paddingTop="4" paddingBottom="4"/>
		</s:layout>
		
		<s:HGroup width="100%">
			<s:Label text="Record 001" fontSize="14" color="#FFFFFF"/>
			<s:Rect width="100%"/>
			<s:Label text="Wed, 14 Feb 2013, 12:55" color="#FFFFFF"/>
		</s:HGroup>
		<s:HGroup width="100%" verticalAlign="middle">
			<s:HScrollBar width="100%" skinClass="com.gazuntite.skins.controls.scrollbar.DictationHScrollBarGreySkin"/>
			<s:Label text="2:38" color="#FFFFFF"/>
		</s:HGroup>
		<s:HGroup width="100%" horizontalAlign="center">
			<s:Button skinClass="com.gazuntite.skins.controls.button.patient.DictationPlayButtonSkin"
					  buttonMode="true" toolTip="Play"
					  />
			<s:Button skinClass="com.gazuntite.skins.controls.button.patient.DictationRecordButtonSkin"
					  buttonMode="true" toolTip="Record"
					  />
			<s:Button skinClass="com.gazuntite.skins.controls.button.patient.DictationPauseButtonSkin"
					  buttonMode="true" toolTip="Pause"
					  />
			<s:Button skinClass="com.gazuntite.skins.controls.button.patient.DictationStopButtonSkin"
					  buttonMode="true" toolTip="Stop"
					  />
		</s:HGroup>
	</s:SkinnableContainer>
</s:Group>
