<?xml version="1.0" encoding="utf-8"?>
<s:Button xmlns:fx="http://ns.adobe.com/mxml/2009" 
		  xmlns:s="library://ns.adobe.com/flex/spark" 
		  xmlns:mx="library://ns.adobe.com/flex/mx"
		  toolTip="Flip" useHandCursor="true" buttonMode="true"
		  skinClass="com.gazuntite.skins.controls.button.FlipViewButtonSkin"
		  click="onClick(event)"
		  >
	
	<fx:Script>
		<![CDATA[
			import com.gazuntite.common.event.FlipViewEvent;
			protected function onClick(event:MouseEvent):void
			{
				this.dispatchEvent(new FlipViewEvent());
			}
		]]>
	</fx:Script>
	
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
</s:Button>
