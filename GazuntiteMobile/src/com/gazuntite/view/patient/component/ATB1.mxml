<?xml version="1.0" encoding="utf-8"?>
<s:Skin xmlns:s="library://ns.adobe.com/flex/spark"
		xmlns:fx="http://ns.adobe.com/mxml/2009"
		width="17" height="18">
	<fx:Metadata>[HostComponent("spark.components.ToggleButton")]</fx:Metadata>
	<fx:Script>
		<![CDATA[
			import spark.components.ToggleButton;
		]]>
	</fx:Script>
	<s:states>
		<s:State name="up"/>
		<s:State name="over"/>
		<s:State name="down"/>
		<s:State name="disabled"/>
		<s:State name="upAndSelected"/>
		<s:State name="overAndSelected"/>
		<s:State name="downAndSelected"/>
		<s:State name="disabledAndSelected"/>
	</s:states>
	<s:Rect x="0.5" y="0.5" width="16" height="17" radiusX="3"
			visible.down="false"
			visible.downAndSelected="false"
			visible.over="false"
			visible.overAndSelected="false"
			visible.upAndSelected="false">
		<s:fill>
			<s:LinearGradient rotation="270">
				<s:GradientEntry alpha="1.0" color="#D6D6D6" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#FCFCFC" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter alpha="0.75" angle="90" blurX="2" blurY="2" color="#333333"
								distance="1" hideObject="false" inner="false" knockout="false"
								quality="3" strength="1"/>
		</s:filters>
		<s:stroke>
			<s:LinearGradientStroke caps="none" joints="miter" miterLimit="4" rotation="90"
									weight="1">
				<s:GradientEntry alpha="1.0" color="#A0A1A1" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#666666" ratio="1"/>
			</s:LinearGradientStroke>
		</s:stroke>
	</s:Rect>
	<s:Rect x="0.5" y="0.5" width="16" height="17" radiusX="2"
			visible.disabled="false"
			visible.disabledAndSelected="false"
			visible.up="false">
		<s:fill>
			<s:LinearGradient rotation="270">
				<s:GradientEntry alpha="1.0" color="#820000" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#E00707" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter alpha="0.5" angle="90" blurX="1" blurY="1" color="0x000000"
								distance="1" hideObject="false" inner="true" knockout="false"
								quality="3" strength="1"/>
			<s:DropShadowFilter alpha="0.75" angle="90" blurX="2" blurY="2" color="#000000"
								distance="1" hideObject="false" inner="false" knockout="false"
								quality="3" strength="1"/>
		</s:filters>
		<s:stroke>
			<s:LinearGradientStroke caps="none" joints="miter" miterLimit="4" rotation="270"
									weight="1"
									rotation.down="90">
				<s:GradientEntry alpha="1.0" color="#C90404" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#7F0404" ratio="1"/>
			</s:LinearGradientStroke>
		</s:stroke>
	</s:Rect>
	<s:RichText x="4" y="3" color="#FFFFFF" fontSize="14"
				lineHeight="0" paddingBottom="0" paddingLeft="0" paddingRight="0" paddingTop="0"
				tabStops="S0" text="N" trackingRight="1%"
				visible.disabled="false"
				visible.disabledAndSelected="false"
				text.down="A"
				text.downAndSelected="A"
				text.over="A"
				text.overAndSelected="A"
				visible.up="false"
				text.upAndSelected="A" fontFamily="CalibriCFFBold" fontWeight="bold">
		<s:filters>
			<s:DropShadowFilter alpha="0.5" angle="90" blurX="1" blurY="1" color="#000000"
								distance="1" hideObject="false" inner="false" knockout="false"
								quality="3" strength="1"/>
		</s:filters>
	</s:RichText>
	<s:RichText x="4" y="3" color="#000000" fontSize="14"
				lineHeight="0" paddingBottom="0" paddingLeft="0" paddingRight="0" paddingTop="0"
				tabStops="S0" text="A" trackingRight="1%"
				color.disabled="#666666"
				color.disabledAndSelected="#666666"
				visible.down="false"
				visible.downAndSelected="false"
				visible.over="false"
				visible.overAndSelected="false"
				visible.upAndSelected="false" fontFamily="CalibriCFFBold" fontWeight="bold"/>
</s:Skin>
