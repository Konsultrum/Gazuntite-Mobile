<?xml version="1.0" encoding="utf-8"?>
<s:VGroup xmlns:fx="http://ns.adobe.com/mxml/2009" 
		  xmlns:s="library://ns.adobe.com/flex/spark" 
		  xmlns:mx="library://ns.adobe.com/flex/mx" width="100" 
		  xmlns:newrx="com.gazuntite.provider.eprescription.services.patient.view.views.newrx.*" 
		  xmlns:component="com.gazuntite.view.patient.component.*"
		  gap="-2"
		  >
	<fx:Script>
		<![CDATA[
			[Bindable]
			public var label:String;
			
			private var _valueA:Number = 0;
			
			private var _valueB:Number = 0;

			[Bindable]
			public function get valueB():Number
			{
				return _valueB;
			}

			public function set valueB(value:Number):void
			{
				_valueB = value;
			}

			[Bindable]
			public function get valueA():Number
			{
				return _valueA;
			}

			public function set valueA(value:Number):void
			{
				_valueA = value;
			}

			]]>
	</fx:Script>
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	<s:Group width="100%" depth="2">
		<s:ToggleButton label="{label}" width="100%" id="uiButton" depth="1"
						useHandCursor="true" buttonMode="true" skinClass="com.gazuntite.view.patient.component.VitalInputToggleButtonSkin" 
						toolTip="{label}"/>
		<s:PopUpAnchor  left="0" right="0" bottom="4" depth="0" displayPopUp="{uiButton.selected}">
			<component:NumericSpinnerValuePairInput
				id="uiPop"
				valueA="@{valueA}" valueB="@{valueB}"
				OK="uiButton.selected = false"
				Cancel="uiButton.selected = false"
				/>
		</s:PopUpAnchor>
	</s:Group>
	<s:Group width="100%" height="27" depth="1">
		<s:Rect width="100%" height="25">
			<s:fill>
				<s:LinearGradient rotation="90">
					<s:GradientEntry alpha="1.0" color="#85919A" ratio="0"/>
					<s:GradientEntry alpha="1.0" color="#575E64" ratio="0.00784313725490196"/>
					<s:GradientEntry alpha="1.0" color="#B1BCC3" ratio="0.054901960784313725"/>
					<s:GradientEntry alpha="1.0" color="#8D9BA6" ratio="0.09803921568627451"/>
					<s:GradientEntry alpha="1.0" color="#AEB6BD" ratio="0.9490196078431372"/>
					<s:GradientEntry alpha="1.0" color="#8A969E" ratio="0.9529411764705882"/>
				</s:LinearGradient>
			</s:fill>
		</s:Rect>
		<s:Line height="100%" right="0">
			<s:stroke>
				<s:SolidColorStroke caps="none" color="#6C7276" joints="miter" miterLimit="4" weight="1"/>
			</s:stroke>
		</s:Line>
		<s:Label verticalCenter="0" left="4" right="4"
				 fontFamily="Calibri"
				 textAlign="center"
				 text="{valueA.toString()+'/'+valueB.toString()}"
				 />
	</s:Group>
</s:VGroup>
