<?xml version="1.0" encoding="utf-8"?>
<s:ItemRenderer xmlns:fx="http://ns.adobe.com/mxml/2009" 
				xmlns:s="library://ns.adobe.com/flex/spark" 
				xmlns:mx="library://ns.adobe.com/flex/mx" 
				autoDrawBackground="true" xmlns:buttonSkins="com.adobe.gazuntite.skins.chrome.buttonSkins.*"
				width="100%">
	
	<fx:Script>
		<![CDATA[
			import com.gazuntite.common.dto.assessment.diagnosis.DiagnosisDTO;
			import com.gazuntite.skins.controls.list.GeneralListAlternateItemSkin;
			import com.gazuntite.skins.controls.list.GeneralListItemSkin;
			
			[Bindable]
			private var diagnosisDTO:DiagnosisDTO;
			
			override public function set data(value:Object):void
			{
				super.data = value;
				
				diagnosisDTO = data as DiagnosisDTO;
			}
			
			override protected function updateDisplayList(unscaledWidth:Number,  unscaledHeight:Number):void 
			{
				id_Header.setStyle('skinClass', itemIndex % 2 ? GeneralListAlternateItemSkin : GeneralListItemSkin);
				super.updateDisplayList(unscaledWidth, unscaledHeight);
			}
			
			private function headerClickHandler():void
			{
			}
			
			private function checkBoxClickHandler():void
			{
				if (!diagnosisDTO)
					return;
				
				diagnosisDTO.isSelected = checkBox.selected;
			}
		]]>
	</fx:Script>
	<fx:Declarations>
		<s:Animate id="glowAnimation" target="{glow1}" duration="250" >
			<s:motionPaths>
				<s:SimpleMotionPath valueFrom="0" valueTo="10" property="blurX"  />
				<s:SimpleMotionPath valueFrom="0" valueTo="10" property="blurY"/>
			</s:motionPaths>
		</s:Animate>
	</fx:Declarations>
	
	<s:filters>
		<s:GlowFilter id="glow1" blurX="0" blurY="0" alpha="0" color="#EA8033" strength="4" inner="true"/>
	</s:filters>
	
	<s:layout >
		<s:VerticalLayout gap="0" horizontalAlign="center" paddingBottom="0" paddingTop="0" paddingLeft="0" paddingRight="0"/> 
	</s:layout>
	
	<s:SkinnableContainer id="id_Header"
						  width="100%" height="35"   
						  click="headerClickHandler()" 
						  toolTip="Open/Close Details" useHandCursor="true" buttonMode="true" >
		<s:layout>
			<s:HorizontalLayout verticalAlign="middle" paddingLeft="10" paddingRight="5"/>
		</s:layout>
		
		<s:CheckBox id="checkBox"
					width="20"
					skinClass="com.gazuntite.skins.controls.checkbox.CheckboxBlack"
					useHandCursor="true" buttonMode="true" selected="{diagnosisDTO.isSelected}" click="checkBoxClickHandler()"
					/>
		<s:Group width="25%">
			<buttonSkins:buttonNavSeparator width="1" height="100%"/>
			<s:Label id="SrNo" 
					 text="{diagnosisDTO.serialNumber}" fontFamily="CalibriCFF" fontSize="14" width="100%"
					 paddingLeft="6" maxDisplayedLines="1"/>
		</s:Group>
		
		<s:Group width="25%">
			<buttonSkins:buttonNavSeparator width="1" height="100%"/>
			<s:Label id="visitDate" 
					 text="{diagnosisDTO.VisitDate}" toolTip="{diagnosisDTO.VisitDate}" 
					 fontFamily="CalibriCFF" fontSize="14" width="100%"
					 paddingLeft="6" maxDisplayedLines="1"/>
		</s:Group>
		
		
		<s:Group width="25%">
			<buttonSkins:buttonNavSeparator width="1" height="100%"/>
			<s:Label id="onSetDate" 
					 text="{diagnosisDTO.OnSet}" toolTip="{diagnosisDTO.OnSet}" 
					 fontFamily="CalibriCFF" fontSize="14" width="100%"
					 paddingLeft="6"  maxDisplayedLines="1"/>
		</s:Group>
		
		<s:Group width="25%">
			<buttonSkins:buttonNavSeparator width="1" height="100%"/>
			<s:Label id="icdCode" 
					 text="{diagnosisDTO.IcdDto.IcdCodeName}" toolTip="{diagnosisDTO.IcdDto.IcdCodeName}"
					 fontFamily="CalibriCFF" fontSize="14" width="100%"
					 paddingLeft="6" maxDisplayedLines="1"/>
		</s:Group>
		
		<s:Group width="25%">
			<buttonSkins:buttonNavSeparator width="1" height="100%"/>
			<s:Label id="diagnosis" 
					 text="{diagnosisDTO.IcdDto.IcdCodeDescription}" toolTip="{diagnosisDTO.IcdDto.IcdCodeDescription}"
					 fontFamily="CalibriCFF" fontSize="14" width="100%"
					 paddingLeft="6" maxDisplayedLines="1"/>
		</s:Group>
		
	</s:SkinnableContainer>
</s:ItemRenderer>
