<?xml version="1.0" encoding="utf-8"?>
<s:SkinnableContainer xmlns:fx="http://ns.adobe.com/mxml/2009" 
					  xmlns:s="library://ns.adobe.com/flex/spark" 
					  xmlns:mx="library://ns.adobe.com/flex/mx"
					  skinClass="com.gazuntite.skins.controls.container.PatientInputSubViewContainerSkin" 
					  xmlns:component="com.gazuntite.view.patient.component.*" 
					  xmlns:components="com.gazuntite.components.*" 
					  xmlns:dictation="com.gazuntite.components.dictation.*"
					  creationComplete="cc()" xmlns:diagnosis="com.gazuntite.view.patient.component.itemrenderer.diagnosis.*" 
					  >
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	<fx:Script>
		<![CDATA[
			import com.gazuntite.common.dto.ModuleNoteDTO;
			import com.gazuntite.common.dto.assessment.diagnosis.DiagnosisDTO;
			import com.gazuntite.components.dictation.PatientDictationNoteViewEvent;
			import com.gazuntite.patient.visit.model.QIModelLocator;
			import com.gazuntite.patient.visit.utils.Constants;
			import com.gazuntite.patient.visit.utils.QIConstants;
			import com.gazuntite.patient.visit.utils.QIUtilityFunctions;
			import com.gazuntite.view.patient.input.assessment.PatientInputAssessmentViewModel;
			
			import mx.formatters.DateBase;
			
			[Bindable]	
			private var model:QIModelLocator = QIModelLocator.getInstance();
			
			[Bindable]
			private var viewModel:PatientInputAssessmentDiagnosisViewModel = PatientInputAssessmentDiagnosisViewModel.getInstance();
			
			[Bindable]
			private var notesDTO:ModuleNoteDTO;
			
			private function cc():void
			{
				notesDTO = QIUtilityFunctions.getModuleNoteDTO(Constants.DIAGNOSIS_MODULE_NAME);
				
				addEventListener(PatientInputAssessmentDiagnosisEvent.PATIENT_INPUT_DIAGNOSIS_ADD_EVENT, 
					patientInputDiagnosisAddHandler, false, 0, true);
				addEventListener(PatientInputAssessmentDiagnosisEvent.PATIENT_INPUT_DIAGNOSIS_ITEM_EDIT_KEY_UP_EVENT, 
					patientInputDiagnosisItemEditKeyUpHandler, false, 0, true);
				addEventListener(PatientInputAssessmentDiagnosisEvent.PATIENT_INPUT_DIAGNOSIS_EDIT_EVENT,
					managePatientInputDiagnosisHandler, false, 0, true);
				
				addEventListener(PatientInputAssessmentDiagnosisEvent.PATIENT_INPUT_DIAGNOSIS_DELETE_EVENT, 
					managePatientInputDiagnosisHandler, false, 0, true);
				
				addEventListener(PatientDictationNoteViewEvent.PATIENT_DICTATION_NOTE_SAVE_EVENT, patientDictationNoteSaveHandler, false, 0, true);
			}
			
			private function patientInputDiagnosisAddHandler(event:PatientInputAssessmentDiagnosisEvent):void
			{
				if (!event.diagnosisDTO)
					return;
				
				if (!model.diagnosisDTOList)
					model.diagnosisDTOList = new ArrayCollection();
				
				model.diagnosisDTOList.addItem(event.diagnosisDTO);
				
				event.diagnosisDTO.serialNumber = model.diagnosisDTOList.length;
				
				viewModel.managePatientDiagnosis(QIConstants.INPUT_VIEW);
			}
			
			private function patientInputDiagnosisItemEditKeyUpHandler(event:PatientInputAssessmentDiagnosisEvent):void
			{
				if (!event.searchString)
					return;
				
				if (event.searchString.length < 2 || event.searchString.length > 10)
					return;
				
				if (event.searchString.length % 2 == 0)
					return;
				
				viewModel.loadPatientDiagnosisStaticData(event.searchString);
			}
			
			private function managePatientInputDiagnosisHandler(event:PatientInputAssessmentDiagnosisEvent):void
			{
				viewModel.managePatientDiagnosis(QIConstants.INPUT_VIEW);
			}
			
			private function patientDictationNoteSaveHandler(event:PatientDictationNoteViewEvent):void
			{
				event.moduleName = Constants.DIAGNOSIS_MODULE_NAME;
				event.data = notesDTO;
			}
		]]>
	</fx:Script>
	<s:layout>
		<s:VerticalLayout gap="0" paddingTop="1" paddingBottom="10"/>
	</s:layout>
	
	<component:PatientSubViewTitleBar width="100%" label="DIAGNOSIS" maxSectionCounter="3"  sectionNumber="1" showInputPart="true"
									  MainSectionLabel="Assessment"
									  dictationNoteViewModel="{viewModel.dictationNoteViewModel}"/>
	<dictation:PatientDictationNoteView id="dictationNoteView" width="100%" minHeight="47" 
										viewModel="{viewModel.dictationNoteViewModel}" note="@{notesDTO.Note}"
										isSectionLevel="true" isSaveButtonVisible="true"/>
	
	<s:Scroller width="100%" height="100%" horizontalScrollPolicy="off" verticalScrollPolicy="auto"
				skinClass="com.gazuntite.skins.controls.list.InvisibleScrollerSkin">
		<s:Group width="100%" height="100%">
			<s:layout>
				<s:VerticalLayout gap="0" />
			</s:layout>
			
			<diagnosis:DiagnosisInputFormView width="100%" dictationNoteViewModel="{viewModel.inlineDictationNoteViewModel}"/>
			
			<s:SkinnableContainer width="100%" height="27" skinClass="com.gazuntite.skins.PatientSortBarSkin">
				<s:layout>
					<s:HorizontalLayout verticalAlign="middle" paddingLeft="10" paddingRight="10" gap="8"/>
				</s:layout>
				
				<s:Label text="Arrange By:" styleName="emailInboxToolbarTitle"/>
				
				<s:DropDownList skinClass="com.gazuntite.skins.controls.list.PatientSortBarDropListSkin" 
								selectedIndex="0"
								buttonMode="true" toolTip="Sort List">
					<s:dataProvider>
						<s:ArrayCollection>
							<fx:Object label="Recently Added" />
							<fx:Object label="Diagnosis" />
						</s:ArrayCollection>
					</s:dataProvider>
				</s:DropDownList>
				<s:Spacer width="100%"/>
			</s:SkinnableContainer>
			
			<s:List id="uiDiagnosisList" width="100%"  minHeight="50" allowMultipleSelection="true"
					
					skinClass="com.gazuntite.skins.controls.list.PatientInputListSkin"
					borderVisible="false"
					dataProvider="{model.diagnosisDTOList}"
					itemRenderer="com.gazuntite.view.patient.component.itemrenderer.diagnosis.DiagnosisListItemRenderer"/>
		</s:Group>
	</s:Scroller>
</s:SkinnableContainer>