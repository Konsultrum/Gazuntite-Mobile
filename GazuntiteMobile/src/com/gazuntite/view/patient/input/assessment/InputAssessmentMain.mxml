<?xml version="1.0" encoding="utf-8"?>
<s:Group xmlns:fx="http://ns.adobe.com/mxml/2009" 
					  xmlns:s="library://ns.adobe.com/flex/spark" 
					  xmlns:mx="library://ns.adobe.com/flex/mx"
					  xmlns:supportclass="com.gazuntite.view.patient.supportclass.*" 
					  xmlns:diagnosis="com.gazuntite.view.patient.input.assessment.diagnosis.*" 
					  xmlns:plan="com.gazuntite.view.patient.input.assessment.plan.*" 
					  xmlns:treatment="com.gazuntite.view.patient.input.assessment.treatment.*" 
					  creationComplete="cc()">
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	
	<fx:Script>
		<![CDATA[
			import com.gazuntite.view.patient.input.assessment.plan.followUp.PatientInputAssessmentFollowUpEvent;
			import com.gazuntite.view.patient.input.assessment.plan.followUp.PatientInputAssessmentFollowUpViewModel;
			
			[Bindable]
			private var viewModel:PatientInputAssessmentViewModel = PatientInputAssessmentViewModel.getInstance();
			
			private function cc():void
			{
				addEventListener(PatientInputAssessmentFollowUpEvent.PATIENT_INPUT_LOAD_FOLLOW_UP_LABS, patientInputLoadFollowUpLabsHandler, false, 0, true);
			}
			
			private function patientInputLoadFollowUpLabsHandler(event:PatientInputAssessmentFollowUpEvent):void
			{
				//viewModel.loadFollowUpLabs();
			}
		]]>
	</fx:Script>
	
	<s:layout>
		<s:HorizontalLayout	paddingLeft="4" paddingRight="4" paddingBottom="3" paddingTop="3"/>
	</s:layout>
	
	<supportclass:PatientSubViewContainer id="uiViewContainer" width="100%" height="100%">
		<supportclass:inputViews>
			<supportclass:FlipViewContainer menuLabel="Diagnosis" selected="false">
				<supportclass:flipViews>
					<diagnosis:DiagnosisInputView />
					<diagnosis:DiagnosisHistoryView />
				</supportclass:flipViews>
			</supportclass:FlipViewContainer>
			<supportclass:FlipViewContainer menuLabel="Treatment" selected="false">
				<supportclass:flipViews>
					<treatment:TreatmentInputView />
					<treatment:TreatmentHistoryView />
				</supportclass:flipViews>
			</supportclass:FlipViewContainer>
			<supportclass:FlipViewContainer menuLabel="Plan" selected="false">
				<supportclass:flipViews>
					<plan:PlanInputView/>
					<plan:PlanHistoryView/>
				</supportclass:flipViews>
			</supportclass:FlipViewContainer>
		</supportclass:inputViews>
	</supportclass:PatientSubViewContainer>
	
</s:Group>