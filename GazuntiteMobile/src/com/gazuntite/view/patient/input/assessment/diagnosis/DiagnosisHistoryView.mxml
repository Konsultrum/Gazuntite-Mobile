<?xml version="1.0" encoding="utf-8"?>
<s:SkinnableContainer xmlns:fx="http://ns.adobe.com/mxml/2009" 
					  xmlns:s="library://ns.adobe.com/flex/spark" 
					  xmlns:mx="library://ns.adobe.com/flex/mx"
					  skinClass="com.gazuntite.skins.controls.container.PatientInputSubViewContainerSkin" 
					  xmlns:component="com.gazuntite.view.patient.component.*"
					  xmlns:components="com.gazuntite.controls.extended.components.*" 
					  xmlns:dictation="com.gazuntite.components.dictation.*" 
					  xmlns:diagnosis="com.gazuntite.view.patient.component.itemrenderer.diagnosis.*" 
					  >
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	
	<fx:Script>
		<![CDATA[
			import com.gazuntite.patient.visit.model.QIModelLocator;
			import com.gazuntite.patient.visit.utils.QIConstants;
			
			import mx.collections.ArrayCollection;
			
			[Bindable]	private var model:QIModelLocator = QIModelLocator.getInstance();
			
			[Bindable]	private var viewModel:PatientInputAssessmentDiagnosisViewModel = PatientInputAssessmentDiagnosisViewModel.getInstance();
			
		]]>
	</fx:Script>
	
	<s:layout>
		<s:VerticalLayout gap="0" paddingBottom="10"/>
	</s:layout>
	
	<component:PatientSubViewTitleBar width="100%" label="DIAGNOSIS"  maxSectionCounter="3"   sectionNumber="1" showHistoryPart="true"
									  MainSectionLabel="Assessment"
									  dictationNoteViewModel="{viewModel.dictationNoteHistoryViewModel}"/>
	
	<dictation:PatientDictationNoteHistoryView width="100%" viewModel="{viewModel.dictationNoteHistoryViewModel}"
											   dictationNoteDataProvider="{model.diagosisDictationNoteHistoryDTOList}"/>
	
	<s:VGroup width="100%" height="100%" gap="-5" paddingTop="10" paddingLeft="2" paddingRight="2" horizontalAlign="center">
		
		<s:TabBar dataProvider="{uiViewStack}" labelField="id" skinClass="com.gazuntite.view.patient.component.PinkTabBarSkin"/>
		
		<s:Scroller width="100%" height="100%" 
					horizontalScrollPolicy="off" verticalScrollPolicy="auto" skinClass="com.gazuntite.skins.controls.list.InvisibleScrollerSkin">
			<s:Group width="100%" height="100%">
				<s:layout>
					<s:VerticalLayout gap="0" />
				</s:layout>
				
				<s:SkinnableContainer width="100%" height="100%" skinClass="com.gazuntite.skins.controls.container.PinkBackgroundSkin">
					<components:LabelViewStack id="uiViewStack" width="100%" height="100%" backgroundAlpha="0" borderVisible="false">
						<s:ArrayList>
							<diagnosis:DiagnosisHistoryListView id="Acute" width="100%" height="100%" 
																diagnosisCollection="{model.diagnosisDTOAcuteHistoryList}"
																sectionName="{QIConstants.ACUTE_DIAGNOSIS_HISTORY}"/>
							<diagnosis:DiagnosisHistoryListView id="Chronic" width="100%" height="100%" 
																diagnosisCollection="{model.diagnosisDTOChronicHistoryList}"
																sectionName="{QIConstants.CHRONIC_DIAGNOSIS_HISTORY}"/>
							<diagnosis:DiagnosisHistoryListView id="Resolved" width="100%" height="100%"
																diagnosisCollection="{model.diagnosisDTOResolvedHistoryList}"
																sectionName="{QIConstants.RESOLVED_DIAGNOSIS_HISTORY}"/>
						</s:ArrayList>
					</components:LabelViewStack>
				</s:SkinnableContainer>
			</s:Group>
		</s:Scroller>
	</s:VGroup>
</s:SkinnableContainer>