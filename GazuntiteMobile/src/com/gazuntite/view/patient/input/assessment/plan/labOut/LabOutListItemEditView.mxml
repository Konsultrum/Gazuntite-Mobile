<?xml version="1.0" encoding="utf-8"?>
<s:SkinnableContainer xmlns:fx="http://ns.adobe.com/mxml/2009" 
		 xmlns:s="library://ns.adobe.com/flex/spark" 
		 xmlns:mx="library://ns.adobe.com/flex/mx" xmlns:components="com.gazuntite.controls.extended.components.*"
		 skinClass="com.gazuntite.skins.controls.container.ePrescription.NewRXExpandRendererSkin">
	<fx:Script>
		<![CDATA[
			import com.gazuntite.common.dto.assessment.diagnosis.DiagnosisDTO;
			import com.gazuntite.common.dto.assessment.labOut.LabDTO;
			import com.gazuntite.common.dto.assessment.labOut.LabOutLIONICLabTestDTO;
			import com.gazuntite.common.dto.assessment.labOut.LabOutTestTypeDTO;
			import com.gazuntite.common.dto.baseDTO.GeneralTypeDTO;
			import com.gazuntite.patient.visit.model.QIModelLocator;
			import com.gazuntite.patient.visit.utils.QIConstants;
			
			import flash.net.dns.AAAARecord;
			
			import mx.controls.Alert;
			import mx.controls.ComboBase;
			import mx.core.FlexGlobals;
			
			import spark.events.IndexChangeEvent;
			
			[Bindable]
			public var model:QIModelLocator = QIModelLocator.getInstance();
			
			[Bindable]
			private var leftLabelWidth:int = 90;
			
			[Bindable]
			private var rightLabelWidth:int = 120;
			
			private var _labDTO:LabDTO;
			private var toolTipChanged:Boolean;
			
			[Bindable]
			public function get labDTO():LabDTO
			{
				return _labDTO;
			}

			public function set labDTO(value:LabDTO):void
			{
				_labDTO = value;
				
				if (!labDTO)
					return;
				
				if (labDTO.LabTestType)
				{
					id_TestTypeCmbo.textInput.text = labDTO.LabTestType.Name;
				}
				
				if (labDTO.LabTestOrderMethodType)
				{
					id_OrderMethodCmbo.textInput.text = labDTO.LabTestOrderMethodType.Name;
				}
				
				if (labDTO.LIONICLabTestType)
				{
					id_TestCodeCmbo.textInput.text = labDTO.LIONICLabTestType.testNum;
					id_TestNameCmbo.textInput.text = labDTO.LIONICLabTestType.Name;
				}
				
				if (labDTO.LabTestPriorityType)
				{
					id_PriorityCmbo.textInput.text = labDTO.LabTestPriorityType.Name;
				}
				
				if (labDTO.LabTestSpecimenType)
				{
					id_SpecimenCmbo.textInput.text = labDTO.LabTestSpecimenType.Name;
				}
				
				if (labDTO.LabType)
				{
					id_LaboratoryCmbo.textInput.text = labDTO.LabType.Name;
				}
				
				toolTipChanged = true;
				invalidateProperties();
			}
			
			private function setRequiredIcon(cmbo:ComboBox, icon:Class):void
			{
				switch (cmbo.id)
				{
					case "id_TestTypeCmbo":
						
						img_TestType.source = icon;
						break;
					
					case "id_OrderMethodCmbo":
						
						img_OrderMethod.source = icon;
						break;
					
					case "id_TestNameCmbo":
						
						img_TestName.source = icon;
						break;
					
					case "id_TestCodeCmbo":
						
						img_TestCode.source = icon;
						break;
					
					case "id_LaboratoryCmbo":
						
						img_Laboratory.source = icon;
						break;
					
					default:
						break;
				}
			}
			
			private function testTypeCmboChangeHandler(event:IndexChangeEvent):void
			{
				if (event.newIndex == event.oldIndex)
					return;
				
				id_TestCodeCmbo.selectedIndex = -1;
				id_TestCodeCmbo.textInput.text = "";
				
				setRequiredIcon(id_TestCodeCmbo, QIConstants.IMG_RED);
				
				id_TestNameCmbo.selectedIndex = -1;
				id_TestNameCmbo.textInput.text = "";
				
				setRequiredIcon(id_TestNameCmbo, QIConstants.IMG_RED);
				
				toolTipChanged = true;
				invalidateProperties();
			}
			
			private function comboKeyUpHandler(event:KeyboardEvent):void
			{
				if (event.keyCode == Keyboard.ENTER || event.keyCode == Keyboard.UP || event.keyCode == Keyboard.DOWN)
					return;
				
				var curTar:ComboBox = event.currentTarget as ComboBox;
				
				if (!curTar)
					return;
				
				toolTipChanged = true;
				invalidateProperties();
				
				var testType:LabOutTestTypeDTO = id_TestTypeCmbo.selectedItem as LabOutTestTypeDTO;
				
				if (!testType)
					return;
				
				var ev:PatientInputAssessmentLabOutEvent = new PatientInputAssessmentLabOutEvent(
							PatientInputAssessmentLabOutEvent.PATIENT_INPUT_LAB_OUT_ITEM_EDIT_KEY_UP_EVENT, true);
				
				ev.searchString = curTar.textInput.text;
				ev.testTypeID = testType.ID;
				
				if (curTar == id_TestCodeCmbo)
				{
					ev.searchType = PatientInputAssessmentLabOutViewModel.LAB_TEST_CODE;
				}
				else if (curTar == id_TestNameCmbo)
				{
					ev.searchType = PatientInputAssessmentLabOutViewModel.LAB_TEST_NAME;
				}
				
				dispatchEvent(ev);
			}
			
			private function comboChangeHandler(event:IndexChangeEvent):void
			{
				var curTar:ComboBox = event.currentTarget as ComboBox;
				
				if (!curTar)
					return;
				
				if (curTar == id_TestTypeCmbo || curTar == id_OrderMethodCmbo || curTar == id_TestCodeCmbo ||
						curTar == id_TestNameCmbo || curTar == id_LaboratoryCmbo)
				{
					if (curTar.id == "id_TestCodeCmbo")
					{
						id_TestNameCmbo.selectedIndex = curTar.selectedIndex;
					}
					else
					{
						id_TestCodeCmbo.selectedIndex = curTar.selectedIndex;
					}
					
					if (curTar.selectedIndex >= 0)
					{
						if (curTar.id == "id_TestNameCmbo" || curTar.id == "id_TestCodeCmbo")
						{
							setRequiredIcon(id_TestNameCmbo, QIConstants.IMG_GREEN);
							setRequiredIcon(id_TestCodeCmbo, QIConstants.IMG_GREEN);
						}
						else
						{
							setRequiredIcon(curTar, QIConstants.IMG_GREEN);
						}
					}
					else
					{
						if (curTar.id == "id_TestNameCmbo" || curTar.id == "id_TestCodeCmbo")
						{
							id_TestNameCmbo.textInput.text = "";
							id_TestCodeCmbo.textInput.text = "";
							
							setRequiredIcon(id_TestNameCmbo, QIConstants.IMG_RED);
							setRequiredIcon(id_TestCodeCmbo, QIConstants.IMG_RED);
						}
						else
						{
							setRequiredIcon(curTar, QIConstants.IMG_RED);
						}
					}
				}
				
				toolTipChanged = true;
				invalidateProperties();
			}
			
			private function saveClickHandler():void
			{
				if (isInvalid())
					return;
				
				if (!labDTO)
					return;
				
				labDTO.IsDirty = true;
				
				labDTO.LabTestType = id_TestTypeCmbo.selectedItem as LabOutTestTypeDTO;
				labDTO.LabTestOrderMethodType = id_OrderMethodCmbo.selectedItem as GeneralTypeDTO;
				labDTO.LIONICLabTestType = id_TestNameCmbo.selectedItem as LabOutLIONICLabTestDTO;
				labDTO.Description = id_Description.text;
				
				labDTO.LabTestPriorityType = id_PriorityCmbo.selectedItem as GeneralTypeDTO;
				labDTO.LabTestSpecimenType = id_SpecimenCmbo.selectedItem as GeneralTypeDTO;
				labDTO.CollectionDate = id_ColDate.text;
				labDTO.LabType = id_LaboratoryCmbo.selectedItem as GeneralTypeDTO;
				
				labDTO.ModifiedAt = new Date();
				labDTO.ModifiedBy = model.LoggedInUserId;
				
				var ev:PatientInputAssessmentLabOutEvent = new PatientInputAssessmentLabOutEvent(
							PatientInputAssessmentLabOutEvent.PATIENT_INPUT_LAB_OUT_EDIT_EVENT, true);
				
				ev.labDTO = labDTO;
				
				dispatchEvent(ev);
			}
			
			private function isInvalid():Boolean
			{
				var isNotValid:Boolean = false;
				var errorStr:String = "";
				var toSetFocus:Object;
				
				if (isTestTypeInvalid())
				{
					isNotValid = true;
					
					errorStr += "Please select Test Type\n";
					
					if (!toSetFocus)
						toSetFocus = id_TestTypeCmbo;
				}
				
				if (isOrderMethodInvalid())
				{
					isNotValid = true;
					
					errorStr += "Please select Order Method\n";
					
					if (!toSetFocus)
						toSetFocus = id_OrderMethodCmbo;
				}
				
				if (isTestNameInvalid())
				{
					isNotValid = true;
					
					errorStr += "Please select Test Name\n";
					
					if (!toSetFocus)
						toSetFocus = id_TestNameCmbo;	
				}
				
				if (isTestCodeInvalid())
				{
					isNotValid = true;
					
					errorStr += "Please select Test Code\n";
					
					if (!toSetFocus)
						toSetFocus = id_TestCodeCmbo;
				}
				
				if (isPriorityInvalid())
				{
					isNotValid = true;
					
					errorStr += "Please select Priority\n";
					
					if (!toSetFocus)
						toSetFocus = id_PriorityCmbo;
				}
				
				if (isSpecimenInvalid())
				{
					isNotValid = true;
					
					errorStr += "Please select Specimen\n";
					
					if (!toSetFocus)
						toSetFocus = id_SpecimenCmbo;
				}
				
				if (isLaboratoryInvalid())
				{
					isNotValid = true;
					
					errorStr += "Please select Laboratory\n";
					
					if (!toSetFocus)
						toSetFocus = id_LaboratoryCmbo;
				}
				
				if (errorStr.length > 0)
				{
					Alert.show(errorStr, "Required Field", Alert.OK, FlexGlobals.topLevelApplication.mainContainer, function():void
					{
						if (toSetFocus)
							toSetFocus.setFocus();
					});
				}
				
				return isNotValid;
			}
			
			private function isTestTypeInvalid():Boolean
			{
				var isNotValid:Boolean = false;
				
				if (id_TestTypeCmbo.selectedIndex < 0)
				{
					if (!id_TestTypeCmbo.selectedItem)
					{
						isNotValid = true;
					}
					else
					{
						var testType:LabOutTestTypeDTO = id_TestTypeCmbo.selectedItem as LabOutTestTypeDTO;
						
						if (!testType)
							isNotValid = true;
					}
				}
				
				return isNotValid;
			}
			
			private function isOrderMethodInvalid():Boolean
			{
				var isNotValid:Boolean = false;
				
				if (id_OrderMethodCmbo.selectedIndex < 0)
				{
					if (!id_OrderMethodCmbo.selectedItem)
					{
						isNotValid = true;
					}
					else
					{
						var orderMethod:GeneralTypeDTO = id_OrderMethodCmbo.selectedItem as GeneralTypeDTO;
						
						if (!orderMethod)
							isNotValid = true;
					}
				}
				
				return isNotValid;
			}
			
			private function isTestNameInvalid():Boolean
			{
				var isNotValid:Boolean = false;
				
				if (id_TestNameCmbo.selectedIndex < 0)
				{
					if (!id_TestNameCmbo.selectedItem)
					{
						isNotValid = true;
					}
					else
					{
						var testName:LabOutLIONICLabTestDTO = id_TestNameCmbo.selectedItem as LabOutLIONICLabTestDTO;
						
						if (!testName)
							isNotValid = true;
					}
				}
				
				return isNotValid;
			}
			
			private function isTestCodeInvalid():Boolean
			{
				var isNotValid:Boolean = false;
				
				if (id_TestCodeCmbo.selectedIndex < 0)
				{
					if (!id_TestCodeCmbo.selectedItem)
					{
						isNotValid = true;
					}
					else
					{
						var testCode:LabOutLIONICLabTestDTO = id_TestCodeCmbo.selectedItem as LabOutLIONICLabTestDTO;
						
						if (!testCode)
							isNotValid = true;
					}
				}
				
				return isNotValid;
			}
			
			private function isPriorityInvalid():Boolean
			{
				var isNotValid:Boolean = false;
				
				if (id_PriorityCmbo.selectedItem)
				{
					var priority:GeneralTypeDTO = id_PriorityCmbo.selectedItem as GeneralTypeDTO;
					
					if (!priority)
						isNotValid = true;
				}
				
				return isNotValid;
			}
			
			private function isSpecimenInvalid():Boolean
			{
				var isNotValid:Boolean = false;
				
				if (id_SpecimenCmbo.selectedItem)
				{
					var specimen:GeneralTypeDTO = id_SpecimenCmbo.selectedItem as GeneralTypeDTO;
					
					if (!specimen)
						isNotValid = true;
				}
				
				return isNotValid;
			}
			
			private function isLaboratoryInvalid():Boolean
			{
				var isNotValid:Boolean = false;
				
				if (id_LaboratoryCmbo.selectedIndex < 0)
				{
					if (!id_LaboratoryCmbo.selectedItem)
					{
						isNotValid = true;
					}
					else
					{
						var laboratory:GeneralTypeDTO = id_LaboratoryCmbo.selectedItem as GeneralTypeDTO;
						
						if (!laboratory)
							isNotValid = true;
					}
				}
				
				return isNotValid;
			}
			
			public function associatedDiagnosisLabel(oItem:Object):String
			{
				var label:String = "";
				
				if (oItem && oItem.hasOwnProperty("IcdDto") && oItem.IcdDto )
				{
					if (oItem.IcdDto.hasOwnProperty("IcdCodeName"))
					{
						label += oItem.IcdDto.IcdCodeName + ", ";
					}
					
					if (oItem.IcdDto.hasOwnProperty("IcdCodeDescription"))
					{
						label += oItem.IcdDto.IcdCodeDescription;
					}
					
					label += oItem.IsChronic ? " (Chronic) " : " (Acute) ";
				}
				return label;
			}
			
			private function setToolTips():void
			{
				if (id_TestTypeCmbo.textInput.text.length)
				{
					id_TestTypeCmbo.toolTip = id_TestTypeCmbo.textInput.text;
				}
				else
				{
					id_TestTypeCmbo.toolTip = "Test Type";
				}
				
				if (id_OrderMethodCmbo.textInput.text.length)
				{
					id_OrderMethodCmbo.toolTip = id_OrderMethodCmbo.textInput.text;
				}
				else
				{
					id_OrderMethodCmbo.toolTip = "Order Method";
				}
				
				if (id_TestCodeCmbo.textInput.text.length)
				{
					id_TestCodeCmbo.toolTip = id_TestCodeCmbo.textInput.text;
				}
				else
				{
					id_TestCodeCmbo.toolTip = "Test Code";
				}
				
				if (id_TestNameCmbo.textInput.text.length)
				{
					id_TestNameCmbo.toolTip = id_TestNameCmbo.textInput.text;
				}
				else
				{
					id_TestNameCmbo.toolTip = "Test Name";
				}
				
				if (id_PriorityCmbo.textInput.text.length)
				{
					id_PriorityCmbo.toolTip = id_PriorityCmbo.textInput.text;
				}
				else
				{
					id_PriorityCmbo.toolTip = "Priority";
				}
				
				if (id_SpecimenCmbo.textInput.text.length)
				{
					id_SpecimenCmbo.toolTip = id_SpecimenCmbo.textInput.text;
				}
				else
				{
					id_SpecimenCmbo.toolTip = "Specimen";
				}
			
				if (id_LaboratoryCmbo.textInput.text.length)
				{
					id_LaboratoryCmbo.toolTip = id_LaboratoryCmbo.textInput.text;
				}
				else
				{
					id_LaboratoryCmbo.toolTip = "Laboratory";
				}
			}
			
			override protected function commitProperties():void
			{
				super.commitProperties();
				
				if (toolTipChanged)
				{
					toolTipChanged = false;
					
					setToolTips();
				}
			}
		]]>
	</fx:Script>
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	
	<s:layout>
		<s:VerticalLayout paddingLeft="8" paddingRight="8" paddingTop="8" paddingBottom="8"/>
	</s:layout>
	
	<s:HGroup width="100%">
		<s:HGroup width="40%" verticalAlign="middle" height="21">
			<s:BitmapImage id="img_TestType" source="{QIConstants.IMG_GREEN}"/>
			<s:Label text="Test Type:" width="{leftLabelWidth}" styleName="patientFormLabel"/>
			<s:ComboBox id="id_TestTypeCmbo" prompt="Select Test Type" width="100%"
						skinClass="com.gazuntite.skins.IPEControls.IPEComboboxSkin" fontFamily="CalibriCFF"
						selectedItem="{labDTO.LabTestType}"
						dataProvider="{model.labTestTypeDTOList}" labelField="Name" 
						keyUp="comboKeyUpHandler(event)" change="testTypeCmboChangeHandler(event)"/>
		</s:HGroup>
		
		<s:HGroup width="60%" verticalAlign="middle" height="21">
			<s:BitmapImage id="img_OrderMethod" source="{QIConstants.IMG_GREEN}"/>
			<s:Label text="Order Method:" width="{rightLabelWidth}" styleName="patientFormLabel"/>
			<s:ComboBox id="id_OrderMethodCmbo" prompt="Enter Order Method" toolTip="Order Method" width="100%"
						skinClass="com.gazuntite.skins.IPEControls.IPEComboboxSkin" fontFamily="CalibriCFF"
						selectedItem="{labDTO.LabTestOrderMethodType}"
						dataProvider="{model.labTestOrderMethodTypeDTOList}" labelField="Name"
						keyUp="comboKeyUpHandler(event)" change="comboChangeHandler(event)"/>
		</s:HGroup>
	</s:HGroup>
	
	<s:HGroup width="100%">
		<s:HGroup width="40%" verticalAlign="middle" height="21">
			<s:BitmapImage id="img_TestName" source="{QIConstants.IMG_GREEN}"/>
			<s:Label text="Test Name:" width="{leftLabelWidth}" styleName="patientFormLabel"/>
			<s:ComboBox id="id_TestNameCmbo" prompt="Select Test Name" toolTip="Test Name" width="100%"
						skinClass="com.gazuntite.skins.IPEControls.IPEComboboxSkin" fontFamily="CalibriCFF"
						selectedItem="{labDTO.LIONICLabTestType}"
						dataProvider="{model.lionicLabTestTypeDTOList}" labelField="Name"
						keyUp="comboKeyUpHandler(event)" change="comboChangeHandler(event)"/>
		</s:HGroup>
		
		<s:HGroup width="60%" verticalAlign="middle" height="21">
			<s:BitmapImage id="img_TestCode" source="{QIConstants.IMG_GREEN}"/>
			<s:Label text="Test Code:" width="{rightLabelWidth}" styleName="patientFormLabel"/>
			<s:ComboBox id="id_TestCodeCmbo" prompt="Enter Test Code" toolTip="Test Code" width="100%"
						skinClass="com.gazuntite.skins.IPEControls.IPEComboboxSkin" fontFamily="CalibriCFF"
						selectedItem="{labDTO.LIONICLabTestType}"
						dataProvider="{model.lionicLabTestTypeDTOList}" labelField="testNum"
						keyUp="comboKeyUpHandler(event)" change="comboChangeHandler(event)"/>
		</s:HGroup>
	</s:HGroup>
	
	<s:HGroup width="100%">
		<s:HGroup width="40%" verticalAlign="middle" height="21">
			<s:Spacer width="11"/>
			<s:Label text="Description:" width="{leftLabelWidth}" styleName="patientFormLabel"/>
			<s:TextInput id="id_Description" prompt="Enter Description" toolTip="{id_Description.text}" 
						 width="100%" height="21"
						 skinClass="com.gazuntite.skins.IPEControls.IPETextInputSkin" fontSize="14" fontFamily="CalibriCFF"
						 text="{labDTO.Description}"/>
		</s:HGroup>
		
		<s:HGroup width="60%" verticalAlign="middle" height="21">
			<s:Spacer width="11"/>
			<s:Label text="Associated Diagnosis:" width="{rightLabelWidth}" styleName="patientFormLabel"/>
			<s:ComboBox id="id_AssociatedDiagnosisCmbo" prompt="Select Associated Diagnosis" toolTip="Associated Diagnosis"
						width="100%"
						skinClass="com.gazuntite.skins.IPEControls.IPEComboboxSkin" fontFamily="CalibriCFF"
						dataProvider="{model.diagnosisDTOList}" labelFunction="associatedDiagnosisLabel"/>
		</s:HGroup>
	</s:HGroup>
	
	<s:HGroup width="100%">
		<s:HGroup width="40%" verticalAlign="middle" height="21">
			<s:Spacer width="11"/>
			<s:Label text="Priority:" width="{leftLabelWidth}" styleName="patientFormLabel"/>
			<s:ComboBox id="id_PriorityCmbo" prompt="Enter Priority" width="100%"
						skinClass="com.gazuntite.skins.IPEControls.IPEComboboxSkin" fontFamily="CalibriCFF"
						selectedItem="{labDTO.LabTestPriorityType}"
						dataProvider="{model.labPriorityTypeDTOList}" labelField="Name"
						keyUp="comboKeyUpHandler(event)" change="comboChangeHandler(event)"/>
		</s:HGroup>
		
		<s:HGroup width="60%" verticalAlign="middle" height="21">
			<s:Spacer width="11"/>
			<s:Label text="Specimen:" width="{rightLabelWidth}" styleName="patientFormLabel"/>
			<s:ComboBox id="id_SpecimenCmbo" prompt="Enter Specimen" width="100%"
						skinClass="com.gazuntite.skins.IPEControls.IPEComboboxSkin" fontFamily="CalibriCFF"
						selectedItem="{labDTO.LabTestSpecimenType}"
						dataProvider="{model.labTestSpecimenTypeDTOList}" labelField="Name"
						keyUp="comboKeyUpHandler(event)" change="comboChangeHandler(event)"/>
		</s:HGroup>
	</s:HGroup>
	
	<s:HGroup width="100%">
		<s:HGroup width="40%" verticalAlign="middle" height="21">
			<s:Spacer width="11"/>
			<s:Label text="Collection Date:" width="{leftLabelWidth}" styleName="patientFormLabel"/>
			<components:LabelDateField id="id_ColDate" prompt="Collection Date" toolTip="{id_ColDate.text}" width="100%"
									   yearNavigationEnabled="true" maxYear="{new Date().getFullYear()}" minYear="1901"
									   selectableRange="{{rangeStart : new Date()}}" 
									   IsEditAllow="false" editable="false"
									   text="{labDTO.CollectionDate}" layoutDirection="rtl"/>
		</s:HGroup>
		
		<s:HGroup width="60%" verticalAlign="middle" height="21">
			<s:BitmapImage id="img_Laboratory" source="{QIConstants.IMG_GREEN}"/>
			<s:Label text="Laboratory:" width="{rightLabelWidth}" styleName="patientFormLabel"/>
			<s:ComboBox id="id_LaboratoryCmbo" prompt="Enter Laboratory" width="100%"
						skinClass="com.gazuntite.skins.IPEControls.IPEComboboxSkin" fontFamily="CalibriCFF"
						selectedItem="{labDTO.LabType}"
						dataProvider="{model.labTypeDTOList}" labelField="Name"
						keyUp="comboKeyUpHandler(event)" change="comboChangeHandler(event)"/>
		</s:HGroup>
	</s:HGroup>
	
	<s:HGroup width="100%" height="100%" verticalAlign="bottom" horizontalAlign="right">
		<s:Button id="id_Save" buttonMode="true" toolTip="Save" skinClass="com.gazuntite.skins.controls.button.SaveButtonSkin"
				  click="saveClickHandler()"/>
	</s:HGroup>
</s:SkinnableContainer>
