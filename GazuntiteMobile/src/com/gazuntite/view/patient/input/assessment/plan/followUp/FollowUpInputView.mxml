<?xml version="1.0" encoding="utf-8"?>
<s:Group xmlns:fx="http://ns.adobe.com/mxml/2009" 
		 xmlns:s="library://ns.adobe.com/flex/spark" 
		 xmlns:mx="library://ns.adobe.com/flex/mx" 
		 xmlns:followUp="com.gazuntite.view.patient.input.assessment.plan.followUp.*" creationComplete="cc(event)">
	<fx:Script>
		<![CDATA[
			import com.gazuntite.patient.visit.model.QIModelLocator;
			import com.gazuntite.patient.visit.utils.QIConstants;
			
			import mx.events.FlexEvent;
			
			[Bindable]
			public var model:QIModelLocator = QIModelLocator.getInstance();
			
			[Bindable]
			private var viewModel:PatientInputAssessmentFollowUpViewModel = PatientInputAssessmentFollowUpViewModel.getInstance();
			
			private function cc(event:FlexEvent):void
			{
				addEventListener(PatientInputAssessmentFollowUpEvent.PATIENT_INPUT_FOLLOW_UP_ITEM_EDIT_KEY_UP_EVENT, 
					followUpItemEditKeyUpHandler, false, 0, true);
				addEventListener(PatientInputAssessmentFollowUpEvent.PATIENT_INPUT_FOLLOW_UP_ADD_EVENT, 
					followUpAddHandler, false, 0, true);
				addEventListener(PatientInputAssessmentFollowUpEvent.PATIENT_INPUT_FOLLOW_UP_EDIT_EVENT, 
					managePatientFollowUpHandler, false, 0, true);
				addEventListener(PatientInputAssessmentFollowUpEvent.PATIENT_INPUT_FOLLOW_UP_DELETE_EVENT, 
					managePatientFollowUpHandler, false, 0, true);
			}
			
			private function followUpItemEditKeyUpHandler(event:PatientInputAssessmentFollowUpEvent):void
			{
				if (!event.searchString)
					return;
				
				if (event.searchString.length < 2 || event.searchString.length > 10)
					return;
				
				if (event.searchString.length % 2 == 0)
					return;
				
				viewModel.loadFollowUpServiceType(event.followUpDataControlTypeID, event.searchString);
			}
			
			private function followUpAddHandler(event:PatientInputAssessmentFollowUpEvent):void
			{
				if (!event.followUpDTO)
					return;
				
				if (!model.followUpDTOList)
					model.followUpDTOList = new ArrayCollection();
				
				model.followUpDTOList.addItem(event.followUpDTO);
				
				event.followUpDTO.serialNumber = model.followUpDTOList.length;
				
				viewModel.manageFollowUp(QIConstants.INPUT_VIEW);
			}
			
			private function managePatientFollowUpHandler(event:PatientInputAssessmentFollowUpEvent):void
			{
				viewModel.manageFollowUp(QIConstants.INPUT_VIEW);
			}
			
		]]>
	</fx:Script>
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	<s:layout>
		<s:VerticalLayout paddingLeft="2" paddingRight="2" paddingTop="10" paddingBottom="2" gap="0"/>
	</s:layout>
	
	<s:Scroller width="100%" height="100%" 
				horizontalScrollPolicy="off" verticalScrollPolicy="auto" skinClass="com.gazuntite.skins.controls.list.InvisibleScrollerSkin">
		<s:Group width="100%" height="100%">
			<s:layout>
				<s:VerticalLayout gap="0" />
			</s:layout>
			
			<followUp:FollowUpInputFormView width="100%" dictationNoteViewModel="{viewModel.inlineDictationNoteViewModel}"/>
			
			<s:SkinnableContainer width="100%" height="27" skinClass="com.gazuntite.skins.PatientSortBarSkin">
				<s:layout>
					<s:HorizontalLayout verticalAlign="middle" paddingLeft="10" paddingRight="10" gap="8"/>
				</s:layout>
				<s:Label text="Arrange By:" styleName="emailInboxToolbarTitle"/>
				<s:DropDownList skinClass="com.gazuntite.skins.controls.list.PatientSortBarDropListSkin"
								selectedIndex="0" buttonMode="true" toolTip="Sort List">
					<s:dataProvider>
						<s:ArrayCollection>
							<fx:Object label="Recently Added"/>
							<fx:Object label="Follow-Up Type"/>
						</s:ArrayCollection>
					</s:dataProvider>
				</s:DropDownList>
				<s:Spacer width="100%"/>
			</s:SkinnableContainer>
			
			<s:List id="labOutInputList" 
					width="100%" allowMultipleSelection="false"
					skinClass="com.gazuntite.skins.controls.list.PatientInputListSkin"
					borderVisible="false" dataProvider="{model.followUpDTOList}"
					itemRenderer="com.gazuntite.view.patient.input.assessment.itemRenderer.FollowUpListIR"/>
			
		</s:Group>
	</s:Scroller>
</s:Group>
