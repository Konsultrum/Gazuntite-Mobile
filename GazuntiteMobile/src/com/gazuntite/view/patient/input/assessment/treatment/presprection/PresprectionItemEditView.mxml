<?xml version="1.0" encoding="utf-8"?>
<s:SkinnableContainer xmlns:fx="http://ns.adobe.com/mxml/2009" 
					  xmlns:s="library://ns.adobe.com/flex/spark" 
					  xmlns:mx="library://ns.adobe.com/flex/mx"
					  skinClass="com.gazuntite.skins.controls.container.ePrescription.NewRXExpandRendererSkin" xmlns:components="com.gazuntite.controls.extended.components.*">
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	
	<fx:Script>
		<![CDATA[
			[Embed(source="/assets/images/checkmark_green.png")]
			[Bindable]	
			public var imgGreen:Class;
			
			[Embed(source="/assets/images/dot_red.png")]
			[Bindable]	
			public var imgRed:Class;
			
			[Bindable]	
			public var labelWidth:Number = 120;
			
			private var _PresprectionDTO:Object;//PresprectionDTO;
			
			[Bindable]
			public function get PresprectionDTO():Object//PresprectionDTO
			{
				return _PresprectionDTO;
			}
			
			public function set PresprectionDTO(value:Object/*PresprectionDTO*/):void
			{
				_PresprectionDTO = value;
			}
			
			
			private function comboFocusOutHandler(event:FocusEvent):void
			{
				return ;
				
			}
		]]>
	</fx:Script>
	
	<s:layout>
		<s:VerticalLayout paddingLeft="8" paddingRight="8" paddingTop="8" paddingBottom="4"/>
	</s:layout>
	
	<s:HGroup width="100%"  height="21" verticalAlign="middle">
		<s:BitmapImage id="img_OnSet" source="{imgGreen}"/>
		<s:Label text="CPT Code:" width="{labelWidth}" styleName="patientFormLabel" />
		<s:ComboBox id="id_CptCmbo" width="100%" prompt="CPT Code"
					selectedItem="{PresprectionDTO.CPTCode}"
					skinClass="com.gazuntite.skins.IPEControls.IPEComboboxSkin"
					focusOut="comboFocusOutHandler(event)"/>
	</s:HGroup>
	
	<s:HGroup width="100%" height="21" verticalAlign="middle">
		<s:BitmapImage id="img_IcdCode" source="{imgGreen}"/>
		<s:Label text="Procedure" width="{labelWidth}" styleName="patientFormLabel"/>
		<s:ComboBox id="id_ProcedureCmbo" width="100%" prompt="Procedure"
					selectedItem="{PresprectionDTO.Procedure}"
					skinClass="com.gazuntite.skins.IPEControls.IPEComboboxSkin"
					focusOut="comboFocusOutHandler(event)"/>
		<s:Button id="id_Add" buttonMode="true" toolTip="Save" 
				  skinClass="com.gazuntite.skins.controls.button.SaveButtonSkin"/>
	</s:HGroup>
	
	
</s:SkinnableContainer>
