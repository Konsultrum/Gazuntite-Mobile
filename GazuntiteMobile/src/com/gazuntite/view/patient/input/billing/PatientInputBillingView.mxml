<?xml version="1.0" encoding="utf-8"?>
<components:PopupGroup xmlns:fx="http://ns.adobe.com/mxml/2009" 
					   xmlns:s="library://ns.adobe.com/flex/spark" 
					   xmlns:mx="library://ns.adobe.com/flex/mx" 
					   xmlns:components="com.gazuntite.controls.extended.components.*"
					   creationComplete="cc(event)" 
					   xmlns:view="com.gazuntite.provider.live.services.billing.view.*" 
					   >
	<fx:Script>
		<![CDATA[
			import com.gazuntite.patient.visit.model.QIModelLocator;
			import com.gazuntite.view.patient.viewmodel.PatientInputViewModel;
			
			import mx.core.FlexGlobals;
			import mx.events.FlexEvent;
			
			[Bindable]
			public var QIModel:QIModelLocator = QIModelLocator.getInstance();
			
			[Bindable]
			public var viewModel:PatientInputViewModel = PatientInputViewModel.getInstance();
			
			protected function cc(event:FlexEvent):void
			{
				FlexGlobals.topLevelApplication.addEventListener(MouseEvent.CLICK, function(event:Event):void
				{
					if( isPopUp )
					{
						viewModel.showInputBilling = false;
					}
				});
				
			}
			
			
			public function LoadData():void
			{
							
			}
			
		]]>
	</fx:Script>
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	
	
	<s:SkinnableContainer width="100%" height="100%"  skinClass="com.gazuntite.skins.controls.container.input.SoapnoteBgSkin">
		<s:layout>
			<s:VerticalLayout paddingBottom="5" paddingLeft="5" paddingRight="5" paddingTop="5" />
		</s:layout>
				
		<view:BillingView width="100%" height="100%" QIVisitID="{viewModel.model.VisitID}" QIVisitProviderID="{viewModel.model.LoggedInUserProviderId}" />
		
	</s:SkinnableContainer>
	
</components:PopupGroup>