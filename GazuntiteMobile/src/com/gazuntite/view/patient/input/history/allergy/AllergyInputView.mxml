<?xml version="1.0" encoding="utf-8"?>
<s:SkinnableContainer xmlns:fx="http://ns.adobe.com/mxml/2009" 
					  xmlns:s="library://ns.adobe.com/flex/spark" 
					  xmlns:mx="library://ns.adobe.com/flex/mx"
					  skinClass="com.gazuntite.skins.controls.container.PatientInputSubViewContainerSkin" 
					  xmlns:component="com.gazuntite.view.patient.component.*" 
					  xmlns:components="com.gazuntite.components.*" 
					  xmlns:allergy1="com.gazuntite.view.patient.component.itemrenderer.allergy.*"
					  xmlns:allergy="com.gazuntite.view.patient.input.history.allergy.*" 
					  xmlns:dictation="com.gazuntite.components.dictation.*" 
					  creationComplete="cc()" 
					  >
	<fx:Script>
		<![CDATA[
			import com.adobe.cairngorm.control.CairngormEventDispatcher;
			import com.gazuntite.common.dto.ModuleNoteDTO;
			import com.gazuntite.common.dto.pmh.Allergy.AllergyDTO;
			import com.gazuntite.common.event.QSAllergyEvent;
			import com.gazuntite.components.dictation.PatientDictationNoteViewEvent;
			import com.gazuntite.patient.visit.model.QIModelLocator;
			import com.gazuntite.patient.visit.model.SortType;
			import com.gazuntite.patient.visit.utils.Constants;
			import com.gazuntite.patient.visit.utils.QIUtilityFunctions;
			import com.gazuntite.utils.UtilityFunctions;
			import com.gazuntite.view.patient.event.AllergyDeleteEvent;
			import com.gazuntite.view.patient.viewmodel.PatientInputViewModel;
			import com.gazuntite.view.patient.viewmodel.tempmodel.TempModel;
			
			import mx.events.FlexEvent;
			
			import spark.events.IndexChangeEvent;
			[Bindable]
			public var model:QIModelLocator = QIModelLocator.getInstance();
			
			[Bindable]
			public var viewModel:PatientInputHistoryAllergyViewModel = PatientInputHistoryAllergyViewModel.getInstance();
			
			//-------- Creation Complete --------------
			protected function cc():void
			{
				addEventListener(PatientInputHistoryAllergyEvent.PATIENT_INPUT_ALLERGY_DELETE_EVENT, patientInputAllergyDeleteHandler, false, 0, true);
				addEventListener(PatientInputHistoryAllergyEvent.PATIENT_INPUT_ALLERGY_EDIT_EVENT, patientInputAllergyEditHandler, false, 0, true);
				addEventListener(PatientDictationNoteViewEvent.PATIENT_DICTATION_NOTE_SAVE_EVENT, patientDictationNoteSaveHandler, false, 0, true);
			}
			
			private function patientInputAllergyDeleteHandler(event:PatientInputHistoryAllergyEvent):void
			{
				if (event.gaxenAllergyID != '')
				{
					UtilityFunctions.AskMessage("Do you want to delete selected Allergy ?", function():void
					{
						var IDsXml:XML = <DeleteAllergies  />
						IDsXml.@GaxenAllergyIDS = "'"+ event.gaxenAllergyID +"'";
						
						callQSAllergyEvent(4, IDsXml, afterDelStatus);
					});
				}
			}
			
			//--------- Call back method for Allergy delete -----------------------
			private function afterDelStatus(response:XML):void
			{
				if (UtilityFunctions.IsNotNullOrEmpty(model.patientDTO.GAXENID))
				{
					callQSAllergyEvent(2, model.patientDTO.GAXENID, callBackAllergy);
				}
			}
			//------------ call back allergy------------------------------ 
			private function callBackAllergy(arrAllergy:ArrayCollection):void
			{
				if(model.QIAllergyDTOList)
					model.QIAllergyDTOList.removeAll();
				else
					model.QIAllergyDTOList = new ArrayCollection();
				
				model.QIAllergyDTOList.addAll(arrAllergy);
				
				for (var ser:Number = 0; ser<model.QIAllergyDTOList.length; ser++)
				{
					var allergy:AllergyDTO = model.QIAllergyDTOList.getItemAt(ser) as AllergyDTO;
					allergy.seriesNumber = ser+1;
				}
				
				if(model.QIAllergyDTOList.length > 0)
				{					
					var allergyDto:AllergyDTO = new AllergyDTO();
					allergyDto			= model.QIAllergyDTOList.getItemAt(0) as AllergyDTO;
					//Tahir Alvi - Set Third Section data && NKDA LAbel Flag
					
					if(!allergyDto.isNKDA)
					{
						model.AllergyNKDAFlag 	= false;
					}
					else if(allergyDto.isNKDA)
					{
						model.AllergyNKDAFlag 	= true;
					}
				}				
			}
			// -------------- Dispatch Allergy Common Event -------------------------------------
			private function callQSAllergyEvent(param1:int, param2:*, param3:Function = null):void
			{
				var alEvent : QSAllergyEvent = new QSAllergyEvent(param1, param2, param3);
				CairngormEventDispatcher.getInstance().dispatchEvent( alEvent ); 
			}
			
			protected function onSortChange(event:IndexChangeEvent):void
			{
				var sort_type:String = "";
				switch (uiSort.selectedIndex)
				{
					case 0:
						sort_type = SortType.RECENTLY_ADDED;
						break;
					case 1: 
						sort_type = SortType.ALLERGY_NAME;
						break;
				}
				viewModel.sortAllergyList(sort_type);
			}
			
			private function patientInputAllergyEditHandler(event:PatientInputHistoryAllergyEvent):void
			{
				if (!event.allergyDTO)
					return;
				
				viewModel.savePatientAllergy(event.allergyDTO);
			}
			
			private function patientDictationNoteSaveHandler(event:PatientDictationNoteViewEvent):void
			{
				if (!viewModel.notesDTO)
				{
					var note:String = dictationNoteView.note;
					
					viewModel.notesDTO = QIUtilityFunctions.getModuleNoteDTO(Constants.ALLERGY_MODULE_NAME);
					viewModel.notesDTO.Note = note;
				}
				
				event.moduleName = Constants.ALLERGY_MODULE_NAME;
				event.data = viewModel.notesDTO;
			}
			
		]]>
	</fx:Script>
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	
	<s:layout>
		<s:VerticalLayout gap="0" paddingTop="1" paddingBottom="3"/>
	</s:layout>
	<component:PatientSubViewTitleBar width="100%" label="ALLERGIES" sectionNumber="1" maxSectionCounter="4"  showInputPart="true" inputCounter="0"
									  MainSectionLabel="History"
									  dictationNoteViewModel="{viewModel.newAllergyInputDictationNoteViewModel}"
									  />
	
	<dictation:PatientDictationNoteView id="dictationNoteView" width="100%" minHeight="47" isSectionLevel="true"
										 viewModel="{viewModel.newAllergyInputDictationNoteViewModel}" note="@{viewModel.notesDTO.Note}"/>
	
	<s:Scroller width="100%" height="100%" horizontalScrollPolicy="off" verticalScrollPolicy="auto" skinClass="com.gazuntite.skins.controls.list.InvisibleScrollerSkin" >
		<s:Group width="100%">
			<s:layout>
				<s:VerticalLayout gap="0" />
			</s:layout>
			
			<s:HGroup width="100%" paddingTop="4" paddingBottom="4" paddingLeft="4" paddingRight="4">
				<allergy1:AllergyItemInputView id="allergyInputView" width="100%" />
			</s:HGroup>
			
			<s:SkinnableContainer width="100%" height="27" skinClass="com.gazuntite.skins.PatientSortBarSkin">
				<s:layout>
					<s:HorizontalLayout verticalAlign="middle" paddingLeft="10" paddingRight="10" gap="8"/>
				</s:layout>
				
				<s:Label text="Arrange By:" styleName="emailInboxToolbarTitle" />
				<s:DropDownList id="uiSort"  
								selectedIndex="0"
								buttonMode="true" 
								toolTip="{uiSort.selectedItem.label}"
								change="onSortChange(event)"
								skinClass="com.gazuntite.skins.controls.list.PatientSortBarDropListSkin" 
								>
					<s:dataProvider>
						<s:ArrayCollection>
							<fx:Object label="Recently Added" />
							<fx:Object label="Allergy Name" />
						</s:ArrayCollection>
					</s:dataProvider>
				</s:DropDownList>
				<s:Spacer width="100%" />
			</s:SkinnableContainer>
			
			<s:List id="uiInboxList"
					width="100%" 
					minHeight="50"
					allowMultipleSelection="false"
					borderVisible="false"
					dataProvider="{model.QIAllergyDTOList}"
					skinClass="com.gazuntite.skins.controls.list.PatientInputListSkin"
					itemRenderer="com.gazuntite.view.patient.component.itemrenderer.allergy.AllergyHistoryListItemRenderer"/>
		</s:Group>	
	</s:Scroller>
</s:SkinnableContainer>