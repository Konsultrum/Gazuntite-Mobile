<?xml version="1.0" encoding="utf-8"?>
<s:SkinnableContainer xmlns:fx="http://ns.adobe.com/mxml/2009" 
					  xmlns:s="library://ns.adobe.com/flex/spark" 
					  xmlns:mx="library://ns.adobe.com/flex/mx"
					  skinClass="com.gazuntite.skins.controls.container.PatientInputSubViewContainerSkin" 
					  xmlns:supportclass="com.gazuntite.view.patient.supportclass.*" xmlns:component="com.gazuntite.view.patient.component.*"
					  creationComplete="cc()" xmlns:components="com.gazuntite.components.*" xmlns:dictation="com.gazuntite.components.dictation.*"
					  >
	<fx:Script>
		<![CDATA[
			import com.adobe.cairngorm.control.CairngormEventDispatcher;
			import com.gazuntite.common.dto.pmh.immunization.ImmunizationDTO;
			import com.gazuntite.patient.visit.event.pmh.immunization.ManagePatientImmunizationEvent;
			import com.gazuntite.patient.visit.model.QIModelLocator;
			import com.gazuntite.utils.UtilityFunctions;
			import com.gazuntite.view.patient.event.ImmunizationDeleteEvent;
			import com.gazuntite.view.patient.viewmodel.PatientInputViewModel;
			
			import spark.events.DropDownEvent;
			
			[Bindable]	
			private var model:QIModelLocator = QIModelLocator.getInstance();
			
			[Bindable]	
			private var viewModel:PatientInputHistoryImmunizationViewModel = PatientInputHistoryImmunizationViewModel.getInstance();
			
			private function cc():void
			{
				addEventListener(ImmunizationDeleteEvent.IMMUNIZATION_DELETE_EVENT, immunizationDeleteHandler, false, 0, true);
			}
			
			private function immunizationDeleteHandler(event:ImmunizationDeleteEvent):void
			{
				if (!event.dto)
					return;
				
				var immDTO:ImmunizationDTO;
				
				if (event.dto is ImmunizationDTO)
					immDTO = event.dto as ImmunizationDTO;
				
				if (!immDTO)
					return;
				
				UtilityFunctions.AskMessage("Do you want to delete selected record", function():void
				{
					immDTO.IsDeleted = true;
					immDTO.IsDirty = true;
					
					onManagePatientImmunizationEvent();
				});
			}
			
			private function onManagePatientImmunizationEvent():void
			{
				viewModel.managePatientImmunization();
			}
			
			protected function onSortDropdownOpen(event:DropDownEvent):void
			{
				uiSortDropdown.dropDown.x = uiSortDropdown.x + 24 ; //add container left padding, should convert to global if we really want perfect
			}
			
		]]>
	</fx:Script>
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	<s:layout>
		<s:VerticalLayout gap="0" paddingBottom="10"/>
	</s:layout>
	<component:PatientSubViewTitleBar width="100%" label="IMMUNIZATION" maxSectionCounter="4" sectionNumber="4" showHistoryPart="true"
									  MainSectionLabel="History"
									  dictationNoteViewModel="{viewModel.dictationNoteHistoryViewModel}"/>
	
	<dictation:PatientDictationNoteHistoryView width="100%" viewModel="{viewModel.dictationNoteHistoryViewModel}"
												dictationNoteDataProvider="{model.immunizationDictationNoteHistoryDTOList}"/>
	
	<s:Scroller width="100%" height="100%" horizontalScrollPolicy="off" verticalScrollPolicy="auto" skinClass="com.gazuntite.skins.controls.list.InvisibleScrollerSkin" >
		<s:Group width="100%" height="100%">
			<s:layout>
				<s:VerticalLayout gap="0" />
			</s:layout>
			
			<s:SkinnableContainer width="100%" height="27" skinClass="com.gazuntite.skins.PatientSortBarSkin">
				<s:layout>
					<s:HorizontalLayout verticalAlign="middle" paddingLeft="10" paddingRight="10" gap="8"/>
				</s:layout>
				<s:Label text="Arrange By:" styleName="emailInboxToolbarTitle" />
				<s:DropDownList id="uiSortDropdown"
								skinClass="com.gazuntite.skins.controls.list.PatientSortBarDropListSkin"
								selectedIndex="0"
								open="onSortDropdownOpen(event)"
								>
					<s:dataProvider>
						<s:ArrayCollection>
							<fx:Object label="Recently Added" />
							<fx:Object label="Immunization Name" />
						</s:ArrayCollection>
					</s:dataProvider>
				</s:DropDownList>
				<s:Spacer width="100%" />
			</s:SkinnableContainer>
			<s:List id="uiInboxList"
					width="100%" height="100%" allowMultipleSelection="true"
					skinClass="com.gazuntite.skins.controls.list.PatientInputListSkin"
					borderVisible="false"
					dataProvider="{model.immunizationDTOList}"
					itemRenderer="com.gazuntite.view.patient.component.itemrenderer.immunization.ImmunInputListItemRenderer"/>
			
		</s:Group>
	</s:Scroller>
</s:SkinnableContainer>