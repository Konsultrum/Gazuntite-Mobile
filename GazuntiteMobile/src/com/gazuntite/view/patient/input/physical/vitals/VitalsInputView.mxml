<?xml version="1.0" encoding="utf-8"?>
<s:SkinnableContainer xmlns:fx="http://ns.adobe.com/mxml/2009" 
					  xmlns:s="library://ns.adobe.com/flex/spark" 
					  xmlns:mx="library://ns.adobe.com/flex/mx"
					  skinClass="com.gazuntite.skins.controls.container.PatientInputSubViewContainerSkin" 
					  xmlns:supportclass="com.gazuntite.view.patient.supportclass.*" 
					  xmlns:component="com.gazuntite.view.patient.component.*" 
					  xmlns:components="com.gazuntite.components.*"
					  xmlns:vitals="com.gazuntite.view.patient.input.physical.vitals.*" xmlns:dictation="com.gazuntite.components.dictation.*"
					  >
	<fx:Script>
		<![CDATA[
			import com.gazuntite.patient.visit.model.QIModelLocator;
			
			import mx.events.FlexEvent;
			
			import spark.components.ToggleButton;
			[Bindable]
			public var model:QIModelLocator = QIModelLocator.getInstance();
			
			[Bindable]
			public var viewModel:PatientInputPhysicalVitalsViewModel = PatientInputPhysicalVitalsViewModel.getInstance();
			
		
			protected function patientsubviewtitlebar1_creationCompleteHandler(event:FlexEvent):void
			{
				id_titleBar.uiEnglishMetric.addEventListener(MouseEvent.CLICK, OnUnitChangeClick);
				
				addEventListener(PatientInputPhysicalVitalsEvent.PATIENT_INPUT_VITALS_ADD_EVENT, patientInputPhysicalVitalsAddHandler, false, 0, true);
				addEventListener(PatientInputPhysicalVitalsEvent.PATIENT_INPUT_VITALS_EDIT_EVENT, patientInputPhysicalVitalsEditHandler, false, 0, true);
				addEventListener(PatientInputPhysicalVitalsEvent.PATIENT_INPUT_VITALS_DELETE_EVENT, patientInputPhysicalVitalsDeleteHandler, false, 0, true);
			}
			
			private function OnUnitChangeClick(event:MouseEvent):void
			{
				var isMetric:Boolean = (event.currentTarget as ToggleButton).selected;
				id_vital.setCalculationAndConversions(isMetric);
			}
			
			private function patientInputPhysicalVitalsAddHandler(event:PatientInputPhysicalVitalsEvent):void
			{
				if (!event.vitalsDTO)
					return;
				
				event.vitalsDTO.Note = dictationNoteView.note;
				
				if (!model.patientVitalsInputList)
					model.patientVitalsInputList = new ArrayCollection();
				
				model.patientVitalsInputList.removeAll();
				
				event.vitalsDTO.SNo = "1";
				model.patientVitalsInputList.addItem(event.vitalsDTO);
				
				viewModel.managePatientVitals(event.vitalsDTO, onVitalsSaved);
				
				dictationNoteView.note = "";
				viewModel.dictationNoteViewModel.inDictationMode = false;
				viewModel.dictationNoteViewModel.inNoteMode = false;
			}
			
			private function patientInputPhysicalVitalsEditHandler(event:PatientInputPhysicalVitalsEvent):void
			{
				if (!event.vitalsDTO)
					return;
				
				if (!model.patientVitalsInputList)
					model.patientVitalsInputList = new ArrayCollection();
				
				model.patientVitalsInputList.removeAll();
				
				event.vitalsDTO.SNo = "1";
				event.vitalsDTO.IsDirty = true;
				model.patientVitalsInputList.addItem(event.vitalsDTO);
				
				viewModel.managePatientVitals(event.vitalsDTO, onVitalsSaved);
			}
			
			private function patientInputPhysicalVitalsDeleteHandler(event:PatientInputPhysicalVitalsEvent):void
			{
				if (!event.vitalsDTO)
					return;
				
				if (model.patientVitalsInputList)
					model.patientVitalsInputList.removeAll();
				
				viewModel.managePatientVitals(event.vitalsDTO, onVitalsSaved);
			}
			
			private function onVitalsSaved(success:Boolean):void
			{
				if (!success)
					return;
				
				viewModel.loadPatientVitals();
			}
		]]>
	</fx:Script>
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	
	<s:layout>
		<s:VerticalLayout gap="0" paddingTop="1" paddingBottom="10"/>
	</s:layout>
	<component:PatientSubViewTitleBar id="id_titleBar" width="100%" label="VITALS"  sectionNumber="1" maxSectionCounter="5" showInputPart="true" inputCounter="0"
									  MainSectionLabel="Physical"
									  dictationNoteViewModel="{viewModel.dictationNoteViewModel}"
									  showMetric="true" creationComplete="patientsubviewtitlebar1_creationCompleteHandler(event)"
									  />
	
	<dictation:PatientDictationNoteView id="dictationNoteView" width="100%" minHeight="47" viewModel="{viewModel.dictationNoteViewModel}"
										 isSectionLevel="true" isSaveButtonVisible="false"/>
	
	<s:Scroller width="100%" height="100%" horizontalScrollPolicy="off" verticalScrollPolicy="auto" skinClass="com.gazuntite.skins.controls.list.InvisibleScrollerSkin" >
		<s:Group width="100%" height="100%">
			<s:layout>
				<s:VerticalLayout gap="0" />
			</s:layout>	
			
			<s:HGroup width="100%" paddingTop="2" paddingBottom="2" paddingLeft="0" paddingRight="0">
				<vitals:VitalsItemEditView2 width="100%" id="id_vital"/>
			</s:HGroup>
			
			<s:SkinnableContainer width="100%" height="27" skinClass="com.gazuntite.skins.PatientSortBarSkin">
				<s:layout>
					<s:HorizontalLayout verticalAlign="middle" paddingLeft="10" paddingRight="10" gap="8"/>
				</s:layout>
				
				<s:Label text="Arrange By:" styleName="emailInboxToolbarTitle" />
				<s:DropDownList id="uiSort"  
								selectedIndex="0"
								buttonMode="true" 
								toolTip="{uiSort.selectedIndex == -1 ? 'Sort List': (uiSort.selectedItem as Object).label}"
								skinClass="com.gazuntite.skins.controls.list.PatientSortBarDropListSkin" 
								>
					<s:dataProvider>
						<s:ArrayCollection>
							<fx:Object label="Recently Added" />
							<fx:Object label="Vitals" />
						</s:ArrayCollection>
					</s:dataProvider>
				</s:DropDownList>
				<s:Spacer width="100%" />
			</s:SkinnableContainer>
			
			<s:List id="uiInboxList"
					width="100%"
					allowMultipleSelection="false"
					borderVisible="false"
					dataProvider="{model.patientVitalsInputList}"
					skinClass="com.gazuntite.skins.controls.list.PatientInputListSkin"
					itemRenderer="com.gazuntite.view.patient.input.physical.vitals.VitalsItemRenderer"/>
		</s:Group>	
	</s:Scroller>
</s:SkinnableContainer>
