<?xml version="1.0" encoding="utf-8"?>
<s:Group xmlns:fx="http://ns.adobe.com/mxml/2009" 
		 xmlns:s="library://ns.adobe.com/flex/spark" 
		 xmlns:mx="library://ns.adobe.com/flex/mx" 
		 xmlns:diabetes="com.gazuntite.provider.live.services.diabetes.view.physical.*"
		 xmlns:physical="com.gazuntite.view.patient.input.physical.physical.*" 
		 xmlns:reviewofsystem="com.gazuntite.view.patient.input.physical.reviewofsystem.*"
		 xmlns:qicomponent="com.gazuntite.view.patient.component.*" 
		 xmlns:components="com.gazuntite.controls.extended.components.*" 
		 xmlns:dictation="com.gazuntite.components.dictation.*" 
		 creationComplete="cc(event)" 
		 >
	<fx:Script>
		<![CDATA[
			import com.gazuntite.common.dto.ModuleNoteDTO;
			import com.gazuntite.common.dto.physical.ros.PhysicalDTO;
			import com.gazuntite.common.view.components.reviewofsystem.PatientInputPhysicalReviewOfSystemViewModel;
			import com.gazuntite.components.dictation.PatientDictationNoteViewEvent;
			import com.gazuntite.patient.visit.model.QIModelLocator;
			import com.gazuntite.patient.visit.utils.Constants;
			import com.gazuntite.patient.visit.utils.QIUtilityFunctions;
			import com.gazuntite.view.patient.viewmodel.tempmodel.TempModelPhysicalRos;
			import com.gazuntite.view.patient.viewmodel.tempmodel.TempModelPhysicalRosItemLevelOne;
			import com.gazuntite.viewModel.PatientDictationNoteViewModel;
			
			import mx.binding.utils.BindingUtils;
			import mx.collections.ArrayCollection;
			import mx.events.FlexEvent;
			
			[Bindable]	
			private var model:QIModelLocator = QIModelLocator.getInstance();
			
			[Bindable]
			public var viewModel:PatientInputPhysicalReviewOfSystemViewModel = PatientInputPhysicalReviewOfSystemViewModel.getInstance();
			
			[Bindable]
			private var dictationNoteViewModel:PatientDictationNoteViewModel =  viewModel.physicalDictationNoteViewModel;
			
			[Bindable]
			private var notesDTO:ModuleNoteDTO;
			
			private var _moduleName:String;
			
			[Bindable]
			public function get moduleName():String
			{
				return _moduleName;
			}
			
			public function set moduleName(value:String):void
			{
				_moduleName = value;
				
				dictationNoteViewModel = viewModel.physicalDictationNoteViewModel;
				
				if (moduleName.length < 0)
					return;
				
				notesDTO = QIUtilityFunctions.getModuleNoteDTO(moduleName);
			}
			
			/////////////////// Physical STATIC DATA PROVIDER ////////////////////////////////////////////
			[Bindable]
			private var PhysicalList:ArrayCollection;
			
			private var firstLevelLabels:Array 		= ["General", "HEENT", "Respiratory", "Cardiovascular", "Breast", "Gastrointestinal", "Genitourinary", "Lymph/Endo", "Nuscle/Skel", "Skin", "Neurological", "Allergy" ,"Psychiatric", "Other", "Respiratory", "Cardiovascular", "Breast", "Gastrointestinal", "Genitourinary", "Lymph/Endo"];
			private var SecondLevelLabels:Array 	= ["Avg. Weight", "Weight Loss/Gain", "Sense of Well Being", "Strength", "Conduct Usual Activities", "Exercise Tolerance", "Fatigue", "Fever/chills", "Weakness", "Trouble Sleeping", "General State of Health", "Other"];
			private var HEENT2ndLevelLabels:Array 	= ["Head", "Eyes", "Ears", "Nose", "Throat"];
			private var HEENT3rdLevelLabels:Array 	= ["Headaches", "Vertigo", "Light Headedness", "Head Injury", "Other"];
			
			private function createDP():void
			{
				PhysicalList = new ArrayCollection();
				var i:int;
				for(i = 0; i < firstLevelLabels.length; i++ )
				{
					var dto:PhysicalDTO = new PhysicalDTO();
					dto.MainCategoryName = firstLevelLabels[i];
					dto.PhysicalMainCategoryTypeID = i;
					
					if( i == 1 )
						create2ndLevelHEENT( dto );
					else
						create2ndLevel( dto );
					
					PhysicalList.addItem( dto );
				}
			}
			
			private function create2ndLevel(parent:PhysicalDTO):void
			{
				var list:ArrayCollection = new ArrayCollection();
				var i:int;
				for(i = 0; i < SecondLevelLabels.length; i++ )
				{
					var dto:PhysicalDTO = new PhysicalDTO();
					dto.MainCategoryName = SecondLevelLabels[i];
					dto.PhysicalMainCategoryTypeID = parent.PhysicalMainCategoryTypeID;
					dto.PhysicalSubCategoryTypeID = i;
					
					list.addItem( dto );
				}
				
				parent.children = list;
			}
			
			private function create2ndLevelHEENT(parent:PhysicalDTO):void
			{
				var list:ArrayCollection = new ArrayCollection();
				var i:int;
				for(i = 0; i < HEENT2ndLevelLabels.length; i++ )
				{
					var dto:PhysicalDTO = new PhysicalDTO();
					dto.MainCategoryName = HEENT2ndLevelLabels[i];
					dto.PhysicalMainCategoryTypeID = parent.PhysicalMainCategoryTypeID;
					dto.PhysicalSubCategoryTypeID = i;
					create3rdLevel( dto );
					list.addItem( dto );
				}
				
				parent.children = list;
			}
			
			private function create3rdLevel(parent:PhysicalDTO):void
			{
				var list:ArrayCollection = new ArrayCollection();
				var i:int;
				for(i = 0; i < HEENT3rdLevelLabels.length; i++ )
				{
					var dto:PhysicalDTO = new PhysicalDTO();
					dto.MainCategoryName = HEENT3rdLevelLabels[i];
					dto.PhysicalMainCategoryTypeID = parent.PhysicalSubCategoryTypeID;
					dto.PhysicalSubCategoryTypeID = i;
					
					list.addItem( dto );
				}
				
				parent.children = list;
			}
			
			/////////////////// Physical STATIC DATA PROVIDER ////////////////////////////////////////////

			protected function cc(event:FlexEvent):void
			{
				
				/* arrCol = new ArrayCollection();
				
				arrCol.source = [{serialNumber: "1", headerLabel:"General- Avg.Weight [Abnormal]", inDictationNoteMode: false}, 
					{serialNumber: "2", headerLabel:"Head- Headache [Abnormal]", inDictationNoteMode: false}, 
					{serialNumber: "3", headerLabel:"Skin- Rash [Normal]", inDictationNoteMode: false}, 
					{serialNumber: "4", headerLabel:"Complete PE/Chronic [Abnormal]", inDictationNoteMode: false}]; */
				
				
				addEventListener(PatientDictationNoteViewEvent.PATIENT_DICTATION_NOTE_SAVE_EVENT, patientDictationNoteSaveHandler, false, 0, true);
					
				createDP();
				// TODO Auto-generated method stub
				addEventListener("NoDiabetes" ,function():void{
					
					uiViewStack.selectedIndex = 0;
					
				});
				
				addEventListener("Diabetes" ,function():void{
					
					uiViewStack.selectedIndex = 1;
					
				});
				
				BindingUtils.bindSetter(CheckPatientHasDiabetes, model, "diagnosisDTOAcuteHistoryList");
				BindingUtils.bindSetter(CheckPatientHasDiabetes, model, "diagnosisDTOChronicHistoryList");
				BindingUtils.bindSetter(CheckPatientHasDiabetes, model, "diagnosisDTOList");
			}
			
			private function CheckPatientHasDiabetes(collection:Object):void
			{
				  /* titleBar.showDiabetesButton = QIUtilityFunctions.isDiabetesPaitent();   */
				  QIUtilityFunctions.isDiabetesPaitent();  
			}
			
			private function patientDictationNoteSaveHandler(event:PatientDictationNoteViewEvent):void
			{
				event.moduleName = moduleName;
				event.data = notesDTO;
			}

			
		]]>
	</fx:Script>
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	
	<s:layout>
		<s:VerticalLayout gap="0" paddingTop="1" paddingBottom="0"		/>
	</s:layout>
	<qicomponent:PatientSubViewTitleBar id="titleBar" width="100%" label="{moduleName}"   maxSectionCounter="5" sectionNumber="4" showInputPart="true" inputCounter="0" showFlipButton="true"
										MainSectionLabel="Physical"
									  dictationNoteViewModel="{dictationNoteViewModel}" showAllNormalButton="true"
									 />
	
	<dictation:PatientDictationNoteView id="dictationNoteView" width="100%" minHeight="47" viewModel="{dictationNoteViewModel}"
										 isSectionLevel="true" note="@{notesDTO.Note}"/>
	<s:Scroller width="100%" height="100%"  
				skinClass="com.gazuntite.skins.controls.list.InvisibleScrollerSkin" 
				horizontalScrollPolicy="off" verticalScrollPolicy="auto">
		<s:Group width="100%" height="100%">
			<s:layout>
				<s:VerticalLayout gap="0" />
			</s:layout>
			
			
			
			<s:SkinnableContainer width="100%" height="100%" ><!-- skinClass="com.gazuntite.skins.controls.container.PinkBackgroundSkin"-->
				<components:LabelViewStack id="uiViewStack" width="100%" height="100%" backgroundAlpha="0" borderVisible="false">
					<s:ArrayList>
						<physical:PhysicalInputView width="100%" height="100%" />
						<diabetes:PhysicalDiabeticView width="100%" height="100%" />
					</s:ArrayList>
				</components:LabelViewStack>
			</s:SkinnableContainer>
			
			
		</s:Group>	
	</s:Scroller>

	
</s:Group>
