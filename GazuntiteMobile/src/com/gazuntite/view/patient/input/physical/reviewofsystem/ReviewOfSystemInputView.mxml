<?xml version="1.0" encoding="utf-8"?>
<s:SkinnableContainer xmlns:fx="http://ns.adobe.com/mxml/2009" 
					  xmlns:s="library://ns.adobe.com/flex/spark" 
					  xmlns:mx="library://ns.adobe.com/flex/mx"
					  skinClass="com.gazuntite.skins.controls.container.PatientInputSubViewContainerSkin" 
					  xmlns:supportclass="com.gazuntite.view.patient.supportclass.*" 
					  xmlns:component="com.gazuntite.view.patient.component.*" 
					  xmlns:components="com.gazuntite.components.*" 
					  xmlns:reviewofsystem="com.gazuntite.common.view.components.reviewofsystem.*"
					  creationComplete="cc()" xmlns:dictation="com.gazuntite.components.dictation.*"
					  >
	<fx:Script>
		<![CDATA[
			import com.adobe.cairngorm.control.CairngormEventDispatcher;
			import com.gazuntite.common.dto.ModuleNoteDTO;
			import com.gazuntite.common.dto.physical.ros.ROSDTO;
			import com.gazuntite.common.view.components.reviewofsystem.PatientInputPhysicalReviewOfSystemViewModel;
			import com.gazuntite.components.dictation.PatientDictationNoteViewEvent;
			import com.gazuntite.patient.visit.event.physical.ros.LoadROSCategoryTypesEvent;
			import com.gazuntite.patient.visit.event.physical.ros.ManagePatientROSEvent;
			import com.gazuntite.patient.visit.model.QIModelLocator;
			import com.gazuntite.patient.visit.utils.Constants;
			import com.gazuntite.patient.visit.utils.QIUtilityFunctions;
			import com.gazuntite.view.patient.viewmodel.tempmodel.TempModelPhysicalRos;
			import com.gazuntite.viewModel.PatientDictationNoteViewModel;
			
			import spark.events.IndexChangeEvent;
			
			[Bindable]
			private var model:QIModelLocator = QIModelLocator.getInstance();
			
			[Bindable]
			public var viewModel:PatientInputPhysicalReviewOfSystemViewModel = PatientInputPhysicalReviewOfSystemViewModel.getInstance();
			
			private var _moduleName:String;
			
			[Bindable]
			private var notesDTO:ModuleNoteDTO;
			
			[Bindable]
			private var dictationNoteViewModel:PatientDictationNoteViewModel;
			
			private var m_acDataProvider:ArrayCollection;
			
			[Bindable]
			public function get dataProvider():ArrayCollection
			{
				return m_acDataProvider;
			}
			
			public function set dataProvider(value:ArrayCollection):void
			{
				m_acDataProvider = value;
			}

			
			/////////////////// ROS STATIC DATA PROVIDER ////////////////////////////////////////////
			
			private var firstLevelLabels:Array 		= ["General", "HEENT", "Respiratory", "Cardiovascular", "Breast", "Gastrointestinal", "Genitourinary", "Lymph/Endo", "Nuscle/Skel", "Skin", "Neurological", "Allergy" ,"Psychiatric", "Other", "Respiratory", "Cardiovascular", "Breast", "Gastrointestinal", "Genitourinary", "Lymph/Endo"];
			private var SecondLevelLabels:Array 	= ["Avg. Weight", "Weight Loss/Gain", "Sense of Well Being", "Strength", "Conduct Usual Activities", "Exercise Tolerance", "Fatigue", "Fever/chills", "Weakness", "Trouble Sleeping", "General State of Health", "Other"];
			private var HEENT2ndLevelLabels:Array 	= ["Head", "Eyes", "Ears", "Nose", "Throat"];
			private var HEENT3rdLevelLabels:Array 	= ["Headaches", "Vertigo", "Light Headedness", "Head Injury", "Other"];
			
			private function createDP():void
			{
				if( null != dataProvider && dataProvider.length > 0 )
					return;
				
				dataProvider = new ArrayCollection();
				var i:int;
				for(i = 0; i < firstLevelLabels.length; i++ )
				{
					var dto:ROSDTO = new ROSDTO();
					dto.MainCategoryName = firstLevelLabels[i];
					dto.ROSMainCategoryTypeID = i;
					
					if( i == 1 )
						create2ndLevelHEENT( dto );
					else
						create2ndLevel( dto );
					
					dataProvider.addItem( dto );
				}
			}
			
			private function create2ndLevel(parent:ROSDTO):void
			{
				var list:ArrayCollection = new ArrayCollection();
				var i:int;
				for(i = 0; i < SecondLevelLabels.length; i++ )
				{
					var dto:ROSDTO = new ROSDTO();
					dto.MainCategoryName = SecondLevelLabels[i];
					dto.ROSMainCategoryTypeID = parent.ROSMainCategoryTypeID;
					dto.ROSSubCategoryTypeID = i;
					
					dto.Note = parent.MainCategoryName + "::" + dto.MainCategoryName +" \n dto.Note " + i ;
					
					list.addItem( dto );
				}
				
				parent.children = list;
			}
			
			private function create2ndLevelHEENT(parent:ROSDTO):void
			{
				var list:ArrayCollection = new ArrayCollection();
				var i:int;
				for(i = 0; i < HEENT2ndLevelLabels.length; i++ )
				{
					var dto:ROSDTO = new ROSDTO();
					dto.MainCategoryName = HEENT2ndLevelLabels[i];
					dto.ROSMainCategoryTypeID = parent.ROSMainCategoryTypeID;
					dto.ROSSubCategoryTypeID = i;
					create3rdLevel( dto );
					list.addItem( dto );
				}
				
				parent.children = list;
			}
			
			private function create3rdLevel(parent:ROSDTO):void
			{
				var list:ArrayCollection = new ArrayCollection();
				var i:int;
				for(i = 0; i < HEENT3rdLevelLabels.length; i++ )
				{
					var dto:ROSDTO = new ROSDTO();
					dto.MainCategoryName = HEENT3rdLevelLabels[i];
					dto.ROSMainCategoryTypeID = parent.ROSSubCategoryTypeID;
					dto.ROSSubCategoryTypeID = i;
					
					dto.Note = parent.MainCategoryName + "::" + dto.MainCategoryName +" \n dto.Note " + i ;
					
					list.addItem( dto );
				}
				
				parent.children = list;
			}
			
			/////////////////// ROS STATIC DATA PROVIDER ////////////////////////////////////////////
			private function cc():void
			{
				if (moduleName == Constants.REVIEW_OF_SYSTEM_MODULE_NAME)
				{
					createDP();
				}
				
				
				addEventListener(PatientDictationNoteViewEvent.PATIENT_DICTATION_NOTE_SAVE_EVENT, patientDictationNoteSaveHandler, false, 0, true);
				
			}
			
			
			
			[Bindable]
			public function get moduleName():String
			{
				return _moduleName;
			}
			
			public function set moduleName(value:String):void
			{
				_moduleName = value;
				
				if (moduleName.length < 0)
					return;
				
				notesDTO = QIUtilityFunctions.getModuleNoteDTO(moduleName);
			}

			protected function uiSort_changeHandler(event:IndexChangeEvent):void
			{
				if (uiSort.selectedIndex == 0)
					uiSort.toolTip = 'Recently Added';
				else
					uiSort.toolTip = 'Category';
			}
			
			private function patientDictationNoteSaveHandler(event:PatientDictationNoteViewEvent):void
			{
				event.moduleName = moduleName;
				event.data = notesDTO;
			}

			
			protected function saveDataHandler(event:Event):void
			{
				var mange:ManagePatientROSEvent = new ManagePatientROSEvent();
				CairngormEventDispatcher.getInstance().dispatchEvent( mange );
			}
			
		]]>
	</fx:Script>		
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	
	<s:layout>
		<s:VerticalLayout gap="0" paddingTop="1" paddingBottom="0"		/>
	</s:layout>
	<component:PatientSubViewTitleBar id="titleBar" width="100%" label="{moduleName}" maxSectionCounter="5" sectionNumber="3" showInputPart="true" inputCounter="0" showFlipButton="true"
									  MainSectionLabel="Physical"
									  dictationNoteViewModel="{dictationNoteViewModel}" showAllNormalButton="true"
								  />
	
	<dictation:PatientDictationNoteView id="dictationNoteView" width="100%" minHeight="47" viewModel="{dictationNoteViewModel}"
										 isSectionLevel="true" note="@{notesDTO.Note}"/>
	<s:Scroller width="100%" height="100%"  
				skinClass="com.gazuntite.skins.controls.list.InvisibleScrollerSkin" 
				horizontalScrollPolicy="off" verticalScrollPolicy="auto">
		<s:Group width="100%" height="100%">
			<s:layout>
				<s:VerticalLayout gap="0" />
			</s:layout>
			
			<s:HGroup width="100%" height="100%" paddingTop="2" paddingBottom="2" paddingLeft="0" paddingRight="0">
				<reviewofsystem:ReviewOfSystemMainEditView dataProvider="{model.rosDTOList}" saveData="saveDataHandler(event)" width="100%" height="100%" minHeight="150"/>
			</s:HGroup>
			<s:Rect height="4"/>
			
			<s:SkinnableContainer width="100%" height="27" skinClass="com.gazuntite.skins.PatientSortBarSkin">
				<s:layout>
					<s:HorizontalLayout verticalAlign="middle" paddingLeft="10" paddingRight="10" gap="8"/>
				</s:layout>
				
				<s:Label text="Arrange By:" styleName="emailInboxToolbarTitle" />
				<s:DropDownList id="uiSort"  
								selectedIndex="0"
								buttonMode="true" 
								toolTip="Recently Added"
								skinClass="com.gazuntite.skins.controls.list.PatientSortBarDropListSkin" 
								change="uiSort_changeHandler(event)"
								>
					<s:dataProvider>
						<s:ArrayCollection>
							<fx:Object label="Recently Added"/>
							<fx:Object label="Category"/>
						</s:ArrayCollection>
					</s:dataProvider>
				</s:DropDownList>
				<s:Spacer width="100%"/>
			</s:SkinnableContainer>
			
			<s:List id="uiReviewOfSystemInputViewList"
					width="100%"
					allowMultipleSelection="false"
					borderVisible="false"
					dataProvider="{model.rosHistoryDTOList}"
					verticalScrollPolicy="off"
					horizontalScrollPolicy="off"
					itemRenderer="com.gazuntite.common.view.components.reviewofsystem.renderers.ReviewOfSystemListIR"
					/>
		</s:Group>	
	</s:Scroller>
</s:SkinnableContainer>
