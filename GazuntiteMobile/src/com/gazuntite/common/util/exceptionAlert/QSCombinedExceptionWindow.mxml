<?xml version="1.0" encoding="utf-8"?>
<components1:PopupWindow xmlns:fx="http://ns.adobe.com/mxml/2009" 
						xmlns:s="library://ns.adobe.com/flex/spark" 
						xmlns:mx="library://ns.adobe.com/flex/mx" 
						closing="popupwindow1_closingHandler(event)" 
						xmlns:components1="com.gazuntite.controls.extended.components.*"
						>
	
	<fx:Script>
		<![CDATA[
			import com.adobe.cairngorm.control.CairngormEventDispatcher;
			import com.gazuntite.common.dto.ErrorReportDTO;
			import com.gazuntite.common.event.SendErrorReportEvent;
			import com.gazuntite.utils.UtilityFunctions;
			
			import mx.core.FlexGlobals;
			
			private static var instance:QSCombinedExceptionWindow;
			
			[Bindable]
			private var loggedInUserID:int;
			
			[Bindable]
			private var IsShowDetails:Boolean =false;
			
			private function ClosePopup():void
			{
				id_Details.text = "";
				removePopup();	
			}
			
			protected function id_ShowDetails_clickHandler(event:MouseEvent):void
			{
				if(!id_Details.visible)
				{
					id_Details.visible 			= true;
					id_Details.includeInLayout 	= true;
					id_ShowDetails.label 		= "Hide Details";
				}
				else
				{
					id_Details.visible			= false;
					id_Details.includeInLayout 	= false;
					id_ShowDetails.label		= "Show Details";
				}
			}
			
			protected function id_Cancel_clickHandler(event:MouseEvent):void
			{
				ClosePopup();		
			}
			
			protected function id_Send_clickHandler(event:MouseEvent):void
			{
				var objErrorDTO:ErrorReportDTO 	= new ErrorReportDTO();
				objErrorDTO.EmailTemplateID 	= 1;
				objErrorDTO.Message 			= id_Details.text;
				objErrorDTO.Subject 			= "Quivus Error Report";
				objErrorDTO.SenderID 			= loggedInUserID;
				
				var errorSendingEvent:SendErrorReportEvent = new SendErrorReportEvent(objErrorDTO, ClosePopup);
				CairngormEventDispatcher.getInstance().dispatchEvent(errorSendingEvent);
			}
			
			protected function popupwindow1_closingHandler(event:Event):void
			{
				ClosePopup();		
			}
			
			
			public function Show(targetName:String, message:String, userID:int):void
			{
				ShowPopup( FlexGlobals.topLevelApplication as DisplayObject, true );
				
				callLater( function():void
				{
					var messageSeperator:String = "---------------------- *** " + targetName + " *** ---------------------- \n";
					
					if( id_Details.text.length > 0 )
						messageSeperator = "\n\n" + messageSeperator;
					
					id_Details.text 	+= messageSeperator + message;
					loggedInUserID 		= userID;
				});
			}
			
			public static function getInstance():QSCombinedExceptionWindow
			{
				if ( UtilityFunctions.IsNullOrEmpty( instance ) )
					instance = new QSCombinedExceptionWindow();
				
				return instance;
			}
			
		]]>
	</fx:Script>
	
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	
	<components1:layout>
		<s:VerticalLayout verticalAlign="middle" horizontalAlign="center" paddingBottom="10" paddingLeft="10" paddingRight="10" paddingTop="10" />
	</components1:layout>
		
	
	<s:RichText id="id_HeaderDetails" text="Please tell Quivus team about this error.
				System automatically created an report for this error, you can send that
				error to Quivus technical team to improve the product performance."  />
	
	<s:Button id="id_ShowDetails" label="Show Details" click="id_ShowDetails_clickHandler(event)" />
	<s:TextArea id="id_Details" width="100%" height="300" />

	<s:HGroup width="100%" horizontalAlign="right">
		<s:Button id="id_Send" label="Send Error Report" click="id_Send_clickHandler(event)" />
		<s:Button id="id_Cancel" label="Cancel" click="id_Cancel_clickHandler(event)" />
	</s:HGroup>
	
</components1:PopupWindow>
