<?xml version="1.0" encoding="utf-8"?>
<s:SkinnableContainer xmlns:fx="http://ns.adobe.com/mxml/2009"
					  xmlns:s="library://ns.adobe.com/flex/spark"
					  xmlns:mx="library://ns.adobe.com/flex/mx"
					  skinClass="com.adobe.gazuntite.skins.chrome.dataGridSkins.filterGridHeaderSkin" 
					  xmlns:buttonSkins="com.adobe.gazuntite.skins.chrome.buttonSkins.*" 
					  xmlns:components="com.gazuntite.controls.extended.components.*">

	<fx:Metadata>
		[Event(name="ListOnly", type="flash.events.Event")]
		[Event(name="ChangeStaus", type="flash.events.Event")]
		[Event(name="GoToFirstPage", type="flash.events.Event")]
		[Event(name="GoToPreviousPage", type="flash.events.Event")]
		[Event(name="GoToNextPage", type="flash.events.Event")]
		[Event(name="GoToLastPage", type="flash.events.Event")]
		[Event(name="RefreshView", type="flash.events.Event")]
		[Event(name="SearchClick", type="flash.events.Event")]		
		[Event(name="ComboChange", type="flash.events.Event")]
	</fx:Metadata>

	
	<fx:Script>
		<![CDATA[
			import com.gazuntite.controls.extended.skins.transparentTextInputSkin;
			
			import spark.events.TextOperationEvent;
			
			import mx.collections.ArrayCollection;
			
			import spark.events.IndexChangeEvent;
			
			public static const LIST_ONLY			:String = "ListOnly";
			public static const CHANGE_STAUS		:String = "ChangeStaus";
			public static const GOTO_FIRST_PAGE		:String = "GoToFirstPage";
			public static const GOTO_PREVIOUS_PAGE	:String = "GoToPreviousPage";
			public static const GOTO_NEXT_PAGE		:String = "GoToNextPage";
			public static const GOTO_LAST_PAGE		:String = "GoToLastPage";
			public static const REFRESH_VIEW		:String = "RefreshView";
			public static const SEARCH_CLICK		:String = "SearchClick";		
			public static const COMBO_CHANGE		:String = "ComboChange";
			
			
			[Bindable]
			private var m_oDataProvider:ArrayCollection ;

			[Bindable]
			private var m_bShowStatusButton:Boolean ;
			
			[Bindable]
			public function get DataProvider():ArrayCollection
			{
				return m_oDataProvider;
			}
			
			public function set DataProvider(value:ArrayCollection):void
			{
				m_oDataProvider = value;
			}
			
			
			protected function clickHandler(event:MouseEvent):void
			{
				var btn:Button = event.currentTarget as Button;
				switch( btn.id )
				{
					case "id_ListOnly":
						dispatchEvent( new Event( LIST_ONLY, true ) );
						break;
					case "id_ChangeStaus":
						dispatchEvent( new Event( CHANGE_STAUS, true ) );
						break;
					case "id_GoToFirstPage":
						dispatchEvent( new Event( GOTO_FIRST_PAGE, true ) );
						break;
					case "id_GoToPreviousPage":
						dispatchEvent( new Event( GOTO_PREVIOUS_PAGE, true ) );
						break;
					case "id_GoToNextPage":
						dispatchEvent( new Event( GOTO_NEXT_PAGE, true ) );
						break;
					case "id_GoToLastPage":
						dispatchEvent( new Event( GOTO_LAST_PAGE, true ) );
						break;
					case "id_Refresh":
						dispatchEvent( new Event( REFRESH_VIEW, true ) );
						break;
				}
			}

			protected function id_btnSearch_clickHandler(event:MouseEvent):void
			{
				dispatchEvent( new Event( SEARCH_CLICK, true ) );
			}
			
			
			public function  EnableNavigationButtons( currentPage:int, totalPages:int ):void
			{
				return;
				id_GoToFirstPage.enabled 		= currentPage != 1;
				id_GoToLastPage.enabled 		= currentPage != totalPages;
				id_GoToNextPage.enabled 		= !currentPage == totalPages;
				id_GoToPreviousPage.enabled 	= !currentPage == 1;
			}
			
			public function set  EnableChangeStausButton( value:Boolean ):void
			{
				m_bShowStatusButton 			= value;
			}

			protected function id_FieldsCmbo_changeHandler(event:IndexChangeEvent):void
			{
				dispatchEvent( new Event( COMBO_CHANGE, true ) );
				if(id_FieldsCmbo.selectedItem != null)
				{
					if(id_FieldsCmbo.selectedItem.label)
					{
						if(id_FieldsCmbo.selectedItem.label == 'Date')
						{
							isDateSelected = true;
							id_SearchTextInput.text = '';
						}
						else
							isDateSelected = false;
					}
				}
			}
			[Bindable]
			public function get labelField():String
			{
				return _labelField;
			}

			public function set labelField(value:String):void
			{
				_labelField = value;
			}

			private var isDateSelected:Boolean = false;
			private var _labelField:String = 'FieldName';
			
			protected function id_SearchTextInput_changeHandler(event:TextOperationEvent):void
			{
				if(isDateSelected)
				{
					var dob:String				= id_SearchTextInput.text.replace(/[^0-9]/g,"");
					id_SearchTextInput.text 	= dob.substring(0,2) + (dob.length>2?"/"+dob.substring(2,4) + (dob.length>4?"/"+dob.substring(4,8):""):"");
					id_SearchTextInput.selectRange(id_SearchTextInput.text.length, id_SearchTextInput.text.length);
				}
			}
			
		]]>
	</fx:Script>

	<fx:Declarations>

	</fx:Declarations>
	
	<s:layout>
		<s:HorizontalLayout verticalAlign="middle" paddingLeft="5" paddingRight="5" />
	</s:layout>
	
	<components:LabelComboBox id="id_FieldsCmbo" dataProvider="{DataProvider}" width="80" 
							   prompt="Select Type" focusAlpha="0" focusEnabled="false" focusRect="false" 
							  labelField="{labelField}" change="id_FieldsCmbo_changeHandler(event)" />
	<s:SkinnableContainer width="100%" styleName="patientSearchBGContainerSkin" >
	<s:layout >
		<s:HorizontalLayout gap="0" verticalAlign="middle"/>
	</s:layout>
		<components:LabelTextInput id="id_SearchTextInput"
								   change="id_SearchTextInput_changeHandler(event)"
								   focusAlpha="0"  width="100%"  prompt="Search" height="19"  skinClass="com.adobe.gazuntite.skins.chrome.textInputSkins.transparentTextInput"/>
		<s:Button id="id_btnSearch" click="id_btnSearch_clickHandler(event)"   styleName="orangeSearchButtonSkin"
				  buttonMode="true" useHandCursor="true" toolTip="Search"  height="19"  width="23"  />
	</s:SkinnableContainer>
	
	<s:Button id="id_ListOnly" label="List Only" click="clickHandler(event)" buttonMode="true" toolTip="List Only"  
			  skinClass="com.adobe.gazuntite.skins.chrome.buttonSkins.ListBtn" width="70"/>
	<s:Button id="id_ChangeStaus" label="Change Status" 	click="clickHandler(event)"  buttonMode="true" toolTip="Change Status"
			  visible="{m_bShowStatusButton}" includeInLayout="{m_bShowStatusButton}"
			  skinClass="com.adobe.gazuntite.skins.chrome.buttonSkins.ListBtn" width="100"/>
	
	
		<s:SkinnableContainer height="19" skinClass="com.adobe.gazuntite.skins.chrome.buttonSkins.buttonsBG" width="82">
			<s:layout>
				<s:HorizontalLayout gap="0" horizontalAlign="center" verticalAlign="middle"  />
			</s:layout>
		
	
	<s:Button id="id_GoToFirstPage" 	label="|&lt;" 			click="clickHandler(event)" buttonMode="true" toolTip="First"  
			   skinClass="com.adobe.gazuntite.skins.chrome.buttonSkins.paginationFirstBtn"/>
		<buttonSkins:buttonNavSeparator width="1" />
		
	<s:Button id="id_GoToPreviousPage" 	label="&lt;" 			click="clickHandler(event)" buttonMode="true" toolTip="Previous" 
			   skinClass="com.adobe.gazuntite.skins.chrome.buttonSkins.paginationPrevBtn"/>
		
			<buttonSkins:buttonNavSeparator width="1" />
	<s:Button id="id_GoToNextPage" 		label="&gt;" 			click="clickHandler(event)"  buttonMode="true" toolTip="Next"
			   skinClass="com.adobe.gazuntite.skins.chrome.buttonSkins.paginationNextBtn"/>
		
			<buttonSkins:buttonNavSeparator width="1" />
	<s:Button id="id_GoToLastPage" 		label="&gt;|" 			click="clickHandler(event)" buttonMode="true" toolTip="Last" 
			   skinClass="com.adobe.gazuntite.skins.chrome.buttonSkins.paginationLastBtn"/>
		</s:SkinnableContainer>
	<s:Group id="id_Spacer" height="2" width="100%" />
	
	<s:Button id="id_Refresh" 			label="RF" 				click="clickHandler(event)" buttonMode="true" toolTip="Refresh" 
			   skinClass="com.adobe.gazuntite.skins.chrome.buttonSkins.refreshBtn"/>
	
</s:SkinnableContainer>
