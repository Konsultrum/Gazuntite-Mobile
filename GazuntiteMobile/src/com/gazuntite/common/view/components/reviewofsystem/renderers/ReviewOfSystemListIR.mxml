<?xml version="1.0" encoding="utf-8"?>
<s:ItemRenderer xmlns:fx="http://ns.adobe.com/mxml/2009" 
				xmlns:s="library://ns.adobe.com/flex/spark" 
				xmlns:mx="library://ns.adobe.com/flex/mx" xmlns:components="com.gazuntite.components.*"
				width="100%" xmlns:dictation="com.gazuntite.components.dictation.*">
	<fx:Script>
		<![CDATA[
			import com.gazuntite.skins.controls.list.GeneralListAlternateItemSkin;
			import com.gazuntite.skins.controls.list.GeneralListItemSkin;
			import com.gazuntite.viewModel.PatientDictationNoteViewModel;
			
			[Bindable]
			public var viewModel:PatientDictationNoteViewModel = new PatientDictationNoteViewModel();
			
			[Bindable]
			private var dto:Object;
			
			override public function set data(value:Object):void
			{
				super.data = value;
				
				dto = data;
			}
			
			override protected function updateDisplayList(unscaledWidth:Number,  unscaledHeight:Number):void 
			{
				id_Header.setStyle('skinClass', itemIndex % 2 ? GeneralListAlternateItemSkin : GeneralListItemSkin);
				super.updateDisplayList(unscaledWidth, unscaledHeight);
			}
			
			private function onDictationNoteButtonsClick(event:MouseEvent):void
			{
				if (viewModel.inDictationMode || viewModel.inNoteMode)
					data.inDictationNoteMode = true;
					
				else
					data.inDictationNoteMode = false;
				
				editView.visible = data.inDictationNoteMode;
				editView.includeInLayout = data.inDictationNoteMode;
				
				event.stopPropagation();
			}
		]]>
	</fx:Script>
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	
	<s:SkinnableContainer id="id_Header" width="100%" height="35" buttonMode="true" >
		<s:Label left="5" right="110" color="#333333" 
				 fontFamily="CalibriCFF" fontSize="14" maxDisplayedLines="1" verticalCenter="0"
				 text="{data.serialNumber + '. ' + data.headerLabel}" toolTip="{data.serialNumber + '. ' + data.headerLabel}"/>
		
		<s:Group right="76" top="10">
			<s:Image source="@Embed('com/gazuntite/common/view/components/reviewofsystem/skin/images/new.png')"/>
			<s:Image source="@Embed('com/gazuntite/common/view/components/reviewofsystem/skin/images/clockblue.png')" visible="false" includeInLayout="false"/>
		</s:Group>
		
		<s:ToggleButton id="uiDictation" right="53" top="8"
						selected="@{viewModel.inDictationMode}" buttonMode="true" toolTip="Record level Dictation"
						skinClass="com.gazuntite.skins.controls.button.input.DictationButtonSkin"
						click="onDictationNoteButtonsClick(event)"/>
		
		<s:ToggleButton id="uiNote" right="28" top="8"
						selected="@{viewModel.inNoteMode}" buttonMode="true" toolTip="Record level Notes"
						skinClass="com.gazuntite.skins.controls.button.input.WriteNoteButtonSkin"
						click="onDictationNoteButtonsClick(event)"/>
		
		<s:Button right="4" top="8"
				  skinClass="com.gazuntite.skins.controls.button.input.RecycleButtonSkin"
				  buttonMode="true" useHandCursor="true" toolTip="Delete Record"/>
	</s:SkinnableContainer>
	
	<s:VGroup id="editView" left="0" width="{id_Header.width}" top="28" depth="1" paddingTop="{viewModel.visible?0:3}" gap="0">
		<dictation:PatientDictationNoteView width="100%" minHeight="47" viewModel="{viewModel}"/>
	</s:VGroup>
</s:ItemRenderer>
