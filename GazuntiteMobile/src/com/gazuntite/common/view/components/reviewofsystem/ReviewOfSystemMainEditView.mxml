<?xml version="1.0" encoding="utf-8"?>
<s:Group xmlns:fx="http://ns.adobe.com/mxml/2009" 
		 xmlns:s="library://ns.adobe.com/flex/spark" 
		 xmlns:mx="library://ns.adobe.com/flex/mx"
		 creationComplete="onCreated(event)"
		 resize="onResize(event)" 
		 xmlns:components="com.gazuntite.components.*"
		 xmlns:reviewofsystem="com.gazuntite.common.view.components.reviewofsystem.*" xmlns:dictation="com.gazuntite.components.dictation.*"
		 >
	<fx:Metadata>
		[Event(name="saveData", type="flash.events.Event")]
	</fx:Metadata>
	<fx:Script>
		<![CDATA[
			
			import mx.collections.ArrayCollection;
			import mx.controls.Alert;
			import mx.events.FlexEvent;
			import mx.events.ResizeEvent;
			
			import spark.events.IndexChangeEvent;
			
			[Bindable]
			protected var viewModel:PatientInputPhysicalReviewOfSystemViewModel = PatientInputPhysicalReviewOfSystemViewModel.getInstance();
			
			private var m_acDataProvider:ArrayCollection;
			
			[Bindable]
			protected var selectedItemRow:int = 0;
			
			[Bindable]
			protected var listItemHeight:int = 27;
			
			[Bindable]
			protected var listItemWidth:int = 100;
			
			[Bindable]
			public var selectedItem:Object;
			
			protected var selectedPage:int = 0;
			
			[Bindable]
			public function get dataProvider():ArrayCollection
			{
				return m_acDataProvider;
			}

			public function set dataProvider(value:ArrayCollection):void
			{
				m_acDataProvider = value;
				scrollToPage(0);
			}

			protected function onItemSelected(event:IndexChangeEvent):void
			{
				selectedItem = uiList.selectedItem;
				viewModel.rosDetailSelectedItemIndex = -1;
				viewModel.rosHeentSelectedItemIndex = -1;
				
				if (selectedItem.MainCategoryName.toLowerCase() == "heent")
				{
					viewModel.showRosItemDetailViewTopLevel = false;
					viewModel.showRosItemViewHeentLevel = true;
					viewModel.showRosItemLevel2DetailView = false;
					viewModel.showRosItemViewHeentDetailLevel = false;
				}
				else
				{
					viewModel.showRosItemDetailViewTopLevel = true;
					viewModel.showRosItemViewHeentLevel = false;
					viewModel.showRosItemLevel2DetailView = false;
					viewModel.showRosItemViewHeentDetailLevel = false;
				}
				var item_height:Number = listItemHeight;
				var total_items:int = uiList.dataProvider.length;
				var item_per_page:int = Math.ceil(uiListContainer.height/item_height)-1;
				var total_pages:int = Math.ceil(total_items/item_per_page);
				
				selectedItemRow = uiList.selectedIndex - item_per_page*selectedPage;
			}
			
			protected function scrollToPage(newPage:Number):void
			{
				if ( dataProvider == null)
				{
					return;
				}
				var item_height:Number = listItemHeight;
				var total_items:int = dataProvider.length;
				var item_per_page:int = Math.ceil(uiListContainer.height/item_height)-1;
				var total_pages:int = Math.ceil(total_items/item_per_page);
				
				if (newPage<0 || newPage>=total_pages)
				{
					return;
				}
				viewModel.showRosItemDetailViewTopLevel = false;
				viewModel.showRosItemViewHeentLevel = false;
				viewModel.showRosItemLevel2DetailView = false;
				viewModel.showRosItemViewHeentDetailLevel = false;
				viewModel.rosSelectedItemIndex = -1;
				viewModel.rosHeentSelectedItemIndex=-1;
				
				selectedPage = newPage;
				var scroll_to_item:int = newPage*item_per_page;
				var scroll_pos:int = scroll_to_item*item_height;
				//				uiListContainer.verticalScrollPosition = scroll_pos;
				uiScrollAnimatePath.valueTo = scroll_pos;
				uiScrollAnimate.play();
				uiPageLabel.text = (newPage+1).toString()+' of '+total_pages.toString();
				
				
			}
			
			protected function onCreated(event:FlexEvent):void
			{
				scrollToPage(0);
			}
			
			protected function onResize(event:ResizeEvent):void
			{
				scrollToPage(selectedPage);
			}
			
			protected function saveButton_clickHandler(event:MouseEvent):void
			{
				dispatchEvent( new Event("saveData", true) );
			}
			
		]]>
	</fx:Script>
	<fx:Declarations>
		<s:Animate id="uiScrollAnimate" target="{uiListContainer}" duration="300">
			<s:motionPaths>
				<s:SimpleMotionPath id="uiScrollAnimatePath" property="verticalScrollPosition" />
			</s:motionPaths>
			
		</s:Animate>
	</fx:Declarations>
	<s:layout>
		<s:VerticalLayout />
	</s:layout>
	
	<s:Group width="100%" height="100%">
		
		<s:BorderContainer height="100%" borderVisible="false" backgroundColor="#FFFFFF" cornerRadius="3">
			<s:filters>
				<s:DropShadowFilter alpha="0.75" angle="90" blurX="2" blurY="2" color="#000000"
									distance="0" hideObject="false" inner="false" knockout="false"
									quality="3" strength="1"/>
			</s:filters>
			<s:layout>
				<s:VerticalLayout
					horizontalAlign="center" paddingTop="2" paddingBottom="2" paddingLeft="2" paddingRight="2" gap="3"
					/>
			</s:layout>
			<s:Group  width="{uiListContainer.width}" height="23">
				<s:Rect left="1" right="1" top="1" bottom="1" alpha="1" radiusX="3">
					<s:stroke>
						<s:SolidColorStroke caps="round" color="#545454" joints="miter" miterLimit="3" weight="1"/>
					</s:stroke>
					<s:fill>
						<s:LinearGradient rotation="90">
							<s:GradientEntry alpha="1" color="#FFFFFF" ratio="0"/>
							<s:GradientEntry alpha="1.0" color="#BFC2CA" ratio="1"/>
						</s:LinearGradient>
					</s:fill>
					<s:filters>
						<s:DropShadowFilter alpha="0.75" angle="90" blurX="2" blurY="2" color="#000000"
											distance="1" hideObject="false" inner="false" knockout="false"
											quality="3" strength="1"/>
					</s:filters>
				</s:Rect>			
				<s:TextInput left="2" right="22" top="2" bottom="2" 
							 prompt="Search" width="{uiListContainer.width}" 
							 contentBackgroundAlpha="0" borderVisible="false" 
							 fontFamily="CalibriCFF" fontStyle="normal" color="0x666666"
							 />
				<!--source="@Embed('/assets/images/searchicon.png')"-->
				<s:Image right="4" verticalCenter="0" width="15" height="12" smooth="true"
						  transformX="7.5"
						 transformY="6" rotation="90" buttonMode="true" useHandCursor="true" toolTip="Search"/>
				
			</s:Group>
			
			<s:VGroup id="uiListContainer" height="100%" clipAndEnableScrolling="true">
				<s:List id="uiList" 
						borderVisible="false" width="{listItemWidth}"
						dataProvider="{dataProvider}"
						selectedIndex="@{viewModel.rosSelectedItemIndex}"
						itemRenderer="com.gazuntite.common.view.components.reviewofsystem.renderers.ReviewOfSystemItemRenderer"
						change="onItemSelected(event)"
						>
					<s:layout>
						<s:VerticalLayout gap="-1"/>
					</s:layout>
				</s:List>
			</s:VGroup>
			<s:HGroup width="{uiListContainer.width}" verticalAlign="middle">
				<s:Button toolTip="Scroll Down" useHandCursor="true" buttonMode="true"
						  click="scrollToPage(selectedPage-1)" 
						  skinClass="com.gazuntite.common.view.components.reviewofsystem.skin.DownBtnSkin"
						  />
				<s:Label id="uiPageLabel" width="100%" textAlign="center" fontFamily="CalibriCFFBold"/>
				<s:Button toolTip="Scroll Up" useHandCursor="true" buttonMode="true"
						  click="scrollToPage(selectedPage+1)" 
						  skinClass="com.gazuntite.common.view.components.reviewofsystem.skin.UpBtnSkin"
						  />
			</s:HGroup>
		</s:BorderContainer>
		
		<s:Group left="101" right="0" height="100%" visible="{!uiList.selectedIndex >= 0}" includeInLayout="{!uiList.selectedIndex >= 0}">
			<dictation:PleaseSelectView label="Select any item for input" horizontalCenter="0" verticalCenter="0"  width="90%"/>
		</s:Group>
		
		<reviewofsystem:ReviewOfSystemItemDetailView
			top="0" bottom="24" right="2" 
			left="{listItemWidth+12}"
			model="{selectedItem}"
			selectedItemRow="{selectedItemRow}"
			listItemHeight="{listItemHeight}"
			visible="{viewModel.showRosItemDetailViewTopLevel}"
			includeInLayout="{viewModel.showRosItemDetailViewTopLevel}"
			/>
<!--			heentItemList="{dataModel.tempHeentItems}"-->
		<reviewofsystem:ReviewOfSystemHeentEditView
			top="2" bottom="2" right="2" 
			left="2"
			model="{selectedItem}"
			selectedItemRow="{selectedItemRow}"
			listItemHeight="{listItemHeight}"
			visible="{viewModel.showRosItemViewHeentLevel}"
			includeInLayout="{viewModel.showRosItemViewHeentLevel}"
			/>
	</s:Group>
	<s:HGroup width="100%" verticalAlign="middle" horizontalAlign="right">
		<s:Button buttonMode="true"
				  skinClass="com.gazuntite.skins.controls.button.SaveButtonSkin" 
				  toolTip="Save" click="saveButton_clickHandler(event)" />
		<s:Button buttonMode="true"
				  skinClass="com.gazuntite.skins.controls.button.NextButtonSkin" 
				  toolTip="Next"/>
	</s:HGroup>
</s:Group>