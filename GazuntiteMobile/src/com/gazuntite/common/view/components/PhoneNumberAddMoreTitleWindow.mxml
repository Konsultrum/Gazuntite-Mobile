<?xml version="1.0" encoding="utf-8"?>
<mx:TitleWindow xmlns:fx="http://ns.adobe.com/mxml/2009" 
				xmlns:s="library://ns.adobe.com/flex/spark" 
				xmlns:mx="library://ns.adobe.com/flex/mx" 
				width="500" height="180" paddingRight="5" paddingBottom="5" paddingLeft="5" paddingTop="5"
				showCloseButton="true" close="titleWindowCloseHandler(event)"
				title="Add more contacts" xmlns:components="com.gazuntite.controls.extended.components.*" xmlns:components1="com.gazuntite.common.view.components.*">
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	<fx:Script>
		<![CDATA[
			import com.gazuntite.common.util.ValidationUtils;
			
			import mx.collections.ArrayCollection;
			import mx.controls.Alert;
			import mx.controls.Label;
			import mx.core.FlexGlobals;
			import mx.events.CloseEvent;
			import mx.managers.PopUpManager;
			import mx.states.OverrideBase;
			
			private var _isAddPhoneNumberPopUpShown:Boolean = false;
			
			private var _phoneNumbers:ArrayCollection;
			
			private var _PhoneNumberTypes:ArrayCollection;
			
			[Bindable]
			public function get PhoneNumberTypes():ArrayCollection
			{
				return _PhoneNumberTypes;
			}
			
			public function set PhoneNumberTypes(value:ArrayCollection):void
			{
				_PhoneNumberTypes = value;
			}
			
			private function titleWindowCloseHandler(event:CloseEvent):void
			{
				hide();
			}
			
			private function hide():void
			{
				_isAddPhoneNumberPopUpShown = false;
				
				resetFields();
				PopUpManager.removePopUp(this);	
			}
			
			private function onAddButtonClick():void
			{
				if(id_PhoneNumberAddMore.id_TelNumberKind.selectedItem )
				{
					var phoneNo:String = getPhoneNumberWithoutMasking( id_PhoneNumberAddMore.id_TelNumber.text);
					if(ValidationUtils.isRepeatingChars(0, phoneNo))
					{
						Alert.show("Phone number cannot contain repeating chars", "phone numbers error", 4, null);
						return;
					}
					else if(ValidationUtils.isRepeatingChars(1, phoneNo))
					{
						Alert.show("Phone number cannot contain repeating chars", "phone numbers error", 4, null);
						return;
					}
					else if(ValidationUtils.isRepeatingChars(2, phoneNo))
					{
						Alert.show("Phone number cannot contain repeating chars", "phone numbers error", 4, null);
						return;
					}
					else if(ValidationUtils.isRepeatingChars(3, phoneNo))
					{
						Alert.show("Phone number cannot contain repeating chars", "phone numbers error", 4, null);
						return;
					}
					else if (phoneNo.length > 16 || phoneNo.length < 10) //todo
					{
						Alert.show("Phone number Invalid", "phone numbers error", 4, null);
						return;
					}
					else if (phoneNo.charAt(0) == "0" || phoneNo.charAt(0) == "1")
					{
						Alert.show("Area code cannot start with 0 or 1", "phone numbers error", 4, null);
						return;
					}
					else if(phoneNo.substr(0, 3) == "555")
					{
						Alert.show("Area code cannot be 555", "phone numbers error", 4, null);
						return;
					}
					else
					{
						//ok
					}
					
					if (id_AddPhoneNumberGrid.dataProvider && id_AddPhoneNumberGrid.dataProvider.length < 5)
					{
						//if (!isInValid())
						{
							var result:Object = id_PhoneNumberAddMore.getPhoneNumberDetails();
							
							_phoneNumbers.addItem(result);
							resetFields();
						}
					}
					else
					{
						Alert.show("you can not enter more then 5 phone numbers.\n", "phone numbers limit error", 4, null);
						return;
					}
				}
				else
				{
					Alert.show("Please select Phone Type", "phone numbers error", 4, null);
					return;
				}
			}
			
			private function resetFields():void
			{
				if (id_PhoneNumberAddMore)
				{
					id_PhoneNumberAddMore.resetFields();
				}
				
				/*if (id_AddPhoneNumberGrid)
				{
				id_AddPhoneNumberGrid.dataProvider = null;
				}*/
			}
			
			[Bindable]
			public function get phoneNumbers():ArrayCollection
			{
				return _phoneNumbers;
			}
			
			public function set phoneNumbers(value:ArrayCollection):void
			{
				_phoneNumbers = value;
			}
			
			public function get isAddPhoneNumberPopUpShown():Boolean
			{
				return _isAddPhoneNumberPopUpShown;
			}
			
			public function display(parent:DisplayObject, pt:Point = null):void
			{
				if (!_isAddPhoneNumberPopUpShown)
				{
					_isAddPhoneNumberPopUpShown = true;
					visible = true;
					
					PopUpManager.addPopUp(this, parent);
					
					if (pt)
					{
						this.x = pt.x - this.width/2;
						this.y = pt.y;
					}
				}
			}
			
			public function clearPopUp():void
			{
				id_PhoneNumberAddMore.resetFields();
				_phoneNumbers = null;
				
				hide();
			}
			
			override protected function startDragging(event:MouseEvent):void
			{
			}
			
			public function linkbutton1_clickHandler(event:MouseEvent):void
			{
				_phoneNumbers.removeItemAt(id_AddPhoneNumberGrid.selectedIndex);
			} 
			//Tahir Alvi - remove masking on the phone number
			public function getPhoneNumberWithoutMasking(text:String):String
			{
				var val1:String = text;
				var val2:String = val1.replace('(','');
				var val3:String = val2.replace(')','');
				var val4:String = val3.replace('-','');
				
				return val4;
			}
			//Tahir Alvi - apply masking on the phone number at load time
			public function setPhoneNumberMasking(val:String):String
			{
				var val_Format:String = '(' + val.substring(0,3) + ')' + val.substring(3,6) + '-' + val.substring(6,10);
				return val_Format;
			}
			private function getPhoneNo(item:Object, column:DataGridColumn):String
			{
				var result:String = '';
				if(item.phoneNumber)
					result = setPhoneNumberMasking(item.phoneNumber);
				
				return result;
			}
			
		]]>
	</fx:Script>
	<s:VGroup horizontalAlign="center" width="100%">
		<s:HGroup width="100%" verticalAlign="middle">
			<components1:PhoneNumberAddMore id="id_PhoneNumberAddMore" width="80%" phoneNoType="{PhoneNumberTypes}"/>
			<s:Button id="add" label=" Save Phone Numbers" skinClass="com.adobe.gazuntite.skins.chrome.buttonSkins.addButton" click="onAddButtonClick()"
					  useHandCursor="true" buttonMode="true"  toolTip="Save Phone Numbers" />
		</s:HGroup>
		<mx:DataGrid id="id_AddPhoneNumberGrid" editable="false" minHeight="20" width="100%" rowCount="{id_AddPhoneNumberGrid.dataProvider.length}"
					 dataProvider="{phoneNumbers}" verticalScrollBarStyleName="VScrollBar" maxHeight="100" 
					 sortableColumns="false">
			<mx:columns>
				<mx:DataGridColumn dataField="phoneNumber" labelFunction="getPhoneNo" headerText="Phone number" width="0.5" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true"/>
				<mx:DataGridColumn dataField="phoneExtension" headerText="Extension" width="0.2" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true"/>
				<mx:DataGridColumn dataField="phoneNumberKind.NumberTypeName" headerText="Phone type" width="0.2" itemRenderer="mx.controls.Label" headerRenderer="mx.controls.Label" wordWrap="true"/>
				<mx:DataGridColumn width="0.1" headerText="">
					<mx:itemRenderer>
						<fx:Component>	
							<!--<s:HGroup buttonMode="true" useHandCursor="true" width="60" paddingBottom="2" horizontalAlign="center" verticalAlign="middle">
							<s:Button buttonMode="true" useHandCursor="true" toolTip="remove" width="30" label="X" click="outerDocument.linkbutton1_clickHandler(event)" />
							</s:HGroup>-->
							<mx:HBox buttonMode="true" useHandCursor="true" width="60" paddingBottom="2" horizontalAlign="center" verticalAlign="middle">
								<mx:LinkButton click="outerDocument.linkbutton1_clickHandler(event)"   width="30" label="X"
											   buttonMode="true" useHandCursor="true" toolTip="remove" visible="{outerDocument.phoneNumbers.length > 1 ? true : false}"/>							
							</mx:HBox>
							
						</fx:Component>
					</mx:itemRenderer>
				</mx:DataGridColumn>
			</mx:columns>
		</mx:DataGrid>
	</s:VGroup>
</mx:TitleWindow>
