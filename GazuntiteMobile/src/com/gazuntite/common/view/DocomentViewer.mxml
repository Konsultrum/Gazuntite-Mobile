<?xml version="1.0" encoding="utf-8"?>
<s:Group xmlns:fx="http://ns.adobe.com/mxml/2009" 
		 xmlns:s="library://ns.adobe.com/flex/spark"  
		 xmlns:mx="library://ns.adobe.com/flex/mx" creationComplete="group1_creationCompleteHandler(event)" >
	
	<fx:Metadata>
		[Event(name="CloseDocomontView", type="flash.events.Event")]
	</fx:Metadata>
	<fx:Script>
		<![CDATA[
			import mx.core.FlexGlobals;
			import mx.core.UIComponent;
			import mx.events.FlexEvent;
			import mx.managers.PopUpManager;
			
			[Bindable]
			public var filename:String;
			
			[Bindable]
			public var createdDate:String;
			
			[Bindable]
			public var FilePath:String;
			
			protected function group1_creationCompleteHandler(event:FlexEvent):void
			{
				
			}
			
			
			protected function back_button_clickHandler(event:MouseEvent):void
			{
				dispatchEvent( new Event('CloseDocomontView'));
			}
			
			private function ExpandDocomentView():void
			{
				if (null == FilePath)
					return;
				
				var pop:DocomentExpendedViewer = new DocomentExpendedViewer();
				var app:UIComponent = FlexGlobals.topLevelApplication as UIComponent;
				
				pop.x = 14;
				pop.y = 77 + 4;
				pop.width = app.width*0.5 - pop.x - 8;
				pop.height = app.height - pop.y - 65;
				
				pop.documentName = filename;
				pop.documentUrl = FilePath;
				pop.isOrder = false;
				
				PopUpManager.addPopUp(pop, app);
			}
			
		]]>
	</fx:Script>
	<fx:Declarations>
		<mx:DateFormatter id="df" formatString="MM/DD/YYYY" />
	</fx:Declarations>
	<s:layout>
		<s:VerticalLayout />
	</s:layout>
	<s:BorderContainer width="100%" height="100%" cornerRadius="3" backgroundColor="0xFFFFFF" borderVisible="false">
		<mx:HTML id="id_DocViewer" location="{FilePath}" left="3" right="2" top="3" bottom="3" horizontalScrollPolicy="off" verticalScrollBarStyleName="htmlVScroll"/>
	</s:BorderContainer>
	
	<s:HGroup width="100%" paddingBottom="5">
		<s:Button id="back_button" 
				  toolTip="Back" 
				  click="back_button_clickHandler(event)"
				  buttonMode="true" useHandCursor="true"
				  skinClass="com.gazuntite.skins.controls.button.eLab.BackButtonSkin"
				  />
		
		<s:Label text="{filename + ' (' + df.format(createdDate) + ' )'}" 
				 width="100%" fontFamily="CalibriCFFBold" fontSize="14" textAlign="center" color="0xFFFFFF" />
		
		<s:Button id="Expand_button" 
						click="ExpandDocomentView()"
						buttonMode="true" useHandCursor="true" toolTip="Expand"
						skinClass="com.gazuntite.skins.controls.button.eLab.ExpandButtonSkin"/>
	</s:HGroup>
</s:Group>
