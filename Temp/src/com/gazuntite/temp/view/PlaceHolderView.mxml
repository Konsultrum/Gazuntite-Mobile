<?xml version="1.0" encoding="utf-8"?>
<s:View xmlns:fx="http://ns.adobe.com/mxml/2009" 
		xmlns:s="library://ns.adobe.com/flex/spark" 
		title="{navModel.title}" 
		gestureSwipe="onSwipe(event)"
 		xmlns:navigation="com.gazuntite.common.view.navigation.*"
		>
	<fx:Script>
		<![CDATA[
			import com.gazuntite.common.view.navigation.NavigationCallout;
			import com.gazuntite.common.viewmodel.navigation.NavigationInfo;
			import com.gazuntite.common.viewmodel.navigation.NavigationInfoItem;
			
			import spark.transitions.SlideViewTransition;
			[Bindable]
			public var navModel:NavigationInfoItem;
			public var slide:SlideViewTransition = new SlideViewTransition();
			
			public override function set data(value:Object):void
			{
				super.data = value;
				navModel = value as NavigationInfoItem; 
			}
			
			protected function onSwipe(event:TransformGestureEvent):void
			{
				if (event.offsetX ==-1)
				{
					uiNextButton.onNextClick();
				}
				else
				{
					uiPrevButton.onPrevClick();
				}
			}
			
		]]>
	</fx:Script>
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	<s:navigationContent>
		<navigation:NavigationBackButton
			id="uiPrevButton"
			navigator="{this.navigator}"
			navModel="{navModel}"
			/>
	</s:navigationContent>
	<s:actionContent>
		<navigation:NavigationQuickAccessImage
			navigator="{navigator}"
			/>
		<s:Spacer width="4"/>
		<navigation:NavigationNextButton
			id="uiNextButton"
			navigator="{this.navigator}"
			navModel="{navModel}"
			/>
	</s:actionContent>
	<s:Label text="{'Place Holder for '+navModel.title+' View'}" horizontalCenter="0" verticalCenter="0" fontSize="24"/>
</s:View>
