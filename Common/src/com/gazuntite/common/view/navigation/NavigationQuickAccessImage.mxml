<?xml version="1.0" encoding="utf-8"?>
<s:Image xmlns:fx="http://ns.adobe.com/mxml/2009" 
		 xmlns:s="library://ns.adobe.com/flex/spark"
		 source="@Embed('assets/images/60-dialpad-inv.png')"
		 visible="{navigator.context!=null}"
		 includeInLayout="{navigator.context!=null}"
		 click="onNavIconClick(event)"
		 >
	<fx:Script>
		<![CDATA[
			import com.gazuntite.common.viewmodel.navigation.NavigationInfo;
			
			import spark.components.ViewNavigator;
			[Bindable]
			public var navigator:ViewNavigator;
			
			protected function onNavIconClick(event:MouseEvent):void
			{
				var callout:NavigationCallout = new NavigationCallout();
				callout.navModel = navigator.context as NavigationInfo;
				callout.open(this, true);
			}
		]]>
	</fx:Script>
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
</s:Image>
