<?xml version="1.0" encoding="utf-8"?>
<s:ItemRenderer xmlns:fx="http://ns.adobe.com/mxml/2009" 
				xmlns:s="library://ns.adobe.com/flex/spark" 
				xmlns:mx="library://ns.adobe.com/flex/mx" 
				autoDrawBackground="true" xmlns:buttonSkins="com.adobe.gazuntite.skins.chrome.buttonSkins.*"
				width="100%" xmlns:components="com.gazuntite.components.*"
				xmlns:component="com.gazuntite.common.view.component.*">
	
	
	<s:layout >
		<s:VerticalLayout gap="0" horizontalAlign="center" paddingBottom="0" paddingTop="0" paddingLeft="0" paddingRight="0"/> 
	</s:layout>
	
	<s:SkinnableContainer id="id_Header" width="100%" height="35">
		<s:layout>
			<s:HorizontalLayout verticalAlign="middle" paddingLeft="10" paddingRight="5"/>
		</s:layout>
		
		<s:Label id="SrNo" 
				 text="{data.serialNumber.toString()}" fontFamily="CalibriCFF" fontSize="14" width="30"
				 paddingLeft="6" maxDisplayedLines="1"/>
		
		<s:HGroup width="100%" horizontalAlign="left" verticalAlign="middle" gap="0">
<!--			<buttonSkins:buttonNavSeparator width="1" height="100%"/>
-->			<s:Label id="visitDate" 
					 fontFamily="CalibriCFF" fontSize="14" width="100%"
					 paddingLeft="6" maxDisplayedLines="1"/>
		</s:HGroup>
		
		<s:HGroup width="120" horizontalAlign="center" verticalAlign="middle">
<!--			<buttonSkins:buttonNavSeparator width="1" height="100%"/>
-->			
			<s:HGroup width="100%" horizontalAlign="center">
				<s:ToggleButton id="uiDication" skinClass="com.gazuntite.common.view.skin.DictationButtonSkin"
						  buttonMode="true" useHandCursor="true" toolTip="Dictation" selected="@{data.dictationNoteViewModel.inDictationMode}"/>
				<s:ToggleButton id="uiNote" skinClass="com.gazuntite.common.view.skin.WriteNoteButtonSkin"
								buttonMode="true" useHandCursor="true" toolTip="Notes" selected="@{data.dictationNoteViewModel.inNoteMode}"/>
			</s:HGroup>
			
		</s:HGroup>
	</s:SkinnableContainer>
	<component:PatientDictationNoteView width="100%" viewModel="{data.dictationNoteViewModel}" note="@{data.Note}"/>
</s:ItemRenderer>
