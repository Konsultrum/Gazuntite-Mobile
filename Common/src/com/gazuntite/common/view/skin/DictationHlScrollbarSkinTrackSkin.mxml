<?xml version="1.0" encoding="utf-8"?>
<s:Skin xmlns:s="library://ns.adobe.com/flex/spark"
		xmlns:fx="http://ns.adobe.com/mxml/2009"
		width="120" height="24">
	<fx:Metadata>[HostComponent("spark.components.Button")]</fx:Metadata>
	<s:states>
		<s:State name="up"/>
		<s:State name="over"/>
		<s:State name="down"/>
		<s:State name="disabled"/>
	</s:states>
	<s:Rect left="0" y="0" right="0" width="120" height="24" radiusX="12">
		<s:fill>
			<s:LinearGradient rotation="90">
				<s:GradientEntry alpha="1.0" color="#A0847D" ratio="0"/>
				<s:GradientEntry alpha="1.0" color="#836B64" ratio="0.45098039215686275"/>
				<s:GradientEntry alpha="1.0" color="#7E655F" ratio="0.45098039215686275"/>
				<s:GradientEntry alpha="1.0" color="#725D58" ratio="1"/>
			</s:LinearGradient>
		</s:fill>
		<s:filters>
			<s:DropShadowFilter alpha="0.75" angle="90" blurX="2" blurY="2" color="#000000"
								distance="2" hideObject="false" inner="true" knockout="false"
								quality="3" strength="1"/>
			<s:BevelFilter angle="90" blurX="1" blurY="1" distance="1" highlightAlpha="0.25"
						   highlightColor="#FFFFFF" knockout="false" quality="2" shadowAlpha="0.25"
						   shadowColor="#000000" strength="1" type="inner"/>
		</s:filters>
	</s:Rect>
</s:Skin>
