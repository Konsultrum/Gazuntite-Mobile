package com.gazuntite.common.logo
{
	import flash.utils.ByteArray;
	
	import mx.utils.Base64Decoder;

	[Bindable]
	public class LogoAsset
	{
		protected static var LOGIN_LOGO_B4STR:String = '';
		protected static var TOPBAR_LOGO_B4STR:String ='';
		protected static function getByteArray(val:String):ByteArray
		{
			var base64Dec:Base64Decoder = new Base64Decoder();;
			var byteArr:ByteArray;
			base64Dec.decode(val);
			byteArr = base64Dec.toByteArray();
			
			return byteArr;
		}
		public static function get loginLogo():ByteArray
		{
			return getByteArray(LOGIN_LOGO_B4STR);
		}
		public static function get topBarLogo():ByteArray
		{
			return getByteArray(TOPBAR_LOGO_B4STR);
		}
	}
}